# Names only, grouped by platform. Copy to `.env` (git-ignored) and fill in locally. NEVER commit values.
# Worker runtime secrets live in Cloudflare (`wrangler secret put <NAME>`); local worker dev reads
# apps/worker/.dev.vars; the web build reads apps/web/.env.local. The authoritative list is the Env interface in
# apps/worker/src/env.ts. See platforms/README.md.

# --- Cloudflare (deploy scripts and read-only account checks) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Worker secrets (Cloudflare) ---
ADMIN_KEY=
MEMBERSHIP_OUTBOX_TOKEN=

# --- Supabase ---
# SUPABASE_URL and SUPABASE_ANON_KEY are public and live in apps/worker/wrangler.apple.jsonc.
# platforms/supabase/migrate.mjs takes the database URL with --url; do not store it in the repository.

# --- Sentry ---
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_STUDIO=
STRIPE_PORTAL_CONFIGURATION=

# --- Discord ---
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# --- Roblox ---
ROBLOX_API_KEY=
ROBLOX_CREATOR_USER_ID=
ROBLOX_CREATOR_GROUP_ID=
