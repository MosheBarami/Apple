{
  "id": "daily-reward",
  "kind": "system",
  "summary": "A daily reward with a streak: each day back in a row pays the next amount; missing a day starts again at day 1.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "currency": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z ]{0,15}$",
        "default": "Coins",
        "description": "A currency from the currency block"
      },
      "rewards": {
        "type": "array",
        "minItems": 1,
        "maxItems": 14,
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "default": [
          50,
          75,
          100,
          150,
          200,
          300,
          500
        ],
        "description": "Amount for day 1, 2, 3...; after the last it repeats the last"
      }
    }
  },
  "provides": [
    "Daily.claim",
    "DailyClaim"
  ],
  "depends": [
    "currency"
  ]
}