-- PROOF ONLY (never shipped): rebirth is refused below the cost and resets the money above it.
local Players = game:GetService("Players")
local Currency = require(game.ServerScriptService:WaitForChild("Currency"))
local Rebirth = require(game.ServerScriptService:WaitForChild("Rebirth"))
local player = Players:GetPlayers()[1] or Players.PlayerAdded:Wait()
repeat task.wait() until Currency.ready(player)
local cost = Rebirth.cost(player)
Currency.spend(player, Rebirth.CURRENCY, Currency.get(player, Rebirth.CURRENCY), "proof: empty")
assert(Rebirth.rebirth(player) == false, "rebirth without the cost is refused")
Currency.grant(player, Rebirth.CURRENCY, cost + 5, "proof: fund")
task.wait(1.1)
local m = Rebirth.multiplier(player)
assert(Rebirth.rebirth(player) == true, "rebirth with the cost succeeds")
assert(Currency.get(player, Rebirth.CURRENCY) == 0, "the currency is reset")
assert(Rebirth.multiplier(player) > m, "the multiplier grew")
assert(Rebirth.cost(player) > cost, "the next rebirth costs more")
print("STUDPILOT_PROOF_OK rebirth")
