{
  "steps": [
    {
      "id": "create",
      "op": "create_instances",
      "items": [
        {
          "className": "ScreenGui",
          "name": "{{name}}",
          "parent": "game.StarterGui",
          "children": [
            {
              "className": "Frame",
              "name": "Body",
              "props": {
                "AnchorPoint": { "t": "Vector2", "v": [0.5, 0.5] },
                "Position": { "t": "UDim2", "v": [0.5, 0, 0.5, 0] },
                "Size": { "t": "UDim2", "v": [0, "{{width}}", 0, "{{height}}"] },
                "BackgroundColor3": "#16213a",
                "BackgroundTransparency": 0.08,
                "BorderSizePixel": 0
              },
              "children": [
                { "className": "UICorner", "name": "Corner", "props": { "CornerRadius": { "t": "UDim", "v": [0, 12] } } },
                { "className": "UIStroke", "name": "Outline", "props": { "Thickness": 3, "Color": "#000000" } },
                {
                  "className": "Frame",
                  "name": "Header",
                  "props": { "Size": { "t": "UDim2", "v": [1, 0, 0, 48] }, "BackgroundColor3": "{{accent}}", "BorderSizePixel": 0 },
                  "children": [
                    { "className": "UICorner", "name": "Corner", "props": { "CornerRadius": { "t": "UDim", "v": [0, 12] } } },
                    {
                      "className": "TextLabel",
                      "name": "Title",
                      "props": {
                        "Size": { "t": "UDim2", "v": [1, -24, 1, -12] },
                        "Position": { "t": "UDim2", "v": [0, 12, 0, 6] },
                        "BackgroundTransparency": 1,
                        "Text": "{{title}}",
                        "TextColor3": "#ffffff",
                        "TextScaled": true
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
