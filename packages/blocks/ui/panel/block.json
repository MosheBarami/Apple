{
  "id": "panel",
  "kind": "ui",
  "summary": "A menu window on screen: studded colour header with title, dark body, close button. Other UI blocks fill it.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "screen": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "default": "Shop",
        "description": "The ScreenGui this belongs to (the panel's screen)"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 28,
        "default": "Shop",
        "description": "Header text"
      },
      "accent": {
        "type": "string",
        "enum": [
          "green",
          "yellow",
          "orange",
          "pink",
          "blue",
          "purple",
          "red",
          "cream",
          "grey"
        ],
        "default": "blue",
        "description": "Header colour"
      },
      "width": {
        "type": "number",
        "minimum": 0.3,
        "maximum": 0.9,
        "default": 0.6,
        "description": "Share of the screen width"
      },
      "height": {
        "type": "number",
        "minimum": 0.35,
        "maximum": 0.85,
        "default": 0.72,
        "description": "Share of the screen height"
      },
      "closable": {
        "type": "boolean",
        "default": true,
        "description": "Show the red close button"
      },
      "startOpen": {
        "type": "boolean",
        "default": true,
        "description": "Open when the game starts; false for a panel a HUD button opens"
      }
    }
  },
  "provides": [],
  "depends": []
}