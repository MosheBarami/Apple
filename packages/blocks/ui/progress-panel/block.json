{
  "id": "progress-panel",
  "kind": "ui",
  "summary": "Inside a window: stat cards, a big labelled progress bar and one action button (rebirth, level-up, goal screens).",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "screen": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "default": "Shop",
        "description": "The ScreenGui this belongs to (the window's screen)"
      },
      "token": {
        "type": "string",
        "enum": [
          "lime",
          "sky",
          "sun",
          "berry",
          "grape",
          "teal",
          "slate"
        ],
        "default": "grape",
        "description": "Stat card colour"
      },
      "stats": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "value",
            "icon"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 22,
              "default": "Multiplier",
              "description": "Left text"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 14,
              "default": "x1",
              "description": "Right text, large and gold"
            },
            "icon": {
              "type": "string",
              "enum": [
                "coin",
                "coins",
                "cash",
                "money_bag",
                "gem",
                "gift",
                "basket",
                "book",
                "gear",
                "clover",
                "rebirth",
                "trophy",
                "vip",
                "star",
                "heart",
                "bolt",
                "potion",
                "egg",
                "paw",
                "sword",
                "shield",
                "chest",
                "key",
                "lock",
                "check",
                "close",
                "info",
                "clock",
                "map",
                "home",
                "backpack",
                "pickaxe",
                "rocket",
                "fire",
                "ticket",
                "calendar",
                "scroll",
                "arrow_up",
                "magnet",
                "boots"
              ],
              "default": "star",
              "description": "An icon from the kit's pack, by name"
            }
          }
        },
        "default": [
          {
            "label": "Multiplier",
            "value": "x1",
            "icon": "star"
          }
        ]
      },
      "barLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 28,
        "default": "0 / 100",
        "description": "Text on the bar"
      },
      "progress": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.4,
        "description": "Bar fill, 0 to 1"
      },
      "barToken": {
        "type": "string",
        "enum": [
          "lime",
          "sky",
          "sun",
          "berry",
          "grape",
          "teal",
          "slate"
        ],
        "default": "sun",
        "description": "Bar colour"
      },
      "action": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16,
        "default": "Go",
        "description": "Button text, e.g. Rebirth"
      },
      "actionToken": {
        "type": "string",
        "enum": [
          "lime",
          "sky",
          "sun",
          "berry",
          "grape",
          "teal",
          "slate"
        ],
        "default": "lime",
        "description": "Button colour; slate when not ready"
      },
      "actionFires": {
        "type": "string",
        "pattern": "^([A-Za-z][A-Za-z0-9_]{0,31})?$",
        "default": "",
        "description": "The remote the button asks, e.g. RebirthRequest (the rebirth block), or \"\""
      }
    }
  },
  "provides": [],
  "depends": [
    "window"
  ]
}