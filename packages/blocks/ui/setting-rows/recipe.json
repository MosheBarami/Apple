          0
         ],
         "position": [
          0.96,
          0,
          0.5,
          0
         ],
         "anchor": [
          1,
          0.5
         ],
         "visible": "{{item.switch}}",
         "attributes": {
          "States": "{{item.options}}"
         }
        }
       ],
       "each": "settings",
       "order": "{{index}}"
      }
     ]
    }
   ]
  },
  {
   "id": "wire",
   "op": "edit_script",
