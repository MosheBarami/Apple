{
  "id": "row-list",
  "kind": "ui",
  "summary": "Rows in a scrolling list inside a panel: icon chip, label, detail, value, optional progress bar and button.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "screen": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "default": "Shop",
        "description": "The ScreenGui this belongs to (the panel's screen)"
      },
      "showProgress": {
        "type": "boolean",
        "default": false,
        "description": "Show each row's progress bar"
      },
      "showDetail": {
        "type": "boolean",
        "default": true,
        "description": "Show each row's second line (false for a leaderboard)"
      },
      "feed": {
        "type": "string",
        "enum": [
          "none",
          "leaderboard",
          "upgrades"
        ],
        "default": "none",
        "description": "leaderboard: rows fill from the leaderboard block; upgrades: buttons buy from the upgrades block"
      },
      "stat": {
        "type": "string",
        "pattern": "^([A-Za-z][A-Za-z ]{0,15})?$",
        "default": "",
        "description": "For feed leaderboard: the ranked stat; for upgrades: the currency"
      },
      "showButton": {
        "type": "boolean",
        "default": false,
        "description": "Show each row's button"
      },
      "rowHeight": {
        "type": "integer",
        "minimum": 66,
        "maximum": 110,
        "default": 76,
        "description": "Pixels"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "icon",
            "label",
            "detail",
            "value",
            "colour",
            "progress",
            "button",
            "buttonColour"
          ],
          "properties": {
            "icon": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4,
              "default": "⭐",
              "description": "One common emoji or symbol (very new emoji such as 🪙 do not show in Roblox)"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 26,
              "default": "Row",
              "description": "Main text, e.g. a player name, quest or upgrade"
            },
            "detail": {
              "type": "string",
              "minLength": 0,
              "maxLength": 40,
              "default": "",
              "description": "Second line, e.g. +10% speed, 3/5 collected (may be empty)"
            },
            "value": {
              "type": "string",
              "minLength": 0,
              "maxLength": 14,
              "default": "",
              "description": "Right side, e.g. 1,250 wins, Lv 3 (may be empty)"
            },
            "colour": {
              "type": "string",
              "enum": [
                "green",
                "yellow",
                "orange",
                "pink",
                "blue",
                "purple",
                "red",
                "cream",
                "grey"
              ],
              "default": "blue",
              "description": "Icon chip colour"
            },
            "progress": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0,
              "description": "Bar fill, 0 to 1"
            },
            "button": {
              "type": "string",
              "minLength": 0,
              "maxLength": 12,
              "default": "",
              "description": "Button text, e.g. Buy 500 (may be empty)"
            },
            "buttonColour": {
              "type": "string",
              "enum": [
                "green",
                "yellow",
                "orange",
                "pink",
                "blue",
                "purple",
                "red",
                "cream",
                "grey"
              ],
              "default": "green",
              "description": "Grey when it cannot be pressed now"
            }
          }
        },
        "default": [
          {
            "icon": "⭐",
            "label": "First",
            "detail": "",
            "value": "",
            "colour": "blue",
            "progress": 0,
            "button": "",
            "buttonColour": "green"
          }
        ]
      }
    }
  },
  "provides": [],
  "depends": [
    "panel"
  ]
}