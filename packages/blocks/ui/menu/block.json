{
  "id": "menu",
  "kind": "ui",
  "summary": "A full-screen main menu: glossy backdrop, a big gold title and large studded buttons that start or open windows.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "screen": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "default": "MainMenu",
        "description": "The ScreenGui this belongs to (the window's screen)"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24,
        "default": "My Game",
        "description": "The game name, large"
      },
      "subtitle": {
        "type": "string",
        "minLength": 0,
        "maxLength": 40,
        "default": "",
        "description": "A line under the title (may be empty)"
      },
      "token": {
        "type": "string",
        "enum": [
          "lime",
          "sky",
          "sun",
          "berry",
          "grape",
          "teal",
          "slate"
        ],
        "default": "sky",
        "description": "Backdrop colour"
      },
      "buttons": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "icon",
            "token",
            "closes"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 14,
              "default": "Play",
              "description": "Button text"
            },
            "icon": {
              "type": "string",
              "enum": [
                "coin",
                "coins",
                "cash",
                "money_bag",
                "gem",
                "gift",
                "basket",
                "book",
                "gear",
                "clover",
                "rebirth",
                "trophy",
                "vip",
                "star",
                "heart",
                "bolt",
                "potion",
                "egg",
                "paw",
                "sword",
                "shield",
                "chest",
                "key",
                "lock",
                "check",
                "close",
                "info",
                "clock",
                "map",
                "home",
                "backpack",
                "pickaxe",
                "rocket",
                "fire",
                "ticket",
                "calendar",
                "scroll",
                "arrow_up",
                "magnet",
                "boots"
              ],
              "default": "rocket",
              "description": "An icon from the kit's pack, by name"
            },
            "token": {
              "type": "string",
              "enum": [
                "lime",
                "sky",
                "sun",
                "berry",
                "grape",
                "teal",
                "slate"
              ],
              "default": "lime",
              "description": "Button colour"
            },
            "closes": {
              "type": "boolean",
              "default": false,
              "description": "Pressing it hides the menu (true for Play)"
            },
            "action": {
              "type": "string",
              "pattern": "^(open:[A-Za-z][A-Za-z0-9_]{0,31})?$",
              "default": "",
              "description": "open:<Screen> opens that window (Settings, Shop); \"\" for none"
            }
          }
        },
        "default": [
          {
            "label": "Play",
            "icon": "rocket",
            "token": "lime",
            "closes": true
          }
        ]
      }
    }
  },
  "provides": [],
  "depends": []
}
