{
 "steps": [
  {
   "id": "create",
   "op": "create_instances",
   "items": [
    {
     "parent": "game.StarterGui",
     "className": "ScreenGui",
     "name": "{{screen}}",
     "props": {
      "ResetOnSpawn": false,
      "ZIndexBehavior": {
       "t": "EnumItem",
       "v": "Enum.ZIndexBehavior.Sibling"
      },
      "IgnoreGuiInset": true
     },
     "children": [
      {
       "kit": "card",
       "name": "Backdrop",
       "token": "{{token}}",
       "size": [
        1,
        0,
        1,
        0
       ]
      },
      {
       "kit": "text",
       "name": "Title",
       "text": "{{title}}",
       "ink": "gold",
       "size": [
        0.8,
        0,
        0.2,
        0
       ],
       "position": [
        0.5,
        0,
        0.07,
        0
       ],
       "anchor": [
        0.5,
        0
       ],
       "max": 110
      },
      {
       "kit": "text",
       "name": "Subtitle",
       "text": "{{subtitle}}",
       "size": [
        0.6,
        0,
        0.06,
        0
       ],
       "position": [
        0.5,
        0,
        0.27,
        0
       ],
       "anchor": [
        0.5,
        0
       ],
       "max": 36
      },
      {
       "className": "Frame",
       "name": "Buttons",
       "props": {
        "BackgroundTransparency": 1,
        "Size": {
         "t": "UDim2",
         "v": [
          0.36,
          0,
          0.54,
          0
         ]
        },
        "Position": {
         "t": "UDim2",
         "v": [
          0.5,
          0,
          0.37,
          0
         ]
        },
        "AnchorPoint": {
         "t": "Vector2",
         "v": [
          0.5,
          0
         ]
        },
        "ZIndex": 5
       },
       "attributes": {
        "StudKit": "menu.layout"
       },
       "children": [
        {
         "className": "UIListLayout",
         "name": "Stack",
         "props": {
          "Padding": {
           "t": "UDim",
           "v": [
            0.05,
            0
           ]
          },
          "SortOrder": {
           "t": "EnumItem",
           "v": "Enum.SortOrder.LayoutOrder"
          },
          "HorizontalAlignment": {
           "t": "EnumItem",
           "v": "Enum.HorizontalAlignment.Center"
          }
         }
        },
        {
         "kit": "button",
         "name": "Button{{index}}",
         "token": "{{item.token}}",
         "text": "{{item.label}}",
         "icon": "{{item.icon}}",
         "size": [
          1,
          0,
          0.23,
          0
         ],
         "order": "{{index}}",
         "max": 48,
         "attributes": {
          "Closes": "{{item.closes}}",
          "Action": "{{item.action}}"
         },
         "each": "buttons"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "close",
   "op": "edit_script",
   "path": "game.StarterGui.{{screen}}.MenuButtons",
   "file": "src/MenuButtons.luau",
   "create": {
    "className": "LocalScript",
    "parent": "game.StarterGui.{{screen}}"
   }
  }
 ]
}
