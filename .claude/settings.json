  "disableBundledSkills": false,
  "deniedMcpServers": [],
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "vercel@vercel-plugins": false,
    "design@knowledge-work-plugins": false,
    "design@lovstudio": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "hf-cli@huggingface-skills": true,
    "superpowers@claude-plugins-official": false,
    "data@knowledge-work-plugins": false,
    "mcp-builder@mcp-use": true,
    "cloudflare@cloudflare": true,
    "supabase@claude-plugins-official": true,
    "watch@claude-video": true
  },
  "effortLevel": "high",
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "/Users/moshe/.claude/rules/context7.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-cloud-start.sh\"",
            "timeout": 900
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/critique.mjs\" gate --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__Roblox_Studio__screen_capture|mcp__Roblox_Studio__execute_luau",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/critique.mjs\" nudge",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
