{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "TodoWrite",
      "mcp__claude-in-chrome",
      "mcp__apple-studio"
