{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "TodoWrite",
      "mcp__claude-in-chrome",
      "mcp__apple-studio"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(~/.ssh/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.mcp-auth/**)",
      "Edit(**/.env)",
      "Edit(~/.ssh/**)",
      "Edit(~/Library/Keychains/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/autonomy_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/autonomy_no_questions.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/autonomy_stop_gate.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/autonomy_prompt_context.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": false,
    "vercel@vercel-plugins": false,
    "design@knowledge-work-plugins": false,
    "design@lovstudio": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "hf-cli@huggingface-skills": false,
    "superpowers@claude-plugins-official": false,
    "data@knowledge-work-plugins": false,
    "mcp-builder@mcp-use": false
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "20",
    "BASH_MAX_OUTPUT_LENGTH": "12000"
  },
  "effortLevel": "high"
}
