{
  "name": "golem",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/checks/check-workspace-coverage.mjs && pnpm -r test",
    "e2e": "playwright test",
    "check:dispositions": "node scripts/checks/check-dispositions.mjs",
    "check:backlog": "node scripts/checks/check-backlog.mjs",
    "check:pixels": "node scripts/checks/check-pixels.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "brand:check": "node scripts/make-brand-assets.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "wrangler": "^4.127.1"
  }
}
