---
import {
  PLAN_COPY,
  PLAN_FEATURES,
  PLAN_IDS,
  PLAN_LIMITS,
  PLAN_SUPPORT,
  PRICE_CURRENCY,
  buildsPerMonth,
  formatMoney,
  CREDITS_PER_BUILD,
  fullRateDays,
  monthlyCeilingBitesFirst,
  PRODUCT_MODES_OFFERED,
  PRODUCT_MODE_INFO,
  MODE_INFO,
  PRODUCT_MODE_TO_SPECIALIST,
} from '@golem/shared';

// THE NUMBERS ON THIS PAGE ARE READ, NOT WRITTEN. They used to be typed in prose and in the plan
// cards, so the marketing site and the thing enforcing the quota could drift apart — and they had:
// this page still advertised a waitlist tier at a daily figure no plan grants, under a name that
// under that name or that number. scripts/check-offer.mjs is what caught it, and reading from
// PLAN_LIMITS is what stops it recurring.
//[[ WHETHER A PLAN CAN BE BOUGHT IS ASKED, NOT TYPED.
//
//   Every sentence on this page saying "planned tier — not available to purchase yet" was prose.
//   It is TRUE today — the live Worker holds two secrets, ADMIN_KEY and ROBLOX_API_KEY, and no
//   Stripe key at all, so checkoutConfigured() is false and `purchasable` comes back empty — but a
//   hardcoded truth is a lie waiting for the day it changes. The moment Stripe is connected, a page
//   still saying "planned" costs the owner the sale it was built to make, and nothing anywhere
//   would fail to tell him.
//
//   So the build ASKS. /api/billing/config returns { checkout, purchasable } computed from the
//   deployment's own environment, and every claim below is derived from the answer.
//
//   THE FALLBACK IS THE SAFE CLAIM, NOT THE CONVENIENT ONE. An unreachable probe means "not
//   purchasable". Claiming a plan is buyable when we could not establish it walks someone into a
//   checkout that answers 503; claiming it is not buyable when it is costs a sale and is visibly
//   wrong to the owner within a day. Those two errors are not the same size.
//
//   Build-time, not client-side: this is a static page served out of D1, a deploy is the moment the
//   answer can change, and every deploy re-asks.
//
//   `import.meta.env` IS DELIBERATELY NOT USED HERE. It breaks this page's build — esbuild reports
//   `Expected ")" but found "s"`, because it reads `import` and expects a dynamic import's paren.
//   Isolated by bisection: the committed page builds, the same code with a template literal builds,
//   and only the `import.meta.env` form fails. The origin is therefore a constant.
const BILLING_ORIGIN = 'https://apple.moshe-barami111.workers.dev';
const billingProbe = await fetch(BILLING_ORIGIN + '/api/billing/config').then((r) => (r.ok ? r.json() : null)).catch(() => null);
const billing = {
  checkout: billingProbe?.checkout === true,
  purchasable: Array.isArray(billingProbe?.purchasable) ? billingProbe.purchasable : [],
};
const canBuy = (id) => billing.purchasable.includes(id);

const free = PLAN_LIMITS.free;
const paid = PLAN_IDS.filter((id) => id !== 'free' && PLAN_COPY[id].priceUsdMonthly !== null);
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

// Figures come from docs/COST-MODEL.md through the SAME arithmetic the worker uses,
// `creditsForNeurons(n) = max(1, ceil(n / 30))`, and are not invented here:
// Allowances themselves are read from PLAN_LIMITS above, never restated here.
//
//   Plan         37-43 neurons -> ceil(43/30)  =  2 credits
//   Agent        111 neurons   -> ceil(111/30) =  4 credits  (targeted edit + read-back verify)
//   Super Agent  297 neurons   -> ceil(297/30) = 10 credits  (withdrawn; kept for the arithmetic)
//
// COST-MODEL.md names these by their INTERNAL specialist identities — Clay, Stone, Rune
// — which is correct there and wrong here: packages/shared says those "are internal
// specialist identities, not user-facing brands: nothing in normal product UI should
// name them", and §15.3 gave the public modes as Plan / Agent / Super Agent. Super Agent has
// since been withdrawn from PRODUCT_MODES_OFFERED, which is what this page now reads.
//
// Plan was published as 1 credit and a request count computed from it. It is 2. Agent and
// Super Agent were both right, which is what makes the Plan figure an arithmetic slip
// rather than a different model of pricing: whoever wrote them divided correctly.
// "≈ requests / free day" is the free daily allowance divided by cost, and it is now
// COMPUTED rather than typed. It was typed — 30 / 15 / up to 6 — against a free tier that
// granted 60 Credits a day. The repricing took free to 231 and those three numbers stayed
// exactly where they were, so this page understated its own free allowance almost
// fourfold for as long as that was live. Nobody typed a wrong number; three right ones
// were left behind by a change somewhere else, which is the failure mode a literal always
// has and a derivation cannot.
//
// Derived from the row's OWN `cost`, so there is one literal per row rather than two that
// can disagree with each other.
const perFreeDay = (cost: string, prefix = ''): string => {
  const n = Number(/^\d+/.exec(cost)?.[0]);
  if (!n) throw new Error(`pricing.astro: "${cost}" does not start with a Credit count`);
  return `${prefix}${Math.floor(free.creditsPerDay / n)}`;
};

/*
 * THE TABLE READS THE PRODUCT, NOT A LIST TYPED BESIDE IT.
 *
 * These three rows were hardcoded — Plan, Agent, Super Agent — and Super Agent was withdrawn from
 * what the product offers. The pricing page went on quoting it a price. A page that prices a mode
 * nobody can select is a promise the product cannot keep, and it is the first thing a buyer finds
 * when they sign up and cannot find the third option.
 *
 * PRODUCT_MODES_OFFERED is the list every surface a person chooses from already reads;
 * PRODUCT_MODES still carries 'super' because rows written while it existed must stay readable.
 * Reading the first is what makes this page incapable of advertising a fourth mode, or a withdrawn
 * one, without somebody deciding to.
 */
const CLS = { plan: 'is-clay', agent: 'is-stone', super: 'is-rune' } as const;
const EXTRA = { plan: '', agent: '', super: '+1 per extra step' } as const;
const PREFIX = { plan: '', agent: '', super: 'up to ' } as const;

const modeRows = PRODUCT_MODES_OFFERED.map((m) => {
  const info = PRODUCT_MODE_INFO[m];
  const credits = MODE_INFO[PRODUCT_MODE_TO_SPECIALIST[m]].typicalCredits;
  // "2" and "4-18" both arrive here; the table quotes the entry price, which is what the row is
  // comparing. A range's own upper bound is explained by the footnote under the table.
  const cost = `${String(credits).split('-')[0]} credits`;
  return {
    mode: info.name,
    cls: CLS[m],
    cost,
    extra: EXTRA[m],
    does: MODE_INFO[PRODUCT_MODE_TO_SPECIALIST[m]].blurb,
    perDayPrefix: PREFIX[m],
  };
}).map((r) => ({ ...r, perDay: perFreeDay(r.cost, r.perDayPrefix) }));

const limitFaq = [
  {
    q: 'What happens when I run out of Credits?',
    a: `<p>Apple tells you plainly, mid-conversation, and shows when your quota resets (daily, at midnight UTC — the same instant for everyone, not 24 hours after you started). Nothing is lost — your chat, project and checkpoints stay exactly where they are. You can keep reading, browsing your project and restoring checkpoints; only new AI requests wait for the reset. If it is the <em>monthly</em> ceiling you have reached rather than the day's, the next reset that helps you is the start of the month, and the workspace says which of the two you hit.</p>`,
  },
  {
    q: 'Why is there a limit at all?',
    a: `<p>Apple runs real inference on every request, and inference costs real compute. A hard daily quota is how the free tier stays genuinely free — no card required, no surprise bill, no "free trial" countdown. We would rather give you an honest daily allowance than an unlimited plan with an asterisk.</p>`,
  },
  {
    q: 'Do unused Credits roll over?',
    a:
      `<p>No. Credits reset to your full daily amount each day, up to your plan's monthly ceiling. Rollover sounds nice but pushes people to hoard; a fresh daily allowance keeps the math simple and the queue fair.</p>` +
      (monthlyCeilingBitesFirst('free')
        ? `<p><strong>On Free the monthly ceiling is the one that bites.</strong> ${free.creditsPerDay.toLocaleString()} a day against ${free.creditsPerMonth.toLocaleString()} a month is <strong>${fullRateDays('free')} full days</strong>; spend the whole daily allowance every day and there is nothing left for the rest of the month. Whichever limit is lower is the one you actually have, and the workspace shows both.</p>`
        : ''),
  },
  {
    q: 'Can one request cost more than the price in the table?',
    a: `<p>Yes, and it is metered transparently. The table quotes what a request starts at; an Agent build settles against the compute it actually used, so a long one costs more. You see the running total live in the workspace, and a request never silently drains your day — Apple warns before starting work it estimates will be expensive.</p>`,
  },
  {
    q: 'What is a Credit, underneath?',
    a: `<p>A unit of real compute. One Credit is 30 neurons of real compute, and Apple bills from the engine's own reported figure for each call rather than from an estimate. A full Agent build — read the tree, edit scripts, create instances, verify — measured 511 neurons, about $0.0056. That is why the free tier can exist at all.</p>`,
  },
  {
    q: 'Can I subscribe now?',
    a: billing.checkout
      ? `<p>Yes. Builder and Studio can be bought now, and your account’s Plans &amp; Credits page is where a subscription starts, changes or is cancelled. No subscription starts without a confirmed checkout.</p>`
      : `<p>Paid checkout is not open yet. Builder and Studio are the planned subscription tiers. Your account’s Plans &amp; Credits page shows live purchase availability; no subscription starts without a confirmed checkout.</p>`,
  },
];
---

<Base
  title="Pricing — Apple"
  description={`Start with Apple and ${free.creditsPerDay} daily Credits. Apple MAX is the subscription tier. Paid checkout and public Studio installation are not yet open in this preview.`}
>
  <!-- ==================================================== head -->
  <section class="section phead is-ember" aria-labelledby="pricing-title">
    <div class="sheet-rails" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h1 id="pricing-title" class="carved">Start with Apple.</h1>
      <p class="lede lede-wide">
        Apple is the limited free tier. Apple MAX is for paid subscribers.
        {billing.checkout
          ? 'Every paid plan below can be bought now. Cancel from your own account page at any time.'
          : 'Paid checkout is not open yet; the paid plans below describe the planned offering.'}
      </p>

      <div class="plans">
        <article class="plan slab slab--seam" aria-labelledby="plan-free" data-reveal>
          <header class="plan__head">
            <h2 id="plan-free">Free</h2>
            <p class="plan__price"><span>{formatMoney(0, { currency: PRICE_CURRENCY })}</span> forever</p>
          </header>
          <ul class="plan__list">
            <li><strong>{free.creditsPerDay.toLocaleString()} Credits</strong> per day · {free.creditsPerMonth.toLocaleString()} a month</li>
            <li>About {buildsPerMonth('free')} quality-gated builds a month</li>
            <li>Apple · limited free access</li>
            <li>Unlimited projects</li>
            <li>Checkpoints &amp; rollback</li>
            <li>Studio integration · public installation pending</li>
            {/* Published for every plan, including this one. Three of the four tiers said nothing
                about support anywhere, and a buyer cannot tell silence from "there is none". */}
            <li>{PLAN_SUPPORT.free.channel}</li>
          </ul>
          <a href="/app/signup" class="btn btn-primary plan__cta">Start building — free</a>
          <p class="plan__note">
            No paid subscription to cancel. Free chat is available now.
          </p>
        </article>

        {
          paid.map((id, i) => (
            /* NO HUE ON THE RECOMMENDED CARD. This carried `is-rune`, which repoints the whole
               subtree's `--accent` at a violet — so the one plan the page wants read was the only
               violet object on an otherwise unhued site, and it was violet because of a class named
               after a colour rather than because of anything about the plan. The emphasis it
               deserves is carried by `is-featured`, in the accent this site actually has. */
            <article
              class={`plan slab slab--seam${i === 0 ? ' is-featured' : ''}`}
              aria-labelledby={`plan-${id}`}
              data-reveal
              data-reveal-delay={110 + i * 60}
            >
              <header class="plan__head">
                <h2 id={`plan-${id}`}>{PLAN_COPY[id].name}</h2>
                <p class="plan__price">
                  <span>{formatMoney(PLAN_COPY[id].priceUsdMonthly ?? 0, { currency: PRICE_CURRENCY })}</span> a month
                </p>
              </header>
              <ul class="plan__list">
                <li>
                  <strong>{PLAN_LIMITS[id].creditsPerDay.toLocaleString()} Credits</strong> per day ·{' '}
                  {PLAN_LIMITS[id].creditsPerMonth.toLocaleString()} a month
                </li>
                <li>About {buildsPerMonth(id)} quality-gated builds a month</li>
                <li>Apple MAX access</li>
                {PLAN_COPY[id].highlights.map((h) => (
                  <li>{h}</li>
                ))}
                <li>{PLAN_SUPPORT[id].channel}</li>
              </ul>
              {canBuy(id) ? (
                <a href={`/app/usage?plan=${id}`} class="btn btn-primary plan__cta">Choose {PLAN_COPY[id].name}</a>
              ) : (
                <p class="plan__note">Planned tier — not available to purchase yet.</p>
              )}
            </article>
          ))
        }

        <p class="plan__note" style="grid-column:1/-1;max-width:62ch">
          One build costs about {CREDITS_PER_BUILD} Credits, so every figure above is also a number of
          estimated builds. Free limits apply now.{' '}
          {canBuy('builder') || canBuy('studio')
            ? 'Paid prices and limits are live and may still change.'
            : 'Paid prices and limits describe the planned offering and may change before checkout opens.'}
        </p>

        {/*
          THE PRICE ABOVE IS THE PRICE BEFORE TAX, AND SAYING SO IS THE POINT.
          The checkout asks Stripe to calculate tax from the billing address, so a buyer in a
          jurisdiction we are registered in pays more than the figure on this page. Quoting the bare
          number and letting them discover the difference on a bank statement is the same failure as
          quoting a bare currency symbol, which this page already stopped doing.
        */}
        <p class="plan__note" style="grid-column:1/-1;max-width:62ch">
          Prices are in {PRICE_CURRENCY} and exclude tax. Any VAT or sales tax that applies where you
          are is calculated at checkout, and businesses can enter a VAT or GST number there so the
          invoice carries it.
        </p>

        <p class="plan__note" style="grid-column:1/-1;max-width:62ch">
          <strong>What support means on every plan above:</strong> {PLAN_SUPPORT.free.promise} Paid
          accounts are answered first. Enterprise is different — {PLAN_SUPPORT.enterprise.promise.toLowerCase()}
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================== comparison -->
  <section class="section" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Side by side</p>
        <h2 id="compare-title" data-reveal class="carved">What each plan includes</h2>
        <p class="lede lede-wide" data-reveal>
          The cards above say what each tier <em>adds</em>. This says what each tier
          <em>has</em> — including the rows where the answer is the same for everyone,
          because a capability missing from a list of bullets is indistinguishable from
          one nobody mentioned.
        </p>
      </header>

      <div class="table-scroll" data-reveal>
        <table class="compare">
          <caption class="visually-hidden">
            Every capability by plan. Rows are capabilities; columns are plans.
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              {PLAN_IDS.map((id) => <th scope="col">{PLAN_COPY[id].name}{id !== 'free' && !canBuy(id) ? ' (planned)' : ''}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              PLAN_FEATURES.map((feature) => (
                <tr>
                  <th scope="row">
                    {feature.label}
                    {feature.note && <span class="tx">{feature.note}</span>}
                  </th>
                  {PLAN_IDS.map((id) => {
                    const value = feature.values[id];
                    if (value === true) {
                      return (
                        <td class="compare__yes">
                          {/* The glyph is decoration; the word is the answer. A table whose
                              cells are bare ticks and blanks is unreadable aloud, and "blank"
                              is exactly the ambiguity this table exists to remove. */}
                          <span aria-hidden="true">&#10003;</span>
                          <span class="visually-hidden">Included</span>
                        </td>
                      );
                    }
                    if (value === false) {
                      return (
                        <td class="compare__no">
                          <span aria-hidden="true">&#8212;</span>
                          <span class="visually-hidden">Not included</span>
                        </td>
                      );
                    }
                    return <td>{value}</td>;
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="plan__note" style="max-width:62ch">
        Figures come from the shared plan configuration. Free access is available now.{' '}
        {canBuy('builder') || canBuy('studio')
          ? 'Paid tiers can be purchased below.'
          : 'Paid tiers and Apple MAX subscriptions are not yet available to purchase.'}{' '}
        Studio access also requires a connected plugin; public installation is currently unavailable.
      </p>
    </div>
  </section>


  <!-- ==================================================== per-mode -->
  <section class="section" aria-labelledby="credits-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Per request</p>
        <h2 id="credits-title" data-reveal class="carved">What a Credit buys</h2>
        <p class="lede lede-wide" data-reveal>
          These are internal work-mode estimates, not the Apple and Apple MAX model selector.
          Final usage depends on the work performed.
        </p>
      </header>

      <div class="table-scroll" data-reveal>
        <table>
          <caption class="visually-hidden">Credit cost per request by mode</caption>
          <thead>
            <tr>
              <th scope="col">Mode</th>
              <th scope="col">Cost per request</th>
              <th scope="col">What it does</th>
              <th scope="col">≈ requests / free day</th>
            </tr>
          </thead>
          <tbody>
            {
              modeRows.map((r) => (
                <tr class={r.cls}>
                  <td>
                    {r.mode}
                  </td>
                  <td>
                    <code>{r.cost}</code>
                    {r.extra && <span class="tx">{r.extra}</span>}
                  </td>
                  <td>{r.does}</td>
                  <td class="num">{r.perDay}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="tfoot" data-reveal>
        An Agent request settles against the work it actually did, so a long build costs more than
        the entry price above — metered live, so you always see where you stand. Apple&rsquo;s own
        housekeeping does not count against your quota.
      </p>
    </div>
  </section>

  <!-- ==================================================== limits -->
  <section class="section limitsec" aria-labelledby="limits-title">
    <div class="wrap wrap-narrow-ish">
      <header class="sechead">
        <p class="eyebrow" data-reveal>The honest part</p>
        <h2 id="limits-title" data-reveal class="carved">Limits, plainly stated</h2>
      </header>
      <div data-reveal data-reveal-delay="90">
        <FAQ items={limitFaq} />
      </div>
    </div>
  </section>
</Base>

<style>
  .phead {
    position: relative;
    padding-top: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .phead::before {
    content: '';
    position: absolute;
    top: -10%;
    left: -8%;
    width: min(60vw, 700px);
    aspect-ratio: 1;
    background: radial-gradient(
      circle at 50% 50%,
      var(--accent-soft),
      transparent 65%
    );
    pointer-events: none;
    z-index: 0;
  }

  .phead > .wrap {
    position: relative;
    z-index: 1;
  }

  /* `margin-inline: auto`, not just a max-width. The wrap is 1200px and centred; a 900px grid
     inside it with no auto margin sits against the LEFT edge, so the two cards were centred on 563
     while the heading above them was centred on 713 — the same 150px disagreement the landing
     page had, on a page nobody had measured. */
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: clamp(2.25rem, 5vw, 3.5rem) auto 0;
    max-width: 1120px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: none;
  }

  .plan__flag {
    position: absolute;
    top: 1.1rem;
    right: 1.2rem;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--r-pill);
    padding: 0.22rem 0.6rem;
  }

  .plan__head {
    margin-bottom: 1.4rem;
  }

  .plan h2 {
    font-size: 1.7rem;
    margin: 0 0 0.3rem;
  }

  .plan__price {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .plan__price span {
    font-family: var(--font-body);
    font-variation-settings: normal;
    font-variant-numeric: tabular-nums;
    font-weight: 620;
    font-size: 1.65rem;
    color: var(--ink);
    margin-right: 0.4rem;
    letter-spacing: -0.04em;
  }

  /* "Waitlist" is a state, not a price — it should not shout like one */
  .plan__price--soft span {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0;
    color: var(--accent);
  }

  .plan__list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .plan__list strong {
    color: var(--accent);
  }

  .plan__list li {
    padding-left: 1.5rem;
    position: relative;
  }

  .plan__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    background: var(--accent);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  .plan__cta {
    margin-top: auto;
    justify-content: center;
  }

  .plan__note {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    color: var(--faint);
    line-height: 1.5;
  }

  .calcsec {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }

  /*[[ ONE AXIS, the same one the landing page settled on. Measured on the deployed page at
   *   1425px: the plan grid is centred at 713 and every section head was centred at 355 — one page
   *   drawn on two centre lines, which is the exact thing that made the landing look unfinished.
   *   Scoped to this page style block rather than to the shared class, because /changelog uses the
   *   same class and a dated log is a document, not a poster. ]]*/
  .sechead {
    max-width: 60ch;
    margin: 0 auto clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
  }

  .phead > .wrap > .eyebrow,
  .phead > .wrap > h1,
  .phead > .wrap > .lede,
  .sechead .lede {
    margin-inline: auto;
    text-align: center;
  }

  /* THE EYEBROW IS `inline-flex`, which is why neither `margin-inline: auto` nor its own
     `text-align` moved it: an inline box is placed by its PARENT alignment, and the wrap is
     `text-align: start`. Measured: width 87, left 113, while the headline beside it was centred at
     713. Making it block-level is what lets `justify-content` mean anything here. */
  .phead > .wrap > .eyebrow,
  .sechead .eyebrow {
    display: flex;
    justify-content: center;
  }

  .plan__note {
    margin-inline: auto;
    text-align: center;
  }

  .sechead h2 {
    margin-bottom: 0.5rem;
  }

  /* table extras */
  .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    margin-right: 0.5rem;
  }

  .tx {
    color: var(--faint);
    font-size: 0.78rem;
    margin-left: 0.45rem;
    white-space: nowrap;
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .tfoot {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.87rem;
    max-width: 62ch;
