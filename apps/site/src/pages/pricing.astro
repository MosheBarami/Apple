---
import {
  PLAN_COPY,
  PLAN_FEATURES,
  PLAN_IDS,
  type PlanId,
  PLAN_LIMITS,
  PLAN_SUPPORT,
  SUPPORT_EMAIL,
  PRICE_CURRENCY,
  buildsPerMonth,
  buildsPerDay,
  formatMoney,
  CREDITS_PER_BUILD,
  NEURONS_PER_CREDIT,
  BUILD_NEURONS,
  fullRateDays,
  monthlyCeilingBitesFirst,
  PRODUCT_MODES,
  PRODUCT_MODE_INFO,
  PRODUCT_MODELS,
  PRODUCT_MODEL_INFO,
  canUseProductModel,
  MODE_INFO,
  CREDIT_PURCHASE_LIVE as SHARED_CREDIT_PURCHASE_LIVE } from '@golem/shared';
import { STUDIO_PLUGIN_INSTALL_HREF, STUDIO_PLUGIN_STORE_LIVE } from '../lib/studio-plugin';
import { DAILY_NEURON_CEILING } from '../../../worker/src/pricing';

/*
 * THE LIMIT THIS PAGE NEVER MENTIONED, ON THE PAGE WHERE PEOPLE DECIDE.
 *
 * A plan's Credits are a per-account allowance. Behind all of them is ONE service-wide daily
 * ceiling on inference — apps/worker/src/pricing.ts, DAILY_NEURON_CEILING — and a run stops against
 * it with "Apple has reached today's shared building capacity" while the customer's own balance
 * still shows Credits. /docs/credits-and-limits and /docs/troubleshooting both disclose it. This
 * page, which is the one a prospect reads before signing up, did not: it said "about N builds a
 * month, free" and stopped.
 *
 * The figures are DERIVED from the worker's own ceiling rather than typed, so the sentence cannot
 * outlive the number. The per-account arithmetic is deliberately printed as a floor, because the
 * honest claim is "a handful of busy accounts", not a promise about any particular day.
 */
const serviceCreditsPerDay = Math.floor(DAILY_NEURON_CEILING / NEURONS_PER_CREDIT);

/*
 * THE STUDIO LINE ON EVERY CARD IS ASKED, NOT TYPED.
 *
 * STUDIO_PLUGIN_STORE_LIVE says whether the Creator Store install path works. While it does, the
 * shared plugin row is `true` for every plan and prints once, as a universal bullet (see
 * cardLabel below) — so there is no second Studio line to disagree with it. While it does not,
 * this bullet says so on every card, in the one sentence the rest of the site uses.
 */
const studioBullet = STUDIO_PLUGIN_STORE_LIVE ? null : 'Roblox Studio plugin · public installation unavailable';

// THE NUMBERS ON THIS PAGE ARE READ, NOT WRITTEN. They used to be typed in prose and in the plan
// cards, so the marketing site and the thing enforcing the quota could drift apart — and they had:
// this page still advertised a waitlist tier at a daily figure no plan grants, under a name that
// under that name or that number. scripts/check-offer.mjs is what caught it, and reading from
// PLAN_LIMITS is what stops it recurring.
//[[ WHETHER A PLAN CAN BE BOUGHT IS ASKED, NOT TYPED.
//
//   Every sentence on this page saying "planned tier — not available to purchase yet" was prose.
//   It is TRUE today — the live Worker holds two secrets, ADMIN_KEY and ROBLOX_API_KEY, and no
//   Stripe key at all, so checkoutConfigured() is false and `purchasable` comes back empty — but a
//   hardcoded truth is a lie waiting for the day it changes. The moment Stripe is connected, a page
//   still saying "planned" costs the owner the sale it was built to make, and nothing anywhere
//   would fail to tell him.
//
//   So the build ASKS. /api/billing/config returns { checkout, purchasable } computed from the
//   deployment's own environment, and every claim below is derived from the answer.
//
//   THE FALLBACK IS THE SAFE CLAIM, NOT THE CONVENIENT ONE. An unreachable probe means "not
//   purchasable". Claiming a plan is buyable when we could not establish it walks someone into a
//   checkout that answers 503; claiming it is not buyable when it is costs a sale and is visibly
//   wrong to the owner within a day. Those two errors are not the same size.
//
//   Build-time, not client-side: this is a static page served out of D1, a deploy is the moment the
//   answer can change, and every deploy re-asks.
//
//   `import.meta.env` IS DELIBERATELY NOT USED HERE. It breaks this page's build — esbuild reports
//   `Expected ")" but found "s"`, because it reads `import` and expects a dynamic import's paren.
//   Isolated by bisection: the committed page builds, the same code with a template literal builds,
//   and only the `import.meta.env` form fails. The origin is therefore a constant.
const BILLING_ORIGIN = 'https://apple.moshe-barami111.workers.dev';
const billingProbe = await fetch(BILLING_ORIGIN + '/api/billing/config').then((r) => (r.ok ? r.json() : null)).catch(() => null);
const billing = {
  checkout: billingProbe?.checkout === true,
  purchasable: Array.isArray(billingProbe?.purchasable) ? billingProbe.purchasable : [],
};
// Typed rather than left implicit: `astro check` reported ts(7006) here, and an `any` parameter on
// the one predicate that decides whether a plan shows a buy button is the parameter you least want
// unchecked — a mode id or a plan NAME passed by mistake would compile and quietly answer false.
const canBuy = (id: PlanId) => billing.purchasable.includes(id);

const free = PLAN_LIMITS.free;
const paid = PLAN_IDS.filter((id) => id !== 'free' && PLAN_COPY[id].priceUsdMonthly !== null);

/*
 * THE CARDS' SHARED FLOOR IS DERIVED, WHICH IS ALSO WHAT CLOSES THE HOLE IN THEM.
 *
 * Free listed "Unlimited projects" and "Checkpoints & rollback" as typed bullets while Builder and
 * Studio said "Everything in Free" and stopped — so the two paid cards ran out of content after
 * five lines and left ~235px of empty charcoal above their own bottom edge, measured on the
 * deployed page. "Everything in Free" is not a capability, it is an instruction to go and read
 * another card; the reader who does not is left thinking the paid tier has fewer features than the
 * free one, which is the opposite of the truth.
 *
 * PLAN_FEATURES already knows which rows are true for every plan. Enumerating them per card is
 * therefore not new copy — it is the comparison table's own answer, printed where the decision is
 * made. The void closes because the cards now say what they actually include, not because
 * something was padded.
 */
/* A universal row's label as a card bullet. The comparison table keeps the shared label; on a card
   the modes read better by their names (derived, so a third mode could not hide). */
const cardLabel = (f: (typeof PLAN_FEATURES)[number]) =>
  f.id === 'modes' ? `${PRODUCT_MODES.map((m) => PRODUCT_MODE_INFO[m].name).join(' and ')} modes` : f.label;

/* THE SUPPORT LINE ON A CARD NAMES THE KIND OF SUPPORT, NOT THE MAILBOX (2026-09-22). Each card used
   to end on "Email <address>", which is a contact detail set as a plan feature. The address is
   printed once, in the support note under the cards, beside what PLAN_SUPPORT promises. */
const supportBullet = (id: PlanId) =>
  id === 'free' ? 'Email support, read by a person' : 'Email support, answered before Free';

/* Autonomous is a toggle on Agent on every plan, with the same step ceiling; it is one bullet on
   every card rather than a Free-only line that made the paid cards look as if they lacked it. */
const autonomousBullet = `Autonomous on ${PRODUCT_MODE_INFO.agent.name} · up to 1000 steps a message`;
const UNIVERSAL_BULLETS = PLAN_FEATURES.filter((f) => PLAN_IDS.every((id) => f.values[id] === true)).map(cardLabel);

/* MODELS ARE NOT PLANS. Apple and Apple MAX are model choices; Free, Builder, Studio and Enterprise
   are plans. Which plans include which model is asked of canUseProductModel — the function the
   worker enforces — so the page cannot promise Apple MAX to a plan that does not get it. */
const [baseModel, strongModel] = PRODUCT_MODELS;
const listNames = (names: string[]) =>
  names.length < 2 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
const strongPlans = listNames(
  PLAN_IDS.filter((id) => canUseProductModel(strongModel, id)).map((id) => PLAN_COPY[id].name),
);
const planNames = listNames(PLAN_IDS.map((id) => PLAN_COPY[id].name));
const baseName = PRODUCT_MODEL_INFO[baseModel].name;
const strongName = PRODUCT_MODEL_INFO[strongModel].name;

/*
 * ONE CARD IS RANKED, AND WHICH ONE IS ASKED RATHER THAN TYPED.
 *
 * `is-featured` was set on the first paid plan and styled NOWHERE — measured, the middle card's
 * computed style was byte-identical to its neighbours: same size, same fill, same border, no
 * shadow, no badge. Three plans of equal weight and one button between them is a page with no
 * answer to "what do I click".
 *
 * The honest answer today is Free: it is the only plan this deployment can actually give anybody.
 * The moment checkout opens, the answer becomes the cheapest plan that can be bought, and this
 * line changes with `/api/billing/config` rather than with somebody remembering.
 */
const promoted: PlanId = paid.find((id) => canBuy(id)) ?? 'free';


//[[ "BUY EXTRA CREDITS" WAS THE ONE ROW IN THE MATRIX THAT ADVERTISED A CHANNEL RATHER THAN A
//   CAPABILITY, AND THE CHANNEL DOES NOT EXIST.
//
//   PLAN_FEATURES marks `credits` true for all four plans. Three of those column headers carry
//   "(planned)" while Free's does not — by construction, a few lines below — so the only plan
//   anybody can be on was the only one told, without caveat, that buying extra Credits is included.
//   The in-app usage meter then offers "add credits" as the next action at the exact moment the
//   allowance runs out, which is the exact moment somebody would have paid.
//
//   NOTHING IN THE PRODUCT CAN TAKE THAT MONEY, and this is not an environment gap a key would
//   close. `buildCheckoutRequest` in apps/worker/src/billing.ts hardcodes `mode=subscription`, its
//   CheckoutEnv declares price ids for Builder and Studio and nothing else, and no `mode=payment`
//   construction exists anywhere in apps/ or packages/. The webhook branch that reads a `credits`
//   figure off a completed checkout therefore has no producer in any deployment.
//
//   THE OVERRIDE LIVES HERE RATHER THAN IN packages/shared BECAUSE THIS PAGE IS WHAT THE READER
//   RECEIVES, and because the string branch of the cell renderer below already exists for precisely
//   this shape — it is how the `plugin` row prints "Public installation unavailable" instead of a
//   tick. The row is kept and answered rather than deleted: the table's whole premise is that a
//   capability missing from it is indistinguishable from one nobody mentioned.
//
//   apps/site/tests/credit-purchase-claim.test.mjs holds the flag to the worker: it goes red the
//   moment a credit checkout appears, so this cannot quietly outlive the gap it describes.
// DERIVED, NOT DECLARED. This was a local `= false` that corrected this page and left the shared
// constant saying "included on every plan" for every other reader — including the in-app meter,
// which went on offering "Add credits" at the moment a customer's allowance ran out. One fact, one
// home: packages/shared/src/index.ts.
const CREDIT_PURCHASE_LIVE = SHARED_CREDIT_PURCHASE_LIVE;
/* The shared `modes` label reads "All two build modes"; on this page the row names them, the same
   words the cards use (cardLabel). */
const planFeatures = PLAN_FEATURES.map((f) => (f.id === 'modes' ? { ...f, label: cardLabel(f) } : f)).map((f) =>
  f.id === 'credits' && !CREDIT_PURCHASE_LIVE
    ? {
        ...f,
        /* The shared label says "credits" in lower case; the unit is a proper noun on this site. */
        label: f.label.replace(/\bcredits\b/g, 'Credits'),
        note: 'Apple cannot sell Credits in this preview — there is no checkout for them on any plan.',
        values: Object.fromEntries(PLAN_IDS.map((id) => [id, 'Unavailable'])) as Record<string, string>,
      }
    : f,
);
import Base from '../layouts/Base.astro';
import Accordion from '../components/picks-docs/Accordion.astro';
import BeamBorder from '../components/picks-docs/BeamBorder.astro';
import BuildEstimator from '../components/picks-docs/BuildEstimator.astro';
import PriceSwitch from '../components/picks-docs/PriceSwitch.astro';
import ShinyButton from '../components/picks-docs/ShinyButton.astro';
import Spotlight from '../components/picks-docs/Spotlight.astro';

/* A PLAN'S PRICE PER BUILD, for the "a month / a build" switch above the cards. Derived from the
   same two numbers the card already prints — the monthly price and buildsPerMonth — so the switch
   cannot show a figure the card does not imply. Rounded to the cent. */
const perBuild = (id: PlanId) =>
  formatMoney(Math.round(((PLAN_COPY[id].priceUsdMonthly ?? 0) / Math.max(1, buildsPerMonth(id))) * 100) / 100, {
    currency: PRICE_CURRENCY,
  });

/* The build estimator's plans, in order, from the same configuration as the cards. A paid plan
   nobody can buy yet says so; Enterprise is a conversation, not a checkout. */
const estimatorPlans = PLAN_IDS.map((id) => ({
  name: PLAN_COPY[id].name,
  builds: buildsPerMonth(id),
  planned: id !== 'free' && id !== 'enterprise' && !canBuy(id),
  contact: id === 'enterprise',
}));

// Figures come from docs/COST-MODEL.md through the SAME arithmetic the worker uses,
// `creditsForNeurons(n) = max(1, ceil(n / 30))`, and are not invented here:
// Allowances themselves are read from PLAN_LIMITS above, never restated here.
//
//   Plan   37-43 neurons -> ceil(43/30)  = 2 credits
//   Agent  111 neurons   -> ceil(111/30) = 4 credits  (targeted edit + read-back verify)
//
// Plan was once published as 1 credit and a request count computed from it. It is 2. The
// request counts below are now derived so a later repricing cannot leave the table behind.
// "≈ requests / free day" is the free daily allowance divided by cost, and it is now
// COMPUTED rather than typed. It was typed — 30 / 15 / up to 6 — against a free tier that
// granted 60 Credits a day. The repricing took free to 231 and those three numbers stayed
// exactly where they were, so this page understated its own free allowance almost
// fourfold for as long as that was live. Nobody typed a wrong number; three right ones
// were left behind by a change somewhere else, which is the failure mode a literal always
// has and a derivation cannot.
//
// Derived from the row's OWN `cost`, so there is one literal per row rather than two that
// can disagree with each other.
const perFreeDay = (cost: string, prefix = ''): string => {
  const n = Number(/^\d+/.exec(cost)?.[0]);
  if (!n) throw new Error(`pricing.astro: "${cost}" does not start with a Credit count`);
  return `${prefix}${Math.floor(free.creditsPerDay / n)}`;
};

/*
 * THE TABLE READS THE PRODUCT, NOT A LIST TYPED BESIDE IT.
 *
 * ProductMode is the contract. PRODUCT_MODES is exactly Plan and Agent, and MODE_INFO is keyed by
 * that same type. There is no translation layer here and no third pricing row for Autonomous:
 * Autonomous is an Agent continuation toggle, not another mode.
 */
const modeRows = PRODUCT_MODES.map((mode) => {
  const info = MODE_INFO[mode];
  const credits = info.typicalCredits;
  // "2" and "4-18" both arrive here; the table quotes the entry price, which is what the row is
  // comparing. A range's own upper bound is explained by the footnote under the table.
  const cost = `${String(credits).split('-')[0]} Credits`;
  return {
    mode: info.name,
    cost,
    does: info.blurb,
    /*
     * WHAT THAT PRICE BOUGHT, beside the price.
     *
     * The cost column and the per-day column are useless to a buyer without the unit between them,
     * and leaving it out is how this table came to say "Apple Max builds features across your
     * project · 4 credits · ~57 a free day" on a page whose plan cards say a build is 77 Credits
     * and three a free day. The blurb describes the MODE; this describes the REQUEST that was
     * measured. See MODE_INFO.entryUnit in packages/shared.
     */
    unit: info.entryUnit,
  };
}).map((r) => ({ ...r, perDay: perFreeDay(r.cost) }));

const limitFaq = [
  {
    q: 'What happens when I run out of Credits?',
    a: `<p>Apple tells you plainly, mid-conversation, and shows when your quota resets (daily, at midnight UTC — the same instant for everyone, not 24 hours after you started). Nothing is lost — your chat, project and checkpoints stay exactly where they are. You can keep reading, browsing your project and restoring checkpoints; only new AI requests wait for the reset. If it is the <em>monthly</em> ceiling you have reached rather than the day's, the next reset that helps you is the start of the month, and the workspace says which of the two you hit.</p>`,
  },
  {
    q: 'Why is there a limit at all?',
    a: `<p>Apple runs real inference on every request, and inference costs real compute. A hard daily quota is how the free tier stays genuinely free — no card required, no surprise bill, no "free trial" countdown. We would rather give you an honest daily allowance than an unlimited plan with an asterisk.</p>`,
  },
  {
    q: 'Do unused Credits roll over?',
    a:
      `<p>No. Credits reset to your full daily amount each day, up to your plan's monthly ceiling. Rollover sounds nice but pushes people to hoard; a fresh daily allowance keeps the math simple and the queue fair.</p>` +
      (monthlyCeilingBitesFirst('free')
        ? `<p><strong>On Free the monthly ceiling is the one that bites.</strong> ${free.creditsPerDay.toLocaleString()} a day against ${free.creditsPerMonth.toLocaleString()} a month is <strong>${fullRateDays('free')} full days</strong>; spend the whole daily allowance every day and there is nothing left for the rest of the month. Whichever limit is lower is the one you actually have, and the workspace shows both.</p>`
        : ''),
  },
  //[[ NO SENTENCE HERE MAY PROMISE A WARNING BEFORE A RUN STARTS.
  //
  //   This answer used to end "a request never silently drains your day — Apple warns before
  //   starting work it estimates will be expensive." Nothing in the product does that, and nothing
  //   can: `ServerMsg` in packages/shared has no cost-warning variant, `RunIntent` carries no cost
  //   field, and a run is admitted on `quotaSpend(owner, 1, …)` (apps/worker/src/do/session.ts)
  //   whose only refusal is a zero balance. `estimateNeurons` exists but reserves BudgetDO budget
  //   for the owner's bill; it is never shown to anyone. The worker says the same thing about the
  //   one control that would have gated an expensive tool — apps/worker/src/preferences.ts
  //   downgrades the `ask` permission to `deny` because "nothing in this product can interrupt a
  //   run to ask".
  //
  //   The clause was a safety guarantee a reader could rely on when deciding to send one more
  //   build, and relying on it is how a day's allowance goes into a run that never finishes. It is
  //   deleted rather than softened: a vaguer promise of the same thing is the same untruth. What
  //   replaces it is the behaviour that IS implemented, quoted from session.ts's own stop message.
  //   apps/site/tests/pre-run-cost-warning.test.mjs fails if the promise comes back while the wire
  //   protocol still has nothing to carry it.
  {
    q: 'Can one request cost more than the price in the table?',
    a: `<p>Yes, and it is metered transparently. The table quotes what a request starts at; an Agent build settles against the compute it actually used, so a long one costs more. You see the running total live in the workspace while it climbs, and if a run reaches the end of your Credits it stops there and says so — everything it finished by then is saved, and the allowance refills at midnight UTC.</p>`,
  },
  {
    q: 'What is a Credit, underneath?',
    a: `<p>A unit of real compute. One Credit is ${NEURONS_PER_CREDIT} neurons, and Apple bills from the engine's own reported figure for each call rather than from an estimate. A <strong>quality-gated</strong> build — read the tree, edit scripts, create instances, then render it and critique the picture — measures about ${BUILD_NEURONS.qualityGated.toLocaleString()} neurons, which is the ${CREDITS_PER_BUILD} Credits the allowances above are counted in. The same build with the critique left out measured ${BUILD_NEURONS.buildBlind}; we price the one that looked at what it made.</p>`,
  },
  {
    q: 'Can I subscribe now?',
    a: billing.checkout
      ? `<p>Yes. Builder and Studio can be bought now, and your account’s Plans &amp; Credits page is where a subscription starts, changes or is cancelled. No subscription starts without a confirmed checkout.</p>`
      : `<p>Paid checkout is not open yet. Builder and Studio are the planned subscription tiers. Your account’s Plans &amp; Credits page shows live purchase availability; no subscription starts without a confirmed checkout.</p>`,
  },
];
---

<Base
  title="Pricing — Apple"
  description={`Plans and Credits for Apple. Free includes ${free.creditsPerDay} Credits a day and the ${baseName} model; ${strongName}, the stronger model, is included with ${strongPlans}.${billing.checkout ? '' : ' Paid checkout is not open yet.'}`}
>
  <!-- ==================================================== head -->
  <section class="section phead" aria-labelledby="pricing-title">
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      {/* THE HEADLINE AGREES WITH THE BUTTONS UNDER IT. It read "Pay when you build every day" over
          two cards whose only control is a disabled "Checkout not open". Asked of the same probe as
          everything else on this page. */}
      <h1 id="pricing-title" class="carved">
        {canBuy('builder') || canBuy('studio') ? 'Start free. Pay when you build every day.' : 'Start free. Paid plans are not on sale yet.'}
      </h1>
      <p class="lede lede-wide">
        {planNames} are plans. {baseName} and {strongName} are models: every plan gets {baseName}, and
        {strongName}, the stronger model, is included with {strongPlans}.
        {billing.checkout
          ? 'Every paid plan below can be bought now. Cancel from your own account page at any time.'
          : 'Paid checkout is not open yet; the paid plans below describe the planned offering.'}
      </p>

      <div class="plans">
        <PriceSwitch creditsPerBuild={CREDITS_PER_BUILD} />
        <div class="plan-rail">
        <article
          class={`plan slab slab--seam${promoted === 'free' ? ' is-promoted' : ''}`}
          aria-labelledby="plan-free"
          data-reveal
          data-spotlight
        >
          {promoted === 'free' && <BeamBorder />}
          {promoted === 'free' && <p class="plan__flag">Available now</p>}
          <header class="plan__head">
            <h2 id="plan-free">Free</h2>
            <p class="plan__price">
              <span data-price-roll data-month={formatMoney(0, { currency: PRICE_CURRENCY })} data-build={perBuild('free')}>{formatMoney(0, { currency: PRICE_CURRENCY })}</span>
              <small class="plan__per" data-price-unit data-month="forever" data-build="a build">forever</small>
            </p>
          </header>
          <ul class="plan__list">
            <li><strong>{free.creditsPerDay.toLocaleString()} Credits</strong> per day · {free.creditsPerMonth.toLocaleString()} a month</li>
            <li>About {buildsPerMonth('free')} quality-gated builds a month</li>
            <li>{baseName} model</li>
            <li>{autonomousBullet}</li>
            {UNIVERSAL_BULLETS.map((b) => <li>{b}</li>)}
            {studioBullet && <li>{studioBullet}</li>}
            {/* Published for every plan, including this one. Three of the four tiers said nothing
                about support anywhere, and a buyer cannot tell silence from "there is none". */}
            <li>{supportBullet('free')}</li>
          </ul>
          {/*[[ EVERY CARD ENDS ON THE SAME ROW, AND THE ROW IS ANCHORED TO THE BOTTOM EDGE.
               Only this card had a button. `margin-top: auto` on a CTA that two of three cards did
               not render is not a layout — it is a layout for one card and a hole for the others.
               The footer is the thing that is anchored now, so the card that cannot be bought still
               ends on a control at the same y as the one that can, and the caption that explains
               why sits under it instead of floating in the middle of the void. ]]*/}
          <footer class="plan__foot">
            {/* The same words the landing uses for the same door. "Start building" promised a
                build to a reader whose card, a few lines up, could say Studio installation was
                unavailable; the note under the button is asked of the same flag. */}
            {promoted === 'free' ? (
              <ShinyButton href="/app/signup" class="plan__cta">Create a free account</ShinyButton>
            ) : (
              <a href="/app/signup" class="btn btn-primary plan__cta">Create a free account</a>
            )}
            <p class="plan__note plan__note--foot">
              {STUDIO_PLUGIN_STORE_LIVE
                ? 'No card required. Chat and building in Studio both work on Free.'
                : 'No card required. Free chat works now.'}
            </p>
          </footer>
        </article>

        {
          paid.map((id, i) => (
            /* What ranks a card here is `is-promoted`, and it is only ever on a plan somebody can
               actually take. The presentation does not depend on a work-mode identity. */
            <article
              class={`plan slab slab--seam${promoted === id ? ' is-promoted' : ' is-planned'}`}
              aria-labelledby={`plan-${id}`}
              data-reveal
              data-reveal-delay={110 + i * 60}
              data-spotlight
            >
              {promoted === id && <BeamBorder />}
              {promoted === id ? <p class="plan__flag">Recommended</p> : <p class="plan__flag plan__flag--quiet">Planned</p>}
              <header class="plan__head">
                <h2 id={`plan-${id}`}>{PLAN_COPY[id].name}</h2>
                <p class="plan__price">
                  <span
                    data-price-roll
                    data-month={formatMoney(PLAN_COPY[id].priceUsdMonthly ?? 0, { currency: PRICE_CURRENCY })}
                    data-build={perBuild(id)}
                  >
                    {formatMoney(PLAN_COPY[id].priceUsdMonthly ?? 0, { currency: PRICE_CURRENCY })}
                  </span>
                  <small class="plan__per" data-price-unit data-month="a month" data-build="a build">a month</small>
                </p>
              </header>
              <ul class="plan__list">
                <li>
                  <strong>{PLAN_LIMITS[id].creditsPerDay.toLocaleString()} Credits</strong> per day ·{' '}
                  {PLAN_LIMITS[id].creditsPerMonth.toLocaleString()} a month
                </li>
                <li>About {buildsPerMonth(id)} quality-gated builds a month</li>
                <li>{strongName}, the stronger model</li>
                <li>{autonomousBullet}</li>
                {/* The same gap as the `credits` row below, one surface earlier. Builder's
                    highlights include "Buy credits when you need more", and leaving it beside a
                    comparison row that now reads "Unavailable" would make the page disagree with
                    itself in two places a reader can see at once. Filtered rather than reworded:
                    the bullet is true of the planned tier and false of the product today, and the
                    flag is what decides which.

                    "Everything in Free" / "Everything in Builder" is filtered for a different
                    reason: it is a cross-reference, not a capability, and it is what left these
                    cards two hundred pixels short of their own bottom edge. The rows it was
                    standing in for are printed underneath it instead. */}
                {PLAN_COPY[id].highlights
                  .filter((h) => CREDIT_PURCHASE_LIVE || !/\bbuy\b.*\bcredits?\b/i.test(h))
                  .filter((h) => !/^everything in\b/i.test(h))
                  .map((h) => (
                    <li>{h}</li>
                  ))}
                {UNIVERSAL_BULLETS.map((b) => (
                  <li>{b}</li>
                ))}
                {studioBullet && <li>{studioBullet}</li>}
                <li>{supportBullet(id)}</li>
              </ul>
              <footer class="plan__foot">
                {canBuy(id) ? (
                  promoted === id ? (
                    <ShinyButton href={`/app/usage?plan=${id}`} class="plan__cta">Choose {PLAN_COPY[id].name}</ShinyButton>
                  ) : (
                    <a href={`/app/usage?plan=${id}`} class="btn btn-primary plan__cta">Choose {PLAN_COPY[id].name}</a>
                  )
                ) : (
                  /*[[ A BUTTON THAT IS VISIBLY OFF, RATHER THAN NO BUTTON AT ALL.
                       The two planned cards rendered a 12px grey sentence and nothing else, so the
                       row of three cards had exactly one control in it and no answer to "what do I
                       click". A `disabled` button is the honest shape: it says the affordance
                       exists, names the state, and cannot be pressed into a checkout that would
                       answer 503. It is a real <button disabled>, not a styled span, so assistive
                       technology is told the same thing the eye is. ]]*/
                  <button
                    type="button"
                    class="btn plan__cta"
                    disabled
                    aria-describedby={`plan-${id}-note`}
                  >
                    Checkout not open
                  </button>
                )}
                <p class="plan__note plan__note--foot" id={`plan-${id}-note`}>
                  {canBuy(id)
                    ? 'Cancel from your own account page at any time.'
                    : 'Planned tier — checkout is not open.'}
                </p>
              </footer>
            </article>
          ))
        }
        </div>

        <p class="plan-enterprise">
          <strong>{PLAN_COPY.enterprise.name}</strong>
          <span>{PLAN_COPY.enterprise.blurb}</span>
          <a href={`mailto:${SUPPORT_EMAIL}`}>Email us</a>
        </p>

        <BuildEstimator
          plans={estimatorPlans}
          creditsPerBuild={CREDITS_PER_BUILD}
          start={buildsPerMonth('free')}
          step={10}
          max={400}
        />

        {/* FOUR NOTES, EACH WITH ITS OWN TITLE (2026-09-22). They were four dense paragraphs in a row
            directly under the cards, which read as a wall of fine print. Nothing in them is cut; each
            is now a titled item in a quiet two-column list, so a reader can find the one they want. */}
        <div class="plan-notes">
        <p class="plan__note">
          <strong class="note-title">A second, shared limit</strong>
          Every plan above draws on one
          shared pool of about {serviceCreditsPerDay.toLocaleString()} Credits of building a day
          across the whole service, which is roughly{' '}
          {Math.floor(serviceCreditsPerDay / free.creditsPerDay)} accounts building flat out. When
          that day's pool is gone, a run stops with “Apple has reached today's shared building
          capacity” even though your own balance still shows Credits. It resets at midnight UTC, the
          same instant for everyone, and the steps that already finished stay done and stay paid for.{' '}
          <a href="/docs/credits-and-limits">How the two limits differ</a>.
        </p>

        <p class="plan__note">
          <strong class="note-title">Credits and builds</strong>
          One build costs about {CREDITS_PER_BUILD} Credits, so every figure above is also a number of
          estimated builds. Free limits apply now.{' '}
          {canBuy('builder') || canBuy('studio')
            ? 'Paid prices and limits are live and may still change.'
            : 'Paid prices and limits describe the planned offering and may change before checkout opens.'}
        </p>

        {/*
          THE PRICE ABOVE IS THE PRICE BEFORE TAX, AND SAYING SO IS THE POINT.
          The checkout asks Stripe to calculate tax from the billing address, so a buyer in a
          jurisdiction we are registered in pays more than the figure on this page. Quoting the bare
          number and letting them discover the difference on a bank statement is the same failure as
          quoting a bare currency symbol, which this page already stopped doing.
        */}
        <p class="plan__note">
          <strong class="note-title">Tax</strong>
          Prices are in {PRICE_CURRENCY} and exclude tax. Any VAT or sales tax that applies where you
          are is calculated at checkout, and businesses can enter a VAT or GST number there so the
          invoice carries it.
        </p>

        <p class="plan__note">
          <strong class="note-title">Support</strong>
          Write to <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>. {PLAN_SUPPORT.free.promise} Paid
          accounts are answered first. Enterprise is different — {PLAN_SUPPORT.enterprise.promise.toLowerCase()}
        </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================== comparison -->
  <section class="section" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Side by side</p>
        <h2 id="compare-title" data-reveal class="carved">What each plan includes</h2>
        <p class="lede lede-wide" data-reveal>
          The cards above say what each tier <em>adds</em>. This says what each tier
          <em>has</em> — including the rows where the answer is the same for everyone,
          because a capability missing from a list of bullets is indistinguishable from
          one nobody mentioned.
        </p>
      </header>

      <div class="table-scroll stack-sm" data-reveal>
        <table class="compare">
          <caption class="visually-hidden">
            Every capability by plan. Rows are capabilities; columns are plans.
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              {PLAN_IDS.map((id) => <th scope="col">{PLAN_COPY[id].name}{id !== 'free' && !canBuy(id) ? ' (planned)' : ''}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              planFeatures.map((feature) => (
                <tr>
                  <th scope="row">
                    {feature.label}
                    {/*[[ THIS CAPTION USED TO PRINT ON TOP OF THE NUMBERS BESIDE IT.
                         `.tx` in this page's scoped block set `white-space: nowrap`, which beat
                         global.css by Astro's scoping attribute. The row header is capped at 148px
                         and is `position: sticky` with `z-index: 1`, so an unwrappable sentence did
                         not merely overflow — it painted OVER the cells it ran into. Measured on
                         the deployed page with a Range over the text node rather than the element
                         box (the box stays 134px wide while the ink does not): five of five
                         captions overflowed, the worst by 563px across three value columns, on top
                         of "231", "416" and three "Unavailable"s.
                         The element box is the wrong instrument for this defect, which is why a
                         stylesheet grep for the class found nothing wrong.
                         It is its own class now so the mode table's inline `.tx` is untouched. ]]*/}
                    {feature.note && <span class="rownote">{feature.note}</span>}
                  </th>
                  {PLAN_IDS.map((id) => {
                    const value = feature.values[id];
                    if (value === true) {
                      return (
                        <td class="compare__yes" data-label={PLAN_COPY[id].name}>
                          {/* The glyph is decoration; the word is the answer. A table whose
                              cells are bare ticks and blanks is unreadable aloud, and "blank"
                              is exactly the ambiguity this table exists to remove. */}
                          <span aria-hidden="true">&#10003;</span>
                          <span class="visually-hidden">Included</span>
                        </td>
                      );
                    }
                    if (value === false) {
                      return (
                        <td class="compare__no" data-label={PLAN_COPY[id].name}>
                          <span aria-hidden="true">&#8212;</span>
                          <span class="visually-hidden">Not included</span>
                        </td>
                      );
                    }
                    return <td data-label={PLAN_COPY[id].name}>{value}</td>;
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="plan__note compare-note">
        Figures come from the shared plan configuration. Free access is available now.{' '}
        {canBuy('builder') || canBuy('studio')
          ? 'Paid plans can be purchased above.'
          : `Paid plans, and with them ${strongName}, are not yet available to purchase.`}{' '}
        {STUDIO_PLUGIN_STORE_LIVE ? (
          <>Building in Studio also needs the Apple Studio plugin, which is free: <a href={STUDIO_PLUGIN_INSTALL_HREF} target="_blank" rel="noopener noreferrer">get it from the Creator Store</a>.</>
        ) : (
          <>Building in Studio also needs the Apple Studio plugin; public installation is unavailable. <a href={STUDIO_PLUGIN_INSTALL_HREF}>Plugin availability</a>.</>
        )}
      </p>
    </div>
  </section>


  <!-- ==================================================== per-mode -->
  <section class="section" aria-labelledby="credits-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Per request</p>
        <h2 id="credits-title" data-reveal class="carved">What a Credit buys</h2>
        <p class="lede lede-wide" data-reveal>
          Plan and Agent are the two product modes. Autonomous is an Agent toggle, not another
          mode or another price. Final usage depends on the work performed.
        </p>
      </header>

      <div class="table-scroll stack-sm" data-reveal>
        <table class="modes-table">
          <caption class="visually-hidden">Credit cost per request by mode</caption>
          <thead>
            <tr>
              <th scope="col">Mode</th>
              <th scope="col">Cost per request</th>
              <th scope="col">What it does</th>
              <th scope="col">≈ requests / free day</th>
            </tr>
          </thead>
          <tbody>
            {
              modeRows.map((r) => (
                <tr>
                  <td class="mode-cell">
                    {r.mode}
                  </td>
                  <td data-label="Cost per request">
                    <code>{r.cost}</code>
                    <span class="tx">for {r.unit}</span>
                  </td>
                  <td data-label="What it does">{r.does}</td>
                  <td class="num" data-label="≈ requests / free day">{r.perDay}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="tfoot" data-reveal>
        An Agent request settles against the work it actually did, so a long build costs more than
        the entry price above — the workspace counts what the run has spent while it runs. Apple&rsquo;s own
        housekeeping does not count against your quota.
      </p>
      <p class="tfoot" data-reveal>
        <strong>Autonomous does not add a mode.</strong> Turn it on while using Agent when you want
        Agent to keep scheduling its own next step until the task is finished, you stop it, access
        changes, the account reaches a Credits or service-capacity limit, or that message reaches
        the 1000 steps ceiling.
      </p>

      {/*[[ THE TWO UNITS, RECONCILED WHERE THE READER MEETS THEM.
           The table prices a request and the plan cards price a build, and one free day divides
           into 57 of the first and 3 of the second. Both are true. Published a
           hundred lines apart with no unit attached, they read as one figure contradicting itself
           by more than an order of magnitude — on exactly the question the owner asked, which was
           what this will cost in a month. The sentence is DERIVED from CREDITS_PER_BUILD and
           PLAN_LIMITS, never typed, so it cannot be the copy that is left behind next time.
           check-credit-figures.mjs fails if it goes missing or if an offered mode ever prices a
           build at something other than CREDITS_PER_BUILD. ]]*/}
      <p class="tfoot" data-reveal>
        <strong>A request is not a build.</strong> The counts above are requests at the entry price.
        A whole quality-gated build — read the tree, edit the scripts, create the instances, then
        render it and critique the picture — is about {CREDITS_PER_BUILD} Credits, which is{' '}
        {buildsPerDay('free')} of them a free day and {buildsPerMonth('free')} a free month. That is
        the figure the plan cards above are counted in.
      </p>
    </div>
  </section>

  <!-- ==================================================== limits -->
  <section class="section limitsec" aria-labelledby="limits-title">
    <div class="wrap wrap-narrow-ish">
      <header class="sechead">
        <p class="eyebrow" data-reveal>The honest part</p>
        <h2 id="limits-title" data-reveal class="carved">Limits, plainly stated</h2>
      </header>
      <div data-reveal data-reveal-delay="90">
        <Accordion items={limitFaq} />
      </div>
    </div>
  </section>

  <Spotlight />
</Base>

<style>
  /* Structure only; every value is a token from apple-minimal.css. The cards are the page's one
     grid of panels: a surface step and a hairline each, no shadow, the Free card ranked by its
     filled button rather than by colour. */
  .phead {
    padding-top: clamp(48px, 7vw, 96px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .phead > .wrap > .eyebrow,
  .sechead .eyebrow {
    justify-content: center;
  }

  .phead > .wrap > h1,
  .phead > .wrap > .lede,
  .sechead,
  .sechead .lede {
    margin-inline: auto;
    text-align: center;
  }

  .sechead {
    max-width: 62ch;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .sechead h2 {
    margin-bottom: 8px;
  }

  /* THE GRID THAT BROKE. `.plans` is the block; `.plan-rail` holds the three cards and
     `.plan-notes` the notes under them. These rules used to live in relaunch.css, which was
     deleted, and the three cards stacked into one 364px column at 1440 with the notes beside them. */
  .plans {
    max-width: 1120px;
    margin: clamp(40px, 6vw, 64px) auto 0;
  }

  .plan-rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
  }

  .plan.is-planned {
    background: var(--paper-2);
  }

  .plan__flag {
    align-self: flex-start;
    margin: 0 0 20px;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--ink);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .plan__flag--quiet {
    color: var(--faint);
  }

  .plan__head {
    margin-bottom: 22px;
  }

  .plan h2 {
    margin: 0 0 6px;
    color: var(--ink);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .plan__price {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .plan__per {
    font-size: inherit;
  }

  .plan__price span {
    margin-right: 6px;
    color: var(--ink);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .plan__list {
    display: grid;
    gap: 10px;
    margin: 0 0 28px;
    padding: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
    list-style: none;
  }

  .plan__list strong {
    color: var(--ink);
    font-weight: 500;
  }

  .plan__list li {
    position: relative;
    padding-left: 18px;
  }

  .plan__list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .plan__foot {
    display: grid;
    gap: 10px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
  }

  .plan__cta {
    width: 100%;
    min-height: 40px;
  }

  .plan__note {
    margin: 12px 0 0;
    color: var(--faint);
    font-size: 13px;
    line-height: 1.55;
  }

  .plan__note--foot {
    min-height: 3em;
    margin: 0;
    text-align: center;
  }

  .plan-enterprise {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin: 16px 0 0;
    padding: 18px 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    color: var(--muted);
    font-size: 14px;
  }

  .plan-enterprise strong {
    color: var(--ink);
    font-weight: 500;
  }

  .plan-enterprise a {
    margin-left: auto;
    color: var(--ink);
