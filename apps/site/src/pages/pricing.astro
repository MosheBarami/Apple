---
import Base from '../layouts/Base.astro';
import SparkMeter from '../components/SparkMeter.astro';
import FAQ from '../components/FAQ.astro';

// Figures come from docs/COST-MODEL.md through the SAME arithmetic the worker uses,
// `sparksForNeurons(n) = max(1, ceil(n / 30))`, and are not invented here:
// Free 60 sparks/day (900/month) · Pro (designed, waitlist) 400/day (6,000/month)
//
//   Plan         37-43 neurons -> ceil(43/30)  =  2 sparks
//   Agent        111 neurons   -> ceil(111/30) =  4 sparks  (targeted edit + read-back verify)
//   Super Agent  297 neurons   -> ceil(297/30) = 10 sparks  (+1 per extra step)
//
// COST-MODEL.md names these by their INTERNAL specialist identities — Clay, Stone, Rune
// — which is correct there and wrong here: packages/shared says those "are internal
// specialist identities, not user-facing brands: nothing in normal product UI should
// name them", and §15.3 gives the public modes as Plan / Agent / Super Agent.
//
// Plan was published as 1 spark, and 60 requests a free day. It is 2 and 30. Agent and
// Super Agent were both right, which is what makes the Plan figure an arithmetic slip
// rather than a different model of pricing: whoever wrote them divided correctly.
// "≈ requests / free day" is simply 60 ÷ cost.
const modeRows = [
  {
    mode: 'Plan',
    cls: 'is-clay',
    cost: '2 sparks',
    extra: '',
    does: 'Fast answers and small edits',
    perDay: '30',
  },
  {
    mode: 'Agent',
    cls: 'is-stone',
    cost: '4 sparks',
    extra: '',
    does: 'Builds features across your project',
    perDay: '15',
  },
  {
    mode: 'Super Agent',
    cls: 'is-rune',
    cost: '10 sparks',
    extra: '+1 per extra step',
    does: 'Plans, builds, tests and fixes autonomously',
    perDay: 'up to 6',
  },
];

const limitFaq = [
  {
    q: 'What happens when I run out of Sparks?',
    a: `<p>Golem tells you plainly, mid-conversation, and shows when your quota resets (daily, at midnight UTC — the same instant for everyone, not 24 hours after you started). Nothing is lost — your chat, project and checkpoints stay exactly where they are. You can keep reading, browsing your project and restoring checkpoints; only new AI requests wait for the reset.</p>`,
  },
  {
    q: 'Why is there a limit at all?',
    a: `<p>Golem runs real inference on every request, and inference costs real compute. A hard daily quota is how the free tier stays genuinely free — no card required, no surprise bill, no "free trial" countdown. We would rather give you an honest 60 Sparks every day than an unlimited plan with an asterisk.</p>`,
  },
  {
    q: 'Do unused Sparks roll over?',
    a: `<p>No. Sparks reset to your full daily amount every day. Rollover sounds nice but pushes people to hoard; a fresh daily allowance keeps the math simple and the queue fair.</p>`,
  },
  {
    q: 'Can one Super Agent request cost more than 10 Sparks?',
    a: `<p>Yes, and it is metered transparently. Super Agent requests start at 10 Sparks and add 1 Spark per extra step beyond the ones included. You see the running total live in the workspace, and a request never silently drains your day — Golem warns before starting work it estimates will be expensive.</p>`,
  },
  {
    q: 'What is a Spark, underneath?',
    a: `<p>A unit of real compute. One Spark is 30 neurons of real compute, and Golem bills from the engine's own reported figure for each call rather than from an estimate. A full Agent build — read the tree, edit scripts, create instances, verify — measured 511 neurons, about $0.0056. That is why the free tier can exist at all.</p>`,
  },
  {
    q: 'When does Pro launch, and what will it cost?',
    a: `<p>Pro is on the waitlist. We have not fixed the price yet, and we will not charge anyone before the plan, the price and the terms are published. Joining the waitlist costs nothing and commits you to nothing — it just gets you first access and a say in what Pro should include.</p>`,
  },
];
---

<Base
  title="Pricing — Golem"
  description="Golem is free: 60 Sparks a day, all three modes, unlimited projects, checkpoints included. Pro is designed — 400 Sparks/day and a priority queue — and is on the waitlist. No card required, ever."
>
  <!-- ==================================================== head -->
  <section class="section phead is-ember" aria-labelledby="pricing-title">
    <div class="sheet-rails" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h1 id="pricing-title" class="carved">Free to build. Honestly.</h1>
      <p class="lede lede-wide">
        No card. No trial countdown. A hard daily quota is what keeps the free
        tier sustainable — and it is the same number we show you burning down in
        the workspace.
      </p>

      <div class="plans">
        <article class="plan slab slab--seam" aria-labelledby="plan-free" data-reveal>
          <header class="plan__head">
            <h2 id="plan-free">Free</h2>
            <p class="plan__price"><span>$0</span> forever</p>
          </header>
          <ul class="plan__list">
            <li><strong>60 Sparks</strong> per day · 900 a month</li>
            <li>All three modes — Plan, Agent, Super Agent</li>
            <li>Unlimited projects</li>
            <li>Checkpoints &amp; rollback</li>
            <li>Studio plugin included</li>
          </ul>
          <a href="/app" class="btn btn-primary plan__cta">Start building — free</a>
          <p class="plan__note">
            Nothing to cancel, because there is nothing to start.
          </p>
        </article>

        <article
          class="plan slab slab--seam is-rune"
          aria-labelledby="plan-pro"
          data-reveal
          data-reveal-delay="110"
        >
          <span class="plan__flag mono">Not launched</span>
          <header class="plan__head">
            <h2 id="plan-pro">Pro</h2>
            <p class="plan__price plan__price--soft">
              <span>Waitlist</span> price not final
            </p>
          </header>
          <ul class="plan__list">
            <li><strong>400 Sparks</strong> per day · 6,000 a month</li>
            <li>Priority queue — your golem goes first</li>
            <li>Extended checkpoint history</li>
            <li>Everything in Free</li>
          </ul>
          <a href="/app/usage" class="btn btn-ghost plan__cta">Join the waitlist</a>
          <p class="plan__note">
            No payment is collected at v1. You will never be charged without
            seeing a published price first.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================================================== calculator -->
  <section class="section calcsec" id="calculator" aria-labelledby="calc-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Usage explorer</p>
        <h2 id="calc-title" data-reveal class="carved">
          Work out your own day
        </h2>
        <p class="lede lede-wide" data-reveal>
          Rather than guessing whether "60 Sparks" is a lot, set the sliders to
          how you actually build. Whichever limit binds first is the one that
          applies.
        </p>
      </header>

      <div data-reveal data-reveal-delay="100">
        <SparkMeter />
      </div>
    </div>
  </section>

  <!-- ==================================================== per-mode -->
  <section class="section" aria-labelledby="sparks-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Per request</p>
        <h2 id="sparks-title" data-reveal class="carved">What a Spark buys</h2>
        <p class="lede lede-wide" data-reveal>
          Bigger golems burn more, because they do more work per request. The
          craft is picking the smallest one that can carry the job.
        </p>
      </header>

      <div class="table-scroll" data-reveal>
        <table>
          <caption class="visually-hidden">Spark cost per request by mode</caption>
          <thead>
            <tr>
              <th scope="col">Mode</th>
              <th scope="col">Cost per request</th>
              <th scope="col">What it does</th>
              <th scope="col">≈ requests / free day</th>
            </tr>
          </thead>
          <tbody>
            {
              modeRows.map((r) => (
                <tr class={r.cls}>
                  <td>
                    <span class="dot" aria-hidden="true" /> {r.mode}
                  </td>
                  <td>
                    <code>{r.cost}</code>
                    {r.extra && <span class="tx">{r.extra}</span>}
                  </td>
                  <td>{r.does}</td>
                  <td class="num">{r.perDay}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="tfoot" data-reveal>
        A Super Agent request includes its base steps; each additional step beyond
        them costs 1 extra Spark, metered live so you always see where you
        stand. Golem's own housekeeping does not count against your quota.
      </p>
    </div>
  </section>

  <!-- ==================================================== limits -->
  <section class="section limitsec" aria-labelledby="limits-title">
    <div class="wrap wrap-narrow-ish">
      <header class="sechead">
        <p class="eyebrow" data-reveal>The honest part</p>
        <h2 id="limits-title" data-reveal class="carved">Limits, plainly stated</h2>
      </header>
      <div data-reveal data-reveal-delay="90">
        <FAQ items={limitFaq} />
      </div>
    </div>
  </section>
</Base>

<style>
  .phead {
    position: relative;
    padding-top: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .phead::before {
    content: '';
    position: absolute;
    top: -10%;
    left: -8%;
    width: min(60vw, 700px);
    aspect-ratio: 1;
    background: radial-gradient(
      circle at 50% 50%,
      var(--accent-soft),
      transparent 65%
    );
    pointer-events: none;
    z-index: 0;
  }

  .phead > .wrap {
    position: relative;
    z-index: 1;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    max-width: 900px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.1rem);
  }

  .plan__flag {
    position: absolute;
    top: 1.1rem;
    right: 1.2rem;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--r-pill);
    padding: 0.22rem 0.6rem;
  }

  .plan__head {
    margin-bottom: 1.4rem;
  }

  .plan h2 {
    font-size: 1.7rem;
    margin: 0 0 0.3rem;
  }

  .plan__price {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .plan__price span {
    font-family: var(--font-body);
    font-variation-settings: normal;
    font-variant-numeric: tabular-nums;
    font-weight: 620;
    font-size: 1.65rem;
    color: var(--ink);
    margin-right: 0.4rem;
    letter-spacing: -0.04em;
  }

  /* "Waitlist" is a state, not a price — it should not shout like one */
  .plan__price--soft span {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0;
    color: var(--accent);
  }

  .plan__list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .plan__list strong {
    color: var(--accent);
  }

  .plan__list li {
    padding-left: 1.5rem;
    position: relative;
  }

  .plan__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    background: var(--accent);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  .plan__cta {
    margin-top: auto;
    justify-content: center;
  }

  .plan__note {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    color: var(--faint);
    line-height: 1.5;
  }

  .calcsec {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }

  .sechead {
    max-width: 60ch;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .sechead h2 {
    margin-bottom: 0.5rem;
  }

  /* table extras */
  .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    margin-right: 0.5rem;
  }

  .tx {
    color: var(--faint);
    font-size: 0.78rem;
    margin-left: 0.45rem;
    white-space: nowrap;
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .tfoot {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.87rem;
    max-width: 62ch;
  }

  .limitsec .wrap-narrow-ish {
    width: min(820px, calc(100% - var(--gutter) * 2));
    margin-inline: auto;
  }

  @media (max-width: 760px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
