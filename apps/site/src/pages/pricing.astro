---
import {
  PLAN_COPY,
  PLAN_FEATURES,
  LISTED_PLAN_IDS,
  type PlanId,
  PLAN_TABLE,
  PLAN_SUPPORT,
  SUPPORT_EMAIL,
  PRICE_CURRENCY,
  buildsPerMonth,
  formatMoney,
  formatCredits,
  CREDIT_USD,
  TYPICAL_BUILD_CREDITS,
  BUILD_COSTS,
  INTERNAL_PER_CREDIT,
  NEURONS_PER_CREDIT,
  fullRateDays,
  monthlyCeilingBitesFirst,
  PRODUCT_MODEL_INFO,
  CREDIT_PURCHASE_LIVE as SHARED_CREDIT_PURCHASE_LIVE } from '@studpilot/shared';
import { STUDIO_PLUGIN_INSTALL_HREF, STUDIO_PLUGIN_STORE_LIVE } from '../lib/studio-plugin';
import { DAILY_NEURON_CEILING } from '../../../worker/src/pricing';
import { NOT_DECIDED, dailyCapDecided } from '../lib/plan-facts';

/*
 * THE LIMIT THIS PAGE NEVER MENTIONED, ON THE PAGE WHERE PEOPLE DECIDE.
 *
 * A plan's Credits are a per-account allowance. Behind all of them is ONE service-wide daily
 * ceiling on inference — apps/worker/src/pricing.ts, DAILY_NEURON_CEILING — and a run stops against
 * it with "StudPilot has reached today's shared building capacity" while the customer's own balance
 * still shows Credits. /docs/credits-and-limits and /docs/troubleshooting both disclose it. This
 * page, which is the one a prospect reads before signing up, did not: it said "about N builds a
 * month, free" and stopped.
 *
 * The figures are DERIVED from the worker's own ceiling rather than typed, so the sentence cannot
 * outlive the number. The per-account arithmetic is deliberately printed as a floor, because the
 * honest claim is "a handful of busy accounts", not a promise about any particular day. The ceiling
 * is in neurons; a credit is INTERNAL_PER_CREDIT ledger units of NEURONS_PER_CREDIT neurons each.
 */
const serviceCreditsPerDay = Math.floor(DAILY_NEURON_CEILING / (NEURONS_PER_CREDIT * INTERNAL_PER_CREDIT));

/*
 * THE STUDIO LINE ON EVERY CARD IS ASKED, NOT TYPED.
 *
 * STUDIO_PLUGIN_STORE_LIVE says whether the Creator Store install path works. While it does, the
 * shared plugin row is `true` for every plan and prints once, as a universal bullet (see
 * the comparison table's `plugin` row) — so there is no second Studio line to disagree with it. While it does not,
 * this bullet says so on every card, in the one sentence the rest of the site uses.
 */
const studioBullet = STUDIO_PLUGIN_STORE_LIVE ? null : 'Roblox Studio plugin · public installation unavailable';

// THE NUMBERS ON THIS PAGE ARE READ, NOT WRITTEN. They are all in PLAN_TABLE in packages/shared, the
// same table QuotaDO enforces, so the marketing site and the thing enforcing the quota cannot drift
// apart. scripts/check-offer.mjs and scripts/check-credit-figures.mjs hold the page to it.
//[[ WHETHER A PLAN CAN BE BOUGHT IS NOT ASKED ANY MORE, AND THE ANSWER IS NO (2026-10-04).
//
//   This page used to probe /api/billing/config at build time and render a Choose button for any
//   plan the live deployment reported as purchasable. The owner's decision is that paid plans start
//   later: charging begins only after every build type passes the quality bar and an adult holds
//   the Stripe account (planning/pricing-2026-10-04.md). Until then no card shows a way to buy, and
//   a deployment that came to report checkout as open would have put a purchase button under a
//   headline saying paid plans have not started. The probe, its build-time network call and every
//   branch it fed are gone; when charging starts this page is changed on purpose, with the plan
//   cards, the checkout note and apps/site/tests/pricing-config.test.mjs in the same change.
//
//   apps/site/tests/pricing-availability.test.mjs holds the page to "no checkout link".
//]]
const free = PLAN_TABLE.free;

/*
 * THE CARDS' SHARED FLOOR IS DERIVED, WHICH IS ALSO WHAT CLOSES THE HOLE IN THEM.
 *
 * Free listed "Unlimited projects" and "Checkpoints & rollback" as typed bullets while Builder and
 * Studio said "Everything in Free" and stopped — so the two paid cards ran out of content after
 * five lines and left ~235px of empty charcoal above their own bottom edge, measured on the
 * deployed page. "Everything in Free" is not a capability, it is an instruction to go and read
 * another card; the reader who does not is left thinking the paid tier has fewer features than the
 * free one, which is the opposite of the truth.
 *
 * PLAN_FEATURES already knows which rows are true for every plan. Enumerating them per card is
 * therefore not new copy — it is the comparison table's own answer, printed where the decision is
 * made. The void closes because the cards now say what they actually include, not because
 * something was padded.
 */
/* THE SUPPORT LINE ON A CARD NAMES THE KIND OF SUPPORT, NOT THE MAILBOX (2026-09-22). Each card used
   to end on "Email <address>", which is a contact detail set as a plan feature. The address is
   printed once, in the support note under the cards, beside what PLAN_SUPPORT promises. */
const supportBullet = (id: PlanId) =>
  id === 'free' ? 'Email support, read by a person' : 'Email support, answered before Free';

/* Every run has the same step ceiling on every plan; it is one bullet on every card rather than a
   Free-only line that made the paid cards look as if they lacked it. */
const stepsBullet = 'Up to 1000 steps a message';

/* ONE ENGINE ON EVERY PLAN (V3 gate G01). Free, Pro and Max are plans and differ only in their
   allowance; every one of them uses StudPilot, the only engine there is. */
const listNames = (names: string[]) =>
  names.length < 2 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
const planNames = listNames(LISTED_PLAN_IDS.map((id) => PLAN_COPY[id].name));
const engineName = PRODUCT_MODEL_INFO.apple.name;

/*
 * ONE CARD IS RANKED: FREE, THE ONLY PLAN ANYBODY CAN HAVE.
 *
 * `is-featured` was set on the first paid plan and styled NOWHERE — measured, the middle card's
 * computed style was byte-identical to its neighbours: same size, same fill, same border, no
 * shadow, no badge. Three plans of equal weight and one button between them is a page with no
 * answer to "what do I click". The honest answer is Free: paid plans have not started and no paid
 * card has a live control, so only the Free card carries the beam, the flag and the shining button.
 * (It used to be asked of the billing probe which plan could be bought; that question is closed.)
 */

//[[ "BUY EXTRA CREDITS" WAS THE ONE ROW IN THE MATRIX THAT ADVERTISED A CHANNEL RATHER THAN A
//   CAPABILITY, AND THE CHANNEL DOES NOT EXIST.
//
//   PLAN_FEATURES marks `credits` true for all four plans. Three of those column headers carry
//   "(planned)" while Free's does not — by construction, a few lines below — so the only plan
//   anybody can be on was the only one told, without caveat, that buying extra Credits is included.
//   The in-app usage meter then offers "add credits" as the next action at the exact moment the
//   allowance runs out, which is the exact moment somebody would have paid.
//
//   NOTHING IN THE PRODUCT CAN TAKE THAT MONEY, and this is not an environment gap a key would
//   close. `buildCheckoutRequest` in apps/worker/src/billing.ts hardcodes `mode=subscription`, its
//   CheckoutEnv declares price ids for Builder and Studio and nothing else, and no `mode=payment`
//   construction exists anywhere in apps/ or packages/. The webhook branch that reads a `credits`
//   figure off a completed checkout therefore has no producer in any deployment.
//
//   THE OVERRIDE LIVES HERE RATHER THAN IN packages/shared BECAUSE THIS PAGE IS WHAT THE READER
//   RECEIVES, and because the string branch of the cell renderer below already exists for precisely
//   this shape — it is how the `plugin` row prints "Public installation unavailable" instead of a
//   tick. The row is kept and answered rather than deleted: the table's whole premise is that a
//   capability missing from it is indistinguishable from one nobody mentioned.
//
//   apps/site/tests/credit-purchase-claim.test.mjs holds the flag to the worker: it goes red the
//   moment a credit checkout appears, so this cannot quietly outlive the gap it describes.
// DERIVED, NOT DECLARED. This was a local `= false` that corrected this page and left the shared
// constant saying "included on every plan" for every other reader — including the in-app meter,
// which went on offering "Add credits" at the moment a customer's allowance ran out. One fact, one
// home: packages/shared/src/index.ts.
const CREDIT_PURCHASE_LIVE = SHARED_CREDIT_PURCHASE_LIVE;
/* A PAID PLAN'S PER-DAY FIGURE IS NOT THE OWNER'S: the decided pricing doc fixes the monthly pools only (src/lib/plan-facts.ts). The row stays, because a
   capability missing from a list is indistinguishable from one nobody mentioned, and a paid cell says "Not decided yet" in place of the assumed 20 or 30. */
const planFeatures = PLAN_FEATURES.map((f) =>
  f.id === 'credits-per-day'
    ? {
        ...f,
        values: Object.fromEntries(
          LISTED_PLAN_IDS.map((id) => [id, dailyCapDecided(id) ? f.values[id] : NOT_DECIDED]),
        ) as Record<string, string>,
      }
    : f.id === 'credits' && !CREDIT_PURCHASE_LIVE
    ? {
        ...f,
        /* The shared label says "credits" in lower case; the unit is a proper noun on this site. */
        label: f.label.replace(/\bcredits\b/g, 'Credits'),
        note: 'StudPilot cannot sell Credits in this preview — there is no checkout for them on any plan.',
        values: Object.fromEntries(LISTED_PLAN_IDS.map((id) => [id, 'Unavailable'])) as Record<string, string>,
      }
    : f,
);
import Base from '../layouts/Base.astro';
import '../styles/site.css';

/* A PLAN'S PRICE PER TYPICAL BUILD: the monthly price over the builds that month buys, both from the shared config, rounded to the
   cent. It used to sit behind the "a month / a build" switch (a picked component, deleted by the M2 rebuild); the figure itself is
   kept, printed on each paid card. tests/pricing-config.test.mjs and tests/picks-pricing-docs.test.mjs hold it to the config. */
const perBuild = (id: PlanId) =>
  formatMoney(Math.round(((PLAN_COPY[id].priceUsdMonthly ?? 0) / Math.max(1, buildsPerMonth(id))) * 100) / 100, {
    currency: PRICE_CURRENCY,
  });

/*
 * WHAT BUILDS COST, READ FROM THE PRICING CONFIG (BUILD_COSTS in packages/shared).
 *
 * The table that used to sit here priced a REQUEST in the ledger's own unit and a whole build
 * separately in the same unit, and a credit is now INTERNAL_PER_CREDIT ledger units, so neither
 * number means what it did. The table is the pricing doc's: what a build costs in credits
 * (two decimals) and the dollars of AI compute that is, converted at CREDIT_USD. A row that is still
 * an estimate says so.
 */
const dollars = (credits: number) => formatMoney(Math.round(credits * CREDIT_USD * 100) / 100, { currency: PRICE_CURRENCY });
const range = (low: number, high: number, fmt: (n: number) => string) =>
  low === high ? fmt(low) : `${fmt(low)}\u2013${fmt(high)}`;
/* Each row's bar is drawn to the top of its range over the largest top of any row (a width, not a figure): it shows how much more a big
   build costs than a small one and says nothing the two numbers beside it do not. */
const maxCredits = Math.max(...BUILD_COSTS.map((b) => b.creditsHigh));
const buildCostRows = BUILD_COSTS.map((b) => ({
  id: b.id,
  label: b.label,
  credits: range(b.creditsLow, b.creditsHigh, formatCredits),
  dollars: range(b.creditsLow, b.creditsHigh, dollars),
  estimated: b.estimated,
  width: Math.max(4, Math.round((b.creditsHigh / maxCredits) * 100)),
}));

/* Each plan whose monthly ceiling arrives before the month does, as "Free: 5 a day against 30 a month
   is 6 full days". Derived per plan, and only for a plan whose per-day figure is decided: a paid plan's "full days" would be arithmetic on a number
   nobody decided (src/lib/plan-facts.ts). */
const ceilingLines = LISTED_PLAN_IDS.filter((id) => dailyCapDecided(id) && monthlyCeilingBitesFirst(id)).map(
  (id) =>
    `${PLAN_COPY[id].name}: ${PLAN_TABLE[id].creditsPerDay} a day against ${PLAN_TABLE[id].creditsPerMonth} a month is <strong>${fullRateDays(id)} full days</strong>`,
);

/* THE SHARED LIMIT IS ONE OF THE LIMITS, so it is written as one: the same shape as the others, asked in the page's own words. (It used to be a
   note under the plan cards.) The figures are the worker's own ceiling, derived above. */
const sharedLimit = {
  q: 'A second, shared limit',
  a: `<p>Every plan draws on one shared pool of about ${serviceCreditsPerDay.toLocaleString()} Credits of building a day across the whole service, which is roughly ${Math.floor(serviceCreditsPerDay / free.creditsPerDay)} accounts building flat out. When that day's pool is gone, a run stops with “StudPilot has reached today's shared building capacity” even though your own balance still shows Credits. It resets at midnight UTC, the same instant for everyone, and the steps that already finished stay done and stay paid for. <a href="/docs/credits-and-limits">How the two limits differ</a>.</p>`,
};

const limitFaq = [
  {
    q: 'What happens when I run out of Credits?',
    a: `<p>StudPilot tells you plainly, mid-conversation, which limit you reached and when it lifts. The <em>daily</em> limit resets at midnight UTC, the same instant for everyone, not 24 hours after you started. The <em>monthly</em> limit resets at 00:00 UTC on the 1st of the next month, and a new day does not lift it. Nothing is lost — your chat, project and checkpoints stay exactly where they are. You can keep reading, browsing your project and restoring checkpoints; only new AI requests wait for the reset.</p>`,
  },
  {
    q: 'Why is there a limit at all?',
    a: `<p>StudPilot runs real inference on every request, and inference costs real compute. A hard daily quota is how the Free plan stays free while StudPilot is in beta — no card required and no surprise bill. We would rather give you an honest daily allowance than an unlimited plan with an asterisk.</p>`,
  },
  {
    q: 'Do unused Credits roll over?',
    a:
      `<p>No. Credits reset to your full daily amount each day, up to your plan's monthly ceiling. Rollover sounds nice but pushes people to hoard; a fresh daily allowance keeps the math simple and the queue fair.</p>` +
      (ceilingLines.length > 0
        ? `<p><strong>The monthly ceiling is the one that bites.</strong> ${ceilingLines.join('; ')}. Spend a whole daily allowance every day and there is nothing left for the rest of the month. Whichever limit is lower is the one you actually have, and the workspace shows both.</p>`
        : ''),
  },
  //[[ NO SENTENCE HERE MAY PROMISE A WARNING BEFORE A RUN STARTS.
  //
  //   This answer used to end "a request never silently drains your day — StudPilot warns before
  //   starting work it estimates will be expensive." Nothing in the product does that, and nothing
  //   can: `ServerMsg` in packages/shared has no cost-warning variant, `RunIntent` carries no cost
  //   field, and a run is admitted on `quotaSpend(owner, 1, …)` (apps/worker/src/do/session.ts)
  //   whose only refusal is a zero balance. `estimateNeurons` exists but reserves BudgetDO budget
  //   for the owner's bill; it is never shown to anyone. The worker says the same thing about the
  //   one control that would have gated an expensive tool — apps/worker/src/preferences.ts
  //   downgrades the `ask` permission to `deny` because "nothing in this product can interrupt a
  //   run to ask".
  //
  //   The clause was a safety guarantee a reader could rely on when deciding to send one more
  //   build, and relying on it is how a day's allowance goes into a run that never finishes. It is
  //   deleted rather than softened: a vaguer promise of the same thing is the same untruth. What
  //   replaces it is the behaviour that IS implemented, quoted from session.ts's own stop message.
  //   apps/site/tests/pre-run-cost-warning.test.mjs fails if the promise comes back while the wire
  //   protocol still has nothing to carry it.
  {
    q: 'Can a build cost more than the table says?',
    a: `<p>Yes. The table shows what builds typically cost, not a quote. A build is charged for the AI work it actually used, so a long one costs more. The workspace shows what a request cost once it has finished, and if a run reaches the end of your Credits it stops there and says so — everything it finished by then is saved. The limit it reached lifts at midnight UTC if it was the day's, and at 00:00 UTC on the 1st of the next month if it was the month's.</p>`,
  },
  {
    q: 'What is a Credit?',
    a: `<p>One Credit is about ${formatMoney(CREDIT_USD, { currency: PRICE_CURRENCY })} of AI compute: ${(INTERNAL_PER_CREDIT * NEURONS_PER_CREDIT).toLocaleString('en-US')} of Cloudflare's Workers AI neurons, the unit the engine reports. StudPilot charges from the engine's own reported usage for each call rather than from a guess, and your app balance shows with two decimals. A typical build uses about ${formatCredits(TYPICAL_BUILD_CREDITS)} Credits.</p>`,
  },
  {
    q: 'Can I subscribe now?',
    a: `<p>Not yet. Paid checkout is not open. ${PLAN_COPY.builder.name} and ${PLAN_COPY.studio.name} are the planned subscription tiers, and charging starts later. The Plan &amp; billing tab of your account’s Usage and Credits page shows live purchase availability; no subscription starts without a confirmed checkout.</p>`,
  },
];
// The limits, in the order a reader meets them: the ones that are theirs, then the one that is shared.
const limits = [...limitFaq, sharedLimit];
---

<Base
  title="Pricing: free while in beta | StudPilot"
  description={`Plans and Credits for StudPilot, in beta. Free includes ${free.creditsPerDay} Credits a day and ${free.creditsPerMonth} a month, and every plan uses ${engineName}. Paid checkout is not open yet.`}
>
  <!-- ==================================================== head -->
  <section class="page-head" aria-labelledby="pricing-title">
    <div class="wrap">
      <p class="kicker"><span class="badge">Beta</span> Pricing</p>
      {/* THE HEADLINE AGREES WITH THE BUTTONS UNDER IT. It is the owner's line, word for word
          (planning/pricing-2026-10-04.md): paid plans have no way to be bought, and say so. */}
      <h1 id="pricing-title" class="carved">Free while in beta. Paid plans start later</h1>
      <p class="lede lede-wide">
        {planNames} are plans. Every plan uses {engineName}; they differ in how many Credits they
        include and in who is answered first when you write to support. Paid checkout is not open yet; the paid plans below describe the planned offering.
      </p>
    </div>
  </section>

  {/* ================================================ THE ONE DECISION: WHAT FREE GIVES YOU TODAY.
      The old page led with three equal plan cards and a button between them (and a comparison table that repeated them under them).
      This one answers the question a visitor came with first, in one panel, and puts every plan in ONE table after it. */}
  <section class="sec sec--flush" aria-labelledby="now-title">
    <div class="wrap now">
      <div class="now__copy">
        <p class="kicker">Available now</p>
        <h2 id="now-title" class="sec-title">Free</h2>
        <p class="now__price"><span>{formatMoney(0, { currency: PRICE_CURRENCY })}</span> in beta</p>
        <p class="now__line">
          <strong>{free.creditsPerDay} Credits</strong> per day · up to {free.creditsPerMonth} a month. About {buildsPerMonth('free')} typical builds a month.
        </p>
        {studioBullet && <p class="now__line">{studioBullet}</p>}
        {/* THE SHARED LIMIT IS SAID HERE, BEFORE THE TABLE, NOT ONLY IN THE LIMITS AT THE END: a visitor signing up should not meet "StudPilot has reached
            today's shared building capacity" for the first time as an error message (tests/unpurchasable-and-shared-cap.test.mjs holds the order). */}
        <p class="now__line now__shared">
          One thing to know first: every plan draws on one shared pool of building a day across the whole service. When it is gone, a run stops
          with “StudPilot has reached today's shared building capacity” even though your own balance still shows Credits.
          <a href="#limits-title">The details</a>.
        </p>
        <div class="now__cta">
          <a href="/app/signup" class="btn btn-primary btn-lg">Start free (beta)</a>
          <p class="now__note">
            {STUDIO_PLUGIN_STORE_LIVE
              ? 'No card required. Chat and building in Studio both work on Free.'
              : 'No card required. Free chat works now.'}
          </p>
        </div>
      </div>
      <dl class="now__stats" aria-label="What Free gives you">
        <div>
          <dt>A day</dt>
          <dd>{free.creditsPerDay}</dd>
        </div>
        <div>
          <dt>A month, at most</dt>
          <dd>{free.creditsPerMonth}</dd>
        </div>
        <div>
          <dt>Typical builds a month</dt>
          <dd>{buildsPerMonth('free')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ==================================================== every plan, in one table -->
  <section class="sec sec--band" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sechead">
        <p class="kicker">Side by side</p>
        <h2 id="compare-title" class="sec-title">Every plan, in one table</h2>
        <p class="sec-text">
          Free is the only plan anybody can have today. Pro and Max are planned, and nobody can buy them yet. Every row
          is said for every plan, including the rows where the answer is the same for everyone, because a capability missing from a list is
          indistinguishable from one nobody mentioned.
        </p>
      </header>

      <div class="table-scroll stack-sm">
        <table class="compare">
          <caption class="visually-hidden">
            Every capability by plan. Rows are capabilities; columns are plans.
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              {
                LISTED_PLAN_IDS.map((id) => (
                  <th scope="col">
                    {PLAN_COPY[id].name}
                    <span class="colstate">{id === 'free' ? 'Available now' : 'Planned'}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              planFeatures.map((feature) => (
                <tr>
                  <th scope="row">
                    {feature.label}
                    {/* A caption under the capability. Its own class, so it wraps inside the narrow sticky header
                        instead of printing over the cells beside it. */}
                    {feature.note && <span class="rownote">{feature.note}</span>}
                  </th>
                  {LISTED_PLAN_IDS.map((id) => {
                    const value = feature.values[id];
                    if (value === true) {
                      return (
                        <td class="compare__yes" data-label={PLAN_COPY[id].name}>
                          {/* The glyph is decoration; the word is the answer. A table whose cells are bare ticks
                              and blanks is unreadable aloud. */}
                          <span aria-hidden="true">&#10003;</span>
                          <span class="visually-hidden">Included</span>
                        </td>
                      );
                    }
                    if (value === false) {
                      return (
                        <td class="compare__no" data-label={PLAN_COPY[id].name}>
                          <span aria-hidden="true">&#8212;</span>
                          <span class="visually-hidden">Not included</span>
                        </td>
                      );
                    }
                    return <td data-label={PLAN_COPY[id].name}>{value}</td>;
                  })}
                </tr>
              ))
            }
            {/* The rows the table gains by no longer sitting under three cards that said them: what a build costs at that price, the steps a
                message may take, the engine and the kind of support. Each is read from the config or from the one place that declares it. */}
            <tr>
              <th scope="row">Price per typical build</th>
              {
                LISTED_PLAN_IDS.map((id) => (
                  <td data-label={PLAN_COPY[id].name}>{id === 'free' ? 'Free in beta' : `about ${perBuild(id)} a build at this price`}</td>
                ))
              }
            </tr>
            <tr>
              <th scope="row">Steps in one message</th>
              {LISTED_PLAN_IDS.map((id) => <td data-label={PLAN_COPY[id].name}>{stepsBullet}</td>)}
            </tr>
            <tr>
              <th scope="row">Engine</th>
              {LISTED_PLAN_IDS.map((id) => <td data-label={PLAN_COPY[id].name}>Built by {engineName}</td>)}
            </tr>
            <tr>
              <th scope="row">Support</th>
              {LISTED_PLAN_IDS.map((id) => <td data-label={PLAN_COPY[id].name}>{supportBullet(id)}</td>)}
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Get it</th>
              {
                LISTED_PLAN_IDS.map((id) => (
                  <td data-label={PLAN_COPY[id].name}>
                    {id === 'free' ? (
                      <a href="/app/signup" class="btn btn-primary">Start free (beta)</a>
                    ) : (
                      /* A BUTTON THAT IS VISIBLY OFF, RATHER THAN NO BUTTON AT ALL: it says the affordance exists, names the state, and cannot
                         be pressed into a checkout that would answer 503. A real <button disabled>, so assistive technology is told the same
                         thing the eye is. */
                      <button type="button" class="btn" disabled aria-describedby="checkout-note">
                        Checkout not open
                      </button>
                    )
                  }
                  </td>
                ))
              }
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="compare-note" id="checkout-note">
        Planned tier — checkout is not open. Free limits apply now. Paid prices and limits describe the planned offering and may change
        before checkout opens. Figures come from the shared plan configuration.
        {' '}{STUDIO_PLUGIN_STORE_LIVE ? (
          <>Building in Studio also needs the StudPilot Studio plugin, which is free: <a href={STUDIO_PLUGIN_INSTALL_HREF} target="_blank" rel="noopener noreferrer">get it from the Creator Store</a>.</>
        ) : (
          <>Building in Studio also needs the StudPilot Studio plugin; public installation is unavailable. <a href={STUDIO_PLUGIN_INSTALL_HREF}>Plugin availability</a>.</>
        )}
      </p>
    </div>
  </section>

  <!-- ==================================================== what a credit buys -->
  <section class="sec" aria-labelledby="credits-title">
    <div class="wrap">
      <header class="sechead">
        <p class="kicker">Per build</p>
        <h2 id="credits-title" class="sec-title">What a Credit buys</h2>
        <p class="sec-text">
          One Credit is about {formatMoney(CREDIT_USD, { currency: PRICE_CURRENCY })} of AI compute.
