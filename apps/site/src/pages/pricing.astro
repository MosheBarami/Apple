---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const limitFaq = [
  {
    q: 'What happens when I run out of Sparks?',
    a: `<p>Golem tells you plainly, mid-conversation, and shows when your quota resets (daily, on a rolling 24-hour clock per account). Nothing is lost — your chat, project and checkpoints stay exactly where they are. You can keep reading, browsing your project and restoring checkpoints; only new AI requests wait for the reset.</p>`,
  },
  {
    q: 'Why is there a limit at all?',
    a: `<p>Golem runs real inference on every request, and inference costs real compute. A hard daily quota is how the free tier stays genuinely free — no card required, no surprise bill, no "free trial" countdown. We would rather give you an honest 60 Sparks every day than an unlimited plan with an asterisk.</p>`,
  },
  {
    q: 'Do unused Sparks roll over?',
    a: `<p>No. Sparks reset to your full daily amount every day. Rollover sounds nice but pushes people to hoard; a fresh daily allowance keeps the math simple and the queue fair.</p>`,
  },
  {
    q: 'Can one Rune request cost more than 10 Sparks?',
    a: `<p>Yes, and it is metered transparently. Rune requests start at 10 Sparks and add 1 Spark per extra agent step beyond the ones included. You see the running total live in the workspace, and a request never silently drains your day — Golem warns before starting work it estimates will be expensive.</p>`,
  },
  {
    q: 'When does Pro launch, and what will it cost?',
    a: `<p>Pro is in waitlist. We have not fixed the price yet, and we will not charge anyone before the plan, the price and the terms are published. Joining the waitlist costs nothing and commits you to nothing — it just gets you first access and a say in what Pro should include.</p>`,
  },
];
---

<Base
  title="Pricing — Golem"
  description="Golem is free: 60 Sparks a day, all three modes, unlimited projects, checkpoints included. Pro is coming — 400 Sparks/day and a priority queue. No card required, ever."
>
  <section class="section" aria-labelledby="pricing-title">
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h1 id="pricing-title">Free to build. Honestly.</h1>
      <p class="lede">
        No card. No trial countdown. A hard daily quota keeps the free tier sustainable — and keeps
        us honest about what it costs to run.
      </p>

      <div class="plans">
        <article class="plan card card--seam" data-reveal aria-labelledby="plan-free">
          <h2 id="plan-free">Free</h2>
          <p class="plan-price"><span class="plan-amount">$0</span> / forever</p>
          <ul class="plan-list">
            <li><strong>60 Sparks</strong> per day</li>
            <li>All three modes — Clay, Stone, Rune</li>
            <li>Unlimited projects</li>
            <li>Checkpoints &amp; rollback</li>
            <li>Studio plugin included</li>
          </ul>
          <a href="/app" class="btn btn-primary plan-cta">Start building — free</a>
        </article>

        <article class="plan card card--seam plan-pro" data-reveal data-reveal-delay="120" aria-labelledby="plan-pro" style="--seam: var(--violet)">
          <p class="plan-flag">Coming soon</p>
          <h2 id="plan-pro">Pro</h2>
          <p class="plan-price"><span class="plan-amount">Waitlist</span> · price not final</p>
          <ul class="plan-list">
            <li><strong>400 Sparks</strong> per day</li>
            <li>Priority queue — your golem goes first</li>
            <li>Extended checkpoint history</li>
            <li>Everything in Free</li>
          </ul>
          <a href="/app/usage" class="btn btn-ghost plan-cta">Join the waitlist</a>
          <p class="plan-note">
            No payment is collected at v1. You will never be charged without seeing a published
            price first.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section sparks-section" aria-labelledby="sparks-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Sparks</p>
      <h2 id="sparks-title" data-reveal>What a Spark buys</h2>
      <p class="lede" data-reveal>
        Sparks are Golem's daily energy. Bigger golems burn more of it — because they do more work
        per request.
      </p>

      <div class="table-scroll" data-reveal data-reveal-delay="120">
        <table>
          <caption class="visually-hidden">Spark cost per request by mode</caption>
          <thead>
            <tr>
              <th scope="col">Mode</th>
              <th scope="col">Cost per request</th>
              <th scope="col">What it does</th>
              <th scope="col">≈ requests / free day</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="mode-dot" style="--mode: var(--clay)"></span> Clay</td>
              <td><code>1 spark</code></td>
              <td>Fast answers and small edits</td>
              <td>80</td>
            </tr>
            <tr>
              <td><span class="mode-dot" style="--mode: var(--stone)"></span> Stone</td>
              <td><code>4 sparks</code></td>
              <td>Builds features across your project</td>
              <td>20</td>
            </tr>
            <tr>
              <td><span class="mode-dot" style="--mode: var(--rune)"></span> Rune</td>
              <td><code>10 sparks</code> <span class="table-extra">+1 per extra step</span></td>
              <td>Plans, builds, tests and fixes autonomously</td>
              <td>up to 8</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="table-footnote" data-reveal>
        A Rune request includes its base steps; each additional agent step beyond them costs 1
        extra Spark, metered live so you always see where you stand.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="limits-title">
    <div class="wrap limits-wrap">
      <p class="eyebrow" data-reveal>The honest part</p>
      <h2 id="limits-title" data-reveal>Limits, plainly stated</h2>
      <div data-reveal data-reveal-delay="120">
        <FAQ items={limitFaq} />
      </div>
    </div>
  </section>
</Base>

<style>
  .plans {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    margin-top: 3rem;
    max-width: 860px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 2.2rem;
  }

  .plan h2 {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }

  .plan-flag {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--violet);
    border: 1px solid rgba(124, 92, 255, 0.45);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    margin: 0;
  }

  .plan-price {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1.4rem;
  }

  .plan-amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--text);
    margin-right: 0.3rem;
  }

  .plan-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    color: var(--muted);
  }

  .plan-list strong {
    color: var(--amber);
  }

  .plan-list li {
    padding-left: 1.4rem;
    position: relative;
  }

  .plan-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--success);
    font-weight: 700;
  }

  .plan-pro .plan-list strong {
    color: var(--violet);
  }

  .plan-cta {
    margin-top: auto;
    justify-content: center;
  }

  .plan-note {
    margin: 1rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }

  .sparks-section {
    background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(255, 180, 84, 0.06), transparent);
  }

  .sparks-section .table-scroll {
    margin-top: 2.4rem;
  }

  .mode-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--mode);
    margin-right: 0.5rem;
    box-shadow: 0 0 8px var(--mode);
    vertical-align: baseline;
  }

  .table-extra {
    color: var(--muted);
    font-size: 0.8rem;
    margin-left: 0.4rem;
  }

  .table-footnote {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.88rem;
    max-width: 44rem;
  }

  .limits-wrap {
    max-width: 780px;
  }
</style>
