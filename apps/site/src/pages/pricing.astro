  }

  .plan-notes {
    gap: 28px 48px;
    margin-top: 56px;
  }

  .plan-notes .plan__note {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
  }

  .note-title {
    display: block;
    margin-bottom: 6px;
    color: var(--ink);
    font-size: 14px;
  }

  .plan__note a,
  .tfoot a,
  .plan__note strong {
    color: var(--ink);
  }

  .plan__note a,
  .tfoot a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .plan__note strong,
  .tfoot strong {
    font-weight: 500;
  }

  .compare-note {
    max-width: 62ch;
    margin: 16px auto 0;
    text-align: center;
  }

  /* A caption under a capability name in the table. It wraps (the sticky header is narrow on a
     phone) and drops the header's weight. */
  .rownote {
    display: block;
    max-width: 34ch;
    margin-top: 5px;
    color: var(--faint);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.45;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (min-width: 760px) {
    .compare th[scope='row'] {
      width: 30%;
      max-width: 34ch;
    }
  }

  .compare__yes {
    color: var(--ink);
  }

  .compare__no {
    color: var(--faint);
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .tfoot {
    max-width: 62ch;
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .limitsec .wrap-narrow-ish {
    width: min(820px, calc(100% - var(--gutter) * 2));
    margin-inline: auto;
  }

  /* THE TWO TABLES STACK ON A PHONE (2026-09-22). Both are 620px wide, and inside a 356px scroll
     box they cut words mid-word at the right edge ("Inspects the pro") and hid the Studio and
     Enterprise columns with no sign they existed. Below 640px each row becomes a block: the row's
     name on top, then every value under the label its column header gave it (`data-label`), so
     nothing is off-screen and nothing needs a sideways scroll. */
  @media (max-width: 640px) {
    .stack-sm {
      overflow: visible;
    }

    .stack-sm table {
      min-width: 0;
    }

    .stack-sm thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .stack-sm tr {
      display: grid;
      gap: 12px 16px;
      padding: 18px;
      border-bottom: 1px solid var(--hairline);
    }

    .stack-sm tbody tr:last-child {
      border-bottom: 0;
    }

    .stack-sm th,
    .stack-sm td {
      display: block;
      padding: 0;
      border: 0;
    }

    .table-scroll.stack-sm table :global(th[scope='row']) {
      position: static;
      max-width: none;
      background: transparent;
    }

    .table-scroll.stack-sm table :global(th[scope='row'])::after {
      content: none;
    }

    .stack-sm td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-body);
      margin-bottom: 3px;
      color: var(--faint);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* The comparison: capability on top, the four plans as a two-by-two grid under it. */
    .compare tr {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .compare :global(th[scope='row']) {
      grid-column: 1 / -1;
    }

    .mode-cell {
      color: var(--ink);
      font-size: 15px;
      font-weight: 500;
    }
  }

  @media (max-width: 960px) {
    .plan-rail {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
      margin-inline: auto;
    }

    .plan-enterprise,
    .plan-notes {
      max-width: 520px;
      margin-inline: auto;
    }

    .plan-notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .plan {
      padding: 22px;
    }

    .plan-enterprise {
      padding: 16px 22px;
    }

    .plan-enterprise a {
      margin-left: 0;
    }
  }
</style>
