---
import Base from '../layouts/Base.astro';
import StudPilotMark from '../components/StudPilotMark.astro';
import { PRODUCT_MODELS, PRODUCT_MODEL_INFO } from '@studpilot/shared';

/*
 * /models — THE ONE ENGINE (V3 gate G01).
 *
 * StudPilot is the only engine: every plan uses it, Free too, and plans differ only in their allowance.
 * The name and the line under it come from the registry in @studpilot/shared (PRODUCT_MODEL_INFO), so
 * this page cannot describe an engine the product does not run. The URL stays so old links land.
 *
 * Copy is short and plain on purpose (D-UX-2): the readers are young and not technical.
 *
 * NOTHING HERE SAYS THE STUDIO PLUGIN CAN BE INSTALLED. It currently cannot (STUDIO_PLUGIN_STORE_LIVE
 * is false), and this page has no reason to mention installing at all.
 */

const engines = PRODUCT_MODELS.map((m) => PRODUCT_MODEL_INFO[m]);
---

<Base
  title="Engine — StudPilot"
  description="StudPilot builds every game you ask for, on every plan, Free too. Every request uses your StudPilot Credits."
>
  <section class="section mhead" aria-labelledby="models-title">
    <div class="wrap">
      <p class="eyebrow">Engine</p>
      <h1 id="models-title" class="carved">One engine builds with you.</h1>
      <p class="lede">
        StudPilot answers every request, on every plan, Free too. Every request uses your StudPilot Credits.
      </p>
    </div>
  </section>

  <section class="section" id="built-in" aria-labelledby="built-in-title">
    <div class="wrap">
      <h2 id="built-in-title" class="mtitle">Built into StudPilot</h2>
      <ul class="builtin" role="list">
        {engines.map((m) => (
          <li class="builtin-card">
            <span class="logo logo--studpilot"><StudPilotMark size={18} /></span>
            <div>
              <p class="mname">{m.name}</p>
              <p class="mblurb">{m.blurb}</p>
              <p class="micro mmeta">Uses StudPilot Credits · Included with every plan, Free too · plans on the <a href="/pricing">pricing page</a></p>
            </div>
          </li>
        ))}
      </ul>

      <a class="btn btn-primary btn-lg mcta" href="/app/signup">Create a free account</a>
    </div>
  </section>
</Base>

<style>
  /* Structure only; every colour is a token from studpilot-minimal.css. No shadow, no glow, no colour
     but ink: the one accent is the site-wide focus ring, which this page does not touch. */
  .mhead {
    padding-top: clamp(48px, 7vw, 96px);
  }

  .mtitle {
    margin: 0 0 20px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.024em;
  }

  .builtin {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .builtin-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 20px;
    border: 1px solid var(--glass-line);
    border-radius: var(--r-lg);
    background: var(--glass-fill);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
  }

  .mname {
    margin: 2px 0 0;
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .mblurb {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .mmeta {
    margin: 12px 0 0;
  }

  .mmeta a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .logo {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--glass-line);
    border-radius: var(--r-xs);
    background: var(--glass-fill);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    color: var(--ink);
  }

  .logo :global(svg) {
    width: 16px;
    height: 16px;
  }

  .mcta {
    margin-top: 40px;
  }

  @media (max-width: 720px) {
    .builtin {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
