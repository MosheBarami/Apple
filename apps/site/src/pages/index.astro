---
import Base from '../layouts/Base.astro';
import GolemStage from '../components/GolemStage.astro';
import GolemMark from '../components/GolemMark.astro';
import PromptForge from '../components/PromptForge.astro';
import HowScroller from '../components/HowScroller.astro';
import StudioProof from '../components/StudioProof.astro';
import BridgeDiagram from '../components/BridgeDiagram.astro';
import ModeLab from '../components/ModeLab.astro';
import SparkMeter from '../components/SparkMeter.astro';
import FAQ from '../components/FAQ.astro';

// Every figure below is traceable: docs/COST-MODEL.md (model, eval score,
// spark costs, quotas) and docs/DECISIONS.md ADR-010 (corpus size, load
// validation, security audit).
const evidence = [
  {
    n: '98.9',
    unit: '/ 100',
    label: 'Roblox eval suite',
    note: 'GLM-5.3-flash, measured — against 96.8 for the model it replaced.',
  },
  {
    n: '8,326',
    unit: 'chunks',
    label: 'Creator docs indexed',
    note: 'Hybrid vector + full-text search the agent calls as a tool.',
  },
  {
    n: '0',
    unit: 'errors',
    label: '20-user concurrency test',
    note: 'Completed with zero inference errors under real load.',
  },
  {
    n: '60',
    unit: 'sparks',
    label: 'Free, every day',
    note: 'No card. No trial countdown. Resets daily.',
  },
];

const faqItems = [
  {
    q: 'What does Golem cost?',
    a: `<p>Golem is free. Every account gets <strong>60 Sparks per day</strong> — a real building session across all three modes. A Pro plan (400 Sparks/day, priority queue) is designed and on the <a href="/pricing">waitlist</a>. No payment is collected at v1, so there is no card to give and no trial clock running.</p>`,
  },
  {
    q: 'Is my project safe?',
    a: `<p>Yes, in two senses. Golem wraps every batch of changes in a native Studio undo waypoint, so <kbd>Ctrl</kbd>+<kbd>Z</kbd> works exactly as you expect, and it takes a checkpoint before every agent run so you can roll back a whole session. And your project data — scripts, chat, checkpoints — is never used to train models. See <a href="/docs/privacy-and-data">privacy &amp; data</a>.</p>`,
  },
  {
    q: 'What can Golem actually build?',
    a: `<p>Anything that lives in a Roblox place: obby sections, lobbies, shops, round systems, leaderboards, NPC logic, UI, terrain touches. It reads your project tree, writes and edits Luau, creates and configures instances, then verifies its work by running your game in Studio. It is strongest at gameplay scripting and scene assembly, and it will tell you honestly when a request is out of reach.</p>`,
  },
  {
    q: 'Does it work with my existing project?',
    a: `<p>Yes — that is the whole point. Golem does not generate a throwaway starter place. It connects to whatever place you have open in Studio, learns its structure, and makes surgical changes inside it. Ten thousand lines of existing Luau is a normal Tuesday.</p>`,
  },
  {
    q: 'Do I need to install anything?',
    a: `<p>One thing: the <a href="/docs/plugin">Golem for Studio plugin</a>, a standard <code>.rbxm</code> local plugin. It pairs with your web session using a short-lived code and talks to Golem over HTTPS. No executable, no system access, nothing outside Studio.</p>`,
  },
  {
    q: 'Which model is behind it?',
    a: `<p><code>GLM-5.3-flash</code>, running server-side on Cloudflare Workers AI — one model behind every mode, with a 1M-token context window, native tool calling and vision. The choice was made by measurement, not taste: it scored 98.9 on our Roblox eval suite against 96.8 for the model it replaced, and costs less per token. Retrieval over the Roblox creator docs stayed an <em>agent-invoked tool</em> rather than automatic prompt-stuffing, because forced injection measured worse.</p>`,
  },
  {
    q: 'What are the three modes for?',
    a: `<p><strong>Clay</strong> (1 spark) answers questions and makes small edits fast. <strong>Stone</strong> (4 sparks) builds features across multiple scripts and instances. <strong>Rune</strong> (10 sparks, +1 per extra step) plans, builds, playtests and fixes autonomously until the thing works. Pick the smallest golem that can carry the job — <a href="/docs/modes">mode guide</a>.</p>`,
  },
];
---

<Base
  title="Golem — Describe it. Golem builds it."
  description="Golem is the AI builder for Roblox. Describe what you want in plain language and Golem builds it inside Roblox Studio — real scripts, real instances, native undo, verified by running your game."
>
  <!-- ==================================================== hero -->
  <section class="hero is-ember" aria-labelledby="hero-title">
    <div class="sheet-rails" aria-hidden="true"></div>

    <div class="wrap">
      <div class="hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">AI builder for Roblox Studio</p>

          <h1 id="hero-title" class="hero__title kinetic carved">
            <span><span style="--i:0">Describe</span></span>
            <span><span style="--i:1">it.</span></span>
            <br />
            <span class="hero__accent"><span style="--i:2">Golem</span></span>
            <span class="hero__accent"><span style="--i:3">builds</span></span>
            <span class="hero__accent"><span style="--i:4">it.</span></span>
          </h1>

          <p class="lede hero__lede">
            Tell it what you want in plain language. Golem reads your project,
            writes the Luau, wires the instances — inside the Roblox Studio you
            already use — then presses Play to prove it works.
          </p>

          <div class="hero__ctas">
            <a href="/app" class="btn btn-primary btn-lg" data-cursor-label="free">
              Start building — free
            </a>
            <a href="/docs/plugin" class="btn btn-ghost btn-lg">
              Install the Studio plugin
            </a>
          </div>

          <p class="hero__fine mono">
            60 free Sparks a day · no card, ever · works in the project you
            already have
          </p>
        </div>

        <div class="hero__stage">
          <GolemStage state="listening" mode="stone" />
        </div>
      </div>

      <div class="hero__forge" data-reveal data-reveal-delay="120">
        <p class="hero__forgecap mono">
          <span class="hero__forgeline" aria-hidden="true"></span>
          Try it right here — pick a mode, press Build
        </p>
        <PromptForge />
      </div>
    </div>
  </section>

  <!-- ==================================================== evidence -->
  <section class="section section--tight evidence" aria-label="Measured facts">
    <div class="wrap">
      <ul class="evidence__grid">
        {
          evidence.map((e, i) => (
            <li class="evidence__item" data-reveal data-reveal-delay={i * 90}>
              <p class="evidence__n">
                {e.n}
                <span class="evidence__unit mono">{e.unit}</span>
              </p>
              <p class="evidence__label">{e.label}</p>
              <p class="evidence__note">{e.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <hr class="rule" />

  <!-- ==================================================== how -->
  <section class="section" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>How it works</p>
        <h2 id="how-title" data-reveal class="carved">
          One sentence in. A working game out.
        </h2>
        <p class="lede lede-wide" data-reveal>
          You stay in the creative seat. Golem does the stonework — and then
          shows you the receipts.
        </p>
      </header>

      <HowScroller />
    </div>
  </section>

  <!-- ==================================================== proof -->
  <section class="section proofsec" id="proof" aria-labelledby="proof-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Evidence</p>
        <h2 id="proof-title" data-reveal class="carved">
          Not a demo video. The actual output.
        </h2>
        <p class="lede lede-wide" data-reveal>
          One Stone run, from three angles: what changed in your DataModel, the
          Luau it wrote, and the Studio output that proved it works.
        </p>
      </header>

      <div data-reveal data-reveal-delay="120">
        <StudioProof />
      </div>
    </div>
  </section>

  <!-- ==================================================== bridge -->
  <section class="section" id="bridge" aria-labelledby="bridge-title">
    <div class="wrap">
      <div class="bridgesec">
        <header class="bridgesec__head">
          <p class="eyebrow" data-reveal>The bridge</p>
          <h2 id="bridge-title" data-reveal class="carved">
            Real Studio.<br />No sandbox.
          </h2>
          <p class="lede" data-reveal>
            Golem is not a snippet generator or a walled-garden editor. A Luau
            plugin sits inside the Studio you already use and executes typed
            operations on the place you already have.
          </p>
          <p class="bridgesec__hint mono" data-reveal>
            Pick a node to see what it does
          </p>
        </header>

        <div class="bridgesec__diagram" data-reveal data-reveal-delay="120">
          <BridgeDiagram />
        </div>
      </div>

      <ul class="guarantees">
        <li data-reveal>
          <h3>Native undo</h3>
          <p>
            Every batch of changes is one <code>ChangeHistoryService</code>
            waypoint. <kbd>Ctrl</kbd>+<kbd>Z</kbd> behaves exactly as it always
            has.
          </p>
        </li>
        <li data-reveal data-reveal-delay="90">
          <h3>Checkpoints &amp; rollback</h3>
          <p>
            An automatic checkpoint before every agent run, manual ones whenever
            you like, restorable across sessions.
          </p>
        </li>
        <li data-reveal data-reveal-delay="180">
          <h3>Reads before it writes</h3>
          <p>
            It snapshots your project tree and searches your existing scripts
            before touching anything — surgical changes, not regeneration.
          </p>
        </li>
        <li data-reveal data-reveal-delay="270">
          <h3>Honest when stuck</h3>
          <p>
            Golem is banned from guessing Creator Store asset ids and refuses
            duplicate tool calls — two behaviours found by running it against
            real Studio, and fixed.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ==================================================== modes -->
  <section class="section modesec" id="modes" aria-labelledby="modes-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Modes</p>
        <h2 id="modes-title" data-reveal class="carved">
          Three golems. One chisel each.
        </h2>
        <p class="lede lede-wide" data-reveal>
          Every request wakes a golem sized for the job. The craft of using
          Golem well is picking the smallest one that can carry it.
        </p>
      </header>

      <div data-reveal data-reveal-delay="120">
        <ModeLab />
      </div>
    </div>
  </section>

  <!-- ==================================================== sparks -->
  <section class="section" id="sparks" aria-labelledby="sparks-title">
    <div class="wrap">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Sparks</p>
        <h2 id="sparks-title" data-reveal class="carved">
          Will the free plan actually cover you?
        </h2>
        <p class="lede lede-wide" data-reveal>
          Move the sliders to your real day. The maths is the product's own —
          and so is the part where we show you what it costs us to run.
        </p>
      </header>

      <div data-reveal data-reveal-delay="120">
        <SparkMeter />
      </div>

      <p class="sparks__more" data-reveal>
        <a href="/pricing">See the full plan comparison →</a>
      </p>
    </div>
  </section>

  <!-- ==================================================== trust -->
  <section class="trust" aria-labelledby="trust-title">
    <div class="wrap trust__inner" data-reveal>
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 2.4 20 6.2v5c0 5.5-3.4 9.4-8 11-4.6-1.6-8-5.5-8-11v-5Z"
          stroke="currentColor"
          stroke-width="1.6"
          fill="none"></path>
        <path
          d="M8.4 12.1 10.9 14.7 15.6 9.5"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
      </svg>
      <div>
        <h2 id="trust-title">Your projects stay yours. Never trained on.</h2>
        <p>
          Private project data is private, full stop. The service holds no
          auth secrets of its own, scopes every query to your own verified
          session, and shipped after an adversarial security audit with twelve
          fixes verified against the live system.
          <a href="/docs/privacy-and-data">Read the details</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================== faq -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faqsec">
      <header class="sechead">
        <p class="eyebrow" data-reveal>Questions</p>
        <h2 id="faq-title" data-reveal class="carved">Asked before you asked</h2>
      </header>
      <div data-reveal data-reveal-delay="90">
        <FAQ items={faqItems} />
      </div>
    </div>
  </section>

  <!-- ==================================================== CTA -->
  <section class="section cta" aria-labelledby="cta-title">
    <div class="wrap cta__inner" data-reveal>
      <span class="cta__mark"><GolemMark size={64} /></span>
      <h2 id="cta-title" class="carved">The golem is waiting for its words.</h2>
      <p class="lede">
        Describe your first build. It costs nothing to find out what happens
        next.
      </p>
      <div class="cta__btns">
        <a href="/app" class="btn btn-primary btn-lg">Start building — free</a>
        <a href="/docs/getting-started" class="btn btn-ghost btn-lg">
          Read the guide
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------- hero */
  .hero {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 7vw, 5.5rem);
    overflow: clip;
  }

  /* the lit workbench behind the golem */
  .hero::before {
    content: '';
    position: absolute;
    top: -12%;
    right: -6%;
    width: min(62vw, 780px);
    aspect-ratio: 1 / 1;
    background: radial-gradient(
      circle at 50% 50%,
      var(--accent-soft),
      transparent 65%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .hero__title {
    font-size: clamp(2.9rem, 7.4vw, 5.6rem);
    margin-bottom: 1.1rem;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lede {
    max-width: 42ch;
    font-size: clamp(1.05rem, 1.55vw, 1.24rem);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__fine {
    margin-top: 1.1rem;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
  }

  .hero__forge {
    position: relative;
    z-index: 1;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .hero__forgecap {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }

  .hero__forgeline {
    width: 26px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
    flex: none;
  }

  @media (max-width: 940px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hero__stage {
      order: -1;
      max-width: 320px;
      margin-inline: auto;
      width: 100%;
    }

    .hero__lede {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .hero {
      padding-top: 0.75rem;
    }

    .hero__grid {
      gap: 0.75rem;
    }

    .hero__stage {
      max-width: 228px;
    }

    .hero__ctas {
      margin-top: 1.5rem;
    }

    .hero__ctas .btn {
      flex: 1 1 100%;
    }
  }

  /* ------------------------------------------------------ evidence */
  .evidence__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .evidence__item {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .evidence__n {
    font-family: var(--font-body);
    font-variation-settings: normal;
    font-variant-numeric: tabular-nums;
    font-weight: 620;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: 0 0 0.45rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .evidence__unit {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .evidence__label {
    margin: 0 0 0.3rem;
    font-weight: 570;
    font-size: 0.93rem;
    color: var(--ink);
  }

  .evidence__note {
    margin: 0;
    font-size: 0.83rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .evidence__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .evidence__grid {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }

  /* -------------------------------------------------- section heads */
  .sechead {
    max-width: 60ch;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .sechead h2 {
    margin-bottom: 0.55rem;
  }

  /* ------------------------------------------------------- proof */
  .proofsec {
    background:
      radial-gradient(
        ellipse 60% 55% at 15% 0%,
        var(--accent-soft),
        transparent 70%
      ),
      var(--paper-2);
    border-block: 1px solid var(--line);
  }

  /* ------------------------------------------------------ bridge */
  .bridgesec {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .bridgesec__head h2 {
    font-size: clamp(1.9rem, 4vw, 3rem);
  }

  .bridgesec__hint {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 1.2rem 0 0;
  }

  .guarantees {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .guarantees li {
    border-top: 2px solid var(--accent);
    padding-top: 1rem;
  }

  .guarantees h3 {
    font-size: 1.02rem;
    margin-bottom: 0.4rem;
  }

  .guarantees p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 980px) {
    .bridgesec {
      grid-template-columns: 1fr;
    }

    .guarantees {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .guarantees {
      grid-template-columns: 1fr;
    }
  }

  /* ------------------------------------------------------- modes */
  .modesec {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }

  /* ------------------------------------------------------ sparks */
  .sparks__more {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
  }

  /* ------------------------------------------------------- trust */
  .trust {
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--good) 7%, var(--paper));
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
  }

  .trust__inner {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    color: var(--good);
  }

  .trust__inner svg {
    flex: none;
    margin-top: 0.2rem;
  }

  .trust h2 {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    margin: 0 0 0.35rem;
    color: var(--ink);
  }

  .trust p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    max-width: 76ch;
  }

  /* --------------------------------------------------------- faq */
  .faqsec {
    max-width: 820px;
  }

  /* --------------------------------------------------------- cta */
  .cta {
    text-align: center;
    background:
      radial-gradient(
        ellipse 55% 80% at 50% 110%,
        var(--accent-soft),
        transparent 70%
      ),
      var(--paper);
    border-top: 1px solid var(--line);
  }

  .cta__mark {
    display: inline-flex;
    margin-bottom: 1.1rem;
    opacity: 0.9;
  }

  .cta__inner h2 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
  }

  .cta__inner .lede {
    margin-inline: auto;
  }

  .cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
