                    <canvas class="gm-canvas" role="img" data-cursor="drag" data-cursor-label="turn" aria-label="A low-polygon mesh drawn as a wireframe, turning slowly."></canvas>
                    {/* The still frame. It is real markup rather than a <noscript>, because the
