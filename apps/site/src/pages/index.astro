---
import BuildStage from '../components/BuildStage.astro';

/**
 * The library, as figures somebody could check rather than adjectives.
 *
 * These are counts from packages/corpus/data/library — the harvest's own totals — and they are
 * written here as literals on purpose: a landing page that queried a live database to render a
 * number would be a landing page that can fail to render. They move when the harvest moves, and
 * scripts/check-proof-figures.mjs recomputes each one from the file its `from`
 * pointer names, and runs in the gate suite. An earlier version of this comment named
 * a test that had never been written.
 */
const proof = [
  { n: '510,979', what: 'assets, every licence recorded', from: 'library.total' },
  { n: '81,311', what: 'usable with no upload at all', from: 'library.withRobloxId' },
  //[[ WAS "3,017 game templates, checked against current Roblox APIs". Both halves were false.
  //
  //   3,017 is what a GitHub search over Roblox topics returned. It contains rojo, StyLua,
  //   roblox-ts, a Rust CSV tool and a Bee Swarm Simulator macro — tooling and cheats, not game
  //   templates. Nothing in this repository curates it into templates, so the noun was a claim
  //   about work nobody has done.
  //
  //   And the API check the label attached to all 3,017 is recorded by the harvest for 300.
  //   MY OWN FIRST REPLACEMENT SAID "free of removed APIs" over 1,034 and the new guard rejected
  //   it, which is the guard earning its place: the harvester's `usable` flag ANDs in
  //   `removed.length === 0`, and for the 2,717 repositories whose code was never read `removed`
  //   is empty because nothing looked — not because nothing was found.
  //
  //   What is true of all 1,034: not archived, and carrying a licence that is not NOASSERTION. ]]
  { n: '1,034', what: 'community Roblox projects, each with a licence on record', from: 'templates.usable' },
];

/**
 * THE WALL. Real rows out of the real library, with the provenance a competitor cannot show.
 *
 * The owner's complaint was that this site says it has a library and never shows one — not what
 * the assets look like, not where they came from. Every card below is a row in
 * packages/corpus/data/library, and it carries the name, the kind, the pack, the licence and the
 * author, because that last pair is the whole point: rival sites illustrate themselves with
 * generated art for games that do not exist, and generated art has no author to name.
 *
 * WRITTEN AS LITERALS, for the same reason `proof` above is. A landing page that queried D1 to
 * fill this wall would be a landing page that can fail to render, and a wall is not worth a blank
 * page. scripts/build-asset-wall.mjs derives these rows from the harvest, verifies every preview
 * is really an image, copies it into apps/site/public/library, and splices the result in below.
 * Re-run it; do not hand-edit between the markers.
 *
 * WHAT IS DELIBERATELY ABSENT: the Creator Store rows, which are the overwhelming majority of the
 * live table and are 2008-era user uploads and anime rips — `Bakiiiiiiiiiiiiiiii`, `Part2`,
 * `diediedieDIELess`. They are in the library and they are in the counts above; putting them on
 * this wall would have demonstrated the complaint instead of answering it.
 *
 * `img: null` IS A REAL STATE, not an oversight. `Slime` is published as a 125x225 filmstrip, so
 * there is no picture of the one asset; its card says what it is and says there is no preview.
 * The route ships no JavaScript, so a broken <img> could not be swapped out at runtime — which is
 * exactly why nothing here is allowed to be a broken <img>.
 */
const wall = [
  /* wall:begin — generated by scripts/build-asset-wall.mjs, do not hand-edit */
  { id: "kenney/pirate-kit/previews/chest", name: "Chest", kind: "prop", pack: "Pirate Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-pirate-kit-previews-chest.png" },
  { id: "kenney/pirate-kit/previews/cannon", name: "Cannon", kind: "prop", pack: "Pirate Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-pirate-kit-previews-cannon.png" },
  { id: "kenney/mini-dungeon/previews/character-orc", name: "Character Orc", kind: "character", pack: "Mini Dungeon", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-mini-dungeon-previews-character-orc.png" },
  { id: "kenney/mini-dungeon/previews/coin", name: "Coin", kind: "prop", pack: "Mini Dungeon", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-mini-dungeon-previews-coin.png" },
  { id: "kenney/car-kit/previews/ambulance", name: "Ambulance", kind: "vehicle", pack: "Car Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-car-kit-previews-ambulance.png" },
  { id: "kenney/car-kit/previews/taxi", name: "Taxi", kind: "vehicle", pack: "Car Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-car-kit-previews-taxi.png" },
  { id: "kenney/car-kit/previews/tractor", name: "Tractor", kind: "vehicle", pack: "Car Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-car-kit-previews-tractor.png" },
  { id: "kenney/castle-kit/previews/bridge-draw", name: "Bridge Draw", kind: "building", pack: "Castle Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-castle-kit-previews-bridge-draw.png" },
  { id: "kenney/survival-kit/previews/tent", name: "Tent", kind: "prop", pack: "Survival Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-survival-kit-previews-tent.png" },
  { id: "kenney/survival-kit/previews/barrel", name: "Barrel", kind: "prop", pack: "Survival Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-survival-kit-previews-barrel.png" },
  { id: "kenney/food-kit/previews/burger", name: "Burger", kind: "prop", pack: "Food Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-food-kit-previews-burger.png" },
  { id: "kenney/food-kit/previews/pineapple", name: "Pineapple", kind: "prop", pack: "Food Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-food-kit-previews-pineapple.png" },
