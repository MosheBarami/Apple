  { id: "kenney/graveyard-kit/previews/coffin", name: "Coffin", kind: "prop", pack: "Graveyard Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-graveyard-kit-previews-coffin.png" },
  { id: "kenney/mini-arcade/previews/arcade-machine", name: "Arcade Machine", kind: "prop", pack: "Mini Arcade", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-mini-arcade-previews-arcade-machine.png" },
  { id: "kenney/mini-arcade/previews/claw-machine", name: "Claw Machine", kind: "prop", pack: "Mini Arcade", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-mini-arcade-previews-claw-machine.png" },
  { id: "kenney/retro-fantasy-kit/previews/tower", name: "Tower", kind: "building", pack: "Retro Fantasy Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-retro-fantasy-kit-previews-tower.png" },
  { id: "kenney/city-kit-roads/previews/traffic-light", name: "Traffic Light", kind: "prop", pack: "City Kit (Roads)", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-city-kit-roads-previews-traffic-light.png" },
  { id: "kenney/mini-arena/previews/trophy", name: "Trophy", kind: "prop", pack: "Mini Arena", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-mini-arena-previews-trophy.png" },
  { id: "kenney/mini-market/previews/cash-register", name: "Cash Register", kind: "prop", pack: "Mini Market", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-mini-market-previews-cash-register.png" },
  { id: "kenney/watercraft-kit/previews/boat-fishing-small", name: "Boat Fishing Small", kind: "vehicle", pack: "Watercraft Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-watercraft-kit-previews-boat-fishing-small.png" },
  { id: "kenney/platformer-kit/previews/crate", name: "Crate", kind: "prop", pack: "Platformer Kit", source: "Kenney", licence: "CC0-1.0", author: "Kenney", img: "/library/kenney-platformer-kit-previews-crate.png" },
  { id: "game_icons/lorc/broadsword", name: "broadsword", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "lorc", img: "/library/game-icons-lorc-broadsword.png" },
  { id: "game_icons/lorc/campfire", name: "campfire", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "lorc", img: "/library/game-icons-lorc-campfire.png" },
  { id: "game_icons/lorc/crossed-swords", name: "crossed swords", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "lorc", img: "/library/game-icons-lorc-crossed-swords.png" },
  { id: "game_icons/lorc/wizard-staff", name: "wizard staff", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "lorc", img: "/library/game-icons-lorc-wizard-staff.png" },
  { id: "game_icons/delapouite/health-potion", name: "health potion", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "delapouite", img: "/library/game-icons-delapouite-health-potion.png" },
  { id: "game_icons/delapouite/checkered-flag", name: "checkered flag", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "delapouite", img: "/library/game-icons-delapouite-checkered-flag.png" },
  { id: "game_icons/willdabeast/round-shield", name: "round shield", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "willdabeast", img: "/library/game-icons-willdabeast-round-shield.png" },
  { id: "game_icons/sbed/key", name: "key", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "sbed", img: "/library/game-icons-sbed-key.png" },
  { id: "game_icons/zeromancer/heart-plus", name: "heart plus", kind: "ui_icon", pack: "game-icons.net", source: "game-icons.net", licence: "CC-BY-3.0", author: "zeromancer", img: "/library/game-icons-zeromancer-heart-plus.png" },
  { id: "cgbookcase/texture/brick-wall-04", name: "Brick Wall 04", kind: "texture", pack: "cgbookcase.com", source: "cgbookcase.com", licence: "CC0-1.0", author: "cgbookcase", img: "/library/cgbookcase-texture-brick-wall-04.png" },
  { id: "cgbookcase/texture/cobblestone-wall-01", name: "Cobblestone Wall 01", kind: "texture", pack: "cgbookcase.com", source: "cgbookcase.com", licence: "CC0-1.0", author: "cgbookcase", img: "/library/cgbookcase-texture-cobblestone-wall-01.png" },
  { id: "cgbookcase/texture/mossy-wall-02", name: "Mossy Wall 02", kind: "texture", pack: "cgbookcase.com", source: "cgbookcase.com", licence: "CC0-1.0", author: "cgbookcase", img: "/library/cgbookcase-texture-mossy-wall-02.png" },
  { id: "cgbookcase/texture/rusty-metal-panel-01", name: "Rusty Metal Panel 01", kind: "texture", pack: "cgbookcase.com", source: "cgbookcase.com", licence: "CC0-1.0", author: "cgbookcase", img: "/library/cgbookcase-texture-rusty-metal-panel-01.png" },
  { id: "cgbookcase/texture/marble-05", name: "Marble 05", kind: "texture", pack: "cgbookcase.com", source: "cgbookcase.com", licence: "CC0-1.0", author: "cgbookcase", img: "/library/cgbookcase-texture-marble-05.png" },
  { id: "opengameart/10-spaceships/spaceship-1", name: "Spaceship 1", kind: "vehicle", pack: "10 Spaceships", source: "OpenGameArt", licence: "CC0-1.0", author: "VeiaG", img: "/library/opengameart-10-spaceships-spaceship-1.png" },
  { id: "opengameart/10-spaceships/spaceship-4", name: "Spaceship 4", kind: "vehicle", pack: "10 Spaceships", source: "OpenGameArt", licence: "CC0-1.0", author: "VeiaG", img: "/library/opengameart-10-spaceships-spaceship-4.png" },
  { id: "opengameart/16px-sword-and-shield/sword-0", name: "Sword 0", kind: "ui_icon", pack: "16px sword and shield", source: "OpenGameArt", licence: "CC0-1.0", author: "qubodup", img: "/library/opengameart-16px-sword-and-shield-sword-0.png" },
  { id: "opengameart/25x25-slime-animation/slime", name: "Slime", kind: "ui_icon", pack: "25x25 Slime animation", source: "OpenGameArt", licence: "CC0-1.0", author: "Min", img: null },
  /* wall:end */
];

/* Three rows drifting at three speeds. Dealt round-robin rather than sliced, so each row carries
   every source instead of one row of Kenney and one row of icons — and because a round-robin over
   the whole array is a partition, which is what keeps the heading's count honest. */
const wallRows = [0, 1, 2].map((r) => wall.filter((_, i) => i % 3 === r));

/**
 * The landing page. Six sections, ZERO JavaScript on the route.
 *
 * SUPERSEDES "one viewport, no scroll". This page used to hold the whole
 * proposition in a single frame, with how-it-works and pricing deliberately
 * moved off it onto real routes. The owner's design brings them back as
 * sections — hero, product, library, modes, how it works, pricing — and
 * docs/DECISIONS.md ADR-020 records that call with the artifact it came from.
 * docs/DESIGN-SPEC.md §0–§1 is updated to match.
 *
 * THE LIBRARY SECTION IS NOT IN THAT DESIGN. It answers a separate complaint —
 * that the site claims a library and never shows one — and it is the reason
 * the landing payload budget moved from 12,000 to 16,000 B gzip. The
 * arithmetic for that is written into scripts/check-landing-budget.mjs.
 *
 * WHAT DID NOT CHANGE, and is the reason this file still exists apart from
 * Base.astro: the route ships no JavaScript. Every animation is CSS, every
 * layout is intrinsic, the type is one webfont request, and the composer
 * panel in §2 is a still frame rather than the animated one in the design.
 *
 * THE NAV POINTS AT ANCHORS AGAIN, which the previous version of this file
 * forbade in as many words: links "point at real routes, never at /#anchor,
 * because the sections those anchors named do not exist". They exist now.
 * That rule was a proxy for the real one — no destination may be dead — and
 * tests/e2e/landing.spec.ts now asserts the real one directly: a route has to
 * answer 200, and an anchor has to name an element that is actually on the
 * page. That is strictly more than the ban checked.
 *
 * THREE PLACES WHERE THIS DEPARTS FROM THE DESIGN, each because the design
 * states something the product cannot keep. They are recorded here rather
 * than in a commit message because the next person to compare page against
 * artifact will notice the difference and need the reason:
 *
 *   1. The design's models section is titled "Two models". There is one
 *      authoring model — apps/worker/src/router.ts routes every authoring
 *      mode to the same one — and what actually differs is how much work the
 *      mode does. The design's OWN lede, "Same builder, two settings", is
 *      exactly right; only the eyebrow overclaims. So the eyebrow says Modes,
 *      the count says three, and everything else is the design's copy.
 *   2. The design's free tier reads "Apple model only". A plan-conditional
 *      model entitlement has no code path in gateway.ts, so publishing it
 *      would advertise a restriction nothing enforces and a capability
 *      nothing withholds.
 *   3. The design counts in "credits". This product counts in Credits, and
 *      "credits" already means something else here — the purchased,
 *      non-expiring balance. Two meanings for one word on the page that
 *      introduces the unit is how a reader ends up budgeting wrong.
 *
 * Every figure below is READ from packages/shared, never typed. That is what
 * scripts/check-offer.mjs exists to keep true.
 */
import Landing from '../layouts/Landing.astro';
import AppleMark from '../components/AppleMark.astro';
import AssetCard from '../components/AssetCard.astro';
import { PLAN_COPY, PLAN_LIMITS, PRICE_CURRENCY, CREDITS_PER_BUILD, buildsPerMonth, formatMoney } from '@golem/shared';
import { STUDIO_PLUGIN_INSTALL_HREF, STUDIO_PLUGIN_STORE_LIVE } from '../lib/studio-plugin';

/** Nav. Five anchors at sections that exist on this page, and one real route. */
const navLinks = [
  { href: '#product', label: 'Product' },
  { href: '#library', label: 'Library' },
  { href: '#modes', label: 'Modes' },
  { href: '#how', label: 'How it works' },
  { href: '#pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
];

/** Example prompts. Phrased as prompts, and labelled as examples, because a
 *  row of chips under a hero reads as "things people are doing" — which would
 *  be an adoption claim, and Apple has no adoption to claim yet. */
const prompts = [
  'Build a shop UI',
  'Create claimable plots',
  'Add timed rounds',
  'A teleport portal',
];

/** The still frame. An EXAMPLE run, named as one in the copy and in the
 *  panel's accessible name: object counts and a place name presented without
 *  that label are a reader's own data as far as the reader can tell. */
const runSteps = [
  { what: 'Read the lobby', got: '41 objects' },
  { what: 'Built frame, ring and light', got: '3 parts' },
  { what: 'Weighed two teleport strategies', got: 'picked one' },
  { what: 'Wrote PortalTeleport.server.luau', got: '1 script' },
  { what: 'Ran a playtest — the teleport fires', got: 'passed' },
];

/**
 * The modes, in the product's public vocabulary.
 *
 * §15.3 and packages/shared both hold that Clay, Stone and Rune "are internal
 * specialist identities, not user-facing brands", and check-site-semantics
 * fails the build if one reaches visible copy. The public names are these.
 *
 * The Credit costs are the same ones apps/site/src/pages/pricing.astro derives
 * from docs/COST-MODEL.md through the worker's own arithmetic, and
 * scripts/check-credit-figures.mjs now reads this file too, so they cannot
 * drift from it quietly.
 */
const modes = [
  {
    name: 'Plan',
    tag: '2 credits',
    body:
      'The default. Answers in a couple of seconds and handles the great majority of asking — ' +
      'what is in the place, how something works, what a change would touch.',
    does: ['Reads your place', 'Answers and explains', 'Changes nothing on its own'],
  },
  {
    name: 'Agent',
    tag: '4 credits',
    body:
      'Building and editing. Parts, props, single scripts, and changes to what is already ' +
      'there — each step named while it happens, and stoppable mid-run.',
    does: ['Builds and edits geometry', 'Single-file scripts', 'Checkpoint before every change'],
    featured: true,
  },
  {
    name: 'Super Agent',
    tag: '10 credits',
    body:
      'For the things that touch everything. It reads more of your place first, weighs ' +
      'alternatives, and shows you the ones it rejected before it commits.',
    does: [
      'Multi-file systems and refactors',
      'Shows the options it rejected',
      'Pauses for your call on overwrites',
    ],
  },
];

/**
 * How it works.
 *
 * Step one is NOT the design's "One click in Studio". The plugin asset is
 * uploaded but not distributable — STUDIO_PLUGIN_STORE_LIVE is false and
 * toolbox-service 404s for it — so "one click" describes a trip that does not
 * work yet. The landing e2e fails on that exact phrase for that exact reason.
 */
const steps = [
  {
    n: '01',
    title: 'Connect Studio',
    body:
      'Install the Apple plugin and pair it with the place you have open. Apple can then read ' +
      'and write that place, and nothing else.',
  },
  {
    n: '02',
    title: 'Say what you want',
    body:
      'Plain sentences. Apple names each step as it works, and stops the moment you tell it to.',
  },
  {
    n: '03',
    title: 'Playtest and keep going',
    body:
      'Every run leaves a checkpoint, so trying something risky costs you nothing but the time.',
  },
];

/* The self-serve plans, read from the shared table. Enterprise is deliberately
   not a card: a plan whose limits are negotiated cannot carry a price tag, and
   a fourth column that says "contact us" is the one nobody reads. It is a line
   under the grid instead, pointing at the page that has the whole table. */
const plans = (['free', 'builder', 'studio'] as const).map((id) => ({
  id,
  name: PLAN_COPY[id].name,
  price: PLAN_COPY[id].priceUsdMonthly,
  credits: PLAN_LIMITS[id].creditsPerMonth,
  builds: buildsPerMonth(id),
  blurb: PLAN_COPY[id].blurb,
  cta: id === 'free' ? 'Start free' : `Get ${PLAN_COPY[id].name}`,
  featured: id === 'builder',
}));
---

<Landing
  title="Apple — It builds inside the Roblox place you already have open"
  description="Apple is an AI that works inside Roblox Studio: it writes Luau, places instances, and runs your game to check the change. Every edit lands on Studio's own undo stack, and every asset it uses carries a recorded licence."
>
  <a href="#main" class="skip-link">Skip to content</a>

  {/* ------------------------------------------------------------ header -- */}
  <header class="ap-header">
    <a href="/" class="ap-wordmark" aria-label="Apple — home">
      <AppleMark size={26} />
      <span>Apple</span>
    </a>

    <nav class="ap-nav" aria-label="Primary">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="ap-header__end">
      <a href="/app/login" class="ap-btn ap-btn--sm ap-sign-in">Sign in</a>
      <a href="/app/signup" class="ap-btn ap-btn--primary ap-btn--sm">Start building</a>
    </div>
  </header>

  <main id="main">
    {/* ---------------------------------------------------------- hero -- */}
    <section class="ap-hero" id="top" aria-labelledby="hero-title">
      <div class="ap-hero__inner">
        <p class="ap-badge ap-in">
          <span class="ap-badge__dot" aria-hidden="true"></span>
          Works inside Roblox Studio
        </p>

        <h1 class="ap-display ap-in" id="hero-title">
          <span class="ap-hero__l1">It works inside the place</span>
          <span class="ap-hero__l2">you already have open.</span>
        </h1>

        <p class="ap-hero__sub ap-in">
          Apple writes the scripts, builds the parts and wires the systems directly into the place
          you have open in Studio. Ask for a shop, get a working shop.
        </p>

        <div class="ap-hero__cta ap-in">
          <a href="/app/signup" class="ap-btn ap-btn--primary ap-btn--lg">Start building — free</a>
          {/* Destination comes from packages/shared, never retyped, and it is
              deliberately NOT the bare store URL: the asset is uploaded but not
              distributable, so sending a reader straight to the store hands
              them a page with nothing to get and no explanation. While
              STUDIO_PLUGIN_STORE_LIVE is false this points at /docs/plugin,
              which says plainly that it is not published yet (ADR-017
              decision 3). It becomes the store link, in a new tab, the moment
              that constant flips — hence the conditional target. */}
          <a
            href={STUDIO_PLUGIN_INSTALL_HREF}
            class="ap-btn ap-btn--lg"
            target={STUDIO_PLUGIN_STORE_LIVE ? '_blank' : undefined}
            rel={STUDIO_PLUGIN_STORE_LIVE ? 'noopener noreferrer' : undefined}
          >
            Install for Studio
          </a>
        </div>

        <p class="ap-hero__note ap-mono ap-in">
          Free to start <span aria-hidden="true">·</span> No card required
          <span aria-hidden="true">·</span> Works in your project
        </p>

        <div class="ap-chips ap-in" role="group" aria-label="Example prompts">
          {prompts.map((p) => <span class="ap-chip">{p}</span>)}
        </div>

        {/* The product, running, rather than a sentence about it. Measured on the leading
            competitor: zero canvas and zero video elements on every page of their site. */}
        <div class="ap-hero__stage ap-in">
          <BuildStage />
        </div>

        {/* PROOF, NOT ADJECTIVES. Every figure here is one a reader could go and check, which is
            the one thing the competitor does better than anyone in this category — real logos,
            real counts, and a subscriber number they chose to show at an unflattering 289. */}
        <ul class="ap-proof ap-in" aria-label="What is in the library">
          {proof.map((p) => (
            <li class="ap-proof__item">
              <span class="ap-proof__n ap-mono">{p.n}</span>
              <span class="ap-proof__what">{p.what}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ------------------------------------------------------- product -- */}
    <section class="ap-section ap-section--seam" id="product" aria-labelledby="product-title">
      <div class="ap-section__inner">
        <p class="ap-eyebrow"><span class="ap-eyebrow__dot" aria-hidden="true"></span>The product</p>
        <h2 class="ap-display" id="product-title">Every step named, and a stop button.</h2>
        <p class="ap-lede">
          Apple reads your place before it touches it, takes a checkpoint, then works. Every step
          is named while it happens, and you can stop it mid-run. Below is one finished run,
          shown exactly as the transcript leaves it.
        </p>

        <div class="ap-demo">
          <div class="ap-panel" role="group" aria-label="Example run — not your data">
            <div class="ap-panel__bar">
              <span class="ap-panel__name">Neon Arena</span>
              <span class="ap-panel__sub">lobby portal · run 4 · example</span>
              <span class="ap-panel__end">
                <span class="ap-live">
                  <span class="ap-live__dot" aria-hidden="true"></span>
                  Studio connected
                </span>
              </span>
            </div>

            <div class="ap-panel__body">
              <p class="ap-said">
                Build a lobby with a spinning golden portal that teleports players to the arena.
                <span class="ap-said__time">14:22</span>
              </p>

              <ol class="ap-steps">
                {
                  runSteps.map((s) => (
                    <li>
                      <span class="ap-steps__tick" aria-hidden="true">
                        ✓
                      </span>
                      <span class="ap-steps__what">{s.what}</span>
                      <span class="ap-steps__got">{s.got}</span>
                    </li>
                  ))
                }
              </ol>

              <p class="ap-reply">
                Done — the portal is in <code class="ap-mono">Lobby/Portal</code>, and
                <code class="ap-mono">PortalTeleport.server.luau</code> moves players to
                <code class="ap-mono">Arena/Spawn</code>. I left the old spawn pad where it was;
                say the word and I'll take it out.
              </p>
            </div>

            <div class="ap-panel__foot">
              <span>Super Agent</span>
              <span aria-hidden="true">·</span>
              <span>5 steps</span>
              <span aria-hidden="true">·</span>
              <span>checkpoint at 14:19</span>
            </div>
          </div>

          <div class="ap-panel ap-place" role="group" aria-label="Example place state">
            <p class="ap-card__meta ap-mono">The place · captured 14:24</p>
            <p class="ap-place__row">
              <span>Objects</span>
              <span class="ap-place__val"><span class="ap-place__was">41 →</span> 44</span>
            </p>
            <p class="ap-place__row">
              <span>Scripts</span>
              <span class="ap-place__val"><span class="ap-place__was">3 →</span> 4</span>
            </p>
            <p class="ap-place__row">
              <span>Checkpoints</span>
              <span class="ap-place__val">4</span>
            </p>
            <p class="ap-card__meta">
              Every run leaves one. Rewind restores the whole place — parts, scripts and properties.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------- library -- */}
    {/* THE WALL IS FULL-BLEED, so it sits OUTSIDE .ap-section__inner and the copy above and below
        it sits inside. A drifting row that stops at a 68rem measure reads as a widget in a box;
        one that runs off both edges reads as a library you are seeing part of. */}
    <section class="ap-section ap-section--seam" id="library" aria-labelledby="library-title">
      <div class="ap-section__inner">
        <p class="ap-eyebrow"><span class="ap-eyebrow__dot" aria-hidden="true"></span>The library</p>
        <h2 class="ap-display" id="library-title">
          {wall.length} assets, with the licence and the author on every one.
        </h2>
        <p class="ap-lede">
          Apple builds with art that already exists. These are rows from its library, shown the way
          it holds them — what the thing is, the pack it came out of, the licence it carries, and
          the person who made it. Touch or hover the wall to stop it and read one.
        </p>
      </div>

      <div
        class="ap-wall"
        role="group"
        aria-label={`${wall.length} assets from the library, each with its pack, licence and author`}
      >
        {
          wallRows.map((row, i) => (
            <div class={`ap-wall__row ap-wall__row--${i + 1}`}>
              <ul class="ap-wall__track">
                {row.map((a) => <AssetCard asset={a} />)}
              </ul>
              {/* The same cards again, and only so that translating this row by exactly -50%
                  lands on an identical frame. It is hidden from assistive technology because a
                  reader who cannot see the loop should not be read the library twice. */}
              <ul class="ap-wall__track ap-wall__track--echo" aria-hidden="true">
                {row.map((a) => <AssetCard asset={a} />)}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="ap-section__inner">
        <p class="ap-after">
          From <a href="https://kenney.nl/assets" rel="noopener noreferrer">Kenney</a>,
          <a href="https://game-icons.net" rel="noopener noreferrer">game-icons.net</a>,
          <a href="https://www.cgbookcase.com/textures" rel="noopener noreferrer">cgbookcase</a> and
          <a href="https://opengameart.org" rel="noopener noreferrer">OpenGameArt</a>. Previews are
          each pack's own, copied here and served from this domain rather than hotlinked.
        </p>
      </div>
    </section>

    {/* --------------------------------------------------------- modes -- */}
    <section class="ap-section ap-section--seam" id="modes" aria-labelledby="modes-title">
      <div class="ap-section__inner">
        <p class="ap-eyebrow"><span class="ap-eyebrow__dot" aria-hidden="true"></span>Modes</p>
        <h2 class="ap-display" id="modes-title">Three modes, one price list.</h2>
        <p class="ap-lede">
          Same builder, three settings. Switch mid-conversation; the run keeps its checkpoints
          either way.
        </p>

        <div class="ap-grid">
          {
            modes.map((m) => (
              <div class={`ap-card${m.featured ? ' ap-card--featured' : ''}`}>
                <div class="ap-model__head">
                  <h3 class="ap-model__name">{m.name}</h3>
                  <span class="ap-tag">{m.tag}</span>
                </div>
                <p class="ap-card__body">{m.body}</p>
                <ul class="ap-list">
                  {m.does.map((d) => (
                    <li>
                      <span class="ap-list__dot" aria-hidden="true" />
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <p class="ap-after">
          What each one costs, and why, is on <a href="/pricing">the pricing page</a> — with the
          measured figures it is derived from.
        </p>
      </div>
    </section>

    {/* ----------------------------------------------------- how it works -- */}
    <section class="ap-section ap-section--seam" id="how" aria-labelledby="how-title">
      <div class="ap-section__inner">
        <p class="ap-eyebrow"><span class="ap-eyebrow__dot" aria-hidden="true"></span>How it works</p>
        <h2 class="ap-display" id="how-title">Set up in three steps.</h2>
        <p class="ap-lede">
          Nothing to configure and no export step. Apple works in the project you already have
          open, through the same undo stack you already use.
        </p>

        {/* An ordered list, because the numerals encode a real sequence: you
            cannot say what you want before Studio is connected. Numbered
            markers on content that is not a sequence are decoration. */}
        <ol class="ap-grid" style="list-style:none;margin:0;padding:0">
          {
            steps.map((s) => (
              <li class="ap-card">
                <span class="ap-step__n" aria-hidden="true">
                  {s.n}
                </span>
                <h3 class="ap-card__title">{s.title}</h3>
                <p class="ap-card__body">{s.body}</p>
              </li>
            ))
          }
        </ol>

        <p class="ap-after">
          The plugin is not on the Creator Store yet.
          <a href={STUDIO_PLUGIN_INSTALL_HREF}>What that means for installing it</a>.
        </p>
      </div>
    </section>

    {/* ------------------------------------------------------- pricing -- */}
    <section class="ap-section ap-section--seam" id="pricing" aria-labelledby="pricing-title">
      <div class="ap-section__inner">
        <p class="ap-eyebrow"><span class="ap-eyebrow__dot" aria-hidden="true"></span>Pricing</p>
        <h2 class="ap-display" id="pricing-title">Simple credit pricing.</h2>
        <p class="ap-lede">
          One Credit is one unit of work, and a build spends about {CREDITS_PER_BUILD} of them. Everybody gets
          every mode; what a plan buys you is how much you can run.
        </p>

        <div class="ap-grid">
          {
            plans.map((p) => (
              <div class={`ap-card${p.featured ? ' ap-card--featured' : ''}`}>
                <div class="ap-model__head">
                  <h3 class="ap-model__name">{p.name}</h3>
                  {p.featured && <span class="ap-pill">Popular</span>}
                </div>

                <p class="ap-price">
                  {/* Formatted rather than concatenated: the symbol's position is the locale's
                      to choose, and '$' on its own does not name a currency. */}
                  <span class="ap-price__n">{formatMoney(p.price ?? 0, { currency: PRICE_CURRENCY })}</span>
                  {p.price !== 0 && <span class="ap-price__per">/mo</span>}
                </p>

                <p class="ap-card__body">
                  {p.credits.toLocaleString('en-US')} Credits a month — about {p.builds} builds.
                </p>
                <p class="ap-card__meta">{p.blurb}</p>

                <div class="ap-card__action">
                  <a
                    href={p.id === 'free' ? '/app/signup' : '/pricing'}
                    class={`ap-btn${p.featured ? ' ap-btn--primary' : ''}`}
                  >
                    {p.cta}
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        <p class="ap-after">
          Negotiated limits, invoicing and direct support are an Enterprise conversation.
          <a href="/pricing">See every plan and what it grants</a>.
        </p>
      </div>
    </section>
  </main>

  {/* ------------------------------------------------------------ footer -- */}
  <footer class="ap-footer">
    <div class="ap-footer__inner">
      <a href="/" class="ap-wordmark" aria-label="Apple — home">
        <AppleMark size={22} />
        <span>Apple</span>
      </a>

      <nav class="ap-footer__nav" aria-label="Footer">
        <a href="#product">Product</a>
        <a href="#modes">Modes</a>
        <a href="/pricing">Pricing</a>
        <a href="/docs">Docs</a>
        <a href="/changelog">Changelog</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>

      <p class="ap-footer__note">
        Apple is an independent product and is not affiliated with, endorsed by, or sponsored by
        Roblox Corporation. Roblox and Roblox Studio are trademarks of Roblox Corporation.
      </p>
    </div>
  </footer>
</Landing>
