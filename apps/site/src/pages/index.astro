---
import Landing from '../layouts/Landing.astro';
import AppleMark from '../components/AppleMark.astro';
import { PLAN_LIMITS, PRODUCT_MODELS, PRODUCT_MODEL_INFO } from '@golem/shared';
import { STUDIO_PLUGIN_INSTALL_HREF, STUDIO_PLUGIN_STORE_LIVE, STUDIO_PLUGIN_STORE_REFUSAL } from '../lib/studio-plugin';

/*
 * REBUILT 2026-09-19 AGAINST A MEASURED BAR, AND THE HERO RE-MEASURED AGAINST IT ON 2026-09-20.
 *
 * The second pass exists because the owner rejected the first: the instruction is the reference's
 * geometry exactly, in our black and green. tesana.ai/en was read again with
 * getComputedStyle at 1568x900 and at 390x844, and the hero's structure below now mirrors what that
 * reading found — a viewport-tall section with its content centred, a 56/64 headline over a full-ink
 * 20/30 sub-line, and one block holding an 838x140 composer, a small qualifying line and a row of
 * 36px controls. The words, the mark and the claims are unchanged and are ours.
 *
 * The owner named tesana.ai. It was opened in Chrome and read with getComputedStyle rather than
 * admired: the ramp, the type scale, the tracking rule, the radii, the nav treatment and the
 * section rhythm are in packages/corpus/data/ui-references/web-landing.json, and landing.css
 * derives from those numbers.
 *
 * WHAT WAS DELIBERATELY NOT TAKEN, which is the harder half. Most of the reference's page area is
 * social proof: a 300,000-builder claim, a live counter ticker, a gallery of user games and a wall
 * of creator videos. We have none of those things. Reproducing the shells with placeholder numbers
 * or stock imagery would make this page a lie in exactly the shape the rest of this repository
 * exists to prevent, so those sections are absent rather than empty.
 *
 * What replaces them is the only material we actually have: what the product does, verified. Every
 * claim below is one this repository has evidence for on 2026-09-19 — the consent gate, the
 * refusals, the visual critique, the plan limits — and the install line asks the shared constant
 * rather than asserting anything.
 */

const free = PLAN_LIMITS.free;

const truths = [
  { label: 'Scope', title: 'One place, the one you opened', body: 'Apple works in the Studio place you pair it to, and nowhere else. It cannot reach your files or your other games.' },
  { label: 'Consent', title: 'Edits are off until you allow them', body: 'The plugin opens read-only. Turning writes on takes two deliberate clicks, and disconnecting turns them off again.' },
  { label: 'Refusals', title: 'It says no, by name', body: 'It will not run code it was sent, drive play mode, or insert an asset carrying a script. Each refusal comes back with its reason.' },
  /* "A RUN YOU DISLIKE IS A SINGLE CTRL+Z AWAY" WAS FALSE FOR EVERY RUN THAT WROTE MORE THAN ONCE.
     The title is true and stays: Commands.luau opens exactly one ChangeHistoryService recording per
     operation, and Bridge.luau walks a server batch one operation at a time. That is precisely why
     the old body could not be true — one waypoint per change means a five-step run is five presses,
     and a reader who pressed once got back the last write and kept the other four. The one-keystroke
     exit is the checkpoint, so that is what this now points at. */
  { label: 'Undo', title: 'Every change is one waypoint', body: 'Writes are wrapped in Studio’s own undo history — one step per change, so a five-step run is five presses of Ctrl+Z. To take a whole run back at once, restore the checkpoint Apple saved before it started.' },
];

// The activity figure is data, not a pasted blob: the refused line is the point of the whole
// figure and needs its own element to carry colour, and a string with markup spliced into it is
// how that ends up unparseable.
const activity = [
  { text: 'get_tree         game.Workspace           ok' },
  { text: 'create_instances 4 parts                  refused', refused: true },
  { text: '  writes require explicit edit consent', refused: true },
  { text: 'create_instances 4 parts                  ok' },
  { text: 'edit_script      ServerScriptService.Main ok' },
  { text: 'render_view      eye · 288×180            ok' },
  { text: 'inspect_visually score 6/10 · 3 defects   ok' },
];

const capabilities = [
  { title: 'Reads before it writes', body: 'It walks your instance tree and scripts first, then proposes the change — and takes a checkpoint before touching anything.', glyph: 'tree' },
  { title: 'Checks its own work', body: 'It renders the scene from inside Studio and scores the picture against a visual gate, with named defects rather than a verdict.', glyph: 'eye' },
  { title: 'Builds in Luau, not pseudocode', body: 'Scripts land in your place through Studio’s own editor APIs, and it refuses to write code that loads assets or calls the network.', glyph: 'code' },
  { title: 'Generates real geometry', body: 'Text-to-3D runs through Roblox’s own generation service, and a descendant scan refuses anything that arrives carrying code.', glyph: 'cube' },
];
---

<Landing
  title="Apple — build Roblox games inside Studio"
  description="Describe what you want, and Apple builds it in the Roblox Studio place you already have open. It reads before it writes, checks its own work, and edits nothing until you allow it."
>
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="site-header">
    <div class="shell">
      <a href="/" class="wordmark" aria-label="Apple — home"><AppleMark size={22} /><span>Apple</span></a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/docs">Docs</a>
        <a href="/pricing">Pricing</a>
        <a href="/changelog">Changelog</a>
        <a href="/status">Status</a>
        {/* SIGN IN WAS NOWHERE ON THIS PAGE, at any width. "Open Apple" does land on the sign-in
            screen, but nothing said so — a returning customer had to guess. Every other page on
            this site carries a Sign in; the front door did not. */}
        <a href="/app/login">Sign in</a>
      </nav>
      {/* THE ONE CONTROL THIS PAGE WAS MISSING. Every other route carries a theme toggle in Nav.astro;
          the landing has its own header and had none, so a reader who chose light elsewhere on the
          site could not see or change that choice on the front page. Same 36px control height as the
          links beside it, so the nav is still one row of one-sized objects. */}
      <div class="header-actions">
      <button class="pill pill-quiet pill-icon" type="button" data-theme-toggle aria-pressed="true" aria-label="Switch to light theme">
        <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
          </g>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z" fill="currentColor"></path>
        </svg>
      </button>
      <a class="pill" href="/app">Open Apple</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="atmosphere" aria-hidden="true">
        <div class="light-column"></div>
        <svg viewBox="0 0 1600 760" preserveAspectRatio="xMidYMin slice">
          {Array.from({ length: 18 }, (_, i) => (
            <path d={`M-80 ${330 + i * 22} C 420 ${190 + i * 16}, 1060 ${560 - i * 9}, 1840 ${250 + i * 20}`} />
          ))}
          <path class="ridge" d="M-40 620 L220 430 L360 520 L560 350 L760 560 L980 400 L1180 540 L1420 380 L1640 560 L1840 470" />
          <path class="ridge" d="M-40 700 L260 560 L470 640 L700 500 L930 660 L1180 540 L1420 660 L1700 560 L1840 620" />
        </svg>
      </div>

      <div class="shell hero-inner">
        <h1 id="hero-title" class="display">Build it in the place you already have open.</h1>
        <p class="lead">Describe the game you want. Apple builds it inside your own Roblox Studio place, names every step while it happens, and changes nothing until you say so.</p>

        {/* THE COMPOSER AND THE ROW UNDER IT ARE ONE BLOCK. The bar spaces its hero as four things
            — headline, sub-line, composer, and a small line above a row of controls — with 24px
            and 40px gaps that only hold if the last two are a single group. Splitting them into
            siblings with their own margins is how those gaps drifted apart the first time. */}
        <div class="composer-group">
          <div class="composer" aria-hidden="true">
            <div class="composer-field">Ask Apple to build…</div>
            <div class="composer-bar">
              {/* THE DOT WAS GREEN AND THE WORD WAS "connected", on a page selling a product whose
                  plugin Roblox has not approved for distribution. A mock is still a claim: the
                  largest, most tappable-looking thing above the fold on a phone told a reader the
                  product was attached to their Studio before they had one. The sub-line two blocks
                  down says the opposite, and a reader believes the picture.
                  "Studio" alone is the same image without the assertion — it shows where the model
                  chip and the connection chip sit, which is the only job this mock has. */}
              <div class="composer-chips">
                <span class="chip">Studio</span>
                <span class="chip">Apple</span>
              </div>
              <span class="composer-send">Build</span>
            </div>
          </div>

          <div class="hero-foot">
            <p class="availability">
              {STUDIO_PLUGIN_STORE_LIVE ? (
                <>Free to start, no card. <a href={STUDIO_PLUGIN_INSTALL_HREF}>Get the Studio plugin ↗</a></>
              ) : (
                <>
                  Free to start, no card. Chat works now; building inside Studio needs the plugin, and
                  {STUDIO_PLUGIN_STORE_REFUSAL ? ' Roblox has not approved it for distribution.' : ' public installation is not open yet.'}
                  {' '}<a href={STUDIO_PLUGIN_INSTALL_HREF}>See the status ↗</a>
                </>
              )}
            </p>

            <div class="hero-actions">
              <a class="pill" href="/app/signup">Create a free account</a>
              <a class="pill pill-quiet" href="/docs">Read the docs</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="inside" aria-labelledby="truths-title">
      <div class="shell">
        <div class="band-head">
          <h2 id="truths-title" class="section-title">What it will and will not do</h2>
          <p class="section-sub">Every line here is a rule in the plugin, not a promise in a brochure.</p>
        </div>
        <div class="truths">
          {truths.map((t) => (
            <article class="truth">
              <p class="micro">{t.label}</p>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="sequence-title">
      <div class="shell">
        <div class="band-head">
          <h2 id="sequence-title" class="section-title">How a run actually goes</h2>
          <p class="section-sub">Three steps, in order, with the third one being the point.</p>
        </div>
        <div class="sequence">
          <figure class="sequence-figure">
            <figcaption class="figure-head micro">Studio · activity</figcaption>
            <div class="activity">
              {activity.map((line) => <div class={line.refused ? 'activity-line refused' : 'activity-line'}>{line.text}</div>)}
            </div>
          </figure>
          <div class="steps">
            <article class="step">
              <h3>Pair one place</h3>
              <p>A six-character code links Apple to the Studio place you have open. Nothing else in your account is in scope, and the pairing ends when you disconnect.</p>
            </article>
            <article class="step">
              <h3>Say what you want</h3>
              <p>Plain language. Apple reads the tree, plans the change, and takes a checkpoint before it writes — so the state before the run is always recoverable.</p>
            </article>
            <article class="step">
              <h3>Look at what it did</h3>
              <p>Every operation is named as it happens, including the ones that were refused. The result is in your place, in Studio, where you can run it.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="statement-title">
      <div class="shell" style="text-align:center">
        <h2 id="statement-title" class="statement">Apple builds inside Roblox Studio — in your place, with your account, under your approval.</h2>
      </div>
    </section>

    <section class="band" aria-labelledby="cap-title">
      <div class="shell">
        <div class="band-head">
          <h2 id="cap-title" class="section-title">What it is good at</h2>
          <p class="section-sub">Four things it does end to end today.</p>
        </div>
        <div class="cards">
          {capabilities.map((c) => (
            <article class="card">
              <div class="card-media" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  {c.glyph === 'tree' && <><path d="M5 4v14a2 2 0 0 0 2 2h4" /><path d="M5 12h6" /><rect x="13" y="2" width="6" height="5" rx="1" /><rect x="13" y="10" width="6" height="5" rx="1" /><rect x="13" y="17" width="6" height="5" rx="1" /></>}
                  {c.glyph === 'eye' && <><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z" /><circle cx="12" cy="12" r="2.6" /></>}
                  {c.glyph === 'code' && <><path d="m9 8-5 4 5 4" /><path d="m15 8 5 4-5 4" /></>}
                  {c.glyph === 'cube' && <><path d="M12 2.6 20.5 7v10L12 21.4 3.5 17V7Z" /><path d="M3.5 7 12 11.6 20.5 7" /><path d="M12 11.6v9.8" /></>}
                </svg>
              </div>
              <div class="card-body">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="models" aria-labelledby="plans-title">
      <div class="shell">
        <div class="band-head">
          <h2 id="plans-title" class="section-title">Two ways to work</h2>
          <p class="section-sub">Apple is free to use today. Paid checkout is not open yet, and the pricing page says so too.</p>
        </div>
        <div class="model-grid">
          {PRODUCT_MODELS.map((model) => (
            <article class="model-card">
              <h3>{model === 'apple-max' ? <>Apple <span class="max-name">MAX</span></> : PRODUCT_MODEL_INFO[model].name}</h3>
              <p>{model === 'apple'
                ? `The free tier. ${free.creditsPerDay.toLocaleString()} Credits a day, up to ${free.creditsPerMonth.toLocaleString()} a month — you have whichever is lower at the time.`
                : PRODUCT_MODEL_INFO[model].blurb}</p>
              <p class="micro">{model === 'apple' ? 'Free · no card' : 'Planned · not purchasable'}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="shell">
        <h2 class="statement">Start with one place and one idea.</h2>
        <a class="pill" href="/app/signup">Create a free account</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <div class="footer-grid">
        <div class="footer-col">
          <a class="wordmark" href="/"><AppleMark size={20} /><span>Apple</span></a>
          <p class="footer-note">Independent from Roblox Corporation. Apple can get things wrong — review and test what it changed before you publish.</p>
        </div>
        <div class="footer-col">
          <h3>Product</h3>
          <a href="/pricing">Pricing</a>
          <a href="/changelog">Changelog</a>
          <a href="/status">Status</a>
        </div>
        <div class="footer-col">
          <h3>Docs</h3>
          <a href="/docs">Getting started</a>
          <a href="/docs/plugin">Install the plugin</a>
          <a href="/docs/credits-and-limits">Credits &amp; limits</a>
        </div>
        <div class="footer-col">
          <h3>Legal</h3>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/docs/privacy-and-data">Your data</a>
        </div>
      </div>
    </div>
  </footer>
</Landing>
