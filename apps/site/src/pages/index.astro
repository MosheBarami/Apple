---
import Landing from '../layouts/Landing.astro';
import AppleMark from '../components/AppleMark.astro';
import { PRODUCT_MODELS, PRODUCT_MODEL_INFO } from '@golem/shared';
import { STUDIO_PLUGIN_INSTALL_HREF, STUDIO_PLUGIN_STORE_LIVE } from '../lib/studio-plugin';
---
<Landing title="Apple — build Roblox games inside Studio" description="A focused AI workspace for Roblox. Describe your idea, work in your own Studio place, and inspect the result before you publish.">
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header">
    <a href="/" class="wordmark" aria-label="Apple — home"><AppleMark size={28} /><span>Apple</span></a>
    <nav aria-label="Primary"><a href="/docs">Docs</a><a href="/pricing">Plans</a><a class="sign-in" href="/app/login">Sign in <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="atmosphere" aria-hidden="true">
        <div class="light-column"></div>
        <svg viewBox="0 0 1600 800" preserveAspectRatio="none"><g>{Array.from({length: 24}, (_, i) => <path d={`M-100 ${420+i*7} C350 ${190+i*5} 960 ${970-i*5} 1710 ${220+i*9}`} />)}</g></svg>
      </div>
      <div class="hero-content">
        <div class="hero-signature" aria-hidden="true"><AppleMark size={76} /></div>
        <p class="eyebrow">Your imagination. Your Studio.</p>
        <h1 id="hero-title">What will you<br />bring to life?</h1>
        <p class="hero-description">A conversation for the game in your head.<br />Built with you, inside Roblox Studio.</p>
        <div class="hero-actions">
          <a class="primary-button" href="/app">Open your workspace <span aria-hidden="true">↗</span></a>
          <a class="hero-secondary" href="/app/signup">Create a free account</a>
        </div>
        <p class="availability">{STUDIO_PLUGIN_STORE_LIVE ? <a href={STUDIO_PLUGIN_INSTALL_HREF}>Get the Studio plugin ↗</a> : <>Early preview. Public Studio installation is not available yet. <a href={STUDIO_PLUGIN_INSTALL_HREF}>See status ↗</a></>}</p>
      </div>
      <a class="discover" href="#inside">Inside Apple <span aria-hidden="true">↓</span></a>
    </section>
    <section class="inside section" id="inside" aria-labelledby="inside-title">
      <div class="section-heading"><p class="eyebrow">Less interface. More imagination.</p><h2 id="inside-title">One conversation.<br />Your whole project.</h2><p>Ask a question, shape a mechanic, or work through a broken script. Keep the conversation in focus and open the details when you need them.</p></div>
      <div class="principles">
        <article><span class="step">01</span><h3>Work in context</h3><p>Connect your own Studio place. Apple can inspect its objects and scripts before proposing changes.</p></article>
        <article><span class="step">02</span><h3>See what happens</h3><p>Compact activity keeps you informed. Code changes and available results stay beside the conversation.</p></article>
        <article><span class="step">03</span><h3>You keep control</h3><p>Stop a run, inspect the work, and test it in Studio. Publishing is your decision.</p></article>
      </div>
    </section>
    <section class="models section" id="models" aria-labelledby="models-title">
      <div class="section-heading"><p class="eyebrow">Choose your collaborator</p><h2 id="models-title">Start with Apple.<br />Go further with <span class="max-name">MAX</span>.</h2></div>
      <div class="model-grid">{PRODUCT_MODELS.map(model => <article class="model-card"><AppleMark size={38} /><h3>{model === 'apple-max' ? <>Apple <span class="max-name">MAX</span></> : PRODUCT_MODEL_INFO[model].name}</h3><p>{model === 'apple' ? 'The limited free tier. A place to begin, ask questions, and make smaller changes.' : 'The subscription tier for more involved work, with a larger working budget.'}</p><span class="model-access">{model === 'apple' ? 'Free · daily limits' : 'Paid subscribers'}</span></article>)}</div>
      <p class="model-note">Custom Roblox training is in development. We do not claim a completed proprietary model. <a href="/app/usage">Check plan availability ↗</a></p>
    </section>
    <section class="closing section"><AppleMark size={42} /><h2>The next idea is yours.</h2><a class="primary-button" href="/app/signup">Create an account <span aria-hidden="true">↗</span></a></section>
  </main>
  <footer><a class="wordmark" href="/"><AppleMark size={22} /> Apple</a><nav aria-label="Footer"><a href="/status">Status</a><a href="/docs">Docs</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav><p>Independent from Roblox Corporation. Review and test generated work before publishing.</p></footer>
</Landing>
