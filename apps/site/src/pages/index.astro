                    <path d="m14.6 8.4-5.1 5.1a1.75 1.75 0 0 0 2.5 2.5l5.2-5.2a3.5 3.5 0 0 0-5-5L6.8 11.2a5.25 5.25 0 0 0 7.4 7.4l4.3-4.3" />
                  </svg>
                </span>
                <span class="chip chip-model">{composerModel}</span>
              </div>
              {/* A real submit. It was a <span>, so the most prominent control above the fold was
                  not a control: not focusable, not pressable by keyboard, and announced as text. */}
