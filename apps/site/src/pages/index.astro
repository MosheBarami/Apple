---
/**
 * The landing page. One viewport, no scroll, nothing below the fold, and
 * ZERO JavaScript on the route.
 *
 * The composition is CENTRED and symmetrical about the vertical axis: eyebrow,
 * two-line headline, lede, two calls to action, a mono micro-line, and a
 * three-cell strip pinned to the bottom edge. Behind it, a prism rises from
 * bottom centre with a warm amber glow off its peak. All of that depth is CSS
 * planes plus one inline SVG line drawing — no images, no canvas, no 3D.
 *
 * Everything that used to live under the hero — the how-it-works scroller, the
 * Studio proof strip, the bridge diagram, the mode lab, the spark meter, the
 * FAQ and the closing CTA — was removed rather than hidden. Those subjects
 * live on real routes (/docs, /pricing) where someone who wants them can
 * actually read them. Which is also why the nav links here point at routes and
 * never at a `/#anchor`: the sections those anchors named do not exist.
 *
 * See docs/DESIGN-SPEC.md §0 and §1.
 */
import Landing from '../layouts/Landing.astro';
import GolemMark from '../components/GolemMark.astro';
import { STUDIO_PLUGIN_INSTALL_HREF, STUDIO_PLUGIN_STORE_LIVE } from '../lib/studio-plugin';

/** Nav destinations. Every one of these is a real page. No anchors. */
const navLinks = [
  { href: '/docs/getting-started', label: 'How it works' },
  { href: '/docs/modes', label: 'Modes' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/changelog', label: 'Changelog' },
];

/** The bottom strip: icon, bold title, faint subtitle. Three cells.
 *
 * EVERY CLAIM HERE MUST BE ONE THE PRODUCT CAN KEEP TODAY.
 *
 * This strip used to read "Trusted by builders", "Loved by teams", "Indie devs to
 * studios". Those are adoption claims, and Golem has no adoption to claim: the
 * Creator Store plugin is not distributed yet (STUDIO_PLUGIN_STORE_LIVE is false,
 * five lines of this same file route the install button at the docs instead). A
 * visitor reading them was being told something untrue on the first screen, by a
 * project whose whole evidence standard is that a capability is not proven because
 * code for it exists.
 *
 * So they say what Golem actually does, and each one is a thing a first-time visitor
 * can go and verify: the Studio connection is a real paired session, the build loop
 * really does plan/build/playtest/repair, and the training-data promise is the
 * standing policy in docs/SECURITY.md. If one of these ever stops being true, change
 * it here rather than leaving it to age into the last set's problem. */
const cells = [
  {
    icon: 'bolt',
    title: 'Plans, builds, playtests, repairs',
    sub: 'Then shows you what it changed',
  },
  {
    icon: 'people',
    title: 'Works inside your Studio',
    sub: 'Real scripts and instances, native undo',
  },
  {
    icon: 'shield',
    title: 'Your project stays yours',
    sub: 'Never training data without your say-so',
  },
];

/** 16px line icons, drawn here so the strip costs no extra request. */
const icons: Record<string, string> = {
  shield: 'M12 3.2 19 6v5.4c0 4-2.9 7.2-7 8.4-4.1-1.2-7-4.4-7-8.4V6z',
  bolt: 'M13.4 3 6 13.2h4.6L10.6 21 18 10.8h-4.6z',
  people:
    'M9 11.4a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4M2.8 19.6c0-3 2.8-5 6.2-5s6.2 2 6.2 5M16 5.4a3 3 0 0 1 0 5.9M17.4 14.9c2.3.4 3.8 2.1 3.8 4.7',
};
---

<Landing
  title="Golem — Describe it. Golem builds it."
  description="Golem is the AI builder for Roblox. Describe what you want in plain language and Golem makes the change in your project — real scripts, real instances, native undo, verified by running your game."
>
  <a href="#main" class="skip-link">Skip to content</a>

  {/* ---------------------------------------------------- the stage ------ */}
  <div class="stage" aria-hidden="true">
    {/* Layer order is the whole picture. The far ridge is a dark mass; the
        glow blooms in front of it; the near peak is drawn last so it
        silhouettes crisply against the warm light rather than being washed
        out by it. Putting the glow first instead hides it behind the ridge —
        which is exactly what it did on the first pass. */}
    <div class="prism prism--far"></div>
    <div class="stage__glow"></div>
    <div class="prism prism--left"></div>
    <div class="prism prism--right"></div>

    {/* Long thin diagonals sweeping the upper corners. They stay in the outer
        sixths so no rule ever crosses the headline. */}
    <svg
      class="stage__rules"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <g stroke="rgba(245,242,236,0.07)" stroke-width="1">
        <line x1="-120" y1="300" x2="340" y2="-120"></line>
        <line x1="-120" y1="470" x2="500" y2="-60"></line>
        <line x1="1560" y1="300" x2="1100" y2="-120"></line>
        <line x1="1560" y1="470" x2="940" y2="-60"></line>
      </g>
    </svg>

    <div class="stage__grain"></div>
  </div>

  {/* ---------------------------------------------------- the frame ------ */}
  {/* `main` is the FRAME, not the hero.
      The hero was the main landmark and the three value cells sat in a `footer`
      beside it — an element chosen for where it is on the screen rather than what it
      says. That put the product's three claims into `contentinfo`, which announces
      them as site boilerplate, and left "Skip to content" landing above content that
      was not in `main`.
      Element names only: `.frame` is a three-row grid and every rule here is
      class-based, so the box tree is byte-for-byte what it was. */}
  <main class="frame" id="main">
    <header class="nav">
      <a href="/" class="brand" aria-label="Golem — home">
        <GolemMark size={32} />
        <span>Golem</span>
      </a>

      <nav class="nav__links" aria-label="Primary">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <a href="/app" class="btn btn--cream nav__cta">
        Open Golem
        <svg
          class="btn__arrow"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M7 17 17 7m0 0H8.5M17 7v8.5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </header>

    <div class="hero">
      <p class="eyebrow reveal reveal-1">
        <span class="eyebrow__dash" aria-hidden="true"></span>
        AI builder for Roblox
      </p>

      <h1 class="title reveal reveal-2">
        Describe it.
        <em>Golem builds it.</em>
      </h1>

      <p class="lede reveal reveal-3">
        Go from an idea in your head to a working experience in
        <strong>Roblox Studio</strong>. Golem reads your project, writes the
        code, writes the instances — then presses Play to prove it works.
      </p>

      <div class="actions reveal reveal-4">
        <a href="/app" class="btn btn--cream btn--lg">
          Start building — free
          <svg
            class="btn__arrow"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M7 17 17 7m0 0H8.5M17 7v8.5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        {/* Destination comes from packages/shared, never retyped, and it is
            deliberately NOT the bare store URL: the asset is uploaded but not
            distributable (toolbox-service 404s for it), so sending a reader
            straight to the store hands them a page with nothing to get and no
            explanation. While STUDIO_PLUGIN_STORE_LIVE is false this points at
            /docs/plugin, which says plainly that it is not published yet
            (ADR-017 decision 3). It becomes the store link, in a new tab, the
            moment that constant flips — hence the conditional target. */}
        <a
          href={STUDIO_PLUGIN_INSTALL_HREF}
          class="btn btn--outline btn--lg"
          target={STUDIO_PLUGIN_STORE_LIVE ? '_blank' : undefined}
          rel={STUDIO_PLUGIN_STORE_LIVE ? 'noopener noreferrer' : undefined}
        >
          Install for Studio
        </a>
      </div>

      <p class="micro reveal reveal-5">
        Free to start <span aria-hidden="true">·</span> No card required
        <span aria-hidden="true">·</span> Works in your project
      </p>
    </div>

    {/* A labelled region, not a footer: these are the page's claims, not its
        colophon. */}
    <section class="strip" aria-label="What Golem does">
      {
        cells.map((cell) => (
          <div class="strip__cell">
            <svg
              class="strip__icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d={icons[cell.icon]}
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <h2 class="strip__title">{cell.title}</h2>
            <span class="strip__sub">{cell.sub}</span>
          </div>
        ))
      }
    </section>
  </main>
</Landing>
