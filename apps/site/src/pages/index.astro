---
import Base from '../layouts/Base.astro';
import ScreenSlot from '../components/ScreenSlot.astro';
import PieceIcon from '../components/PieceIcon.astro';
import '../styles/site.css';
import { PIECES } from '../data/pieces';
import { LISTED_PLAN_IDS, PLAN_COPY, PLAN_TABLE, PRICE_CURRENCY, formatMoney } from '@studpilot/shared';
import { STUDIO_PLUGIN_STORE_LIVE } from '../lib/studio-plugin';
import { EMAIL_FOR_EVERYONE, ROBLOX_LIMIT, ROBLOX_OAUTH_REVIEWED } from '../lib/roblox-signin';

/*
 * THE FRONT PAGE, REBUILT (M2, handoff 2.2). A new layout, not the old one restyled.
 *
 * WHAT IT MAY SAY. The site ships before any piece has passed the quality bar, so this page makes the
 * promise as the bar StudPilot is being built to and never as a result: no score, no sample build, no
 * critique, no picture of anything StudPilot made. The only pictures it will ever hold are real product UI,
 * in the fixed-size slots below (ScreenSlot.astro, src/data/screens.json). tests/no-fake-output.test.mjs and
 * tests/beta-labels.test.mjs hold all of it.
 *
 * WHAT IT READS. The plan figures come from the shared pricing config (packages/shared), so the teaser
 * cannot disagree with /pricing, and the plugin line asks the same flag the docs ask.
 */
const free = PLAN_TABLE.free;
const paid = LISTED_PLAN_IDS.filter((id) => id !== 'free');
const price = (id: (typeof paid)[number]) => formatMoney(PLAN_COPY[id].priceUsdMonthly ?? 0, { currency: PRICE_CURRENCY });

/*
 * THE STUDIO PLUGIN IS ASKED, NOT TYPED. STUDIO_PLUGIN_STORE_LIVE is false while the Creator Store listing is unavailable, and then a new
 * customer cannot get the plugin: they can sign up and use the chat, and cannot build in Studio. Every sentence below that says the piece is
 * built in Studio is qualified where it is said (the hero, the description, step 02), never only in the last line of the page. The sentence
 * the repository itself uses is in src/data/known-issues.ts ("new customers can chat and plan but cannot build inside Studio yet").
 */
const pluginHero = STUDIO_PLUGIN_STORE_LIVE
  ? 'The Studio plugin is free on the Creator Store.'
  : 'The Studio plugin is not open to new customers yet, so for now you can sign up and use the chat.';
const description = STUDIO_PLUGIN_STORE_LIVE
  ? 'StudPilot is an AI co-pilot for Roblox Studio, in beta. Ask for a piece of your game and a free plugin builds it in your own Studio place. Free while in beta.'
  : 'StudPilot is an AI co-pilot for Roblox Studio, in beta. The Studio plugin is not open to new customers yet; you can sign up and use the chat. Free while in beta.';
const pairStep = STUDIO_PLUGIN_STORE_LIVE
  ? 'Open StudPilot in Roblox Studio and type the 6-character code from your project.'
  : 'Pairing needs the Studio plugin, which is not open to new customers yet. People who have it type a 6-character code from their project.';
---

<Base title="StudPilot: an AI co-pilot for Roblox Studio (beta)" description={description}>
  <!-- ==================================================== hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__meta">
          <span class="badge">Beta</span>
          <span class="kicker">The bar we are building to</span>
        </p>
        <h1 id="hero-title" class="display">Ask for any piece. It looks pro, it works, and we never claim what we didn't prove.</h1>
        <p class="lede">
          StudPilot is an AI co-pilot for Roblox Studio. You ask in the web app, and a plugin builds the piece in your own
          Studio place. The line above is the bar we are building to. It is not a result we are claiming.
        </p>
        <p class="hero__plugin" data-plugin-line>{pluginHero} <a href="/docs/plugin">Where the plugin stands</a>.</p>
        <div class="hero__cta">
          <a class="btn btn-primary btn-lg" href="/app/signup">Start free (beta)</a>
          <a class="btn btn-lg" href="/how-it-works">How it works</a>
        </div>
        <p class="hero__note">Free while in beta. No card. For creators aged 13 and up.</p>
      </div>
      <ScreenSlot id="app-idle" priority />
    </div>
  </section>

  <!-- ==================================================== the four kinds of piece -->
  <section class="sec sec--band" id="pieces" aria-labelledby="pieces-title">
    <div class="wrap split">
      <header class="split__head">
        <p class="kicker">What you can ask for</p>
        <h2 id="pieces-title" class="sec-title">Four kinds of pieces</h2>
        <p class="sec-text">A piece is one part of your game, and it can be small or big. These are the four kinds StudPilot is built for.</p>
        <a class="text-link" href="/catalog">See the catalog</a>
      </header>
      <ul class="pieces">
        {
          PIECES.map((piece) => (
            <li class="piece">
              <span class="piece__icon">
                <PieceIcon piece={piece.id} />
              </span>
              <div>
                <h3>{piece.title}</h3>
                <p>{piece.short}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================================================== how it works, in short -->
  <section class="sec" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <p class="kicker">How it works</p>
      <h2 id="how-title" class="sec-title">From sign-in to your first piece, in four steps</h2>
      <ol class="rail">
        <li>
          <span class="rail__n">01</span>
          <h3>Sign in</h3>
          <p>
            {ROBLOX_OAUTH_REVIEWED
              ? 'Use your email, or sign in with Roblox.'
              : `Use your email. ${ROBLOX_LIMIT} ${EMAIL_FOR_EVERYONE}`}
            {' '}Google and Discord are coming.
          </p>
        </li>
        <li>
          <span class="rail__n">02</span>
          <h3>Pair the plugin</h3>
          <p>{pairStep}</p>
        </li>
        <li>
          <span class="rail__n">03</span>
          <h3>Ask for a piece</h3>
          <p>Type a request in the project chat. Short and plain is fine.</p>
        </li>
        <li>
          <span class="rail__n">04</span>
          <h3>Follow the steps</h3>
          <p>A live step list shows what StudPilot is doing while it does it.</p>
        </li>
      </ol>
      <a class="text-link" href="/how-it-works">All eight steps, and what works today</a>
    </div>
  </section>

  <!-- ==================================================== the bar, stated -->
  <section class="sec sec--band" id="bar" aria-labelledby="bar-title">
    <div class="wrap bar">
      <div>
        <p class="kicker">The quality bar</p>
        <h2 id="bar-title" class="sec-title">The bar a piece has to clear</h2>
        <p class="sec-text">
          The bar is a fresh blind critic. It will see only the request and screenshots of the result, and it will not know
          how the piece was made. A piece will go in the catalog only when it clears all three lines.
        </p>
        <p class="note">
          <strong>Beta:</strong> this is a target, not a score. The critic is being built, so nothing has been rated against the bar
          yet, and the catalog has no examples yet. <a href="/blog/what-works-today">What works today</a> says what is built and what is not.
        </p>
      </div>
      <ul class="bar__list" data-quality-bar>
        <li class="bar__row">
          <span class="bar__fig"><span class="bar__value">8/10</span><span class="bar__target">Target</span></span>
          <p class="bar__what">or better from the critic in every area, with no serious flaw.</p>
        </li>
        <li class="bar__row">
          <span class="bar__fig"><span class="bar__value">0</span><span class="bar__target">Target</span></span>
          <p class="bar__what">errors when the piece is play tested in Studio.</p>
        </li>
        <li class="bar__row">
          <span class="bar__fig"><span class="bar__value">0</span><span class="bar__target">Target</span></span>
          <p class="bar__what">false claims in the reply. It says what it proved, and lists what it did not.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ==================================================== the price strip -->
  <section class="sec" id="pricing" aria-labelledby="pricing-title">
    <div class="wrap tease">
      <div>
        <p class="kicker">Pricing</p>
        <h2 id="pricing-title" class="sec-title">Free while in beta. Paid plans start later</h2>
        <p class="sec-text">
          The Free plan gives you {free.creditsPerDay} Credits a day, up to {free.creditsPerMonth} a month. You do not need a card. The
          paid plans are planned, and nobody can buy them yet.
        </p>
        <a class="text-link" href="/pricing">See the plans</a>
      </div>
      <ul class="mini">
        <li>
          <span class="mini__name">Free</span>
          <span class="mini__what">{free.creditsPerDay} Credits a day, up to {free.creditsPerMonth} a month. Available now.</span>
        </li>
        {
          paid.map((id) => (
            <li>
              <span class="mini__name">{PLAN_COPY[id].name}</span>
              <span class="mini__what">
                {price(id)} a month, {PLAN_TABLE[id].creditsPerMonth} Credits. Planned.
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================================================== the closing call -->
  <section class="sec sec--flush" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta">
        <div>
          <h2 id="cta-title" class="sec-title">Try it while it is free.</h2>
          <p class="sec-text">
            {
              STUDIO_PLUGIN_STORE_LIVE
                ? 'Sign up, get the free Studio plugin, and ask for your first piece.'
                : 'You can sign up and use the chat now. The Studio plugin is not on the Creator Store yet.'
            }
            {' '}<a href="/docs/plugin">Where the plugin stands</a>.
          </p>
        </div>
        <div class="cta__row">
          <a class="btn btn-primary btn-lg" href="/app/signup">Start free (beta)</a>
        </div>
      </div>
    </div>
  </section>
</Base>
