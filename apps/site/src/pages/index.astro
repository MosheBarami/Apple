                )}

                {c.demo === 'code' && (
                  <div class="lu">
                    <div class="lu-asks" role="group" aria-label="Ask for one of three things">
                      {/* THE ANSWER TRAVELS ON THE BUTTON THAT ASKS FOR IT. Both come off one
