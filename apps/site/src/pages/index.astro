---
/**
 * The landing page. One viewport, no scroll, nothing below the fold.
 *
 * Everything that used to live under the hero — the how-it-works scroller,
 * the Studio proof strip, the bridge diagram, the mode lab, the spark meter,
 * the FAQ and the closing CTA — has been removed rather than hidden. Those
 * subjects now live on real routes (/docs, /pricing) where someone who wants
 * them can actually read them.
 *
 * There is no mascot, no 3D stage and no canvas. All depth on this page is
 * CSS planes, one inline SVG line drawing, and light.
 */
import Landing from '../layouts/Landing.astro';
import GolemMark from '../components/GolemMark.astro';

/** Three facts, each independently true and independently checkable. */
const facts = [
  'Free every day. No card, no trial clock.',
  'Native Studio undo on every change.',
  'Works inside the place you already have.',
];
---

<Landing
  title="Golem — Describe it. Golem builds it."
  description="Golem is the AI builder for Roblox Studio. Describe what you want in plain language and Golem makes the change in your project — real scripts, real instances, native undo, verified by running your game."
>
  <a href="#main" class="skip-link">Skip to content</a>

  {/* ---------------------------------------------------- the stage ------ */}
  <div class="stage" aria-hidden="true">
    <div class="stage__key"></div>
    <div class="stage__fill"></div>
    <div class="plane plane--a"></div>
    <div class="plane plane--b"></div>
    <div class="plane plane--c"></div>

    {/* Thin architectural rules: a drawing sheet beneath the stone. Drawn as
        one inline SVG so it costs no request and scales with the viewport. */}
    <svg
      class="stage__lines"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      {/* The drawing lives in the right half, where the planes are. The left
          half is left clear for type — no rule crosses the headline. The
          horizon sits at 0.855 of the height so it clears the CTA row rather
          than grazing it. */}
      <g stroke="rgba(244,239,228,0.10)" stroke-width="1">
        <line x1="900" y1="0" x2="900" y2="900"></line>
        <line x1="820" y1="770" x2="1440" y2="770"></line>
      </g>
      <g stroke="rgba(244,239,228,0.055)" stroke-width="1">
        <line x1="900" y1="770" x2="1330" y2="286"></line>
        <line x1="1148" y1="0" x2="1148" y2="770"></line>
        <line x1="900" y1="286" x2="1440" y2="286"></line>
      </g>
      {/* Dimension ticks at the intersections: the drafting detail that makes
          the sheet read as measured rather than decorative. */}
      <g stroke="rgba(244,239,228,0.20)" stroke-width="1">
        <line x1="894" y1="770" x2="906" y2="770"></line>
        <line x1="1142" y1="286" x2="1154" y2="286"></line>
      </g>
    </svg>

    <div class="stage__grain"></div>
  </div>

  {/* ---------------------------------------------------- the frame ------ */}
  <div class="frame">
    <header class="nav">
      <a href="/" class="brand" aria-label="Golem — home">
        <GolemMark size={26} alive={false} />
        <span>Golem</span>
      </a>

      <nav class="nav__links" aria-label="Primary">
        <a href="/pricing">Pricing</a>
        <a href="/docs">Docs</a>
        <a href="/changelog">Changelog</a>
        <a href="/app" class="btn btn--quiet btn--sm nav__cta">Open Golem</a>
      </nav>
    </header>

    <main class="hero" id="main">
      <div class="hero__inner">
        <p class="eyebrow reveal reveal-1">
          <span class="eyebrow__dot" aria-hidden="true"></span>
          AI builder for Roblox Studio
        </p>

        <h1 class="hero__title reveal reveal-2">
          Describe it.
          <em>Golem builds it.</em>
        </h1>

        <p class="hero__lede reveal reveal-3">
          Say what you want in plain language. Golem makes the change inside
          Roblox Studio — <strong>real scripts, real instances</strong> — then
          runs your game to check its own work.
        </p>

        <div class="hero__actions reveal reveal-4">
          <a href="/app" class="btn btn--cream">Start building</a>
          <a href="/docs/getting-started" class="btn btn--quiet">
            How it works
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 12h13m0 0-5-5m5 5-5 5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </main>

    <footer class="support">
      {
        facts.map((fact) => (
          <span class="support__item">
            <svg
              class="support__tick"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 12.5 9.5 18 20 6.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {fact}
          </span>
        ))
      }

      <span class="support__legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </span>
    </footer>
  </div>
</Landing>
