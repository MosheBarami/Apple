---
// /discord forwards to the community server's permanent invite. A page, not a worker route, so it
// ships with the site; the visible link is the fallback when scripts are off.
import Base from '../layouts/Base.astro';
import { DISCORD_INVITE_URL } from '../lib/community';
---

<Base title="Apple on Discord" description="Join the Apple community server on Discord: help, the changelog, and games people built with Apple." noindex>
  <div class="wrap discord-hop">
    <h1>Apple on Discord</h1>
    <p>Opening the Apple community server…</p>
    <p><a class="btn" href={DISCORD_INVITE_URL} rel="noopener">Join the server</a></p>
  </div>
  <script is:inline define:vars={{ url: DISCORD_INVITE_URL }}>location.replace(url);</script>
</Base>

<style>
  .discord-hop {
    padding: clamp(4rem, 12vw, 8rem) 0;
    text-align: center;
  }
</style>
