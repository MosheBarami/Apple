---
import Base from '../layouts/Base.astro';
import '../styles/site.css';

/* PLAIN AND LEFT-ALIGNED LIKE THE REST OF THE REBUILT SITE: it says what happened and where to go. The label and the
   heading share one left edge (tests/rendered-typography.test.mjs measures it). */
---

<Base title="Page not found | StudPilot" description="This page does not exist." noindex>
  <section class="page-head lost" aria-labelledby="lost-title">
    <div class="wrap">
      <p class="kicker">Error 404</p>
      <h1 id="lost-title" class="carved">That page is not here</h1>
      <p class="lede">
        The address may be mistyped, or the page may have moved. The home page and the docs are both one click away.
      </p>
      <div class="lost__ctas">
        <a href="/" class="btn btn-primary btn-lg">Go to the home page</a>
        <a href="/docs" class="btn btn-lg">Browse the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 56vh;
  }

  .lost__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
