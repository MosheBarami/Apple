---
import { MODE_INFO, PLAN_COPY, PLAN_IDS, PLAN_LIMITS, PRODUCT_MODELS, PRODUCT_MODES, canUseProductModel, type ProductMode } from '@golem/shared';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { STUDIO_PLUGIN_STORE_LIVE } from '../../lib/studio-plugin';

const free = PLAN_LIMITS.free;
const list = new Intl.ListFormat('en', { type: 'conjunction' });
// Plans and which of them include the stronger model, asked of the same function the worker enforces.
const planNames = list.format(PLAN_IDS.map((id) => PLAN_COPY[id].name));
const strongPlans = list.format(
  PLAN_IDS.filter((id) => canUseProductModel(PRODUCT_MODELS[1], id)).map((id) => PLAN_COPY[id].name),
);
const MODE_DETAIL: Record<ProductMode, string> = {
  plan: 'Use Plan when you want Apple to inspect the project, reason about the change and give you a concrete approach without modifying the place.',
  agent: 'Use Agent when you want Apple to carry the work through in Studio: read the project, make permitted edits, verify what changed and repair problems it finds.',
};
---

<DocsLayout
  title="Plan and Agent — Apple Docs"
  description="Plan and Agent are Apple's two product modes. Autonomous is an Agent toggle that changes continuation behavior; it is not a third mode."
  heading="Plan and Agent"
>
  <p>
    Apple has two product modes: <strong>Plan</strong> and <strong>Agent</strong>. The mode chooses
    what kind of work the request may do. It is separate from the Apple / Apple MAX model selector,
    Studio edit permission and your subscription allowance.
  </p>

  {PRODUCT_MODES.map((mode) => (
    <section>
      <h2>{MODE_INFO[mode].name}</h2>
      <p>{MODE_DETAIL[mode]}</p>
      <p>
        <strong>Published typical usage:</strong> {MODE_INFO[mode].typicalCredits} Credits. That is
        a measured guide, not a guaranteed fixed charge; the request settles against the compute it
        actually uses. {mode === 'plan' && <>Plan itself does not change your Studio place.</>}
      </p>
    </section>
  ))}

  <h2>Autonomous</h2>
  <p>
    <strong>Autonomous is a toggle on Agent, not another mode.</strong> With it off, Agent responds
    normally to the request you sent. With it on, Agent can keep scheduling its own next step until
    the task is finished, you stop it, access is revoked, the account reaches its Credits or service
    capacity limit, an unrecoverable infrastructure failure ends the run, or that message reaches
    the hard 1000 steps ceiling. There is no wall-clock cutoff.
  </p>

  <h2>What changes in Studio</h2>
  <p>
    Mode and edit permission are separate. Agent cannot bypass Studio pairing, the edit-consent
    gate, quota or tool safety checks. Without a connected plugin, a chat response is not a change
    to your place. {STUDIO_PLUGIN_STORE_LIVE
      ? <>The plugin is free on the Creator Store: see <a href="/docs/plugin">Install the plugin</a>.</>
      : <>Public Studio installation is unavailable right now. See <a href="/docs/plugin">plugin availability</a>.</>}
  </p>

  <h2>Models and plans are separate</h2>
  <p>
    Apple and Apple MAX are model choices; {planNames} are account plans. Neither adds another work
    mode. Apple MAX is the stronger model, included with {strongPlans}. The Free plan uses Apple and
    includes {free.creditsPerDay} Credits per day subject to its monthly ceiling. See <a href="/docs/credits-and-limits">Credits and limits</a> for the current
    allowance and metering rules.
  </p>
</DocsLayout>
