---
import { MODE_INFO, PRODUCT_MODES } from '@golem/shared';
import DocsLayout from '../../layouts/DocsLayout.astro';
import DocsKit from '../../components/picks-docs/DocsKit.astro';
import { STUDIO_PLUGIN_STORE_LIVE } from '../../lib/studio-plugin';

// The two ProductMode values are named from the shared contract rather than repeated here.
/*
 * THE BODY WAS GATED AND THE METADATA WAS NOT, WHICH IS THE HALF PEOPLE ACTUALLY SHARE.
 *
 * A <meta name="description"> and its og:description twin are what a search result and a pasted
 * link show. This page's body has asked STUDIO_PLUGIN_STORE_LIVE since the listing was removed,
 * while its description went on promising a Creator Store install path in every snippet — so the
 * promise reached the reader BEFORE the correction did, and the correction only arrived if they
 * clicked. Same constant, same answer, one sentence earlier.
 */
const modeNames = new Intl.ListFormat('en', { type: 'conjunction' }).format(
  PRODUCT_MODES.map((m) => MODE_INFO[m].name),
);
---

<DocsLayout
  title="Documentation — Apple"
  description={STUDIO_PLUGIN_STORE_LIVE
    ? `Everything you need to build with Apple: getting started, installing and connecting the Studio plugin, ${modeNames}, Credits, and how your data is handled.`
    : `Everything you need to build with Apple: getting started, ${modeNames}, Credits, and how your data is handled. Public Studio installation is unavailable right now.`}
  heading="Apple documentation"
>
  <p>
    Apple turns plain-language descriptions into real changes inside Roblox Studio. These docs cover
    the whole journey: installing the plugin, connecting it to a project, choosing a mode,
    understanding Credits, and knowing exactly what happens to your data.
  </p>

  {!STUDIO_PLUGIN_STORE_LIVE && <div class="callout"><p><strong>Public Studio installation is unavailable right now.</strong> You can create an account and chat; building inside Studio needs the plugin. <a href="/docs/plugin">Plugin availability</a>.</p></div>}

  <h2>Start here</h2>
  <ul>
    <li>
      <strong><a href="/docs/getting-started">Getting started</a></strong> — create your workspace
      and check what is available.
    </li>
    <li>
      <strong><a href="/docs/plugin">{STUDIO_PLUGIN_STORE_LIVE ? 'Install the plugin' : 'Plugin availability'}</a></strong> —
      {STUDIO_PLUGIN_STORE_LIVE ? ' get Apple Studio from the Creator Store and open it in Studio.' : ' public Studio installation is unavailable right now.'}
    </li>
    <li>
      <strong><a href="/docs/connect">Connect a project</a></strong> — link the plugin to one Apple
      project with a short-lived code.
    </li>
  </ul>

  <h2>Using Apple</h2>
  <ul>
    <li>
      <strong><a href="/docs/modes">Modes</a></strong> — {modeNames}, plus when to turn on
      Autonomous for Agent.
    </li>
    <li>
      <strong><a href="/docs/credits-and-limits">Credits &amp; limits</a></strong> — how the daily
      quota works and what happens at the edges.
    </li>
  </ul>

  <h2>Keeping it working</h2>
  <ul>
    <li>
      <strong><a href="/docs/updating">Updating the plugin</a></strong> — Roblox does not update
      plugins for you. Here is the button.
    </li>
    <li>
      <strong><a href="/docs/troubleshooting">Troubleshooting</a></strong> — every message the
      Studio panel can show, and the fix.
    </li>
  </ul>

  <h2>Trust</h2>
  <ul>
    <li>
      <strong><a href="/docs/privacy-and-data">Privacy &amp; data</a></strong> — what is stored,
      where, and the never-trained-on promise.
    </li>
    <li>
      <strong><a href="/docs/faq">FAQ</a></strong> — quick answers to the questions everyone asks.
    </li>
  </ul>

  <div class="callout">
    <p>
      {STUDIO_PLUGIN_STORE_LIVE ? <>Install the <a href="/docs/plugin">plugin</a>, open your place in Studio, <a href="/docs/connect">connect</a> it to a project, and describe your idea.</> : <>Start with <a href="/app/signup">a free account</a> and a conversation. If you already have a working plugin, <a href="/docs/connect">connect your place</a>. Otherwise, check <a href="/docs/plugin">plugin availability</a>.</>}
    </p>
  </div>

  <h2>For developers</h2>
  <p>
    Working on Apple itself rather than with it?
    <a href="/docs/build-from-source">Build the plugin from source</a> covers the Rojo build and the
    local-plugin debug loop. It is explicitly not the install path.
  </p>

  <DocsKit />
</DocsLayout>
