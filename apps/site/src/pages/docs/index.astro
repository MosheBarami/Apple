---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsPages } from '../../data/docs-index';
import { STUDIO_PLUGIN_STORE_LIVE } from '../../lib/studio-plugin';

/*
 * THE DOCS INDEX, DERIVED FROM THE FILES (M2 site fix cycle 1, plan step 2.6). The list of pages below is read from the page sources by
 * docsPages() (src/data/docs-index.ts), the same function the sidebar of DocsLayout.astro reads, so a page appears here the day its file exists, under
 * its own heading and its own one-line summary. It used to be a hand-written list in four sections, and a page that was added and not listed was an
 * orphan.
 *
 * THE BODY WAS GATED AND THE METADATA WAS NOT, WHICH IS THE HALF PEOPLE ACTUALLY SHARE. A <meta name="description"> and its og:description twin are
 * what a search result and a pasted link show. This page asks STUDIO_PLUGIN_STORE_LIVE for its description as well as its body, so the promise never
 * reaches the reader before the correction.
 */
const sources = import.meta.glob('./*.astro', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const pages = docsPages(sources).filter((p) => p.path !== '/docs');
---

<DocsLayout
  title="Documentation | StudPilot"
  description={STUDIO_PLUGIN_STORE_LIVE
    ? 'Everything you need to start with StudPilot: getting started, the Studio plugin, Credits and limits, billing, troubleshooting and how your data is handled.'
    : 'Everything you need to start with StudPilot: getting started, Credits and limits, billing, troubleshooting and how your data is handled. Public Studio installation is unavailable right now.'}
  heading="StudPilot documentation"
  order={0}
  summary="Where to start."
>
  <p>
    StudPilot is an AI co-pilot for Roblox Studio, in beta. These pages say how to start, what the plugin does, how Credits work, and how your data is
    handled. They say plainly what does not work yet.
  </p>

  {!STUDIO_PLUGIN_STORE_LIVE && <div class="callout"><p><strong>Public Studio installation is unavailable right now.</strong> You can create an account and chat; building inside Studio needs the plugin. <a href="/docs/plugin">Plugin availability</a>.</p></div>}

  <h2>The pages</h2>
  <ul data-docs-index>
    {
      pages.map((p) => (
        <li>
          <strong><a href={p.path}>{p.heading}</a></strong>{p.summary ? ` ${p.summary}` : ''}
        </li>
      ))
    }
  </ul>
</DocsLayout>
