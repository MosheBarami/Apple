---
/**
 * ONE ICON FOR EACH OF THE FOUR KINDS OF PIECE (src/data/pieces.ts), drawn for this site.
 *
 * Plain outlines on a 24 by 24 grid, 1.6 stroke, `currentColor`, so an icon takes the colour of the text
 * around it and follows the theme. They are decoration beside a title that says the same thing, so they
 * are hidden from assistive technology.
 */
import type { PieceId } from '../data/pieces';
interface Props { piece: PieceId; size?: number }
const { piece, size = 24 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    piece === 'ui' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2.5" />
        <path d="M3 9h18" />
        <rect x="7" y="13" width="6" height="3.2" rx="1.2" />
      </>
    )
  }
  {
    piece === 'system' && (
      <>
        <circle cx="6" cy="7" r="2.2" />
        <circle cx="18" cy="7" r="2.2" />
        <circle cx="12" cy="17.5" r="2.2" />
        <path d="M7.7 8.6l3 6.9M16.3 8.6l-3 6.9M8.2 7h7.6" />
      </>
    )
  }
  {
    piece === 'prop' && (
      <>
        <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" />
        <path d="M4 7.5l8 4.5 8-4.5M12 12v9" />
      </>
    )
  }
  {
    piece === 'area' && (
      <>
        <path d="M3 19.5l6-9.5 4.2 5.2 2.8-3.7 5 8z" />
        <circle cx="17.2" cy="6.2" r="1.8" />
      </>
    )
  }
</svg>
