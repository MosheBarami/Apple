---
/**
 * A FIXED-SIZE PLACE FOR A REAL SCREENSHOT OF THE PRODUCT, AND NOTHING ELSE.
 *
 * Handoff M2: the site ships before any piece has passed the bar, so the only pictures it may show are real
 * product UI (the web app's idle and empty states, or the plugin in Studio). Never a build, never a result.
 * The captures step takes those screenshots and records each one in src/data/screens.json
 * ({slot, file, sha256, source, commit, date, containsResult: false, alt, width, height}).
 *
 * Until a record names this slot the slot holds no image: a quiet frame that says so. The box is reserved
 * either way (aspect-ratio, plus data-width and data-height), so the page does not move when a picture
 * arrives. tests/no-fake-output.test.mjs holds all of it: a slot with no record holds no <img>, a record
 * with a file whose hash differs fails, and an <img> outside a slot fails.
 */
import screens from '../data/screens.json';

interface Props {
  /** The slot's name, matched against `slot` in screens.json. */
  slot: string;
  /** What the picture will show, in words, for the empty frame. */
  label: string;
  /** The box, in pixels. Both are reserved whether or not a picture is there. */
  width?: number;
  height?: number;
  class?: string;
}
const { slot, label, width = 1200, height = 900, class: className = '' } = Astro.props;
const record = (screens as Array<{ slot: string; file: string; alt: string; width: number; height: number }>).find((r) => r.slot === slot);
---

<figure
  class={`slot ${className}`}
  data-screen-slot={slot}
  data-width={width}
  data-height={height}
  style={`aspect-ratio: ${width} / ${height}`}
>
  {
    record ? (
      <img src={record.file} alt={record.alt} width={record.width} height={record.height} loading="lazy" decoding="async" />
    ) : (
      <div class="slot__empty">
        <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 3H27.8Q29 3 29 4.2V20A9 9 0 0 1 20 29H12A9 9 0 0 1 3 20V12A9 9 0 0 1 12 3ZM20 17a4.6 4.6 0 1 0-9.2 0 4.6 4.6 0 0 0 9.2 0Z" />
        </svg>
        <p>{label}</p>
        <p class="slot__sub">A real screenshot goes here.</p>
      </div>
    )
  }
</figure>

<style>
  .slot {
    position: relative;
    margin: 0;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .slot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slot__empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 24px;
    text-align: center;
    color: var(--muted);
  }

  .slot__empty svg {
    margin-bottom: 6px;
    color: var(--faint);
  }

  .slot__empty p {
    margin: 0;
    max-width: 28ch;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .slot__empty .slot__sub {
    font-size: 12px;
    color: var(--muted);
  }
</style>
