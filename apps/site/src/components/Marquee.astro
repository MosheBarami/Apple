---
/**
 * ROWS OF THINGS TO ASK FOR, DRIFTING — AND EACH ONE, PRESSED, IS TYPED INTO THE COMPOSER.
 *
 * This component existed as a CSS-only strip that no page mounted. It is now the landing's prompt
 * ticker, and two of the owner's picks are merged into it because they are the same object:
 *
 *   GSAP "ModifiersPlugin" (infinite marquee via wrap): every row's offset is passed through a
 *            wrap(0, length) modifier, so the row is endless with no seam and no reset to time;
 *            two rows run in opposite directions. Re-implemented in ./picks/ticker.ts — GSAP is not
 *            a dependency of this site.
 *   Motion "Ticker" (LicenseRef-Motion-Plus, code not used): the speed is a value that EASES —
 *            pointing at a row slows it smoothly to a crawl rather than stopping it dead, and it
 *            picks back up when the pointer leaves.
 *
 * WHAT IT IS FOR. The chips are example requests — the only thing that can sit next to an empty
 * composer without becoming a claim. Pressing one writes it into the field named by `fills` and
 * focuses it, so a young visitor who does not know what to type has twenty ideas one tap away.
 *
 * NOTHING IS LOST WITHOUT THE MOTION. With scripting off, or under reduced motion, a row is a
 * still, horizontally scrollable list and every chip in it is reachable. Only the copies the loop
 * needs are aria-hidden and taken out of the tab order, so each idea is read and tabbed once.
 * Keyboard focus inside a row stops it, so a focused chip never slides away.
 */
import './picks/ticker.css';

interface Props {
  /** Two rows of short example requests. Anything long enough to wrap does not belong in a chip. */
  rows: string[][];
  /** The id of the <textarea> a pressed chip is written into. */
  fills: string;
  /** What the rows are, for a screen reader. */
  label: string;
  /** A short visible line above the rows. */
  caption?: string;
}

const { rows, fills, label, caption } = Astro.props;
const clean = rows.map((row) => row.filter((item) => typeof item === 'string' && item.trim().length > 0)).filter((row) => row.length);
---
{clean.length > 0 && (
  <div class="ticker" role="group" aria-label={label} data-ticker data-fills={fills}>
    {caption && <p class="micro ticker-cap" aria-hidden="true">{caption}</p>}
    {clean.map((row, i) => (
      <div class="ticker-row" data-dir={i % 2 === 0 ? '-1' : '1'}>
        <ul class="ticker-track" role="list">
          {row.map((item) => (
            <li><button type="button" class="ticker-chip" data-prompt={item}>{item}</button></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}

<script>
  import { mountTickers } from './picks/ticker';
  mountTickers();
</script>
