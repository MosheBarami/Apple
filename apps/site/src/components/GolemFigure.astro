---
// Geometric rune-carved golem characters. One component, three personalities:
//  - clay: rounded, warm, small and quick
//  - stone: angular slabs, solid and dependable
//  - rune: fractured, levitating, humming with arcane charge
interface Props {
  variant: 'clay' | 'stone' | 'rune';
  size?: number;
  class?: string;
}
const { variant, size = 180, class: className = '' } = Astro.props;
const uid = `gf-${variant}`;
const colors = {
  clay: { accent: '#E2A16F', slabA: '#3a2d24', slabB: '#241c16', line: '#57432f' },
  stone: { accent: '#9AA7B8', slabA: '#2a3550', slabB: '#161d2e', line: '#3c4c66' },
  rune: { accent: '#7C5CFF', slabA: '#251f45', slabB: '#151129', line: '#40357a' },
} as const;
const c = colors[variant];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 200 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${variant} golem illustration`}
  class={`golem-figure golem-figure--${variant} ${className}`}
>
  <defs>
    <linearGradient id={`${uid}-body`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={c.slabA}></stop>
      <stop offset="1" stop-color={c.slabB}></stop>
    </linearGradient>
    <radialGradient id={`${uid}-halo`} cx="0.5" cy="0.45" r="0.55">
      <stop offset="0" stop-color={c.accent} stop-opacity="0.35"></stop>
      <stop offset="1" stop-color={c.accent} stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <circle cx="100" cy="98" r="92" fill={`url(#${uid}-halo)`}></circle>

  {
    variant === 'clay' && (
      <g stroke={c.line} stroke-width="2">
        {/* rounded, friendly clay golem */}
        <ellipse cx="100" cy="168" rx="52" ry="8" fill="#000" opacity="0.35" stroke="none" />
        <path d="M58 118 Q58 88 100 88 Q142 88 142 118 L138 158 Q136 168 124 168 L76 168 Q64 168 62 158 Z" fill={`url(#${uid}-body)`} />
        <rect x="66" y="34" width="68" height="52" rx="24" fill={`url(#${uid}-body)`} />
        {/* arms */}
        <path d="M50 112 Q38 118 42 136 Q44 146 54 144 L60 140" fill={`url(#${uid}-body)`} />
        <path d="M150 112 Q162 118 158 136 Q156 146 146 144 L140 140" fill={`url(#${uid}-body)`} />
        {/* carved seams */}
        <path d="M70 104 Q100 96 130 104" fill="none" opacity="0.7" />
        <path d="M74 132 Q100 126 126 132" fill="none" opacity="0.5" />
        {/* eyes */}
        <rect x="80" y="55" width="12" height="6" rx="3" fill={c.accent} stroke="none" class="gf-eye" />
        <rect x="108" y="55" width="12" height="6" rx="3" fill={c.accent} stroke="none" class="gf-eye" />
        {/* chest rune: spiral dot */}
        <circle cx="100" cy="118" r="9" fill="none" stroke={c.accent} class="gf-rune" />
        <circle cx="100" cy="118" r="3" fill={c.accent} stroke="none" class="gf-rune" />
      </g>
    )
  }

  {
    variant === 'stone' && (
      <g stroke={c.line} stroke-width="2">
        {/* broad angular slab golem */}
        <ellipse cx="100" cy="172" rx="60" ry="8" fill="#000" opacity="0.35" stroke="none" />
        <path d="M52 100 L148 100 L140 164 L134 172 L66 172 L60 164 Z" fill={`url(#${uid}-body)`} />
        <path d="M64 34 L136 34 L142 44 L142 78 L134 90 L66 90 L58 78 L58 44 Z" fill={`url(#${uid}-body)`} />
        {/* shoulders */}
        <path d="M34 100 L56 92 L58 128 L40 132 Z" fill={`url(#${uid}-body)`} />
        <path d="M166 100 L144 92 L142 128 L160 132 Z" fill={`url(#${uid}-body)`} />
        {/* carved seams */}
        <path d="M52 122 L100 116 L148 122" fill="none" opacity="0.7" />
        <path d="M60 146 L100 141 L140 146" fill="none" opacity="0.5" />
        <path d="M58 56 L84 56 M116 56 L142 56" fill="none" opacity="0.6" />
        {/* eyes */}
        <rect x="76" y="60" width="16" height="5" fill={c.accent} stroke="none" class="gf-eye" />
        <rect x="108" y="60" width="16" height="5" fill={c.accent} stroke="none" class="gf-eye" />
        {/* chest rune: chevron */}
        <path d="M88 124 L100 136 L112 124 M88 136 L100 148 L112 136" fill="none" stroke={c.accent} class="gf-rune" />
      </g>
    )
  }

  {
    variant === 'rune' && (
      <g stroke={c.line} stroke-width="2">
        {/* fractured levitating golem */}
        <ellipse cx="100" cy="180" rx="42" ry="6" fill="#000" opacity="0.35" stroke="none" />
        {/* floating shards */}
        <path d="M36 84 L52 76 L56 96 L40 102 Z" fill={`url(#${uid}-body)`} class="gf-shard gf-shard-a" />
        <path d="M164 78 L150 70 L144 92 L158 98 Z" fill={`url(#${uid}-body)`} class="gf-shard gf-shard-b" />
        <path d="M60 160 L76 154 L78 170 L64 174 Z" fill={`url(#${uid}-body)`} class="gf-shard gf-shard-c" />
        <path d="M140 158 L126 152 L124 168 L136 172 Z" fill={`url(#${uid}-body)`} class="gf-shard gf-shard-a" />
        {/* torso: split slabs with glowing gaps */}
        <path d="M64 96 L136 96 L130 128 L70 128 Z" fill={`url(#${uid}-body)`} />
        <path d="M72 134 L128 134 L122 160 L78 160 Z" fill={`url(#${uid}-body)`} />
        <path d="M70 131 L130 131" stroke={c.accent} stroke-width="2.5" opacity="0.9" class="gf-rune" />
        {/* head: floating, split crown */}
        <path d="M70 34 L130 34 L134 58 L126 72 L74 72 L66 58 Z" fill={`url(#${uid}-body)`} />
        <path d="M84 22 L100 12 L116 22 L112 30 L88 30 Z" fill={`url(#${uid}-body)`} class="gf-shard gf-shard-b" />
        {/* eyes */}
        <rect x="80" y="50" width="14" height="5" fill={c.accent} stroke="none" class="gf-eye" />
        <rect x="106" y="50" width="14" height="5" fill={c.accent} stroke="none" class="gf-eye" />
        {/* chest rune: angular sigil */}
        <path d="M100 102 L110 112 L100 122 L90 112 Z M100 108 L100 116" fill="none" stroke={c.accent} class="gf-rune" />
      </g>
    )
  }
</svg>

<style>
  .golem-figure {
    display: block;
  }

  .gf-eye {
    filter: drop-shadow(0 0 5px currentColor);
  }

  .golem-figure--clay .gf-eye,
  .golem-figure--clay .gf-rune {
    color: #e2a16f;
  }
  .golem-figure--stone .gf-eye,
  .golem-figure--stone .gf-rune {
    color: #9aa7b8;
  }
  .golem-figure--rune .gf-eye,
  .golem-figure--rune .gf-rune {
    color: #7c5cff;
  }

  .gf-rune {
    filter: drop-shadow(0 0 6px currentColor);
    animation: gf-pulse 3.2s ease-in-out infinite;
  }

  .gf-shard {
    animation: gf-float 5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .gf-shard-b {
    animation-delay: -1.6s;
  }

  .gf-shard-c {
    animation-delay: -3.1s;
  }

  @keyframes gf-pulse {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes gf-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gf-rune,
    .gf-shard {
      animation: none;
    }
  }
</style>
