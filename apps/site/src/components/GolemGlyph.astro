---
// The Golem mark: a carved stone head with glowing rune eyes.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="golem-glyph"
>
  <defs>
    <linearGradient id="gg-stone" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a3550"></stop>
      <stop offset="1" stop-color="#161d2e"></stop>
    </linearGradient>
  </defs>
  <!-- head slab -->
  <path
    d="M10 8 L38 8 Q42 8 42 12 L42 32 Q42 36 38 38 L28 44 Q24 46 20 44 L10 38 Q6 36 6 32 L6 12 Q6 8 10 8 Z"
    fill="url(#gg-stone)"
    stroke="#324158"
    stroke-width="1.5"></path>
  <!-- carved seam -->
  <path d="M6 20 L20 20 L24 24 L28 20 L42 20" stroke="#0b0e14" stroke-width="1.6" fill="none"></path>
  <!-- rune eyes -->
  <rect x="13" y="25" width="7" height="4" rx="1" fill="#FFB454"></rect>
  <rect x="28" y="25" width="7" height="4" rx="1" fill="#FFB454"></rect>
  <!-- forehead rune -->
  <path d="M24 11 L27 15 L24 17 L21 15 Z" fill="none" stroke="#7C5CFF" stroke-width="1.6"></path>
</svg>

<style>
  .golem-glyph {
    filter: drop-shadow(0 0 6px rgba(255, 180, 84, 0.4));
    flex-shrink: 0;
  }
</style>
