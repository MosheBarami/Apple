---
// Custom cursor with contextual states. Desktop / fine-pointer only, and it
// never activates under prefers-reduced-motion (the OS cursor stays).
//
// States are read off the DOM, so any element can opt in:
//   data-cursor="drag" | "link" | "text" | "play" …
//   data-cursor-label="drag to explore"
---

<div class="cursor" id="cursor" aria-hidden="true">
  <span class="cursor__ring"></span>
  <span class="cursor__dot"></span>
  <span class="cursor__label" id="cursor-label"></span>
</div>

<script>
  const el = document.getElementById('cursor');
  const labelEl = document.getElementById('cursor-label');
  const fine = window.matchMedia('(pointer: fine)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (el && labelEl && fine.matches && !reduced.matches) {
    document.documentElement.classList.add('has-cursor');

    let tx = window.innerWidth / 2;
    let ty = window.innerHeight / 2;
    let x = tx;
    let y = ty;
    let raf = 0;
    let running = false;

    function loop() {
      // light damping — the ring trails the pointer just enough to feel alive
      x += (tx - x) * 0.24;
      y += (ty - y) * 0.24;
      el!.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
      if (Math.abs(tx - x) > 0.1 || Math.abs(ty - y) > 0.1) {
        raf = requestAnimationFrame(loop);
      } else {
        running = false;
      }
    }

    function kick() {
      if (!running) {
        running = true;
        raf = requestAnimationFrame(loop);
      }
    }

    // park it off-screen until the pointer actually reports a position
    el.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        tx = e.clientX;
        ty = e.clientY;
        el!.classList.add('is-awake');
        kick();

        const target = e.target as HTMLElement | null;
        const hit = target?.closest<HTMLElement>(
          '[data-cursor], a, button, summary, [role="button"], input, textarea, select, label'
        );

        let state = '';
        let label = '';

        if (hit) {
          if (hit.dataset.cursor) {
            state = hit.dataset.cursor;
          } else if (
            hit.tagName === 'INPUT' &&
            (hit as HTMLInputElement).type === 'range'
          ) {
            state = 'drag';
          } else if (hit.tagName === 'INPUT' || hit.tagName === 'TEXTAREA') {
            state = 'text';
          } else {
            state = 'link';
          }
          label = hit.dataset.cursorLabel || '';
        }

        if (state) el!.setAttribute('data-state', state);
        else el!.removeAttribute('data-state');

        if (label) {
          el!.setAttribute('data-label', '');
          labelEl!.textContent = label;
        } else {
          el!.removeAttribute('data-label');
        }
      },
      { passive: true }
    );

    window.addEventListener('pointerdown', () => {
      el!.style.setProperty('--press', '1');
      el!.classList.add('is-down');
    });
    window.addEventListener('pointerup', () => el!.classList.remove('is-down'));

    document.addEventListener('pointerleave', () =>
      el!.classList.remove('is-awake')
    );
    document.addEventListener('pointerenter', () =>
      el!.classList.add('is-awake')
    );
  }
</script>

<style>
  .cursor {
    transition: opacity 160ms var(--ease-out);
  }

  .cursor.is-down .cursor__ring {
    transform: scale(0.82);
  }

  .cursor.is-down[data-state='drag'] .cursor__ring {
    transform: rotate(45deg) scale(0.82);
  }
</style>
