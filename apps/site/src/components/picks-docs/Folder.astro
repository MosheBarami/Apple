---
/*
 * A FOLDER THAT OPENS TO SHOW WHAT IS INSIDE IT.
 *
 * Adapted from React Bits' "Folder" (MIT + Commons Clause, https://github.com/DavidHDev/react-bits):
 * a folder whose front flap tilts back on hover and, when opened, fans its papers out. Kept: the
 * back, the two-part front flap, three papers and their fan-out transforms. Changed: it is a real
 * <button> with aria-expanded, the papers carry words, the colours are Apple's tokens rather than
 * the demo's light blue, and opening it also reveals a plain list saying what each paper is —
 * the folder is the picture, the list is the explanation.
 *
 * Without JavaScript the list is simply visible. Under prefers-reduced-motion the papers move
 * without travelling (the site-wide rule in apple-minimal.css cuts every transition to 1ms).
 */
interface Item {
  name: string;
  text: string;
}

interface Props {
  label: string;
  items: [Item, Item, Item];
}

const { label, items } = Astro.props;
const id = `folder-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class="fold" data-folder>
  <button type="button" class="fold__btn" aria-expanded="true" aria-controls={`${id}-list`}>
    <span class="fold__art" aria-hidden="true">
      <span class="fold__back">
        {items.map((item) => <span class="fold__paper">{item.name}</span>)}
        <span class="fold__front"></span>
        <span class="fold__front fold__front--right"></span>
      </span>
    </span>
    <span class="fold__label">{label}</span>
  </button>
  <p class="fold__hint" hidden>Open the folder to see what is inside.</p>
  <ul class="fold__list" id={`${id}-list`}>
    {items.map((item) => <li><strong>{item.name}</strong> — {item.text}</li>)}
  </ul>
</div>

<style>
  .fold {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px 28px;
    margin: 20px 0 24px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .fold__btn {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 78px 34px 6px;
    border: 0;
    border-radius: var(--r-sm);
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .fold__btn:hover .fold__label {
    color: var(--ink);
  }

  .fold__art {
    display: block;
    transition: transform 200ms ease-in;
  }

  .fold__back {
    position: relative;
    display: block;
    width: 100px;
    height: 80px;
    border-radius: 0 10px 10px 10px;
    background: color-mix(in srgb, var(--accent) 78%, var(--paper));
  }

  .fold__back::after {
    content: '';
    position: absolute;
    bottom: 98%;
    left: 0;
    width: 30px;
    height: 10px;
    border-radius: 5px 5px 0 0;
    background: inherit;
  }

  .fold__paper {
    position: absolute;
    z-index: 2;
    bottom: 10%;
    left: 50%;
    display: flex;
    justify-content: center;
    width: 70%;
    height: 80%;
    padding-top: 6px;
    border-radius: 8px;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 8px;
    font-weight: 600;
    line-height: 1.2;
    transform: translate(-50%, 10%);
    transition: transform 300ms ease-in-out;
  }

  .fold__paper:nth-child(2) {
    width: 80%;
    height: 70%;
    background: var(--primary-hover);
  }

  .fold__paper:nth-child(3) {
    width: 90%;
    height: 60%;
  }

  .fold__front {
    position: absolute;
    z-index: 3;
    inset: 0;
    border-radius: 5px 10px 10px 10px;
    background: var(--accent);
    transform-origin: bottom;
    transition: transform 300ms ease-in-out;
  }

  .fold__btn:hover .fold__art,
  .fold__btn[aria-expanded='true'] .fold__art {
    transform: translateY(-6px);
  }

  .fold__btn:hover:not([aria-expanded='true']) .fold__paper {
    transform: translate(-50%, 0%);
  }

  .fold__btn:hover .fold__front,
  .fold__btn[aria-expanded='true'] .fold__front {
    transform: skew(15deg) scaleY(0.6);
  }

  .fold__btn:hover .fold__front--right,
  .fold__btn[aria-expanded='true'] .fold__front--right {
    transform: skew(-15deg) scaleY(0.6);
  }

  .fold__btn[aria-expanded='true'] .fold__paper:nth-child(1) {
    transform: translate(-128%, -62%) rotate(-15deg);
  }

  .fold__btn[aria-expanded='true'] .fold__paper:nth-child(2) {
    height: 80%;
    transform: translate(28%, -62%) rotate(15deg);
  }

  .fold__btn[aria-expanded='true'] .fold__paper:nth-child(3) {
    height: 80%;
    transform: translate(-50%, -112%) rotate(4deg);
  }

  .fold__label {
    color: var(--muted);
    transition: color var(--t-fast) var(--ease-out);
  }

  .fold__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The hint and the list take turns in the same cell. */
  .fold__hint,
  .fold__list {
    grid-row: 1;
    grid-column: 2;
  }

  .fold__hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .fold__hint[hidden],
  .fold__list[hidden] {
    display: none;
  }

  .fold__list li {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.55;
    animation: fold-in 360ms var(--ease-out) both;
  }

  .fold__list li:nth-child(2) {
    animation-delay: 60ms;
  }

  .fold__list li:nth-child(3) {
    animation-delay: 120ms;
  }

  @keyframes fold-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (max-width: 560px) {
    .fold {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .fold__hint,
    .fold__list {
      grid-row: 2;
      grid-column: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-folder]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('.fold__btn');
    const list = root.querySelector<HTMLElement>('.fold__list');
    const hint = root.querySelector<HTMLElement>('.fold__hint');
    if (!button || !list) return;
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      list.hidden = !open;
      if (hint) hint.hidden = open;
    };
    // Starts closed once the script runs, so opening it is the reader's own discovery.
    set(false);
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
  });
</script>
