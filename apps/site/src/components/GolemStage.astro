---
// ---------------------------------------------------------------------------
// GolemStage — the character, in real-time WebGL (three.js).
//
// A golem carved out of stacked stone blocks, standing on a lit plinth. It is
// not decoration: it is a state machine that narrates the product.
//
//   dormant   → cold stone, eyes barely lit
//   listening → eyes wake, head turns to follow your pointer
//   thinking  → chest core pulses, quarry fragments orbit overhead
//   building  → fragments fly in and lock into the body, arms work
//   verifying → an inspection band sweeps up the body
//   done      → warm settle, then back to a slow breathing idle
//
// It also carries the mode identity: Clay is stubbier and warm, Stone is the
// baseline slab, Rune floats apart and hums violet.
//
// three.js is dynamically imported (own chunk) only after the stage scrolls
// into view AND the browser is idle, so it never blocks first paint. Until
// then — and forever, if WebGL is unavailable or motion is reduced — an inline
// SVG of the same golem holds the space at the same aspect ratio.
// ---------------------------------------------------------------------------

interface Props {
  /** where the stage starts; the page can drive it afterwards */
  state?: 'dormant' | 'listening' | 'thinking' | 'building' | 'verifying' | 'done';
  mode?: 'clay' | 'stone' | 'rune';
  class?: string;
}
const { state = 'listening', mode = 'stone', class: className = '' } = Astro.props;
---

<div
  class={`stage ${className}`}
  id="golem-stage"
  data-state={state}
  data-mode={mode}
  data-cursor="drag"
  data-cursor-label="drag to turn"
>
  <canvas class="stage__gl" id="golem-gl" aria-hidden="true"></canvas>

  <!-- Fallback + first paint: the same golem, flat. Never a blank box. -->
  <svg
    class="stage__svg"
    id="golem-svg"
    viewBox="0 0 320 400"
    role="img"
    aria-label="The Golem: a figure built from stacked stone blocks, standing on a lit plinth with two glowing rune eyes."
  >
    <defs>
      <linearGradient id="gs-stone" x1="0" y1="0" x2="0.3" y2="1">
        <stop offset="0" stop-color="var(--gl-body)" stop-opacity="1"></stop>
        <stop offset="1" stop-color="var(--gl-body)" stop-opacity="0.55"></stop>
      </linearGradient>
      <radialGradient id="gs-pool" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="var(--accent)" stop-opacity="0.28"></stop>
        <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <ellipse cx="160" cy="352" rx="118" ry="30" fill="url(#gs-pool)"></ellipse>
    <ellipse cx="160" cy="352" rx="84" ry="20" fill="var(--gl-body)" opacity="0.35"></ellipse>

    <g fill="url(#gs-stone)" stroke="var(--line-strong)" stroke-width="1.5" stroke-linejoin="round">
      <!-- legs -->
      <rect x="106" y="292" width="42" height="46" rx="7"></rect>
      <rect x="172" y="292" width="42" height="46" rx="7"></rect>
      <rect x="102" y="240" width="50" height="56" rx="8"></rect>
      <rect x="168" y="240" width="50" height="56" rx="8"></rect>
      <!-- hips + torso -->
      <rect x="100" y="204" width="120" height="42" rx="9"></rect>
      <rect x="96" y="152" width="128" height="56" rx="10"></rect>
      <rect x="88" y="106" width="144" height="50" rx="11"></rect>
      <!-- arms -->
      <rect x="46" y="112" width="44" height="48" rx="9"></rect>
      <rect x="230" y="112" width="44" height="48" rx="9"></rect>
      <rect x="50" y="162" width="38" height="52" rx="8"></rect>
      <rect x="232" y="162" width="38" height="52" rx="8"></rect>
      <rect x="44" y="216" width="48" height="42" rx="9"></rect>
      <rect x="228" y="216" width="48" height="42" rx="9"></rect>
      <!-- head -->
      <rect x="132" y="90" width="56" height="18" rx="5"></rect>
      <rect x="110" y="34" width="100" height="60" rx="12"></rect>
    </g>

    <!-- carved seams -->
    <g stroke="var(--line-strong)" stroke-width="1.4" fill="none" opacity="0.7">
      <path d="M110 62h34l16 12 16-12h34"></path>
      <path d="M96 176h128"></path>
    </g>

    <!-- rune light -->
    <rect x="126" y="66" width="22" height="9" rx="3" fill="var(--accent)"></rect>
    <rect x="172" y="66" width="22" height="9" rx="3" fill="var(--accent)"></rect>
    <rect x="146" y="168" width="28" height="28" rx="6" fill="var(--accent)" opacity="0.9"></rect>
  </svg>

  <!-- state read-out: a technical label, not a toy -->
  <p class="stage__readout" aria-live="polite">
    <span class="stage__pip"></span>
    <span id="golem-readout">idle</span>
  </p>
</div>

<style>
  .stage[data-mode='clay'] {
    --accent: var(--acc-clay);
    --accent-soft: var(--acc-clay-soft);
  }

  .stage[data-mode='stone'] {
    --accent: var(--acc-stone);
    --accent-soft: var(--acc-stone-soft);
  }

  .stage[data-mode='rune'] {
    --accent: var(--acc-rune);
    --accent-soft: var(--acc-rune-soft);
  }

  .stage {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    isolation: isolate;
  }

  /* the pool of light the golem stands in */
  .stage::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 78%;
    aspect-ratio: 1 / 1;
    transform: translateX(-50%);
    background: radial-gradient(
      circle at 50% 50%,
      var(--accent-soft),
      transparent 62%
    );
    z-index: -1;
    opacity: 0.9;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .stage[data-state='dormant']::before {
    opacity: 0.35;
  }

  .stage__gl,
  .stage__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage__gl {
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  .stage.is-live .stage__gl {
    opacity: 1;
  }

  .stage__svg {
    transition: opacity 500ms var(--ease-out);
  }

  .stage.is-live .stage__svg {
    opacity: 0;
    pointer-events: none;
  }

  .stage__readout {
    position: absolute;
    left: 50%;
    bottom: -0.25rem;
    transform: translateX(-50%);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  .stage__pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-soft);
    animation: pip 2.4s var(--ease-in-out) infinite;
  }

  @keyframes pip {
    0%,
    100% {
      box-shadow: 0 0 0 0 var(--accent-soft);
    }
    50% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__pip {
      animation: none;
    }
  }

  @media (max-width: 620px) {
    .stage {
      max-width: 100%;
    }

    .stage__readout {
      bottom: -0.5rem;
      font-size: 0.6rem;
    }
  }
</style>

<script>
  // ---------------------------------------------------------------------
  // Stage controller. Everything below is lazy: nothing here downloads
  // three.js until the stage is both visible and the main thread is free.
  // ---------------------------------------------------------------------
  type StageState =
    | 'dormant'
    | 'listening'
    | 'thinking'
    | 'building'
    | 'verifying'
    | 'done';
  type StageMode = 'clay' | 'stone' | 'rune';

  const host = document.getElementById('golem-stage') as HTMLElement | null;
  const canvas = document.getElementById('golem-gl') as HTMLCanvasElement | null;
  const readout = document.getElementById('golem-readout');

  const READOUT: Record<StageState, string> = {
    dormant: 'idle',
    listening: 'listening',
    thinking: 'planning',
    building: 'building in studio',
    verifying: 'verifying',
    done: 'verified',
  };

  if (host && canvas) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let state: StageState = (host.dataset.state as StageState) || 'listening';
    let mode: StageMode = (host.dataset.mode as StageMode) || 'stone';

    function applyLabels() {
      host!.dataset.state = state;
      host!.dataset.mode = mode;
      if (readout) readout.textContent = READOUT[state];
    }
    applyLabels();

    // page → stage messaging
    window.addEventListener('golem:state', (e) => {
      const next = (e as CustomEvent).detail?.state as StageState;
      if (!next || next === state) return;
      state = next;
      applyLabels();
      api?.setState(next);
    });

    window.addEventListener('golem:mode', (e) => {
      const next = (e as CustomEvent).detail?.mode as StageMode;
      if (!next || next === mode) return;
      mode = next;
      applyLabels();
      api?.setMode(next);
    });

    let api: {
      setState: (s: StageState) => void;
      setMode: (m: StageMode) => void;
      refreshTheme: () => void;
      dispose: () => void;
    } | null = null;

    // ------------------------------------------------------------------
    // boot: visible + idle + WebGL available
    // ------------------------------------------------------------------
    let booted = false;

    function hasWebGL() {
      try {
        const c = document.createElement('canvas');
        return !!(
          window.WebGLRenderingContext &&
          (c.getContext('webgl2') || c.getContext('webgl'))
        );
      } catch {
        return false;
      }
    }

    async function boot() {
      if (booted) return;
      booted = true;
      if (!hasWebGL()) return; // SVG stays — no error, no blank box
      try {
        api = await createStage(canvas!, host!, state, mode, reduced.matches);
        host!.classList.add('is-live');
      } catch (err) {
        // Any failure at all leaves the SVG golem in place.
        console.warn('[golem] WebGL stage unavailable', err);
      }
    }

    const idle =
      (window as any).requestIdleCallback ||
      ((fn: () => void) => setTimeout(fn, 260));

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            idle(() => boot(), { timeout: 1800 });
          }
        },
        { rootMargin: '160px' }
      );
      io.observe(host);
    } else {
      idle(() => boot());
    }

    window.addEventListener('golem:theme', () => api?.refreshTheme());
  }

  // =====================================================================
  // The scene
  // =====================================================================
  async function createStage(
    canvas: HTMLCanvasElement,
    host: HTMLElement,
    initialState: StageState,
    initialMode: StageMode,
    reducedMotion: boolean
  ) {
    const THREE = await import('three');

    const css = (name: string, fallback: string) => {
      const v = getComputedStyle(document.documentElement)
        .getPropertyValue(name)
        .trim();
      return v || fallback;
    };

    // ---------------- renderer ----------------
    const isSmall = window.matchMedia('(max-width: 760px)').matches;
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: !isSmall,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isSmall ? 1.5 : 2));
    // Filmic roll-off: the rune light can be genuinely bright without the
    // highlights clipping to a flat white square.
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
    camera.position.set(0, 1.75, 7.4);
    camera.lookAt(0, 1.35, 0);

    // ---------------- lights ----------------
    const hemi = new THREE.HemisphereLight(0xffffff, 0x000000, 0.85);
    scene.add(hemi);

    const key = new THREE.DirectionalLight(0xffffff, 2.1);
    key.position.set(-3.4, 5.2, 4.2);
    scene.add(key);

    const rim = new THREE.DirectionalLight(0xffffff, 1.15);
    rim.position.set(4.6, 2.2, -3.4);
    scene.add(rim);

    // the golem's own light source: the rune core in its chest
    const core = new THREE.PointLight(0xffffff, 1.1, 5.5, 2);
    core.position.set(0, 1.44, 0.95);
    scene.add(core);

    // ---------------- materials ----------------
    // Procedural stone grain: a small noise canvas doing double duty as
    // roughness and bump. Cheap, and it stops the golem reading as plastic.
    const grainTex = (() => {
      const size = 256;
      const c = document.createElement('canvas');
      c.width = c.height = size;
      const g = c.getContext('2d')!;
      const img = g.createImageData(size, size);
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          // two octaves of value noise, quantised into chisel-ish flecks
          const n =
            Math.sin(x * 0.37) * Math.cos(y * 0.29) * 0.5 +
            Math.sin((x + y) * 0.11) * 0.3 +
            Math.random() * 0.55;
          const v = Math.max(0, Math.min(255, 150 + n * 62));
          const i = (y * size + x) * 4;
          img.data[i] = img.data[i + 1] = img.data[i + 2] = v;
          img.data[i + 3] = 255;
        }
      }
      g.putImageData(img, 0, 0);
      const t = new THREE.CanvasTexture(c);
      t.wrapS = t.wrapT = THREE.RepeatWrapping;
      t.repeat.set(2.2, 2.2);
      return t;
    })();

    const stoneMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      roughness: 0.92,
      metalness: 0.04,
      roughnessMap: grainTex,
      bumpMap: grainTex,
      bumpScale: 0.28,
    });

    // Dark body + pure emissive: the hue comes entirely from the light it
    // gives off, so it never washes out under the key light.
    const runeMat = new THREE.MeshStandardMaterial({
      color: 0x110c07,
      emissive: 0xffffff,
      emissiveIntensity: 1,
      roughness: 0.35,
      metalness: 0,
    });

    // Eyes read as the brightest thing on the figure, always.
    const eyeMat = runeMat.clone();
    // The chest core is a lamp seen through stone: warm, never a white square.
    const chestMat = runeMat.clone();

    const plinthMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      roughness: 0.95,
      metalness: 0,
    });

    // ---------------- geometry helpers ----------------
    let RoundedBoxGeometry: any = null;
    try {
      ({ RoundedBoxGeometry } = await import(
        'three/addons/geometries/RoundedBoxGeometry.js'
      ));
    } catch {
      RoundedBoxGeometry = null; // plain boxes still look fine
    }

    const boxCache = new Map<string, any>();
    function block(w: number, h: number, d: number, r = 0.06) {
      const k = `${w}|${h}|${d}|${r}`;
      let g = boxCache.get(k);
      if (!g) {
        g = RoundedBoxGeometry
          ? new RoundedBoxGeometry(w, h, d, 2, r)
          : new THREE.BoxGeometry(w, h, d);
        boxCache.set(k, g);
      }
      return g;
    }

    // ---------------- the body ----------------
    interface Part {
      mesh: any;
      home: any; // assembled position
      away: any; // quarry position
      spin: any; // quarry rotation
      group: 'leg' | 'torso' | 'armL' | 'armR' | 'head' | 'rune';
    }

    const golem = new THREE.Group();
    scene.add(golem);

    const headGroup = new THREE.Group();
    golem.add(headGroup);

    const parts: Part[] = [];

    function addPart(
      w: number,
      h: number,
      d: number,
      x: number,
      y: number,
      z: number,
      group: Part['group'],
      material = stoneMat,
      radius = 0.06
    ) {
      const mesh = new THREE.Mesh(block(w, h, d, radius), material);
      const home = new THREE.Vector3(x, y, z);
      // quarry position: flung outward from the body's centre line
      const dir = new THREE.Vector3(
        x + (Math.random() - 0.5) * 2.4,
        (Math.random() - 0.2) * 2.6,
        (Math.random() - 0.5) * 2.2
      ).normalize();
      const away = home.clone().add(dir.multiplyScalar(2.6 + Math.random() * 1.9));
      const spin = new THREE.Euler(
        (Math.random() - 0.5) * 2.4,
        (Math.random() - 0.5) * 2.4,
        (Math.random() - 0.5) * 2.4
      );
      mesh.position.copy(home);
      (group === 'head' ? headGroup : golem).add(mesh);
      parts.push({ mesh, home, away, spin, group });
      return mesh;
    }

    // legs
    addPart(0.5, 0.3, 0.66, -0.4, 0.2, 0.02, 'leg');
    addPart(0.5, 0.3, 0.66, 0.4, 0.2, 0.02, 'leg');
    addPart(0.44, 0.56, 0.46, -0.34, 0.58, 0, 'leg');
    addPart(0.44, 0.56, 0.46, 0.34, 0.58, 0, 'leg');
    // hips + torso
    addPart(1.02, 0.36, 0.58, 0, 1.0, 0, 'torso');
    addPart(1.1, 0.46, 0.62, 0, 1.38, 0, 'torso');
    addPart(1.26, 0.44, 0.66, 0, 1.8, 0, 'torso');
    // shoulders + arms
    const shoulderL = addPart(0.44, 0.44, 0.52, -0.82, 1.86, 0, 'armL');
    const shoulderR = addPart(0.44, 0.44, 0.52, 0.82, 1.86, 0, 'armR');
    const upperL = addPart(0.36, 0.54, 0.4, -0.9, 1.4, 0, 'armL');
    const upperR = addPart(0.36, 0.54, 0.4, 0.9, 1.4, 0, 'armR');
    const fistL = addPart(0.46, 0.4, 0.46, -0.94, 0.98, 0.04, 'armL');
    const fistR = addPart(0.46, 0.4, 0.46, 0.94, 0.98, 0.04, 'armR');
    // neck + head
    addPart(0.44, 0.18, 0.42, 0, 2.1, 0, 'head');
    addPart(0.9, 0.64, 0.74, 0, 2.46, 0, 'head', stoneMat, 0.09);

    // rune light: eyes, brow seam, chest core
    const eyeL = addPart(0.2, 0.1, 0.06, -0.2, 2.44, 0.38, 'head', eyeMat, 0.02);
    const eyeR = addPart(0.2, 0.1, 0.06, 0.2, 2.44, 0.38, 'head', eyeMat, 0.02);
    const brow = addPart(0.78, 0.035, 0.04, 0, 2.66, 0.38, 'head', runeMat, 0.01);
    const chest = addPart(0.3, 0.3, 0.1, 0, 1.44, 0.34, 'rune', chestMat, 0.04);

    // ---------------- plinth + contact shadow ----------------
    const plinth = new THREE.Mesh(
      new THREE.CylinderGeometry(1.55, 1.72, 0.16, 48),
      plinthMat
    );
    plinth.position.y = -0.03;
    scene.add(plinth);

    // the plinth rim catches the golem's own light — reads as a lit workbench
    const rimRing = new THREE.Mesh(
      new THREE.TorusGeometry(1.63, 0.016, 6, 72),
      new THREE.MeshBasicMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: 0.5,
        depthWrite: false,
      })
    );
    rimRing.rotation.x = Math.PI / 2;
    rimRing.position.y = 0.045;
    scene.add(rimRing);

    // fake contact shadow — a gradient sprite, far cheaper than a shadow map
    const shadowTex = (() => {
      const c = document.createElement('canvas');
      c.width = c.height = 128;
      const g = c.getContext('2d')!;
      const grad = g.createRadialGradient(64, 64, 2, 64, 64, 62);
      grad.addColorStop(0, 'rgba(0,0,0,0.5)');
      grad.addColorStop(0.35, 'rgba(0,0,0,0.2)');
      grad.addColorStop(0.7, 'rgba(0,0,0,0.05)');
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      g.fillStyle = grad;
      g.fillRect(0, 0, 128, 128);
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      return t;
    })();

    const contact = new THREE.Mesh(
      new THREE.PlaneGeometry(2.5, 2.5),
      new THREE.MeshBasicMaterial({
        map: shadowTex,
        transparent: true,
        depthWrite: false,
        opacity: 0.7,
      })
    );
    contact.rotation.x = -Math.PI / 2;
    contact.position.y = 0.055;
    scene.add(contact);

    // ---------------- quarry fragments (orbit during thinking) ----------
    const fragments: any[] = [];
    const fragGroup = new THREE.Group();
    scene.add(fragGroup);
    for (let i = 0; i < 7; i++) {
      const s = 0.13 + Math.random() * 0.12;
      const m = new THREE.Mesh(block(s, s, s, 0.02), stoneMat.clone());
      m.material.transparent = true;
      m.material.opacity = 0;
      m.material.emissive = new THREE.Color(0xffffff);
      m.material.emissiveIntensity = 0.22;
      (m as any).userData = {
        radius: 1.7 + Math.random() * 0.7,
        speed: 0.28 + Math.random() * 0.3,
        phase: (i / 7) * Math.PI * 2,
        height: 1.6 + Math.random() * 1.5,
      };
      fragGroup.add(m);
      fragments.push(m);
    }

    // ---------------- inspection band (verifying) -----------------------
    const band = new THREE.Mesh(
      new THREE.TorusGeometry(1.25, 0.012, 6, 64),
      new THREE.MeshBasicMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: 0,
        depthWrite: false,
      })
    );
    band.rotation.x = Math.PI / 2;
    scene.add(band);

    // ---------------- theme + mode colouring ----------------------------
    // The light a golem gives off is a property of the golem, not of the
    // page theme — so these are fixed, saturated emission colours rather than
    // the text-contrast accents the CSS uses.
    const MODE_LIGHT: Record<StageMode, number> = {
      clay: 0xff8a3d,
      stone: 0x7ec8f2,
      rune: 0xb083ff,
    };

    let mode: StageMode = initialMode;
    let state: StageState = initialState;

    const accentColor = new THREE.Color(0xffffff);
    const targetAccent = new THREE.Color(0xffffff);
    const bodyColor = new THREE.Color(0xffffff);
    const targetBody = new THREE.Color(0xffffff);

    function readTheme(instant = false) {
      const isDark =
        document.documentElement.getAttribute('data-theme') === 'dark' ||
        (!document.documentElement.hasAttribute('data-theme') &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);

      targetAccent.setHex(MODE_LIGHT[mode]);

      // Clay is warmer stone, Rune is darker stone; Stone is the baseline.
      const base = css('--gl-body', isDark ? '#4e4740' : '#cdc4b6');
      targetBody.set(base);
      if (mode === 'clay') targetBody.offsetHSL(0.02, 0.16, isDark ? 0.03 : 0.0);
      if (mode === 'rune') targetBody.offsetHSL(-0.06, 0.08, isDark ? -0.02 : -0.06);

      key.color.set(css('--gl-key', '#ffdcae'));
      rim.color.set(css('--gl-fill', '#34506b'));
      hemi.color.set(css('--gl-key', '#ffdcae'));
      hemi.groundColor.set(css('--gl-ground', '#100e0c'));
      hemi.intensity = isDark ? 0.6 : 0.95;
      key.intensity = isDark ? 2.6 : 2.35;
      rim.intensity = isDark ? 2.4 : 1.0;
      plinthMat.color.set(css('--gl-plinth', css('--gl-ground', '#ddd6c9')));
      contact.material.opacity = isDark ? 0.5 : 0.68;
      (band.material as any).color.copy(targetAccent);

      if (instant) {
        accentColor.copy(targetAccent);
        bodyColor.copy(targetBody);
        stoneMat.color.copy(bodyColor);
        runeMat.color.copy(accentColor);
        runeMat.emissive.copy(accentColor);
        core.color.copy(accentColor);
      }
    }
    readTheme(true);

    // ---------------- responsive sizing ---------------------------------
    function resize() {
      const r = host.getBoundingClientRect();
      const w = Math.max(1, Math.round(r.width));
      const h = Math.max(1, Math.round(r.height));
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      // keep the whole figure framed on narrow viewports
      camera.position.z = w < 420 ? 8.6 : w < 620 ? 8.0 : 7.4;
      camera.updateProjectionMatrix();
    }

    const ro = new ResizeObserver(resize);
    ro.observe(host);
    resize();

    // ---------------- pointer tracking ----------------------------------
    let pointerX = 0;
    let pointerY = 0;
    let dragging = false;
    let dragYaw = 0;
    let lastDragX = 0;

    function onMove(e: PointerEvent) {
      const r = host.getBoundingClientRect();
      pointerX = ((e.clientX - r.left) / r.width) * 2 - 1;
      pointerY = ((e.clientY - r.top) / r.height) * 2 - 1;
      if (dragging) {
        dragYaw += (e.clientX - lastDragX) * 0.008;
        lastDragX = e.clientX;
      }
    }
    window.addEventListener('pointermove', onMove, { passive: true });

    host.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastDragX = e.clientX;
      host.setPointerCapture?.(e.pointerId);
    });
    host.addEventListener('pointerup', () => (dragging = false));
    host.addEventListener('pointercancel', () => (dragging = false));

    // ---------------- state machine -------------------------------------
    let assembly = 1; // 0 = quarry, 1 = assembled
    let targetAssembly = 1;
    let eyeGlow = 0.8;
    let targetEye = 0.8;
    let coreGlow = 1;
    let targetCore = 1;
    let fragVis = 0;
    let targetFrag = 0;
    let bandT = -1; // <0 = off
    let separation = 0;
    let targetSeparation = 0;
    let armPhase = 0;
    let settle = 0;

    function setState(next: StageState) {
      state = next;
      switch (next) {
        case 'dormant':
          targetAssembly = 1;
          targetEye = 0.12;
          targetCore = 0.15;
          targetFrag = 0;
          break;
        case 'listening':
          targetAssembly = 1;
          targetEye = 0.95;
          targetCore = 0.75;
          targetFrag = 0;
          break;
        case 'thinking':
          targetAssembly = 1;
          targetEye = 1.15;
          targetCore = 1.6;
          targetFrag = 1;
          break;
        case 'building':
          targetAssembly = 0.16; // blocks fly apart, then re-lock
          targetEye = 1.3;
          targetCore = 2.1;
          targetFrag = 1;
          window.setTimeout(() => {
            if (state === 'building') targetAssembly = 1;
          }, 520);
          break;
        case 'verifying':
          targetAssembly = 1;
          targetEye = 1.1;
          targetCore = 1.2;
          targetFrag = 0;
          bandT = 0;
          break;
        case 'done':
          targetAssembly = 1;
          targetEye = 1.45;
          targetCore = 1.5;
          targetFrag = 0;
          settle = 1;
          break;
      }
    }

    function setMode(next: StageMode) {
      mode = next;
      targetSeparation = next === 'rune' ? 0.075 : 0;
      readTheme();
    }

    setState(initialState);
    setMode(initialMode);

    // ---------------- render loop ---------------------------------------
    const clock = new THREE.Clock();
    let raf = 0;
    let visible = true;
    let running = false;
    const tmp = new THREE.Vector3();

    function frame() {
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      // eased scalars
      const k = 1 - Math.pow(0.0015, dt);
      assembly += (targetAssembly - assembly) * k;
      eyeGlow += (targetEye - eyeGlow) * k;
      coreGlow += (targetCore - coreGlow) * k;
      fragVis += (targetFrag - fragVis) * k;
      separation += (targetSeparation - separation) * k;
      accentColor.lerp(targetAccent, k);
      bodyColor.lerp(targetBody, k);

      stoneMat.color.copy(bodyColor);
      runeMat.color.copy(accentColor);
      runeMat.emissive.copy(accentColor);
      core.color.copy(accentColor);

      // breathing + settle bounce
      const breathe = Math.sin(t * 1.05) * 0.018;
      if (settle > 0) settle = Math.max(0, settle - dt * 1.6);
      const bounce = settle > 0 ? Math.sin(settle * Math.PI * 2) * settle * 0.09 : 0;
      golem.position.y = breathe + bounce;

      // body turns to face the pointer (or the drag)
      const yaw = dragYaw + pointerX * 0.34;
      const pitch = pointerY * 0.1;
      golem.rotation.y += (yaw * 0.55 - golem.rotation.y) * (dt * 3.2);
      headGroup.rotation.y += (yaw * 0.72 - headGroup.rotation.y) * (dt * 5);
      headGroup.rotation.x += (pitch * 0.5 - headGroup.rotation.x) * (dt * 5);

      // assemble / disperse
      const ease = assembly * assembly * (3 - 2 * assembly);
      for (let i = 0; i < parts.length; i++) {
        const p = parts[i];
        tmp.copy(p.away).lerp(p.home, ease);

        // rune mode: segments drift apart and float on their own clock
        if (separation > 0.001) {
          const dirY = p.home.y - 1.3;
          tmp.y += dirY * separation + Math.sin(t * 0.9 + i) * separation * 0.35;
          tmp.x += p.home.x * separation * 0.5;
        }

        // arms work while building
        if (state === 'building' && (p.group === 'armL' || p.group === 'armR')) {
          const dir = p.group === 'armL' ? 1 : -1;
          tmp.y += Math.sin(armPhase + (dir > 0 ? 0 : Math.PI)) * 0.09;
          tmp.z += Math.cos(armPhase + (dir > 0 ? 0 : Math.PI)) * 0.06;
        }

        p.mesh.position.copy(tmp);

        const spinAmt = 1 - ease;
        p.mesh.rotation.set(
          p.spin.x * spinAmt,
          p.spin.y * spinAmt,
          p.spin.z * spinAmt
        );
      }

      if (state === 'building') armPhase += dt * 5.2;

      // rune light response
      const pulse =
        state === 'thinking'
          ? 0.6 + Math.abs(Math.sin(t * 3.4)) * 0.9
          : state === 'building'
            ? 0.75 + Math.abs(Math.sin(t * 6.2)) * 0.6
            : 1;
      runeMat.emissiveIntensity = Math.min(1, Math.max(0.06, eyeGlow * pulse * 0.62));
      eyeMat.color.copy(runeMat.color);
      eyeMat.emissive.copy(runeMat.emissive);
      eyeMat.emissiveIntensity = Math.min(1, Math.max(0.1, eyeGlow * pulse * 0.9));
      chestMat.color.copy(runeMat.color);
      chestMat.emissive.copy(runeMat.emissive);
      chestMat.emissiveIntensity = Math.min(0.85, Math.max(0.05, coreGlow * pulse * 0.4));
      core.intensity = Math.max(0.08, coreGlow * pulse * 0.85);
      core.position.set(0, 1.44 + golem.position.y, 0.95);

      // orbiting quarry fragments
      fragGroup.visible = fragVis > 0.01;
      if (fragGroup.visible) {
        for (const m of fragments) {
          const u = m.userData;
          const a = t * u.speed + u.phase;
          const pull = state === 'building' ? 0.45 : 1;
          m.position.set(
            Math.cos(a) * u.radius * pull,
            u.height + Math.sin(a * 1.7) * 0.16,
            Math.sin(a) * u.radius * pull
          );
          m.rotation.x += dt * 0.6;
          m.rotation.y += dt * 0.9;
          m.material.opacity = fragVis * 0.9;
          m.material.color.copy(bodyColor);
          m.material.emissive.copy(accentColor);
          m.material.emissiveIntensity = 0.16 + Math.abs(Math.sin(t * 2 + u.phase)) * 0.16;
        }
      }

      (rimRing.material as any).color.copy(accentColor);
      (rimRing.material as any).opacity = 0.18 + Math.min(0.45, coreGlow * 0.22);

      // inspection band sweeps the figure
      if (bandT >= 0) {
        bandT += dt * 0.75;
        if (bandT > 1.15) {
          bandT = -1;
          (band.material as any).opacity = 0;
        } else {
          band.position.y = bandT * 3.0;
          (band.material as any).color.copy(accentColor);
          (band.material as any).opacity =
            Math.sin(Math.min(1, bandT) * Math.PI) * 0.85;
        }
      }

      renderer.render(scene, camera);
      if (running) raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reducedMotion) return;
      running = true;
      clock.getDelta();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    if (reducedMotion) {
      // one composed frame: assembled, lit, no loop, no pointer response
      assembly = targetAssembly = 1;
      eyeGlow = targetEye;
      coreGlow = targetCore;
      for (const p of parts) p.mesh.position.copy(p.home);
      runeMat.emissiveIntensity = Math.max(0.4, eyeGlow);
      core.intensity = Math.max(0.6, coreGlow);
      renderer.render(scene, camera);
    } else {
      const vis = new IntersectionObserver(
        (entries) => {
          visible = entries.some((e) => e.isIntersecting);
          if (visible && !document.hidden) start();
          else stop();
        },
        { rootMargin: '120px' }
      );
      vis.observe(host);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (visible) start();
      });

      start();
    }

    return {
      setState: (s: StageState) => {
        setState(s);
        if (reducedMotion) {
          for (const p of parts) p.mesh.position.copy(p.home);
          runeMat.emissiveIntensity = Math.max(0.4, targetEye);
          core.intensity = Math.max(0.6, targetCore);
          renderer.render(scene, camera);
        }
      },
      setMode: (m: StageMode) => {
        setMode(m);
        if (reducedMotion) {
          accentColor.copy(targetAccent);
          bodyColor.copy(targetBody);
          stoneMat.color.copy(bodyColor);
          runeMat.color.copy(accentColor);
          runeMat.emissive.copy(accentColor);
          core.color.copy(accentColor);
          renderer.render(scene, camera);
        }
      },
      refreshTheme: () => {
        readTheme(reducedMotion);
        if (reducedMotion) renderer.render(scene, camera);
      },
      dispose: () => {
        stop();
        ro.disconnect();
        renderer.dispose();
      },
    };
  }
</script>
