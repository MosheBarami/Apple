---
// Hero visual. A <div id="golem-hero-3d"> mount that lazy-loads a GLB with
// three.js — but only if /assets/hero/golem.glb actually exists (HEAD check).
// Until that model lands, a layered inline-SVG colossus with pointer parallax
// carries the hero. The fallback is the product of love, not a placeholder.
---

<div class="hero-visual">
  <div id="golem-hero-3d" class="hero-3d" aria-hidden="true"></div>

  <div class="hero-fallback" id="hero-fallback" aria-hidden="true">
    <!-- depth-layered SVG colossus -->
    <div class="layer layer-halo" data-depth="6">
      <svg viewBox="0 0 520 520" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="hv-halo" cx="0.5" cy="0.42" r="0.55">
            <stop offset="0" stop-color="#7C5CFF" stop-opacity="0.34"></stop>
            <stop offset="0.55" stop-color="#FFB454" stop-opacity="0.1"></stop>
            <stop offset="1" stop-color="#FFB454" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <circle cx="260" cy="230" r="230" fill="url(#hv-halo)"></circle>
        <!-- rune ring -->
        <g class="hv-ring" stroke="#7C5CFF" stroke-opacity="0.35" stroke-width="1.5">
          <circle cx="260" cy="235" r="188" stroke-dasharray="3 14"></circle>
        </g>
      </svg>
    </div>

    <div class="layer layer-shards" data-depth="14">
      <svg viewBox="0 0 520 520" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#3c4c66" stroke-width="2">
          <path class="hv-float hv-f1" d="M64 180 L96 164 L104 202 L72 214 Z" fill="#1A2233"></path>
          <path class="hv-float hv-f2" d="M448 150 L420 136 L410 176 L438 186 Z" fill="#1A2233"></path>
          <path class="hv-float hv-f3" d="M88 360 L116 350 L120 380 L94 388 Z" fill="#151b29"></path>
          <path class="hv-float hv-f2" d="M436 340 L410 330 L406 362 L430 370 Z" fill="#151b29"></path>
          <path class="hv-float hv-f1" d="M150 80 L172 70 L178 96 L156 104 Z" fill="#1f2942"></path>
          <path class="hv-float hv-f3" d="M380 66 L360 58 L354 84 L374 90 Z" fill="#1f2942"></path>
        </g>
      </svg>
    </div>

    <div class="layer layer-body" data-depth="26">
      <svg viewBox="0 0 520 520" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="hv-slab" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2a3550"></stop>
            <stop offset="1" stop-color="#141b2b"></stop>
          </linearGradient>
          <linearGradient id="hv-slab2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#232d47"></stop>
            <stop offset="1" stop-color="#101523"></stop>
          </linearGradient>
        </defs>
        <g stroke="#3c4c66" stroke-width="2.5">
          <!-- ground shadow -->
          <ellipse cx="260" cy="470" rx="150" ry="16" fill="#000" opacity="0.4" stroke="none"></ellipse>
          <!-- legs -->
          <path d="M180 340 L240 340 L232 452 L226 462 L188 462 L182 452 Z" fill="url(#hv-slab2)"></path>
          <path d="M280 340 L340 340 L338 452 L332 462 L294 462 L288 452 Z" fill="url(#hv-slab2)"></path>
          <!-- torso: two slabs with a molten seam between them -->
          <path d="M150 200 L370 200 L356 288 L164 288 Z" fill="url(#hv-slab)"></path>
          <path d="M168 300 L352 300 L338 344 L182 344 Z" fill="url(#hv-slab2)"></path>
          <!-- molten seam -->
          <path class="hv-seam" d="M166 294 L354 294" stroke="#FFB454" stroke-width="3"></path>
          <!-- shoulders -->
          <path d="M96 206 L148 190 L156 262 L110 272 Z" fill="url(#hv-slab)"></path>
          <path d="M424 206 L372 190 L364 262 L410 272 Z" fill="url(#hv-slab)"></path>
          <!-- arms -->
          <path d="M104 276 L150 268 L146 356 L138 366 L110 360 L104 350 Z" fill="url(#hv-slab2)"></path>
          <path d="M416 276 L370 268 L374 356 L382 366 L410 360 L416 350 Z" fill="url(#hv-slab2)"></path>
          <!-- head -->
          <path d="M196 78 L324 78 L334 104 L334 158 L318 182 L202 182 L186 158 L186 104 Z" fill="url(#hv-slab)"></path>
          <!-- crown notch -->
          <path d="M240 60 L260 46 L280 60 L274 78 L246 78 Z" fill="url(#hv-slab2)"></path>
          <!-- carved face seams -->
          <path d="M186 128 L232 128 M288 128 L334 128" stroke-opacity="0.7"></path>
          <path d="M150 236 L260 226 L370 236" stroke-opacity="0.6" fill="none"></path>
          <path d="M182 322 L260 315 L338 322" stroke-opacity="0.45" fill="none"></path>
          <!-- eyes -->
          <rect class="hv-eye" x="216" y="138" width="30" height="8" rx="2" fill="#FFB454" stroke="none"></rect>
          <rect class="hv-eye" x="274" y="138" width="30" height="8" rx="2" fill="#FFB454" stroke="none"></rect>
          <!-- forehead rune -->
          <path class="hv-rune" d="M260 92 L272 104 L260 116 L248 104 Z M260 98 L260 110" stroke="#7C5CFF" stroke-width="2.5" fill="none"></path>
          <!-- chest rune -->
          <path class="hv-rune" d="M238 240 L260 258 L282 240 M238 256 L260 274 L282 256" stroke="#7C5CFF" stroke-width="3" fill="none"></path>
          <!-- knuckle runes -->
          <rect class="hv-eye" x="116" y="330" width="22" height="6" rx="2" fill="#FFB454" opacity="0.7" stroke="none"></rect>
          <rect class="hv-eye" x="382" y="330" width="22" height="6" rx="2" fill="#FFB454" opacity="0.7" stroke="none"></rect>
        </g>
      </svg>
    </div>

    <div class="layer layer-sparks" data-depth="40">
      <svg viewBox="0 0 520 520" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g fill="#FFB454">
          <circle class="hv-spark hv-f1" cx="120" cy="140" r="2.5" opacity="0.9"></circle>
          <circle class="hv-spark hv-f2" cx="420" cy="120" r="2" opacity="0.7"></circle>
          <circle class="hv-spark hv-f3" cx="90" cy="300" r="1.8" opacity="0.6"></circle>
          <circle class="hv-spark hv-f2" cx="450" cy="280" r="2.4" opacity="0.8"></circle>
          <circle class="hv-spark hv-f1" cx="380" cy="420" r="1.6" opacity="0.5"></circle>
          <circle class="hv-spark hv-f3" cx="150" cy="430" r="2" opacity="0.6"></circle>
        </g>
        <g fill="#7C5CFF">
          <circle class="hv-spark hv-f2" cx="200" cy="60" r="1.8" opacity="0.7"></circle>
          <circle class="hv-spark hv-f1" cx="340" cy="40" r="2.2" opacity="0.6"></circle>
        </g>
      </svg>
    </div>
  </div>
</div>

<style>
  .hero-visual {
    position: relative;
    width: min(520px, 92vw);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .hero-3d {
    position: absolute;
    inset: 0;
    display: none;
  }

  .hero-3d.active {
    display: block;
  }

  .hero-fallback {
    position: absolute;
    inset: 0;
    animation: hv-breathe 7s ease-in-out infinite;
  }

  .hero-fallback.hidden {
    display: none;
  }

  .layer {
    position: absolute;
    inset: 0;
    transition: transform 400ms cubic-bezier(0.15, 0.6, 0.3, 1);
    will-change: transform;
  }

  .layer svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hv-eye {
    filter: drop-shadow(0 0 8px rgba(255, 180, 84, 0.85));
    animation: hv-blink 6.5s ease-in-out infinite;
  }

  .hv-rune {
    filter: drop-shadow(0 0 8px rgba(124, 92, 255, 0.8));
    animation: hv-pulse 3.4s ease-in-out infinite;
  }

  .hv-seam {
    filter: drop-shadow(0 0 10px rgba(255, 180, 84, 0.9));
    stroke-dasharray: 10 6;
    animation: hv-flow 3.5s linear infinite;
  }

  .hv-ring {
    transform-origin: 260px 235px;
    animation: hv-spin 90s linear infinite;
  }

  .hv-float {
    animation: hv-drift 6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hv-spark {
    animation: hv-drift 5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hv-f2 {
    animation-delay: -2s;
    animation-duration: 7s;
  }

  .hv-f3 {
    animation-delay: -3.5s;
    animation-duration: 8s;
  }

  @keyframes hv-breathe {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes hv-blink {
    0%,
    46%,
    52%,
    100% {
      opacity: 1;
    }
    49% {
      opacity: 0.15;
    }
  }

  @keyframes hv-pulse {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes hv-flow {
    to {
      stroke-dashoffset: -32;
    }
  }

  @keyframes hv-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hv-drift {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fallback,
    .hv-eye,
    .hv-rune,
    .hv-seam,
    .hv-ring,
    .hv-float,
    .hv-spark {
      animation: none;
    }

    .layer {
      transition: none;
    }
  }
</style>

<script>
  const mount = document.getElementById('golem-hero-3d');
  const fallback = document.getElementById('hero-fallback');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // --- parallax on the SVG fallback -------------------------------------
  if (fallback && !reduced.matches && matchMedia('(pointer: fine)').matches) {
    const layers = Array.from(fallback.querySelectorAll<HTMLElement>('.layer'));
    const onMove = (e: PointerEvent) => {
      const rect = fallback.getBoundingClientRect();
      const nx = (e.clientX - rect.left - rect.width / 2) / rect.width; // -0.5..0.5
      const ny = (e.clientY - rect.top - rect.height / 2) / rect.height;
      for (const layer of layers) {
        const depth = Number(layer.dataset.depth || 0);
        layer.style.transform = `translate3d(${(-nx * depth).toFixed(1)}px, ${(-ny * depth).toFixed(1)}px, 0)`;
      }
    };
    const onLeave = () => {
      for (const layer of layers) layer.style.transform = '';
    };
    const zone = fallback.closest('.hero') ?? fallback;
    zone.addEventListener('pointermove', onMove as EventListener);
    zone.addEventListener('pointerleave', onLeave);
  }

  // --- optional GLB hero: only load three.js if the model file exists ----
  async function tryLoadModel() {
    if (!mount || !fallback) return;
    let exists = false;
    try {
      const res = await fetch('/assets/hero/golem.glb', { method: 'HEAD' });
      const type = res.headers.get('content-type') || '';
      // SPA-style hosts answer HEAD for missing files with 200 + text/html;
      // require a non-HTML response to count as a real model.
      exists = res.ok && !type.includes('text/html');
    } catch {
      exists = false;
    }
    if (!exists) return; // keep the SVG colossus

    try {
      const [THREE, { GLTFLoader }] = await Promise.all([
        import('three'),
        import('three/examples/jsm/loaders/GLTFLoader.js'),
      ]);

      const scene = new THREE.Scene();
      const rect = mount.getBoundingClientRect();
      const camera = new THREE.PerspectiveCamera(38, rect.width / rect.height, 0.1, 100);
      camera.position.set(0, 1.1, 4.2);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(rect.width, rect.height);
      mount.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0x8a94a6, 0.7));
      const key = new THREE.DirectionalLight(0xffb454, 2.2);
      key.position.set(2.5, 3, 2);
      scene.add(key);
      const rim = new THREE.DirectionalLight(0x7c5cff, 1.6);
      rim.position.set(-3, 1.5, -2);
      scene.add(rim);

      const gltf = await new GLTFLoader().loadAsync('/assets/hero/golem.glb');
      const model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const size = box.getSize(new THREE.Vector3());
      const scale = 2.4 / Math.max(size.x, size.y, size.z);
      model.scale.setScalar(scale);
      box.setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      model.position.sub(center);
      scene.add(model);

      // swap in only after a successful first frame
      renderer.render(scene, camera);
      mount.classList.add('active');
      fallback.classList.add('hidden');

      if (!reduced.matches) {
        const spin = () => {
          model.rotation.y += 0.004;
          renderer.render(scene, camera);
          requestAnimationFrame(spin);
        };
        requestAnimationFrame(spin);
      }

      window.addEventListener('resize', () => {
        const r = mount.getBoundingClientRect();
        camera.aspect = r.width / r.height;
        camera.updateProjectionMatrix();
        renderer.setSize(r.width, r.height);
        renderer.render(scene, camera);
      });
    } catch {
      // any failure: quietly keep the SVG fallback
      mount.classList.remove('active');
      fallback.classList.remove('hidden');
    }
  }

  if ('requestIdleCallback' in window) {
    (window as Window & typeof globalThis).requestIdleCallback(() => void tryLoadModel(), { timeout: 4000 });
  } else {
    setTimeout(() => void tryLoadModel(), 1200);
  }
</script>
