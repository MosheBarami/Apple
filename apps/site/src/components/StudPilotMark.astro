---
/**
 * The StudPilot mark: one path in `currentColor`, the same drawing as
 * packages/design/brand/studpilot-mark.svg (packages/design/src/web/brand.test.mjs holds the two
 * equal). It takes the accent unless a caller sets a colour.
 */
interface Props { size?: number; class?: string; alive?: boolean; }
const { size = 32, class: className = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={`studpilot-mark ${className}`}>
  <path fill-rule="evenodd" d="M12 3H27.8Q29 3 29 4.2V20A9 9 0 0 1 20 29H12A9 9 0 0 1 3 20V12A9 9 0 0 1 12 3ZM20 17a4.6 4.6 0 1 0-9.2 0 4.6 4.6 0 0 0 9.2 0Z"></path>
</svg>
<style>.studpilot-mark { flex: none; display: block; color: var(--accent); }</style>
