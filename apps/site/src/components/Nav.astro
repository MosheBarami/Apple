---
import StudPilotMark from './StudPilotMark.astro';

/*
 * THE SITE'S ONE HEADER (M2 rebuild, handoff 2.2).
 *
 * How it works, Catalog, Pricing, Docs, Blog, Discord, Sign in, and one primary button, "Start free (beta)".
 * Every route renders this component through Base.astro, so there is one header. The links are root-relative
 * and each goes to a page the build emits (tests/nav-and-routes.test.mjs reads them back out of the built
 * HTML and fails on one that does not resolve, or that points at a redirect).
 *
 * The two doors go to the web app, which the worker serves under /app: /app/login and /app/signup are the
 * app's own routes (apps/web/src/app.tsx).
 *
 * On a narrow screen the link list folds into a panel under the bar and the primary button stays in the bar.
 * Without scripting the panel is simply open (`.no-js`), so nothing is ever hidden behind a button that does
 * not work.
 */
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/catalog', label: 'Catalog' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/blog', label: 'Blog' },
  { href: '/discord', label: 'Discord' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
---

<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="StudPilot, home">
      <StudPilotMark size={24} />
      <span class="brand__word">StudPilot</span>
      <span class="badge brand__beta">Beta</span>
    </a>

    <nav aria-label="Primary" id="primary-nav" class="nav__links">
      <ul class="nav__list" id="nav-list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="nav__signin">
          <a href="/app/login">Sign in</a>
        </li>
      </ul>

      <div class="nav__tools">
        <button class="iconbtn" data-theme-toggle type="button" aria-pressed="true" aria-label="Dark theme">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="icon-sun">
            <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
            <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </g>
          </svg>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="icon-moon">
            <path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z" fill="currentColor"></path>
          </svg>
        </button>
        <a href="/app/signup" class="btn btn-primary nav__cta">Start free (beta)</a>
        <button class="iconbtn nav__burger" id="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-list" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  /* A flat bar: the page colour, one hairline under it. It stays at the top while the page moves under it. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 500;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: var(--nav-h);
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand__word {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav__links {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    min-width: 0;
  }

  .nav__list {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 10px;
    border-radius: var(--r-sm);
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out), background-color var(--t-fast) var(--ease-out);
  }

  .nav__list a:hover {
    background: var(--control-fill);
    color: var(--ink);
  }

  /* The page you are on: ink, and a short accent rule under it, so it is not carried by colour alone. */
  .nav__list a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: var(--r-xs);
  }

  .nav__signin {
    margin-left: auto;
  }

  .nav__tools {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }

  .iconbtn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--t-fast) var(--ease-out), background-color var(--t-fast) var(--ease-out);
  }

  .iconbtn:hover {
    background: var(--control-fill);
    color: var(--ink);
  }

  /* The toggle shows the sun while the theme is dark (press for light) and the moon while it is light. */
  .icon-moon {
    display: none;
  }

  :global(html[data-theme='light']) .icon-sun {
    display: none;
  }

  :global(html[data-theme='light']) .icon-moon {
    display: block;
  }

  .nav__burger {
    display: none;
  }

  @media (max-width: 1000px) {
    .nav__inner {
      justify-content: space-between;
      gap: 12px;
    }

    .nav__links {
      justify-content: flex-end;
    }

    .nav__burger {
      display: inline-grid;
    }

    /* The list becomes a panel under the bar. */
    .nav__list {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 10;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 16px;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }

    .nav__links[data-open] .nav__list {
      display: flex;
    }

    .nav__list a {
      display: flex;
      width: 100%;
      min-height: 48px;
      padding: 0 4px;
      font-size: 16px;
      border-radius: 0;
      border-bottom: 1px solid var(--hairline);
    }

    .nav__list a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--accent);
      padding-left: 12px;
    }

    .nav__signin {
      margin-left: 0;
    }

    /* No scripting: nothing folds, so nothing can be hidden behind a button that does not work. */
    :global(.no-js) .nav__burger {
      display: none;
    }

    :global(.no-js) .nav__list {
      position: static;
      display: flex;
      padding: 0;
      border: 0;
    }

    :global(.no-js) .nav__inner {
      flex-wrap: wrap;
    }

    :global(.no-js) .nav__links {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 520px) {
    .brand__beta {
      display: none;
    }
  }
</style>
