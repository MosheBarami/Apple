---
import AppleMark from './AppleMark.astro';

//[[ ONE NAVIGATION FOR THE WHOLE SITE, THE FRONT PAGE INCLUDED.
//
//   The landing used to carry its own inline header. The two drifted: different links, different
//   heights, and on a 390px phone the landing's one wrapped onto three rows (151px) while every
//   other route showed this 64px bar. There is now one header component and every route renders it.
//
//   The hrefs are ROOT-RELATIVE (`/#inside`, not `#inside`) so one list works from every page. On
//   the landing a same-document fragment scrolls without a navigation; from /pricing it loads the
//   landing and lands on the section. apps/site/tests/links-resolve.test.mjs checks every fragment
//   names an id the landing really has.
//
//   SHOWCASE IS NOT AN ASTRO ROUTE. `/showcase` is published into the Worker's static store by
//   infra/deploy-showcase.mjs; links-resolve knows it by name and checks that publisher exists.
const links = [
  { href: '/#inside', label: 'Product' },
  { href: '/models', label: 'Models' },
  { href: '/showcase', label: 'Showcase' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.indexOf('#') === -1 && path.startsWith(href) ? 'page' : undefined;
---

<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="Apple — home">
      <AppleMark size={22} />
      <span class="brand__word">Apple</span>
    </a>

    <nav aria-label="Primary" class="nav__links" id="primary-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav__tools">
        <button class="iconbtn" data-theme-toggle type="button" aria-pressed="true" aria-label="Switch to light theme">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="icon-sun">
            <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
            <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </g>
          </svg>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="icon-moon">
            <path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z" fill="currentColor"></path>
          </svg>
        </button>

        {/* Two doors, named for what is behind them: a signed-out visitor — most of this page's
            traffic — needs the account, a returning one needs sign-in. */}
        <a href="/app/login" class="btn btn-ghost nav__signin">Sign in</a>
        <a href="/app/signup" class="btn btn-primary nav__cta">Create an account</a>
      </div>
    </nav>

    <button
      class="nav__burger"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 500;
    border-bottom: 1px solid transparent;
    background: var(--glass);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transition: border-color var(--t-base) var(--ease-out);
  }

  :global(html.scrolled) .nav {
    border-bottom-color: var(--hairline);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--nav-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand__word {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav__links {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav__links ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .nav__links ul a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border-radius: var(--r-xs);
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .nav__links ul a:hover {
    color: var(--ink);
    background: var(--control-fill);
  }

  /* The current page: an ordinary active state, so it is the restrained blue. */
  .nav__links ul a[aria-current='page'] {
    color: var(--ink);
    background: var(--accent-soft);
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* THE LINKS SIT ON THE PAGE'S CENTRE LINE (2026-09-22). `margin: 0 auto` centred them in the space
     left between the wordmark and the tools, which are different widths, so at 1440 the group's
     centre was x=622 under a hero centred on 720. On a wide bar the list is taken out of the flow and
     centred on the bar itself. Below 1120px the two sides would come close enough to touch it, so it
     falls back to sitting between them. */
  @media (min-width: 1120px) {
    .nav__inner {
      position: relative;
    }

    .nav__links ul {
      position: absolute;
      left: 50%;
      top: 50%;
      margin: 0;
      transform: translate(-50%, -50%);
    }

    .nav__tools {
      margin-left: auto;
    }
  }

  .iconbtn {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--r-xs);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .iconbtn:hover {
    color: var(--ink);
    background: var(--control-fill);
  }

  /* The theme toggle shows the icon of the theme you would switch TO. */
  .iconbtn .icon-moon {
    display: none;
  }

  .iconbtn[aria-pressed='true'] .icon-sun {
    display: block;
  }

  .iconbtn[aria-pressed='false'] .icon-sun {
    display: none;
  }

  .iconbtn[aria-pressed='false'] .icon-moon {
    display: block;
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: transparent;
    cursor: pointer;
  }

  .nav__burger span {
    display: block;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform var(--t-base) var(--ease-out);
  }

  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 940px) {
    .nav__burger {
      display: flex;
    }

    .nav__links {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      border-bottom: 1px solid var(--hairline);
      background: var(--paper);
    }

    .nav__links.is-open {
      display: flex;
    }

    .nav__links ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
    }

    .nav__links ul a {
      display: flex;
      min-height: 48px;
      padding: 0 4px;
      border-radius: 0;
      border-bottom: 1px solid var(--hairline);
      font-size: 16px;
    }

    .nav__links ul a[aria-current='page'] {
      background: transparent;
      box-shadow: inset 2px 0 0 var(--accent);
      padding-left: 12px;
    }

    .nav__tools {
      margin-top: 16px;
    }

    .nav__cta {
      flex: 1;
    }
  }
</style>

<script>
  const burger = document.getElementById('menu-toggle');
  const menu = document.getElementById('primary-nav');

  if (burger && menu) {
    const close = () => {
      menu.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open navigation menu');
    };

    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    });

    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        close();
        burger.focus();
      }
    });
  }

  // The hairline under the bar appears only once the page has moved.
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      document.documentElement.classList.toggle('scrolled', window.scrollY > 8);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
