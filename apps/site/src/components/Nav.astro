---
import AppleMark from './AppleMark.astro';

//[[ ONE NAVIGATION FOR THE WHOLE SITE.
//
//   The comment that stood here said "the landing is one viewport now, so /#how, /#modes and
//   /#proof no longer exist", and it was reasoning from a landing page that had already been
//   rebuilt. Every one of those sections is back — index.astro's own header links to #product,
//   #library, #modes, #how and #pricing. So the site had two navigations offering different
//   destinations: the landing's six, and this one's three, which named none of the product.
//   A reader who clicked Pricing could not get back to Library.
//
//   The hrefs are ROOT-RELATIVE (`/#product`, not `#product`) so one list works from every page.
//   On the landing itself a same-document fragment still scrolls without a navigation; from
//   /pricing it loads the landing and lands on the section.
//   SHOWCASE IS NOT AN ASTRO ROUTE, AND THAT IS WHY IT WAS MISSING FROM HERE FOR A DAY.
//
//   `/showcase` — sixteen Roblox screens and six playable maps the deployed model built out of the
//   product's own library — is an object in the Worker's D1 static store, uploaded by
//   `infra/deploy-showcase.mjs`. Nothing under `apps/site/src/pages` builds it and nothing there
//   should. It was live and reachable from 2026-09-21 with not one link pointing at it, so the
//   only way to see the single best piece of evidence this product has was to be told the URL by
//   hand. The owner is fifteen and does not read git; an unlinked page is a page on one laptop.
//
//   `tests/links-resolve.test.mjs` knows about it by name and checks that a publisher for it
//   exists in the repository — an exemption that has to be earned rather than a hole.
const links = [
  { href: '/#inside', label: 'Product' },
  { href: '/#models', label: 'Models' },
  { href: '/showcase', label: 'Showcase' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.indexOf('#') === -1 && path.startsWith(href) ? 'page' : undefined;
---

<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="Apple — home" data-cursor="link">
      <AppleMark size={28} />
      <span class="brand__word">Apple</span>
    </a>

    <nav aria-label="Primary" class="nav__links" id="primary-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav__tools">
        <button class="iconbtn" data-theme-toggle type="button" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="icon-sun">
            <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
            <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </g>
          </svg>
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="icon-moon">
            <path
              d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z"
              fill="currentColor"></path>
          </svg>
          <span class="visually-hidden">Toggle colour theme</span>
        </button>

        <button class="iconbtn" data-sound-toggle type="button" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
            <path
              d="M4 9.5h3.2L12 5.6v12.8L7.2 14.5H4z"
              fill="currentColor"></path>
            <path
              class="wave"
              d="M15.4 9.2a4 4 0 0 1 0 5.6M18 6.6a7.7 7.7 0 0 1 0 10.8"
              stroke="currentColor"
              stroke-width="1.7"
              fill="none"
              stroke-linecap="round"></path>
            <path
              class="mute"
              d="M15.6 9.6l4.8 4.8M20.4 9.6l-4.8 4.8"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
          </svg>
          <span class="visually-hidden">Toggle interface sound</span>
        </button>

        {/* THE SAME PAIR THE LANDING OFFERS. A lone "Open Apple" sends a signed-out visitor — who
            is most of this page's traffic — to a login screen with no account, and offers the
            signed-in one nothing they cannot already do. Two doors, named for what is behind
            them. */}
        <a href="/app/login" class="btn btn-ghost nav__signin">Sign in</a>
        <a href="/app/signup" class="btn btn-primary nav__cta">Create an account</a>
      </div>
    </nav>

    <button
      class="nav__burger"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 500;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  :global(html.scrolled) .nav {
    border-bottom-color: var(--line);
    background: var(--paper);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand__word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /*[[ THE GAP, AND THE ONE I GOT WRONG. Going from three links to six, I added an override setting
   *   this to 0.15rem — 2.4px at the interface's 80% scale — and the deployed header read
   *   "Product Library Modes How it works Pricing Docs" as a single run-on string. Six items need
   *   LESS room than 1.6rem, not none: 1.1rem is ~14px here, which separates them clearly and
   *   leaves the wordmark and the two calls to action their space at 1280px.
   *
   *   The override is gone rather than corrected, so there is one rule setting this and not two. */
  .nav__links ul {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links ul a {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.3rem 0;
    position: relative;
    text-decoration: none;
  }

  .nav__links ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__links ul a:hover,
  .nav__links ul a[aria-current='page'] {
    color: var(--ink);
    text-decoration: none;
  }

  .nav__links ul a:hover::after,
  .nav__links ul a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    padding: 0;
    transition: color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .iconbtn:hover {
    color: var(--ink);
    background: var(--surface-2);
    border-color: var(--line);
  }

  /* theme icon swap */
  .iconbtn .icon-moon {
    display: none;
  }

  .iconbtn[aria-pressed='true'] .icon-sun {
    display: none;
  }

  .iconbtn[aria-pressed='true'] .icon-moon {
    display: block;
  }

  /* sound icon: muted by default */
  [data-sound-toggle] .wave {
    display: none;
  }

  [data-sound-toggle][aria-pressed='true'] .wave {
    display: block;
  }

  [data-sound-toggle][aria-pressed='true'] .mute {
    display: none;
  }

  [data-sound-toggle][aria-pressed='true'] {
    color: var(--accent);
  }

  .nav__cta {
    padding: 0.52rem 1.1rem;
    font-size: 0.88rem;
    margin-left: 0.35rem;
  }

  /* Quieter than its neighbour and the same height, so the pair reads as one control with a
     primary side rather than as two competing buttons. */
  .nav__signin {
    padding: 0.52rem 0.85rem;
    font-size: 0.88rem;
  }


  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    cursor: pointer;
    padding: 0 10px;
  }

  .nav__burger span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }

  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 940px) {
    .nav__burger {
      display: flex;
    }

    .nav__links {
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--lift-2);
      padding: 0.75rem var(--gutter) 1.35rem;
      display: none;
    }

    .nav__links.is-open {
      display: flex;
    }

    .nav__links ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__links ul a {
      display: block;
      padding: 0.85rem 0.15rem;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--hairline);
    }

    .nav__links ul a::after {
      display: none;
    }

    .nav__tools {
      margin-top: 1rem;
      justify-content: flex-start;
    }

    .nav__cta {
      flex: 1;
      margin-left: auto;
      justify-content: center;
      padding-block: 0.72rem;
      font-size: 0.95rem;
    }
  }
</style>

<script>
  const burger = document.getElementById('menu-toggle');
  const menu = document.getElementById('primary-nav');

  if (burger && menu) {
    const close = () => {
      menu.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open navigation menu');
    };

    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute(
        'aria-label',
        open ? 'Close navigation menu' : 'Open navigation menu'
      );
    });

    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        close();
        burger.focus();
      }
    });
  }

  // hairline appears only once the page has moved
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      document.documentElement.classList.toggle('scrolled', window.scrollY > 8);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
