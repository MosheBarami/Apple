---
import GolemMark from './GolemMark.astro';

const links = [
  { href: '/#how', label: 'How it works' },
  { href: '/#modes', label: 'Modes' },
  { href: '/#proof', label: 'Proof' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.indexOf('#') === -1 && path.startsWith(href) ? 'page' : undefined;
---

<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="Golem — home" data-cursor="link">
      <GolemMark size={28} />
      <span class="brand__word">Golem</span>
    </a>

    <nav aria-label="Primary" class="nav__links" id="primary-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav__tools">
        <button class="iconbtn" data-theme-toggle type="button" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="icon-sun">
            <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
            <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </g>
          </svg>
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="icon-moon">
            <path
              d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z"
              fill="currentColor"></path>
          </svg>
          <span class="visually-hidden">Toggle colour theme</span>
        </button>

        <button class="iconbtn" data-sound-toggle type="button" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
            <path
              d="M4 9.5h3.2L12 5.6v12.8L7.2 14.5H4z"
              fill="currentColor"></path>
            <path
              class="wave"
              d="M15.4 9.2a4 4 0 0 1 0 5.6M18 6.6a7.7 7.7 0 0 1 0 10.8"
              stroke="currentColor"
              stroke-width="1.7"
              fill="none"
              stroke-linecap="round"></path>
            <path
              class="mute"
              d="M15.6 9.6l4.8 4.8M20.4 9.6l-4.8 4.8"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
          </svg>
          <span class="visually-hidden">Toggle interface sound</span>
        </button>

        <a href="/app" class="btn btn-primary nav__cta" data-cursor-label="open app">Open Golem</a>
      </div>
    </nav>

    <button
      class="nav__burger"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 500;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  :global(html.scrolled) .nav {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand__word {
    font-family: var(--font-display);
    font-variation-settings: var(--display-vf);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__links ul {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links ul a {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.3rem 0;
    position: relative;
    text-decoration: none;
  }

  .nav__links ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__links ul a:hover,
  .nav__links ul a[aria-current='page'] {
    color: var(--ink);
    text-decoration: none;
  }

  .nav__links ul a:hover::after,
  .nav__links ul a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    padding: 0;
    transition: color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .iconbtn:hover {
    color: var(--ink);
    background: var(--surface-2);
    border-color: var(--line);
  }

  /* theme icon swap */
  .iconbtn .icon-moon {
    display: none;
  }

  .iconbtn[aria-pressed='true'] .icon-sun {
    display: none;
  }

  .iconbtn[aria-pressed='true'] .icon-moon {
    display: block;
  }

  /* sound icon: muted by default */
  [data-sound-toggle] .wave {
    display: none;
  }

  [data-sound-toggle][aria-pressed='true'] .wave {
    display: block;
  }

  [data-sound-toggle][aria-pressed='true'] .mute {
    display: none;
  }

  [data-sound-toggle][aria-pressed='true'] {
    color: var(--accent);
  }

  .nav__cta {
    padding: 0.52rem 1.1rem;
    font-size: 0.88rem;
    margin-left: 0.35rem;
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    cursor: pointer;
    padding: 0 10px;
  }

  .nav__burger span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }

  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 940px) {
    .nav__burger {
      display: flex;
    }

    .nav__links {
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--lift-2);
      padding: 0.75rem var(--gutter) 1.35rem;
      display: none;
    }

    .nav__links.is-open {
      display: flex;
    }

    .nav__links ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__links ul a {
      display: block;
      padding: 0.85rem 0.15rem;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--hairline);
    }

    .nav__links ul a::after {
      display: none;
    }

    .nav__tools {
      margin-top: 1rem;
      justify-content: flex-start;
    }

    .nav__cta {
      flex: 1;
      margin-left: auto;
      justify-content: center;
      padding-block: 0.72rem;
      font-size: 0.95rem;
    }
  }
</style>

<script>
  const burger = document.getElementById('menu-toggle');
  const menu = document.getElementById('primary-nav');

  if (burger && menu) {
    const close = () => {
      menu.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open navigation menu');
    };

    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute(
        'aria-label',
        open ? 'Close navigation menu' : 'Open navigation menu'
      );
    });

    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        close();
        burger.focus();
      }
    });
  }

  // hairline appears only once the page has moved
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      document.documentElement.classList.toggle('scrolled', window.scrollY > 8);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
