---
import AppleMark from './AppleMark.astro';

//[[ ONE NAVIGATION FOR THE WHOLE SITE, THE FRONT PAGE INCLUDED. REBUILT 2026-10-02 (phase 6).
//
//   A sticky 56px bar with a hairline under it. Blur is allowed on exactly two surfaces in this
//   design, the top bar and the composer, so this is one of them. Logo lockup at the inline start,
//   the five links in the middle, the theme toggle and the two doors at the inline end. Below 900px
//   the links fold into a menu and the Rail (the page's reading line) becomes the 2px progress bar
//   that sits on the bottom edge of this bar.
//
//   The hrefs are ROOT-RELATIVE (`/#inside`, not `#inside`) so one list works from every page.
//   apps/site/tests/links-resolve.test.mjs checks every fragment names an id the landing really has.
//
//   SHOWCASE IS NOT AN ASTRO ROUTE. `/showcase` is published into the Worker's static store by
//   infra/deploy-showcase.mjs; links-resolve knows it by name and checks that publisher exists.
const links = [
  { href: '/#inside', label: 'Product' },
  { href: '/models', label: 'Engine' },
  { href: '/showcase', label: 'Showcase' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.indexOf('#') === -1 && path.startsWith(href) ? 'page' : undefined;
---

<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="Apple, home">
      <AppleMark size={28} lockup />
    </a>

    <nav aria-label="Primary" class="nav__links" id="primary-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav__tools">
        <button class="iconbtn" data-theme-toggle type="button" aria-pressed="true" aria-label="Switch to light theme">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="icon-sun">
            <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
            <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </g>
          </svg>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="icon-moon">
            <path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.4 8.4 0 1 0 10.4 10.4Z" fill="currentColor"></path>
          </svg>
        </button>

        {/* Two doors, named for what is behind them: a signed-out visitor needs the account, a
            returning one needs sign-in. */}
        <a href="/app/login" class="btn btn-ghost nav__signin">Sign in</a>
        <a href="/app/signup" class="btn btn-primary nav__cta">Create an account</a>
      </div>
    </nav>

    <button
      class="nav__burger"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
  {/* The Rail below 900px: a 2px bar of how far down the page you are. */}
  <div class="nav__progress" aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-bar);
    /* Named so a page change (a cross-document view transition) leaves the header where it is. */
    view-transition-name: site-nav;
    border-block-end: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .nav__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--s-5);
    height: var(--nav-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .nav__links {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-4);
  }

  .nav__links ul {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    grid-column: 2;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__links ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-3);
    border-radius: var(--r-sm);
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  .nav__links ul a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  /* The current page is told by shape as well as by colour: an underline bar, not a tint. */
  .nav__links ul a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: var(--r-sm) var(--r-sm) 0 0;
  }

  .nav__tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
    grid-column: 3;
  }

  .iconbtn {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  .iconbtn:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  /* The two glyphs swap over 140ms. The toggle shows the icon of the theme you would switch TO. */
  .iconbtn svg {
    grid-area: 1 / 1;
    transition: opacity 140ms var(--ease-out);
  }

  .iconbtn[aria-pressed='true'] .icon-moon,
  .iconbtn[aria-pressed='false'] .icon-sun {
    opacity: 0;
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 12px;
    margin-inline-start: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: transparent;
    cursor: pointer;
  }

  .nav__burger span {
    display: block;
    height: 2px;
    border-radius: 1px;
    background: var(--ink);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* The reading line, folded flat for phones. It scales from the inline start. */
  .nav__progress {
    display: none;
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--read, 0));
  }

  [dir='rtl'] .nav__progress {
    transform-origin: 100% 50%;
  }

  /* Under reduced motion the Rail is drawn full and the progress bar is not shown. */
  @media (prefers-reduced-motion: reduce) {
    .nav__progress {
      display: none !important;
    }
  }

  @media (max-width: 899.98px) {
    .nav__progress {
      display: block;
    }

    .nav__inner {
      grid-template-columns: 1fr auto;
    }

    .nav__burger {
      display: flex;
    }

    .nav__links {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      display: none;
      grid-template-columns: 1fr;
      gap: var(--s-4);
      padding: var(--s-3) var(--gutter) var(--s-5);
      border-block-end: 1px solid var(--hairline);
      background: var(--surface-2);
    }

    .nav__links.is-open {
      display: grid;
      animation: menu-drop var(--dur-2) var(--ease-out);
    }

    @keyframes menu-drop {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }

    .nav__links ul {
      grid-column: 1;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__links ul a {
      min-height: 48px;
      padding-inline: 0;
      border-radius: 0;
      border-block-end: 1px solid var(--hairline);
      font-size: 1rem;
    }

    .nav__links ul a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--accent);
      padding-inline-start: var(--s-3);
      border-radius: 0;
    }

    .nav__tools {
      grid-column: 1;
      justify-content: stretch;
    }

    .nav__tools :global(.nav__cta) {
      flex: 1;
    }
  }
</style>

<script>
  const burger = document.getElementById('menu-toggle');
  const menu = document.getElementById('primary-nav');

  if (burger && menu) {
    const close = () => {
      menu.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open navigation menu');
    };

    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    });

    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        close();
        burger.focus();
      }
    });
  }

  /* The reading line: how far down the page you are, as a number between 0 and 1 on <html>. The
     Rail on wide screens and the 2px bar on phones both draw from it. Passive and rAF-throttled;
     under reduced motion the bar is simply not shown and the Rail is drawn full (landing.css). */
  let ticking = false;
  const root = document.documentElement;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const room = root.scrollHeight - window.innerHeight;
      root.style.setProperty('--read', String(room > 0 ? Math.min(1, Math.max(0, window.scrollY / room)) : 0));
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
