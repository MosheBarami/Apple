---
import GolemGlyph from './GolemGlyph.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Golem — home">
          <GolemGlyph size={26} />
          <span class="wordmark">Golem</span>
        </a>
        <p class="tagline">Describe it. Golem builds it.</p>
        <p class="built-by">Built by Golem Labs</p>
      </div>

      <nav aria-label="Product" class="footer-col">
        <h2>Product</h2>
        <ul>
          <li><a href="/#how">How it works</a></li>
          <li><a href="/#modes">Modes</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/changelog">Changelog</a></li>
          <li><a href="/status">Status</a></li>
        </ul>
      </nav>

      <nav aria-label="Documentation" class="footer-col">
        <h2>Docs</h2>
        <ul>
          <li><a href="/docs/getting-started">Getting started</a></li>
          <li><a href="/docs/plugin">Studio plugin</a></li>
          <li><a href="/docs/modes">Modes</a></li>
          <li><a href="/docs/sparks-and-limits">Sparks &amp; limits</a></li>
          <li><a href="/docs/faq">FAQ</a></li>
        </ul>
      </nav>

      <nav aria-label="Legal and contact" class="footer-col">
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href="/docs/privacy-and-data">Your data</a></li>
          <li><a href="mailto:golem.labs.app@gmail.com">Contact</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-base">
      <p>&copy; {year} Golem Labs. Golem is a beta service, provided as-is.</p>
      <p class="not-affiliated">Not affiliated with or endorsed by Roblox Corporation.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, var(--bg), #080a0f);
    padding: 4rem 0 2.25rem;
    margin-top: 4rem;
    position: relative;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 30%;
    right: 30%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--amber), transparent);
    opacity: 0.55;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
  }

  .tagline {
    color: var(--muted);
    margin: 1rem 0 0.35rem;
    font-size: 0.95rem;
  }

  .built-by {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    opacity: 0.75;
  }

  .footer-col h2 {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    color: var(--text);
    opacity: 0.82;
    font-size: 0.93rem;
  }

  .footer-col a:hover {
    color: var(--amber);
    opacity: 1;
  }

  .footer-base {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(35, 45, 63, 0.6);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-base p {
    margin: 0;
  }

  .not-affiliated {
    opacity: 0.7;
  }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
