---
import StudPilotMark from './StudPilotMark.astro';
import { SUPPORT_EMAIL } from '@studpilot/shared';
const year = new Date().getFullYear();
---

<footer class="foot" data-site-footer>
  <div class="wrap">
    <div class="foot__grid">
      <div class="foot__brand">
        <a href="/" class="brand" aria-label="StudPilot, home">
          <StudPilotMark size={24} />
          <span class="brand__word">StudPilot</span>
        </a>
        <p class="foot__tag">An AI co-pilot for Roblox Studio.</p>
        {/* THE OPERATOR IS STUDPILOT AND THE CONTACT IS support@studpilot.app: the owner's decision of 2026-10-05
            (planning/proof/OWNER-DECISIONS.md D-13). There is no byline under the wordmark any more: the operator and
            the product have one name, so a second line saying it would be the wordmark twice (tests/one-operator.test.mjs).
            The address is read from the shared config, the one home every surface uses. Before money is charged an
            adult or a company has to become the named operator (planning/proof/BLOCKED.md, D-15). */}
        <p class="foot__contact"><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
        <p class="foot__beta"><span class="badge">Beta</span> StudPilot is in beta. It changes often, and paid plans start later.</p>
      </div>

      <nav aria-label="Product" class="foot__col">
        <h2>Product</h2>
        <ul>
          <li><a href="/how-it-works">How it works</a></li>
          <li><a href="/catalog">Catalog</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/app/signup">Start free (beta)</a></li>
        </ul>
      </nav>

      <nav aria-label="Docs" class="foot__col">
        <h2>Docs</h2>
        <ul>
          <li><a href="/docs">Documentation</a></li>
          <li><a href="/docs/getting-started">Getting started</a></li>
          <li><a href="/docs/plugin">Studio plugin</a></li>
          <li><a href="/docs/credits-and-limits">Credits &amp; limits</a></li>
          <li><a href="/docs/faq">FAQ</a></li>
        </ul>
      </nav>

      <nav aria-label="Company and community" class="foot__col">
        <h2>More</h2>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href="/status">Status</a></li>
          <li><a href="/discord">Discord</a></li>
        </ul>
      </nav>
    </div>

    <div class="foot__base">
      {/* THE NON-BREAKING SPACE IS LOAD-BEARING on a phone: it binds the last two words so "as-is." can never
          be a line by itself (tests/rendered-typography.test.mjs, 19 stranded blocks the day it was found).
          The sentence is the same one the site has always carried. */}
      <p>&copy; {year} StudPilot. StudPilot is a beta service, provided&nbsp;as-is.</p>
      <p class="foot__disclaimer">Not affiliated with or endorsed by Roblox Corporation.</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    background: var(--paper-2);
    padding: clamp(40px, 6vw, 64px) 0 32px;
  }

  .foot__grid {
    display: grid;
    grid-template-columns: minmax(240px, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 56px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand__word {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .foot__brand p {
    margin: 12px 0 0;
  }

  .foot__tag {
    color: var(--muted);
    font-size: 14px;
  }

  .foot__beta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 36ch;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .foot__contact a {
    color: var(--ink-2);
    font-size: 14px;
    text-underline-offset: 0.2em;
  }

  .foot__col h2 {
    margin: 0 0 14px;
    color: var(--faint);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .foot__col ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__col a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
  }

  .foot__col a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(32px, 5vw, 48px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  .foot__base p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .foot__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .foot__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .foot__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
