---
// Accessible FAQ, built on native <details>/<summary> so it works with no JS
// and is keyboard-operable for free.
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" style={`--i:${i}`}>
        <summary>
          <span class="faq__q">{item.q}</span>
          <span class="faq__mark" aria-hidden="true" />
        </summary>
        <div class="faq__a" set:html={item.a} />
      </details>
    ))
  }
</div>

<style>
  /* A quiet list: one hairline per question, no shadow, the open one marked by its ink rather than
     by colour. Tokens from apple-minimal.css. */
  .faq {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 14px 4px;
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    transition: color var(--t-fast) var(--ease-out);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  .faq__item[open] summary {
    color: var(--ink);
  }

  .faq__mark {
    position: relative;
    width: 12px;
    height: 12px;
    flex: none;
  }

  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    border-radius: 1px;
    background: var(--muted);
    transition: transform var(--t-base) var(--ease-out);
  }

  .faq__mark::before {
    width: 12px;
    height: 1.5px;
  }

  .faq__mark::after {
    width: 1.5px;
    height: 12px;
  }

  .faq__item[open] .faq__mark::after {
    transform: rotate(90deg);
  }

  .faq__a {
    max-width: 68ch;
    padding: 0 4px 20px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .faq__a :global(p) {
    margin: 0 0 0.7em;
  }

  .faq__a :global(p:last-child) {
    margin-bottom: 0;
  }

  .faq__a :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .faq__a :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
</style>
