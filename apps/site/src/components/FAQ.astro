---
// Accessible FAQ, built on native <details>/<summary> so it works with no JS
// and is keyboard-operable for free.
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" style={`--i:${i}`}>
        <summary>
          <span class="faq__q">{item.q}</span>
          <span class="faq__mark" aria-hidden="true" />
        </summary>
        <div class="faq__a" set:html={item.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.6rem;
  }

  .faq__item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--lift-1);
    transition: border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .faq__item:hover {
    border-color: var(--line-strong);
  }

  .faq__item[open] {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: var(--lift-2);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    padding: 1.05rem 1.25rem;
    list-style: none;
    font-family: var(--font-body);
    font-weight: 570;
    font-size: 1rem;
    color: var(--ink);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover .faq__q {
    color: var(--accent);
  }

  .faq__q {
    transition: color var(--dur-fast) var(--ease-out);
  }

  .faq__mark {
    position: relative;
    width: 13px;
    height: 13px;
    flex: none;
  }

  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--accent);
    border-radius: 1px;
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__mark::before {
    width: 13px;
    height: 1.5px;
  }

  .faq__mark::after {
    width: 1.5px;
    height: 13px;
  }

  .faq__item[open] .faq__mark::after {
    transform: rotate(90deg);
  }

  .faq__a {
    padding: 0 1.25rem 1.2rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 68ch;
  }

  .faq__a :global(p) {
    margin: 0 0 0.65em;
  }

  .faq__a :global(p:last-child) {
    margin-bottom: 0;
  }

  .faq__a :global(strong) {
    color: var(--ink);
  }
</style>
