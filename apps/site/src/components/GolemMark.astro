---
/**
 * The Golem mark — a hexagon containing an isometric cube.
 *
 * Geometry only. No face, no monolith, no rune eyes, no accent fill and no
 * animation: a mark that blinks or reacts reads as a mascot, and the mascot
 * direction is cancelled. See docs/DESIGN-SPEC.md §0.
 *
 * The cube is the classic isometric read: a vertical line from the apex down
 * to the centre, then two lines from the centre out to the lower-left and
 * lower-right vertices. Those three lines describe the top, left and right
 * faces of a cube without drawing a single one of them.
 *
 * Everything strokes in `currentColor`, so the mark simply takes the colour of
 * whatever text it sits beside — landing nav, docs nav, footer, 404 — and
 * needs no theme-specific tokens of its own.
 */
interface Props {
  size?: number;
  class?: string;
  /**
   * Retained for call-site compatibility. The mark does not animate. The prop
   * is accepted and ignored.
   */
  alive?: boolean;
}
const { size = 32, class: className = '' } = Astro.props;

/* Regular hexagon, circumradius 13 on a 32-unit canvas, apex up. The three
   "lower" vertices of the Y are the ones at 210° and 330°. */
const HEX = '16 3 27.26 9.5 27.26 22.5 16 29 4.74 22.5 4.74 9.5';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class={`gm ${className}`}
>
  <polygon class="gm__hex" points={HEX}></polygon>
  <path class="gm__cube" d="M16 3.4V16m0 0-11.05 6.38M16 16l11.05 6.38"></path>
</svg>

<style>
  .gm {
    flex: none;
  }

  .gm__hex,
  .gm__cube {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* The cube sits a touch lighter than its container so the hexagon reads as
     the outer boundary and the cube as the thing inside it. */
  .gm__cube {
    opacity: 0.72;
  }
</style>
