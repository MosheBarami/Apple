---
// The Golem mark: a standing stone with a chiselled brow-seam and two rune
// eyes. Reads as a face without ever drawing one. Inherits the page's ink for
// the stone and the live accent for the light inside it, so it works in both
// themes and picks up whatever mode the surrounding section is in.
interface Props {
  size?: number;
  class?: string;
  /**
   * Retained for call-site compatibility. The mark no longer animates: a
   * blinking logo reads as a mascot reaction, and the mascot direction was
   * cancelled. The prop is accepted and ignored.
   */
  alive?: boolean;
}
const { size = 30, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class={`gm ${className}`}
>
  <!-- monolith -->
  <path
    class="gm__body"
    d="M9.5 4h21a3.5 3.5 0 0 1 3.5 3.5v20.2a4 4 0 0 1-2.1 3.5l-9.5 5.2a3.9 3.9 0 0 1-3.8 0l-9.5-5.2A4 4 0 0 1 6 27.7V7.5A3.5 3.5 0 0 1 9.5 4Z"
  ></path>
  <!-- brow seam: the chisel cut -->
  <path class="gm__seam" d="M6 16.5h9.6L20 20.2l4.4-3.7H34"></path>
  <!-- rune eyes -->
  <rect class="gm__eye" x="11.2" y="21.4" width="6" height="3.4" rx="1.2"></rect>
  <rect class="gm__eye gm__eye--r" x="22.8" y="21.4" width="6" height="3.4" rx="1.2"></rect>
  <!-- forehead sigil -->
  <path class="gm__sigil" d="M20 7.4l2.7 3.4-2.7 2-2.7-2z"></path>
</svg>

<style>
  .gm {
    flex: none;
    overflow: visible;
  }

  .gm__body {
    fill: color-mix(in srgb, var(--ink) 14%, transparent);
    stroke: color-mix(in srgb, var(--ink) 40%, transparent);
    stroke-width: 1.4;
  }

  .gm__seam {
    stroke: color-mix(in srgb, var(--ink) 45%, transparent);
    stroke-width: 1.4;
    fill: none;
    stroke-linejoin: round;
  }

  .gm__eye {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: center;
  }

  .gm__sigil {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-linejoin: round;
    opacity: 0.75;
  }

</style>
