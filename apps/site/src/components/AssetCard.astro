---
/**
 * One asset on the landing page's library wall.
 *
 * A COMPONENT RATHER THAN MARKUP WRITTEN TWICE, and that is structural rather than tidy. The wall
 * drifts by holding each row's cards twice and translating the row -50%, so the two copies must be
 * byte-identical: if the echo drifts from the original by one element the loop develops a visible
 * jump at the seam. One component, rendered twice, cannot drift.
 *
 * EVERY FIELD HERE IS PROVENANCE, and the reason the section exists. A competitor's asset wall is
 * generated marketing art for games that do not exist; this one names the pack, the licence and
 * the person, because those are the facts that cannot be invented.
 */
interface Props {
  asset: {
    id: string;
    name: string;
    kind: string;
    pack: string;
    source: string;
    licence: string;
    author: string;
    img: string | null;
  };
}

const { asset } = Astro.props;

/** The harvest's kind vocabulary, in words rather than snake_case. */
const KIND_LABEL: Record<string, string> = {
  prop: 'Prop',
  ground: 'Ground',
  texture: 'Texture',
  ui_icon: 'UI icon',
  character: 'Character',
  vehicle: 'Vehicle',
  building: 'Building',
  foliage: 'Foliage',
  particle: 'Particle',
};

/* A kind with no label falls back to the harvest's own word. It is less pretty and still true,
   which is the right trade for a display map: a missing entry must not blank the field. */
const kind = KIND_LABEL[asset.kind] ?? asset.kind;

/* "Pirate Kit · Kenney", but just "game-icons.net" where the pack IS the source. */
const origin = asset.pack === asset.source ? asset.pack : `${asset.pack} · ${asset.source}`;
---

<li class="ap-wall__card">
  {/* The image carries alt="" ON PURPOSE. The name is the next element, so a described image
      would make a screen reader say the thing twice; the card's text already is the caption. */}
  <span class="ap-wall__shot">
    {
      asset.img ? (
        <img src={asset.img} alt="" width="72" height="72" loading="lazy" decoding="async" />
      ) : (
        /* NOT A BLANK TILE, and not a broken one. This row has no preview in the harvest, and the
           route ships no JavaScript to swap a failed image out — so the absence is rendered as
           something that says what the asset is and admits there is no picture of it. */
        <span class="ap-wall__none">
          <span class="ap-wall__none-kind">{kind}</span>
          <span class="ap-wall__none-say">no preview</span>
        </span>
      )
    }
  </span>

  <span class="ap-wall__name">{asset.name}</span>
  <span class="ap-wall__kind ap-mono">{kind}</span>
  <span class="ap-wall__pack">{origin}</span>

  <span class="ap-wall__prov">
    <span class="ap-wall__lic ap-mono">{asset.licence}</span>
    <span class="ap-wall__by">{asset.author}</span>
  </span>
</li>
