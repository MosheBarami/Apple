---
// ---------------------------------------------------------------------------
// PromptForge — the hero's working demonstration of the product.
//
// Pick a mode, pick (or type) a request, press Build. The console plays the
// real shape of a Golem run: the mode's step budget, the documented op set,
// the spark cost, and the verification pass at the end. It drives the WebGL
// golem's state as it goes, so the character *is* the progress indicator.
//
// ILLUSTRATIVE, NOT A LIVE FEED. The transcript below is authored from the
// documented behaviour of the product (op protocol in docs/DECISIONS.md
// ADR-004; step budgets 3 / 8 / 14 and spark costs 1 / 4 / 10 in
// docs/COST-MODEL.md). No request leaves the browser and no inference runs
// here — the surface says so, on screen, in the footer of the console.
// ---------------------------------------------------------------------------
---

<section class="forge is-stone" id="forge" aria-labelledby="forge-title">
  <h2 id="forge-title" class="visually-hidden">Try a Golem run</h2>

  <header class="forge__bar">
    <span class="forge__lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="forge__file">Lobby&nbsp;Project&nbsp;· <span class="mono">place1.rbxl</span></span>
    <span class="forge__link"><span class="forge__pip"></span> Studio connected</span>
  </header>

  <div class="forge__body">
    <ol class="forge__log" id="forge-log" aria-live="polite" aria-relevant="additions">
      <li class="msg msg--golem is-shown">
        <span class="msg__who">Golem</span>
        <p class="msg__text">
          I can see your place — 3 scripts, 47 instances. What should I build?
        </p>
      </li>
    </ol>
  </div>

  <div class="forge__composer">
    <div class="forge__modes" role="group" aria-label="Choose a mode">
      <div class="segmented" id="forge-modes">
        <button type="button" data-mode="clay" aria-pressed="false">Clay <span class="cost">1</span></button>
        <button type="button" data-mode="stone" aria-pressed="true">Stone <span class="cost">4</span></button>
        <button type="button" data-mode="rune" aria-pressed="false">Rune <span class="cost">10</span></button>
      </div>
      <p class="forge__budget mono" id="forge-budget">up to 8 steps · 4 sparks</p>
    </div>

    <form class="forge__input" id="forge-form">
      <label class="visually-hidden" for="forge-prompt">Describe what to build</label>
      <input
        id="forge-prompt"
        name="prompt"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Add a checkpoint system to my obby"
        value="Add a checkpoint system to my obby"
      />
      <button type="submit" class="btn btn-primary btn-sm" id="forge-run" data-cursor-label="run">
        Build
      </button>
    </form>

    <div class="forge__presets">
      <span class="mono">Try:</span>
      <button type="button" class="preset" data-preset="checkpoints" data-mode="stone">
        checkpoint system
      </button>
      <button type="button" class="preset" data-preset="leaderboard" data-mode="clay">
        why does my leaderboard reset?
      </button>
      <button type="button" class="preset" data-preset="rounds" data-mode="rune">
        full round system, verified
      </button>
    </div>
  </div>

  <footer class="forge__foot">
    <div class="sparks" aria-hidden="true">
      <span class="sparks__label mono">Sparks today</span>
      <span class="sparks__bar"><span class="sparks__fill" id="forge-spark-fill"></span></span>
      <span class="sparks__num mono" id="forge-spark-num">60 / 60</span>
    </div>
    <p class="forge__note">
      Scripted preview — the op sequence, step budgets and spark costs are the
      product's real ones. Nothing is sent anywhere from this page.
    </p>
  </footer>
</section>

<style>
  .forge {
    background: linear-gradient(170deg, var(--surface), var(--surface-2));
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--lift-3), var(--inset);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .forge::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }

  /* ---- title bar ---- */
  .forge__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.95rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--paper-2);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .forge__lights {
    display: inline-flex;
    gap: 5px;
  }

  .forge__lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
    opacity: 0.6;
  }

  .forge__file {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .forge__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--good);
    white-space: nowrap;
  }

  .forge__pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--good);
    animation: forge-pip 2.6s var(--ease-in-out) infinite;
  }

  @keyframes forge-pip {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* ---- transcript ---- */
  .forge__body {
    min-height: 17.5rem;
    max-height: 25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.1rem 1.15rem 0.4rem;
    scrollbar-width: thin;
  }

  .forge__log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  /* ---- composer ---- */
  .forge__composer {
    border-top: 1px solid var(--hairline);
    padding: 0.9rem 1.15rem 1rem;
    display: grid;
    gap: 0.7rem;
    background: var(--surface-2);
  }

  .forge__modes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .segmented .cost {
    font-family: var(--font-mono);
    font-size: 0.72em;
    opacity: 0.65;
    margin-left: 0.25rem;
  }

  .forge__budget {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  .forge__input {
    display: flex;
    gap: 0.5rem;
  }

  .forge__input input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.93rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 0.6rem 0.8rem;
    transition: border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .forge__input input::placeholder {
    color: var(--faint);
  }

  /* custom focus indicator, but a clearly visible one */
  .forge__input input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .forge__input input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .forge__presets {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
  }

  .forge__presets .mono {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .preset {
    font: inherit;
    font-size: 0.78rem;
    color: var(--muted);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.24rem 0.7rem;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .preset:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---- foot ---- */
  .forge__foot {
    border-top: 1px solid var(--hairline);
    padding: 0.7rem 1.15rem 0.85rem;
    display: grid;
    gap: 0.45rem;
    background: var(--paper-2);
  }

  .sparks {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sparks__label,
  .sparks__num {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sparks__num {
    color: var(--accent);
  }

  .sparks__bar {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
    min-width: 60px;
  }

  .sparks__fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    border-radius: 2px;
    transform-origin: left;
    transition: width 600ms var(--ease-out);
  }

  .forge__note {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--faint);
  }

  @media (max-width: 560px) {
    .forge__body {
      min-height: 17rem;
      max-height: 21rem;
    }

    .forge__budget {
      order: 3;
      width: 100%;
    }
  }
</style>

<!-- These rules style nodes the script creates at runtime. Astro's scoped CSS
     only attaches its hash to elements that exist in the template, so anything
     built with innerHTML would render unstyled. Scoped by #forge instead. -->
<style is:global>
  #forge .msg {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 340ms var(--ease-out), transform 340ms var(--ease-out);
  }

  #forge .msg.is-shown {
    opacity: 1;
    transform: none;
  }

  #forge .msg__who {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.28rem;
  }

  #forge .msg--you .msg__who {
    color: var(--accent);
  }

  #forge .msg__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 64ch;
  }

  #forge .msg--you .msg__text {
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: var(--r-sm);
    padding: 0.5rem 0.75rem;
    display: inline-block;
    max-width: 100%;
  }

  #forge .msg--golem .msg__text {
    color: var(--muted);
  }

  #forge .caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--accent);
    vertical-align: -0.15em;
    margin-left: 1px;
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ---- op rows ---- */
  #forge .ops {
    display: grid;
    gap: 0.3rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    /* a tool trace is a narrow column, not a full-bleed table */
    max-width: 44rem;
  }

  #forge .op {
    display: grid;
    grid-template-columns: 1.1rem 1fr auto;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    line-height: 1.5;
    color: var(--muted);
    padding: 0.32rem 0.5rem;
    border-radius: 6px;
    background: var(--paper-2);
    border: 1px solid transparent;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  #forge .op.is-shown {
    opacity: 1;
    transform: none;
  }

  #forge .op.is-active {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-soft);
  }

  #forge .op__mark {
    color: var(--accent);
    font-size: 0.8em;
  }

  #forge .op.is-done .op__mark {
    color: var(--good);
  }

  #forge .op__name {
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  #forge .op__arg {
    color: var(--faint);
  }

  #forge .op__ms {
    color: var(--faint);
    font-size: 0.9em;
    white-space: nowrap;
  }

  #forge .verdict {
    max-width: 62ch;
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0.75rem 0 0.2rem;
    padding: 0.7rem 0.85rem;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--good) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--good) 32%, transparent);
    font-size: 0.9rem;
    color: var(--ink);
  }

  #forge .verdict svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--good);
  }

  #forge .verdict code {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    #forge .op {
      grid-template-columns: 1rem 1fr;
      font-size: 0.72rem;
    }

    #forge .op__ms {
      display: none;
    }
  }
</style>

<script>
  type Mode = 'clay' | 'stone' | 'rune';

  interface Op {
    name: string;
    arg?: string;
    ms: number;
  }

  interface Script {
    prompt: string;
    mode: Mode;
    opener: string;
    ops: Op[];
    verdict: string;
  }

  // -------------------------------------------------------------------
  // Authored transcripts. Op names follow the documented plugin op
  // protocol (docs/DECISIONS.md ADR-004): read/search scripts, edit via
  // ScriptEditorService, create/modify instances, DataModel tree
  // snapshots, playtest hooks, log capture. Illustrative, not live.
  // -------------------------------------------------------------------
  const SCRIPTS: Record<string, Script> = {
    checkpoints: {
      prompt: 'Add a checkpoint system to my obby',
      mode: 'stone',
      opener: 'Reading your place, then wiring checkpoints into the existing obby.',
      ops: [
        { name: 'get_project_tree', arg: 'depth 3', ms: 210 },
        { name: 'search_scripts', arg: '"SpawnLocation"', ms: 180 },
        { name: 'create_instance', arg: 'Folder “Checkpoints” → Workspace', ms: 90 },
        { name: 'create_instance', arg: '8 × Part “Checkpoint1..8”', ms: 340 },
        { name: 'set_properties', arg: 'Anchored, CanCollide, BrickColor', ms: 120 },
        { name: 'edit_script', arg: 'ServerScriptService/CheckpointService', ms: 460 },
        { name: 'read_back', arg: 'verify instances + source', ms: 150 },
      ],
      verdict:
        'Checkpoints are in. Touch a pad to claim it; respawns return you to the furthest one you reached. One undo waypoint — <code>Ctrl+Z</code> reverses the whole batch.',
    },
    leaderboard: {
      prompt: 'Why does my leaderboard reset on death?',
      mode: 'clay',
      opener: 'Looking at the script that owns your leaderstats.',
      ops: [
        { name: 'search_scripts', arg: '"leaderstats"', ms: 160 },
        { name: 'read_script', arg: 'ServerScriptService/Stats', ms: 140 },
      ],
      verdict:
        'Your <code>leaderstats</code> folder is created inside <code>CharacterAdded</code>, so it is rebuilt from zero on every respawn. Move it to <code>PlayerAdded</code> and parent it to the Player, not the Character. Want me to make that change?',
    },
    rounds: {
      prompt:
        'Build a round system with intermission, map vote and win detection — and prove it runs',
      mode: 'rune',
      opener:
        'Planning first. Four stages: intermission, vote, round, results — then I will run your game and check the output.',
      ops: [
        { name: 'plan', arg: '4 stages, 9 steps', ms: 380 },
        { name: 'get_project_tree', arg: 'full snapshot', ms: 240 },
        { name: 'create_instance', arg: 'RemoteEvents ×3 → ReplicatedStorage', ms: 130 },
        { name: 'edit_script', arg: 'ServerScriptService/RoundService', ms: 620 },
        { name: 'edit_script', arg: 'StarterGui/VoteUI/VoteController', ms: 410 },
        { name: 'run_playtest', arg: 'start server + 1 client', ms: 1400 },
        { name: 'read_output', arg: '2 warnings, 1 error', ms: 190 },
        { name: 'edit_script', arg: 'fix nil map on first vote tie', ms: 350 },
        { name: 'run_playtest', arg: 're-run, 2 full rounds', ms: 1500 },
        { name: 'read_output', arg: 'clean', ms: 160 },
      ],
      verdict:
        'Two complete rounds ran end to end with no errors. Intermission 15s, vote 10s, round 90s, winner announced and teleported back to lobby. A checkpoint was taken before the run, so you can rewind all of it.',
    },
  };

  const MODE_META: Record<Mode, { steps: number; sparks: number }> = {
    clay: { steps: 3, sparks: 1 },
    stone: { steps: 8, sparks: 4 },
    rune: { steps: 14, sparks: 10 },
  };

  const forge = document.getElementById('forge');
  const log = document.getElementById('forge-log');
  const form = document.getElementById('forge-form') as HTMLFormElement | null;
  const input = document.getElementById('forge-prompt') as HTMLInputElement | null;
  const runBtn = document.getElementById('forge-run') as HTMLButtonElement | null;
  const modesEl = document.getElementById('forge-modes');
  const budgetEl = document.getElementById('forge-budget');
  const sparkFill = document.getElementById('forge-spark-fill');
  const sparkNum = document.getElementById('forge-spark-num');
  const body = forge?.querySelector<HTMLElement>('.forge__body');

  if (forge && log && form && input && runBtn && modesEl) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let mode: Mode = 'stone';
    let running = false;
    let sparks = 60; // the documented free daily allowance
    let seq = 0; // cancels an in-flight run when a new one starts

    const emit = (name: string, detail: Record<string, unknown>) =>
      window.dispatchEvent(new CustomEvent(name, { detail }));

    const wait = (ms: number) =>
      new Promise<void>((r) => setTimeout(r, reduced.matches ? 0 : ms));

    const tick = (f?: number) => (window as any).golemTick?.(f);

    function setMode(next: Mode, silent = false) {
      mode = next;
      forge!.classList.remove('is-clay', 'is-stone', 'is-rune');
      forge!.classList.add(`is-${next}`);
      modesEl!.querySelectorAll('button').forEach((b) => {
        b.setAttribute(
          'aria-pressed',
          String((b as HTMLElement).dataset.mode === next)
        );
      });
      if (budgetEl) {
        const m = MODE_META[next];
        budgetEl.textContent = `up to ${m.steps} steps · ${m.sparks} spark${m.sparks === 1 ? '' : 's'}`;
      }
      if (!silent) emit('golem:mode', { mode: next });
    }

    function paintSparks() {
      if (sparkFill) sparkFill.style.width = `${(sparks / 60) * 100}%`;
      if (sparkNum) sparkNum.textContent = `${sparks} / 60`;
    }

    function clearLog() {
      log!.innerHTML = '';
      if (body) body.scrollTop = 0;
    }

    function push(html: string, cls = '') {
      const li = document.createElement('li');
      li.className = `msg ${cls}`;
      li.innerHTML = html;
      log!.appendChild(li);
      requestAnimationFrame(() => li.classList.add('is-shown'));
      if (body) body.scrollTop = body.scrollHeight;
      return li;
    }

    async function typeInto(el: HTMLElement, text: string, mine: number) {
      if (reduced.matches) {
        el.textContent = text;
        return;
      }
      const caret = document.createElement('span');
      caret.className = 'caret';
      el.after(caret);
      for (let i = 0; i < text.length; i++) {
        if (mine !== seq) {
          caret.remove();
          return;
        }
        el.textContent = text.slice(0, i + 1);
        if (body) body.scrollTop = body.scrollHeight;
        await wait(text.length > 60 ? 12 : 22);
      }
      caret.remove();
    }

    async function run(scriptKey: string | null, customPrompt?: string) {
      const mine = ++seq;
      running = true;
      runBtn!.disabled = true;
      runBtn!.textContent = 'Building…';

      const script: Script = scriptKey
        ? SCRIPTS[scriptKey]
        : {
            // free-typed request: same real op shape, the visitor's words
            prompt: customPrompt || 'Build something',
            mode,
            opener: `Reading your place, then building: ${customPrompt}.`,
            ops:
              mode === 'clay'
                ? [
                    { name: 'search_scripts', arg: 'relevant sources', ms: 180 },
                    { name: 'read_script', arg: 'best match', ms: 160 },
                  ]
                : mode === 'stone'
                  ? [
                      { name: 'get_project_tree', arg: 'depth 3', ms: 220 },
                      { name: 'search_scripts', arg: 'related systems', ms: 190 },
                      { name: 'create_instance', arg: 'new instances → Workspace', ms: 160 },
                      { name: 'edit_script', arg: 'ServerScriptService', ms: 480 },
                      { name: 'read_back', arg: 'verify source', ms: 150 },
                    ]
                  : [
                      { name: 'plan', arg: 'break the ask into steps', ms: 360 },
                      { name: 'get_project_tree', arg: 'full snapshot', ms: 240 },
                      { name: 'edit_script', arg: 'ServerScriptService', ms: 560 },
                      { name: 'run_playtest', arg: 'start server + 1 client', ms: 1300 },
                      { name: 'read_output', arg: 'check for errors', ms: 190 },
                    ],
            verdict:
              mode === 'clay'
                ? 'Here is what I found, with the exact lines that matter. Ask me to change any of it.'
                : mode === 'rune'
                  ? 'Built and verified by running your game. A checkpoint was taken first, so the whole run is reversible.'
                  : 'Built. Every change landed in one undo waypoint — <code>Ctrl+Z</code> reverses the batch.',
          };

      if (scriptKey) setMode(script.mode);

      clearLog();
      emit('golem:state', { state: 'listening' });

      // 1. the request
      const you = push(
        `<span class="msg__who">You</span><p class="msg__text"><span></span></p>`,
        'msg--you'
      );
      await typeInto(you.querySelector('span:last-child')!, script.prompt, mine);
      if (mine !== seq) return;
      tick(520);

      // 2. spark charge
      const cost = MODE_META[script.mode].sparks;
      sparks = Math.max(0, sparks - cost);
      paintSparks();

      // 3. golem thinks
      emit('golem:state', { state: 'thinking' });
      await wait(420);
      if (mine !== seq) return;

      const reply = push(
        `<span class="msg__who">Golem · ${script.mode} · ${cost} spark${cost === 1 ? '' : 's'}</span>
         <p class="msg__text"><span></span></p>
         <ul class="ops"></ul>`,
        'msg--golem'
      );
      await typeInto(
        reply.querySelector('.msg__text span')!,
        script.opener,
        mine
      );
      if (mine !== seq) return;

      // 4. ops land one at a time
      const opsEl = reply.querySelector('.ops')!;
      emit('golem:state', { state: 'building' });

      for (const op of script.ops) {
        if (mine !== seq) return;
        const li = document.createElement('li');
        li.className = 'op is-active';
        li.innerHTML = `<span class="op__mark">◆</span><span><span class="op__name">${op.name}</span>${
          op.arg ? ` <span class="op__arg">${op.arg}</span>` : ''
        }</span><span class="op__ms">${op.ms} ms</span>`;
        opsEl.appendChild(li);
        requestAnimationFrame(() => li.classList.add('is-shown'));
        if (body) body.scrollTop = body.scrollHeight;
        tick(op.name === 'run_playtest' ? 260 : 700);

        if (op.name === 'run_playtest') emit('golem:state', { state: 'verifying' });

        await wait(Math.min(op.ms, 900));
        li.classList.remove('is-active');
        li.classList.add('is-done');
        li.querySelector('.op__mark')!.textContent = '✓';
      }

      if (mine !== seq) return;

      // 5. verdict
      emit('golem:state', { state: 'done' });
      const v = document.createElement('div');
      v.className = 'verdict';
      v.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12.5l4.6 4.6L19.5 6.7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><p style="margin:0">${script.verdict}</p>`;
      reply.appendChild(v);
      if (body) body.scrollTop = body.scrollHeight;
      tick(300);

      running = false;
      runBtn!.disabled = false;
      runBtn!.textContent = 'Build';

      // settle back to a listening idle after a beat
      setTimeout(() => {
        if (mine === seq && !running) emit('golem:state', { state: 'listening' });
      }, 2600);
    }

    // ---- wiring ----
    modesEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-mode]');
      if (!btn) return;
      setMode(btn.dataset.mode as Mode);
      tick(600);
    });

    forge.querySelectorAll<HTMLElement>('.preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.preset!;
        input.value = SCRIPTS[key].prompt;
        run(key);
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      const known = Object.keys(SCRIPTS).find(
        (k) => SCRIPTS[k].prompt.toLowerCase() === text.toLowerCase()
      );
      run(known ?? null, text);
    });

    setMode('stone', true);
    paintSparks();

    // Auto-play the first run once, when the console is actually on screen —
    // only if the visitor has not already started one, and never under
    // reduced motion (there, the finished state is what they get).
    if ('IntersectionObserver' in window && !reduced.matches) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((en) => en.isIntersecting)) {
            io.disconnect();
            if (seq === 0) setTimeout(() => seq === 0 && run('checkpoints'), 700);
          }
        },
        { threshold: 0.35 }
      );
      io.observe(forge);
    } else if (reduced.matches) {
      run('checkpoints');
    }
  }
</script>
