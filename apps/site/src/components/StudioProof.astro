---
// ---------------------------------------------------------------------------
// StudioProof — the evidence panel. Three views of the same single run:
// what changed in the DataModel, the Luau that was written, and the Studio
// output that proved it works.
//
// ILLUSTRATIVE CONTENT: this is a hand-authored example of one checkpoint-system
// run, not a live feed from a session. The op names, the undo behaviour and the
// verify-by-playtest loop are the product's documented behaviour
// (docs/DECISIONS.md ADR-004, ADR-010). The Luau is real, working Luau.
// ---------------------------------------------------------------------------

const tree = [
  { d: 0, kind: 'svc', name: 'Workspace', state: 'same' },
  { d: 1, kind: 'folder', name: 'Lobby', state: 'same' },
  { d: 1, kind: 'folder', name: 'ObbyCourse', state: 'same' },
  { d: 2, kind: 'part', name: 'Platform_01 … Platform_24', state: 'same' },
  { d: 1, kind: 'folder', name: 'Checkpoints', state: 'add' },
  { d: 2, kind: 'part', name: 'Checkpoint1', state: 'add' },
  { d: 2, kind: 'part', name: 'Checkpoint2', state: 'add' },
  { d: 2, kind: 'part', name: '… Checkpoint8', state: 'add' },
  { d: 0, kind: 'svc', name: 'ServerScriptService', state: 'same' },
  { d: 1, kind: 'script', name: 'Stats', state: 'same' },
  { d: 1, kind: 'script', name: 'CheckpointService', state: 'add' },
  { d: 0, kind: 'svc', name: 'StarterPlayer', state: 'same' },
  { d: 1, kind: 'script', name: 'RespawnHandler', state: 'edit' },
];

const logLines = [
  { t: '00.000', k: 'info', m: 'Checkpoint “pre-run” saved · 47 instances, 3 scripts' },
  { t: '00.212', k: 'op', m: 'get_project_tree → 47 instances' },
  { t: '00.396', k: 'op', m: 'search_scripts "SpawnLocation" → 1 match' },
  { t: '00.486', k: 'op', m: 'create_instance Folder "Checkpoints"' },
  { t: '00.826', k: 'op', m: 'create_instance Part ×8' },
  { t: '00.948', k: 'op', m: 'set_properties Anchored=true CanCollide=false' },
  { t: '01.409', k: 'op', m: 'edit_script ServerScriptService.CheckpointService (+38)' },
  { t: '01.560', k: 'op', m: 'read_back → source matches, 8/8 instances present' },
  { t: '01.561', k: 'undo', m: 'ChangeHistoryService waypoint “Golem — checkpoints”' },
  { t: '02.004', k: 'run', m: '▶ Play — server started' },
  { t: '04.117', k: 'good', m: 'Checkpoint 3 claimed by Player1' },
  { t: '06.402', k: 'good', m: 'Respawn → returned to Checkpoint 3' },
  { t: '07.010', k: 'good', m: '■ Stopped — 0 errors, 0 warnings' },
];

const luau = `--!strict
-- ServerScriptService/CheckpointService
-- Written by Golem · Stone mode · one undo waypoint

local Players = game:GetService("Players")
local checkpoints = workspace:WaitForChild("Checkpoints")

local reached: { [number]: number } = {}

local function sendTo(player: Player, index: number)
\tlocal pad = checkpoints:FindFirstChild("Checkpoint" .. index)
\tlocal character = player.Character
\tif pad and character then
\t\tcharacter:PivotTo(pad.CFrame + Vector3.new(0, 4, 0))
\tend
end

for _, pad in checkpoints:GetChildren() do
\tlocal index = tonumber(pad.Name:match("%d+") or "")
\tif not index then continue end

\tpad.Touched:Connect(function(hit)
\t\tlocal player = Players:GetPlayerFromCharacter(hit.Parent)
\t\tif not player then return end
\t\tif (reached[player.UserId] or 0) < index then
\t\t\treached[player.UserId] = index
\t\tend
\tend)
end

Players.PlayerAdded:Connect(function(player)
\treached[player.UserId] = 0
\tplayer.CharacterAdded:Connect(function()
\t\ttask.wait()
\t\tsendTo(player, reached[player.UserId])
\tend)
end)

Players.PlayerRemoving:Connect(function(player)
\treached[player.UserId] = nil
end)`;

const icons: Record<string, string> = {
  svc: 'M4 5.5h16v13H4z',
  folder: 'M3.5 6.5h6l2 2.2h9v9H3.5z',
  part: 'M12 3.5l8 4.5v8l-8 4.5-8-4.5v-8z',
  script: 'M6 3.5h9l4 4v13H6z',
};
---

<div class="proof slab slab--lift" id="proof-panel">
  <div class="proof__head">
    <div class="segmented" role="tablist" aria-label="Evidence from one Golem run">
      <button role="tab" id="tab-tree" aria-controls="panel-tree" aria-selected="true" type="button">
        What changed
      </button>
      <button role="tab" id="tab-code" aria-controls="panel-code" aria-selected="false" type="button">
        The Luau
      </button>
      <button role="tab" id="tab-log" aria-controls="panel-log" aria-selected="false" type="button">
        Verification
      </button>
    </div>
    <p class="proof__meta mono">
      Stone · 4 sparks · 7 ops · 1 undo waypoint
    </p>
  </div>

  <!-- ---------------------------------------------------------- tree -->
  <div class="proof__panel" role="tabpanel" id="panel-tree" aria-labelledby="tab-tree" tabindex="0">
    <p class="proof__cap">
      The DataModel of the open place, before and after. Golem creates and
      configures instances in the place you already have — it does not generate
      a new one.
    </p>
    <ul class="tree">
      {
        tree.map((n) => (
          <li
            class={`tree__row tree__row--${n.state}`}
            style={`--depth:${n.d}`}
          >
            <span class="tree__sign" aria-hidden="true">
              {n.state === 'add' ? '+' : n.state === 'edit' ? '~' : ''}
            </span>
            <svg class="tree__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[n.kind]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
            <span class="tree__name">{n.name}</span>
            {n.state !== 'same' && (
              <span class="tree__tag">{n.state === 'add' ? 'created' : 'edited'}</span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="proof__foot">
      <kbd>Ctrl</kbd>+<kbd>Z</kbd> reverses all of it at once — every batch is
      wrapped in a native <code>ChangeHistoryService</code> waypoint.
    </p>
  </div>

  <!-- ---------------------------------------------------------- code -->
  <div class="proof__panel is-hidden" role="tabpanel" id="panel-code" aria-labelledby="tab-code" tabindex="0">
    <p class="proof__cap">
      Real Luau, written into your script through <code>ScriptEditorService</code>
      — typed, idiomatic, and yours to edit afterwards.
    </p>
    <pre class="proof__code"><code>{luau}</code></pre>
  </div>

  <!-- ---------------------------------------------------------- log -->
  <div class="proof__panel is-hidden" role="tabpanel" id="panel-log" aria-labelledby="tab-log" tabindex="0">
    <p class="proof__cap">
      Rune and Stone both report what they did; Rune goes further and presses
      Play, reads the output, and repairs what breaks before calling it done.
    </p>
    <ol class="loglines">
      {
        logLines.map((l) => (
          <li class={`logline logline--${l.k}`}>
            <span class="logline__t mono">{l.t}</span>
            <span class="logline__m">{l.m}</span>
          </li>
        ))
      }
    </ol>
    <p class="proof__foot">
      Every run takes an automatic checkpoint first, so a whole session can be
      rewound — not just the last edit.
    </p>
  </div>

  <p class="proof__disclaimer">
    Worked example of a single run, reconstructed from the product's op
    protocol and undo model. Not a live session feed.
  </p>
</div>

<style>
  .proof {
    padding: clamp(1rem, 2.2vw, 1.5rem);
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .proof > * {
    min-width: 0;
  }

  .proof__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .proof__meta {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .proof__panel {
    display: grid;
    gap: 0.9rem;
  }

  .proof__panel.is-hidden {
    display: none;
  }

  .proof__cap {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    max-width: 62ch;
  }

  .proof__foot {
    margin: 0;
    font-size: 0.82rem;
    color: var(--faint);
  }

  .proof__disclaimer {
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.72rem;
    color: var(--faint);
  }

  /* ---- tree ---- */
  .tree {
    list-style: none;
    max-width: 46rem;
    margin: 0;
    padding: 0.6rem 0.35rem;
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    font-family: var(--font-mono);
    font-size: 0.79rem;
    overflow-x: auto;
  }

  .tree__row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem 0.2rem calc(0.6rem + var(--depth) * 1.15rem);
    color: var(--muted);
    border-radius: 5px;
    white-space: nowrap;
    position: relative;
  }

  .tree__sign {
    width: 0.7rem;
    text-align: center;
    font-weight: 700;
    color: transparent;
  }

  .tree__icon {
    width: 13px;
    height: 13px;
    flex: none;
    opacity: 0.75;
  }

  .tree__name {
    color: var(--ink);
  }

  .tree__tag {
    margin-left: auto;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-left: 1rem;
  }

  .tree__row--same .tree__name {
    color: var(--muted);
  }

  .tree__row--add {
    background: color-mix(in srgb, var(--good) 12%, transparent);
  }

  .tree__row--add .tree__sign,
  .tree__row--add .tree__tag,
  .tree__row--add .tree__icon {
    color: var(--good);
  }

  .tree__row--edit {
    background: color-mix(in srgb, var(--warn) 14%, transparent);
  }

  .tree__row--edit .tree__sign,
  .tree__row--edit .tree__tag,
  .tree__row--edit .tree__icon {
    color: var(--warn);
  }

  /* ---- code ---- */
  .proof__code {
    margin: 0;
    max-width: 46rem;
    max-height: 25rem;
    overflow: auto;
    font-size: 0.775rem;
    tab-size: 2;
    background: var(--paper-2);
  }

  /* ---- log ---- */
  .loglines {
    list-style: none;
    max-width: 46rem;
    margin: 0;
    padding: 0.6rem 0.4rem;
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    display: grid;
    gap: 0.1rem;
    font-size: 0.79rem;
    overflow-x: auto;
  }

  .logline {
    display: flex;
    gap: 0.75rem;
    padding: 0.22rem 0.6rem;
    border-radius: 5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .logline__t {
    font-size: 0.72rem;
    color: var(--faint);
    flex: none;
  }

  .logline__m {
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .logline--good {
    color: var(--good);
  }

  .logline--run {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .logline--undo {
    color: var(--warn);
  }

  .logline--info {
    color: var(--faint);
  }

  @media (max-width: 620px) {
    .proof__head {
      align-items: flex-start;
      flex-direction: column;
    }

    .segmented {
      width: 100%;
    }

    .tree__tag {
      display: none;
    }
  }
</style>

<script>
  const panel = document.getElementById('proof-panel');
  if (panel) {
    const tabs = Array.from(panel.querySelectorAll<HTMLElement>('[role="tab"]'));

    function select(tab: HTMLElement) {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const p = document.getElementById(t.getAttribute('aria-controls')!);
        p?.classList.toggle('is-hidden', !on);
      });
      (window as any).golemTick?.(520);
    }

    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
        e.preventDefault();
        const next =
          tabs[(i + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next);
      });
    });
  }
</script>
