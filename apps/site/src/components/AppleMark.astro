---
/**
 * THE APPLE LOGO, ONE DRAWING (phase 6, 2026-10-02): a rounded brick with two studs and a prompt
 * chevron cut out of its face. It reads "a command inside a Roblox brick" and has no leaf, no bite
 * and no fruit outline.
 *
 * `lockup` adds the wordmark, drawn as monoline strokes so it needs no font and takes
 * `currentColor`. The brick takes `--accent` (Ember: #ff8a4c on the dark ground, #a63f0a on the
 * light one, both measured above 5.9:1 on --paper). No <mask> and no ids, so it is safe to inline
 * more than once on a page.
 *
 * The right-hand stud is its own shape (`.stud--snap`). It sits lifted when `data-state="lifted"`
 * and clicks down with --ease-snap when something real happens: see components/Snap logic in
 * landing.css and apps/web. Under reduced motion it is simply seated.
 *
 * Files loaded through <img> (favicon.svg, logo-dark.svg, logo-light.svg, og.png, the touch icons)
 * cannot read CSS variables, so they carry the baked colours of this same drawing.
 */
interface Props {
  /** Height in CSS pixels. The width follows the viewBox. */
  size?: number;
  class?: string;
  lockup?: boolean;
  /** Set when the surrounding link or button already carries the name. */
  decorative?: boolean;
}
const { size = 32, class: className = '', lockup = false, decorative = true } = Astro.props;
const box = lockup ? { w: 128, h: 36 } : { w: 32, h: 36 };
const width = Math.round((size * box.w) / box.h);
---
<svg
  width={width}
  height={size}
  viewBox={`0 0 ${box.w} ${box.h}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`apple-mark ${className}`.trim()}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'Apple'}
  data-state="seated"
>
  <g fill="var(--accent)">
    <path fill-rule="evenodd" d="M10 11H22A7 7 0 0 1 29 18V26A7 7 0 0 1 22 33H10A7 7 0 0 1 3 26V18A7 7 0 0 1 10 11ZM9.4 16.2 19.6 22 9.4 27.8 7.8 25.2 13.6 22 7.8 18.8ZM21 26.4H25.6A1.2 1.2 0 0 1 25.6 28.8H21A1.2 1.2 0 0 1 21 26.4Z"></path>
    <rect class="stud" x="7" y="6.5" width="7" height="5.5" rx="2"></rect>
    <rect class="stud stud--snap" x="18" y="6.5" width="7" height="5.5" rx="2"></rect>
  </g>
  {lockup && (
    <g transform="translate(-4 0)" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M44 27 52 9 60 27M47 21H57"></path>
      <path d="M69 15V33"></path><circle cx="75" cy="21" r="6"></circle>
      <path d="M89 15V33"></path><circle cx="95" cy="21" r="6"></circle>
      <path d="M109 8V27"></path>
      <path d="M116 21H128A6 6 0 1 0 126.2 25.3"></path>
    </g>
  )}
</svg>
<style is:global>
  .apple-mark { flex: none; display: block; overflow: visible; }
  .apple-mark .stud--snap {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform 320ms var(--ease-snap);
  }
  .apple-mark[data-state='lifted'] .stud--snap { transform: translateY(-3px) rotate(-8deg); }
  @media (prefers-reduced-motion: reduce) {
    .apple-mark .stud--snap { transition: none; transform: none !important; }
  }
</style>
