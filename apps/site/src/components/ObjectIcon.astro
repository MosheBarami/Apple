---
/**
 * ONE GLYPH PER ROBLOX STUDIO OBJECT CLASS THE PRODUCT READS OR MAKES.
 *
 * Original line drawings on a 24-unit grid, drawn for this site: they evoke the object (a cube for
 * a Part, a page for a Script, a pad with an arrow for a SpawnLocation) and copy none of Roblox's
 * own Studio artwork. No Roblox logo appears anywhere in the set (owner decision, D-VISION-1: object
 * icons only, inside Roblox's brand guidelines). Same stroke, caps and grid as the beam diagram's
 * input glyphs, so the site keeps one icon language.
 *
 * Every stroke is `currentColor`, so an icon takes the colour of whatever holds it and follows the
 * theme with no rule of its own. Decorative by default (`aria-hidden`, the class name is always in
 * the text beside it); pass `title` when the icon is the only thing naming the object.
 */
const GLYPHS = {
  Workspace: '<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>',
  Part: '<path d="M12 3 4 7.5v9L12 21l8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>',
  MeshPart: '<path d="M12 3 3.5 9 7 20h10l3.5-11z"/><path d="M3.5 9 12 13l8.5-4M12 3v10M7 20l5-7 5 7"/>',
  Model: '<path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/><path d="m12 7.5-4 2.2v4.6l4 2.2 4-2.2V9.7z"/><path d="m8 9.7 4 2.2 4-2.2M12 11.9v4.6"/>',
  Script: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  LocalScript: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><circle cx="12" cy="12.5" r="1.8"/><path d="M8.8 18.2a3.4 3.4 0 0 1 6.4 0"/>',
  ModuleScript: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><rect x="8.5" y="11" width="7" height="7" rx="1"/><path d="M12 11v7M8.5 14.5h7"/>',
  ServerScriptService: '<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01M11 7.5h6M11 16.5h6"/>',
  ReplicatedStorage: '<rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4"/>',
  ScreenGui: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  Frame: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18"/>',
  TextButton: '<rect x="3" y="7" width="18" height="10" rx="5"/><path d="M8 12h8"/>',
  ImageLabel: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="m21 16-5-5-8 8"/>',
  Humanoid: '<rect x="9" y="2.5" width="6" height="5" rx="1"/><path d="M8 9.5h8v6H8zM8 10l-3 4.5M16 10l3 4.5M10 15.5V21M14 15.5V21"/>',
  Terrain: '<path d="m2 16 6-9 4 5 3-3.5 7 7.5"/><path d="M2 21c2 0 2-1.2 4-1.2s2 1.2 4 1.2 2-1.2 4-1.2 2 1.2 4 1.2 2-1.2 4-1.2"/>',
  SpawnLocation: '<ellipse cx="12" cy="17.5" rx="9" ry="3.5"/><path d="M12 14V4M8.5 7.5 12 4l3.5 3.5"/>',
  RemoteEvent: '<path d="M4 8h14M14 4l4 4-4 4M20 16H6M10 12l-4 4 4 4"/>',
  Sound: '<path d="M4 9.5v5h3.5l4.5 4v-13l-4.5 4z"/><path d="M15.5 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11"/>',
  ParticleEmitter: '<rect x="9" y="17" width="6" height="3" rx="1"/><path d="M12 14v-3M9 14.5 6.5 12M15 14.5l2.5-2.5"/><circle cx="12" cy="6.5" r="1"/><circle cx="5" cy="9" r="1"/><circle cx="19" cy="9" r="1"/>',
  Lighting: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>',
  Camera: '<path d="M3 8.5A1.5 1.5 0 0 1 4.5 7H7l1.5-2.5h7L17 7h2.5A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z"/><circle cx="12" cy="13" r="3.5"/>',
} as const;

export type ObjectName = keyof typeof GLYPHS;

interface Props {
  name: ObjectName;
  size?: number;
  title?: string;
  class?: string;
}

const { name, size = 18, title, class: className } = Astro.props;
---

<svg
  class:list={['obj-icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  data-object={name}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>{title && <title>{title}</title>}<Fragment set:html={GLYPHS[name]} /></svg>

<style is:global>
  .obj-icon {
    display: block;
    flex: none;
  }
</style>
