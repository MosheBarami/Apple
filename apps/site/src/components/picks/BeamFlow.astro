---
/**
 * WHAT GOES IN, WHAT COMES OUT — a hub with beams running into it and out of it.
 *
 * Four UI Layouts picks (MIT) are the same diagram at different settings, so they are one
 * component here:
 *   Animated Beam (default)          curved beams between nodes and a central hub
 *   Animated Beam Multiple Input     many sources fanning in to the hub
 *   Animated Beam Multiple Output    the hub fanning out to many targets
 *   Animated Beam Unidirectional     every beam travels one way only, in the direction work flows
 * The beams are re-drawn from what the originals do: a light runs along each curve, each at its
 * own pace. The curves are computed from where the nodes really sit (./beam-flow.ts), so the
 * picture holds at every width — side by side on a wide screen, stacked on a phone.
 *
 * EVERY NODE IS SOMETHING THE PRODUCT HANDLES. The inputs are what a run reads (the request, the
 * instance tree via get_project_tree, the Studio selection via get_selection); the outputs are
 * what its tools write (edit_script, create_instances, edit_terrain, set_mood, generate_model in
 * apps/worker/src/tools.ts). The labels are plain words for a young creator; the tool names stay
 * in this comment.
 *
 * Without scripting, or under reduced motion, it is the same nodes with no beams — nothing in it
 * is information that only the motion carries.
 */
import './beam-flow.css';
import AppleMark from '../AppleMark.astro';
import ObjectIcon, { type ObjectName } from '../ObjectIcon.astro';

const ICON: Record<string, string> = {
  idea: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  place: '<path d="M6 3v12M6 9h9M6 15h9"/><circle cx="18" cy="9" r="2.5"/><circle cx="18" cy="15" r="2.5"/><circle cx="6" cy="3" r="0.5"/>',
  selection: '<path d="M4 4l7 17 2.5-7.5L21 11z"/>',
};

const inputs = [
  { icon: 'idea', label: 'Your idea' },
  { icon: 'place', label: 'Your place' },
  { icon: 'selection', label: 'What you selected' },
];

/* The outputs are Roblox objects, so they are drawn from the site's one object icon set. */
const outputs: { icon: ObjectName; label: string }[] = [
  { icon: 'Script', label: 'Scripts' },
  { icon: 'Part', label: 'Parts' },
  { icon: 'Terrain', label: 'Terrain' },
  { icon: 'Lighting', label: 'Lighting' },
  { icon: 'MeshPart', label: '3D models' },
];

const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[name]}</svg>`;
---

<figure class="beam" data-beam>
  <figcaption class="micro beam-cap">What it reads, and what it can make in your place</figcaption>
  <div class="beam-grid">
    <ul class="beam-col beam-col--in" role="list" aria-label="What it reads">
      {inputs.map((n) => (
        <li class="beam-node">
          <span class="beam-label">{n.label}</span>
          <span class="beam-dot" data-beam-in set:html={svg(n.icon)} />
        </li>
      ))}
    </ul>

    <div class="beam-hub" data-beam-hub>
      <AppleMark size={30} alive={false} />
      <span class="visually-hidden">Apple</span>
    </div>

    <ul class="beam-col beam-col--out" role="list" aria-label="What it can make">
      {outputs.map((n) => (
        <li class="beam-node">
          <span class="beam-dot" data-beam-out><ObjectIcon name={n.icon} /></span>
          <span class="beam-label">{n.label}</span>
        </li>
      ))}
    </ul>

    <svg class="beam-svg" aria-hidden="true" focusable="false"></svg>
  </div>
</figure>

<script>
  import { mountBeams } from './beam-flow';
  mountBeams();
</script>
