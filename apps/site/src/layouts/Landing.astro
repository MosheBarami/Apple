---
import '../styles/landing.css';
import InterfaceSound from './InterfaceSound.astro';
import Cursor from '../components/Cursor.astro';
import SoundDock from './SoundDock.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL('https://appleworks.pages.dev');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);

/*
 * `data-theme="dark"` on <html> is the same default Base.astro sets, so the two layouts agree about
 * what a visitor with no stored preference gets, and the inline script below applies a stored
 * choice before first paint. Until this, the landing had no attribute, no script and no toggle, and
 * landing.css had one ramp — so choosing light on /pricing and clicking the wordmark landed a
 * reader on a dark homepage with no control to change it.
 *
 * DO NOT PUT AN ASTRO EXPRESSION BETWEEN <!doctype> AND <html>. One was written here first; Astro
 * stopped treating the file as a full document and emitted the page with no <html> and no <head>
 * at all, which the browser then rebuilt implicitly — so data-theme was gone at runtime while the
 * source still read correctly. The reasoning lives in this comment for that reason.
 */
---

<!doctype html>
<html lang="en" class="no-js" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apple" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Apple — a creative AI chat for Roblox Studio." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* #080808 was the retired pre-warm-ramp black and it was typed here, so on a phone the address
        bar sat a shade cooler than the #141312 page under it and left a seam across the top of every
        route — and it stayed near-black in light mode, over an almost-white page. The value is now
        derived: the script below reads `--theme-color` off :root and writes it here on load and on
        every toggle, so the band cannot disagree with the palette again. The server-rendered value
        is the dark ground, which is what the default `data-theme="dark"` renders. */}
    <meta name="theme-color" id="theme-color" content="#141312" />

    <script is:inline>
      // Runs before first paint, exactly as Base.astro's does: no flash of the wrong theme, and the
      // stored choice made anywhere else on the site is honoured here too.
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('apple-theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {
          /* private mode — keep the default */
        }
      })();
    </script>
  </head>
  <body>
    <slot />

    {/*
      THE FRONT PAGE WAS THE ONLY SILENT ROUTE, AND IT HAD NO CONTROL EITHER.

      The chrome routes carried a sound system inside Base.astro's script and a toggle inside
      Nav.astro; this page — the one the owner actually looks at — had neither, so the thing he
      singled out on rosebud.ai (pressing a button makes a mechanical keyboard click) could not
      happen here at all. Both layouts now render the SAME component, so there is one synth, one
      stored preference and one listener for the whole site rather than two copies that drift.

      The dock is the control and InterfaceSound is the engine. Only this route renders the dock,
      because Nav.astro already carries a toggle on every Base route and two toggles on one page is
      worse than none — and because the dock's stylesheet has no business on a page with no dock.
    */}
    <SoundDock />
    <InterfaceSound />
    {/* LAST IN THE BODY ON PURPOSE. It is a fixed overlay at the top of the stacking order and it
        must be painted over everything, including the dock above it. It renders nothing a reader
        can reach — aria-hidden, pointer-events: none — and it hides the native pointer only from
        inside its own running loop, never from a stylesheet. See the note in the component. */}
    <Cursor />

    <script is:inline>
      // The landing's own theme wiring. It is inline and tiny rather than a module because this
      // route's whole point is that it ships essentially nothing; the alternative was leaving the
      // front page as the only route on the site with no way to change a preference every other
      // route offers.
      (function () {
        var root = document.documentElement;

        /** The address-bar colour is read from the stylesheet, never typed twice. */
        function paintBand() {
          var meta = document.getElementById('theme-color');
          if (!meta) return;
          var v = getComputedStyle(root).getPropertyValue('--theme-color').trim();
          if (v) meta.setAttribute('content', v);
        }

        function theme() {
          var set = root.getAttribute('data-theme');
          return set === 'light' ? 'light' : 'dark';
        }

        function paintToggles() {
          var t = theme();
          var list = document.querySelectorAll('[data-theme-toggle]');
          for (var i = 0; i < list.length; i++) {
            list[i].setAttribute('aria-pressed', String(t === 'dark'));
            list[i].setAttribute(
              'aria-label',
              t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
            );
          }
        }

        document.addEventListener('click', function (e) {
          var btn = e.target && e.target.closest ? e.target.closest('[data-theme-toggle]') : null;
          if (!btn) return;
          var next = theme() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('apple-theme', next);
          } catch (err) {
            /* private mode — the choice still applies for this page view */
          }
          paintToggles();
          paintBand();
        });

        paintToggles();
        paintBand();
      })();
    </script>

    <script is:inline>
      /*
       * SCROLL REVEAL — the driver for the [data-reveal] rules in landing.css.
       *
       * Inline and at the end of <body> on purpose, matching the theme script above: this route's
       * whole point is that it ships essentially nothing, and a hoisted module for twenty lines
       * would be a bundle request to do less than this does. It also means the DOM above it is
       * already parsed, so there is no readiness dance and no `document.currentScript` — the
       * spelling that shipped a completely dead hero effect on this very page today, because
       * `currentScript` is null in every module script by specification.
       *
       * EVERY BRANCH ENDS WITH THE CONTENT VISIBLE. That is the only hard requirement here. A front
       * page that hides its own copy waiting for a class that never arrives is far worse than a
       * front page that does not animate, so the failure is made impossible four times over — see
       * the long note above the rules in landing.css. The failsafe below is the fourth: whatever
       * else happens, everything is revealed shortly after load.
       */
      (function () {
        var nodes = [].slice.call(document.querySelectorAll('[data-reveal]'));
        if (!nodes.length) return;

        function show(el) {
          var d = el.getAttribute('data-reveal-delay');
          if (d) el.style.setProperty('--reveal-delay', d + 'ms');
          el.classList.add('is-in');
        }
        function showAll() {
          for (var i = 0; i < nodes.length; i++) show(nodes[i]);
        }

        if (!('IntersectionObserver' in window)) { showAll(); return; }

        var io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            show(entries[i].target);
            io.unobserve(entries[i].target);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

        for (var i = 0; i < nodes.length; i++) io.observe(nodes[i]);

        /* The failsafe. An observer that never fires — a zero-height parent, a threshold a short
           section can never satisfy, a browser quirk — would leave copy invisible forever. After
           this beat, nothing is hidden regardless of what the observer did or did not do. */
        setTimeout(function () { io.disconnect(); showAll(); }, 2600);
      })();
    </script>
  </body>
</html>
