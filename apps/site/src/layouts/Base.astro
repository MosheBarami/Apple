---
// THE SITE'S ONE LAYOUT (M2 rebuild, handoff 2.2). Every route renders through it, the front page included:
// the front page used to have a layout of its own (Landing.astro), which is how the two drifted apart.
// DocsLayout and LegalLayout sit on top of this one and add only their inner structure.
//
// The design tokens come FIRST: one file, shared with the app. base.css is the shared base on top of it
// and global.css adds the document routes' structure. Neither declares a colour or a type token, so the
// cascade needs no `!important` to settle.
import '@studpilot/design/tokens.css';
import tokensCss from '@studpilot/design/tokens.css?raw';
import { themeColor } from '@studpilot/design/css-tokens';
import '../styles/base.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /**
   * A page that must never be a search result, and must never nominate a canonical URL.
   *
   * The 404 page is served at /404 as a cacheable HTTP 200 (apps/worker/src/static.ts, that lane's to fix), and
   * a self-canonical there would advertise the one URL whose own content says "not here" as a destination.
   * `noindex` emits robots/googlebot noindex and suppresses the self-canonical, so there is no destination
   * claim left to honour whatever status the bytes arrive with.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://studpilot.app');
const canonical = new URL(Astro.url.pathname, site);
// A PNG, not an SVG: Facebook, X, LinkedIn and Slack document PNG, JPEG, GIF and WEBP for og:image and none of
// them list SVG. Generated from apps/site/brand/og.html by scripts/make-brand-assets.mjs.
const ogImage = new URL('/og.png', site);
---

<!doctype html>
<html lang="en" class="no-js" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <>
        <meta name="robots" content="noindex, follow" />
        <meta name="googlebot" content="noindex, follow" />
      </>
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StudPilot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="StudPilot, an AI co-pilot for Roblox Studio." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* The address-bar band is read from `--theme-color` on :root and rewritten on every toggle, so there is
        one definition per theme and it lives in the token file. The server-rendered value is the dark
        ground, matching this element's default `data-theme="dark"`. */}
    <meta name="theme-color" id="theme-color" content={themeColor('dark', tokensCss)} />

    <script is:inline>
      // Runs before first paint, so there is no flash of the wrong theme. The key 'apple-theme' is the
      // stored identifier this site has always written and the app still reads (AGENTS.md section 2: a browser
      // key already in people's browsers is read, never renamed away).
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('apple-theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {
          /* private mode: the dark default stands */
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // The theme toggle and the narrow-screen menu: all the script this layout ships.
      (function () {
        var root = document.documentElement;

        function paint() {
          var meta = document.getElementById('theme-color');
          var band = getComputedStyle(root).getPropertyValue('--theme-color').trim();
          if (meta && band) meta.setAttribute('content', band);
          var dark = root.getAttribute('data-theme') !== 'light';
          document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(dark));
            b.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
          });
        }

        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          if (t.closest('[data-theme-toggle]')) {
            var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('apple-theme', next);
            } catch (err) {
              /* the choice holds for this page only */
            }
            paint();
            return;
          }
          var burger = t.closest('#menu-toggle');
          var nav = document.getElementById('primary-nav');
          if (burger && nav) {
            var open = nav.toggleAttribute('data-open');
            burger.setAttribute('aria-expanded', String(open));
            burger.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
          }
        });

        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          var nav = document.getElementById('primary-nav');
          var burger = document.getElementById('menu-toggle');
          if (nav && nav.hasAttribute('data-open')) {
            nav.removeAttribute('data-open');
            if (burger) {
              burger.setAttribute('aria-expanded', 'false');
              burger.setAttribute('aria-label', 'Open the menu');
              burger.focus();
            }
          }
        });

        paint();
      })();
    </script>
  </body>
</html>
