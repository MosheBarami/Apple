---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** omit nav/footer chrome (unused today, kept for future embeds) */
  bare?: boolean;
  /**
   * A page that must never be a search result, and must never nominate a canonical URL.
   *
   * THE 404 PAGE WAS ADVERTISING ITSELF AS A DESTINATION. It is served at /404 as a cacheable HTTP
   * 200 (apps/worker/src/static.ts — the status is that lane's to fix), and this layout gave it
   * `<link rel="canonical" href=".../404/">`. So the one URL on the site whose own canonical
   * answers 404 was also the one telling crawlers that URL is where this content lives. A crawler
   * that believes both indexes "That page is not here" and points it at a dead address.
   *
   * `noindex` is the half this lane can fix and the half that actually decides indexing: it emits
   * robots/googlebot noindex and suppresses the self-canonical, so there is no destination claim
   * left to honour whatever status code the bytes arrive with.
   */
  noindex?: boolean;
}

const { title, description, bare = false, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://appleworks.pages.dev');
const canonical = new URL(Astro.url.pathname, site);
// A PNG, not the SVG this was. Facebook, X, LinkedIn and Slack all document PNG/JPEG/GIF/WEBP
// for og:image and none of them list SVG, so the old tag most likely produced no preview image at
// all — a failure with no symptom anywhere inside this repository. Generated from
// apps/site/brand/og.html by scripts/make-brand-assets.mjs; `pnpm brand:check` fails the build if
// the committed PNG has drifted from its source.
const ogImage = new URL('/og.png', site);
---

<!doctype html>
<html lang="en" class="no-js" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <>
        <meta name="robots" content="noindex, follow" />
        <meta name="googlebot" content="noindex, follow" />
      </>
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* The icon set is generated from favicon.svg by scripts/make-brand-assets.mjs, so
        every size is the same drawing. The 1.2 MB of PNGs that used to sit in
        public/brand/ showed a different mark entirely and were linked from nothing. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apple" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Apple — an AI that writes Luau and places parts inside Roblox Studio." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* #080808 is the retired pre-warm-ramp black. It was typed here on all seven routes and the
        toggle never touched it, so a phone showed an address-bar band a shade cooler than the
        #141312 page beneath it — a visible seam at the top of every page — and in light mode that
        near-black band sat over an almost-white page. The value is now read from `--theme-color` on
        :root and rewritten on every toggle, so there is one definition per theme and it lives in the
        stylesheet with the rest of the ramp. The server-rendered value is the dark ground, matching
        this element's default `data-theme="dark"`. */}
    <meta name="theme-color" id="theme-color" content="#141312" />

    <script is:inline>
      // Runs before first paint: no flash of the wrong theme, and reveals can
      // safely start hidden because we know scripting is alive.
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('apple-theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {
          /* private mode — fall back to prefers-color-scheme */
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    {!bare && <Nav />}

    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}

    <script>
      // ---------------------------------------------------------------
      // Scroll reveals. Under prefers-reduced-motion the CSS neutralises
      // the transform, so adding the class is harmless and nothing can
      // ever stay invisible.
      // ---------------------------------------------------------------
      const reveals = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal], .kinetic')
      );

      if (reveals.length) {
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const el = entry.target as HTMLElement;
                const delay = el.dataset.revealDelay;
                if (delay) el.style.setProperty('--reveal-delay', `${delay}ms`);
                el.classList.add('is-in');
                io.unobserve(el);
              }
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.06 }
          );
          reveals.forEach((el) => io.observe(el));

          /* THE FAILSAFE, AND WHY IT IS HERE NOW.
             These routes — docs, changelog, pricing — hide their content at opacity 0 and wait for
             a class. The branch above covers a browser with no IntersectionObserver. NOTHING
             covered an observer that is PRESENT and never fires, and in that case the copy is gone
             permanently rather than late: a changelog that renders its releases to nobody.
             Measured on the deployed /changelog on 2026-09-20: two of its three reveal targets sat
             at opacity 0. That reading was taken in a background tab, where the observer legitimately
             waits, so it is not by itself proof of a defect for a normal visitor — but it is proof
             that "nothing has revealed yet" is a state this page really reaches, and the only thing
             standing between that state and a permanent one was an observer firing.
             The landing layout has carried this guarantee since earlier the same day, after a hero
             effect shipped to production whose script never executed at all. Same guarantee, same
             shape, and apps/site/tests/reveal-cannot-hide-content.test.mjs now asserts it for both
             layouts rather than for whichever one somebody remembered. */
          setTimeout(() => {
            io.disconnect();
            reveals.forEach((el) => el.classList.add('is-in'));
          }, 2600);
        } else {
          reveals.forEach((el) => el.classList.add('is-in'));
        }
      }

      // ---------------------------------------------------------------
      // Theme. Explicit choice wins and persists; otherwise the OS decides.
      // ---------------------------------------------------------------
      const root = document.documentElement;
      const mqDark = window.matchMedia('(prefers-color-scheme: dark)');

      function currentTheme(): 'light' | 'dark' {
        const set = root.getAttribute('data-theme');
        if (set === 'light' || set === 'dark') return set;
        return mqDark.matches ? 'dark' : 'light';
      }

      /**
       * The address-bar colour, read from the stylesheet rather than restated here. Called from
       * paintToggles so every path that changes the theme — the button, and an OS change while no
       * explicit choice is set — repaints the band as well as the page.
       */
      function paintBand() {
        const meta = document.getElementById('theme-color');
        if (!meta) return;
        const v = getComputedStyle(root).getPropertyValue('--theme-color').trim();
        if (v) meta.setAttribute('content', v);
      }

      function paintToggles() {
        paintBand();
        const theme = currentTheme();
        document
          .querySelectorAll<HTMLElement>('[data-theme-toggle]')
          .forEach((btn) => {
            btn.setAttribute('aria-pressed', String(theme === 'dark'));
            btn.setAttribute(
              'aria-label',
              theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
            );
          });
      }

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest('[data-theme-toggle]');
        if (!btn) return;
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('apple-theme', next);
        } catch (err) {
          /* ignore */
        }
        paintToggles();
        window.dispatchEvent(
          new CustomEvent('apple:theme', { detail: { theme: next } })
        );
      });

      mqDark.addEventListener('change', () => {
        if (!root.hasAttribute('data-theme')) {
          paintToggles();
          window.dispatchEvent(
            new CustomEvent('apple:theme', { detail: { theme: currentTheme() } })
          );
        }
      });

      paintToggles();

      // ---------------------------------------------------------------
      // Sound. OFF by default and never armed until the visitor presses the
      // toggle — that press is the required user gesture, and it is also
      // what creates the AudioContext. Nothing autoplays, ever.
      // ---------------------------------------------------------------
      let audio: AudioContext | null = null;
      let soundOn = false;

      function paintSoundToggles() {
        document
          .querySelectorAll<HTMLElement>('[data-sound-toggle]')
          .forEach((btn) => {
            btn.setAttribute('aria-pressed', String(soundOn));
            btn.setAttribute(
              'aria-label',
              soundOn ? 'Turn interface sound off' : 'Turn interface sound on'
            );
          });
      }

      /** short synthesised chisel tick — no audio files, no autoplay */
      function tick(freq = 320, dur = 0.07, gain = 0.05) {
        if (!soundOn || !audio) return;
        const t = audio.currentTime;
        const osc = audio.createOscillator();
        const env = audio.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, t);
        osc.frequency.exponentialRampToValueAtTime(freq * 0.55, t + dur);
        env.gain.setValueAtTime(0.0001, t);
        env.gain.exponentialRampToValueAtTime(gain, t + 0.006);
        env.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        osc.connect(env).connect(audio.destination);
        osc.start(t);
        osc.stop(t + dur + 0.02);
      }

      (window as any).appleTick = tick;

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest('[data-sound-toggle]');
        if (!btn) return;
        soundOn = !soundOn;
        if (soundOn && !audio) {
          const Ctx =
            (window as any).AudioContext || (window as any).webkitAudioContext;
          if (Ctx) audio = new Ctx();
        }
        if (soundOn) audio?.resume?.();
        paintSoundToggles();
        if (soundOn) tick(420, 0.09, 0.05);
      });

      paintSoundToggles();
    </script>
  </body>
</html>
