---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;

// Every docs route appears here exactly once. A page absent from this list is
// reachable only by typing its URL, so adding a page under src/pages/docs/ and
// not adding it here ships an orphan — which is what happened to /docs/connect,
// /docs/updating, /docs/troubleshooting and /docs/build-from-source.
const sections = [
  {
    label: 'Start here',
    links: [
      { href: '/docs', label: 'Overview' },
      { href: '/docs/getting-started', label: 'Getting started' },
      { href: '/docs/plugin', label: 'Install the plugin' },
      { href: '/docs/connect', label: 'Connect a project' },
    ],
  },
  {
    label: 'Using Apple',
    links: [
      { href: '/docs/modes', label: 'Modes: Plan and Agent' },
      { href: '/docs/credits-and-limits', label: 'Credits & limits' },
      { href: '/docs/billing', label: 'Billing & payments' },
    ],
  },
  {
    label: 'Keeping it working',
    links: [
      { href: '/docs/updating', label: 'Updating the plugin' },
      { href: '/docs/troubleshooting', label: 'Troubleshooting' },
    ],
  },
  {
    label: 'Trust',
    links: [
      { href: '/docs/privacy-and-data', label: 'Privacy & data' },
      { href: '/docs/faq', label: 'FAQ' },
    ],
  },
  {
    label: 'Developer',
    links: [{ href: '/docs/build-from-source', label: 'Build from source' }],
  },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/docs';
---

<Base title={title} description={description}>
  <div class="wrap docs">
    <aside class="docs__side">
      <details class="docs__nav" id="docs-nav-details">
        <summary>
          <span>Docs navigation</span>
          <span class="docs__chev" aria-hidden="true"></span>
        </summary>
        {/* THE DOCS COULD NOT BE SEARCHED AT ALL until this. The nav below is a hand-written list;
            finding a sentence meant opening pages one at a time. This reads a static index built
            from the page sources at deploy time (src/pages/docs-index.json.js) and filters it in
            the browser — it deliberately does NOT call the worker's /api/docs/search, which
            indexes Roblox's documentation rather than ours and bills a Credit per query. */}
        <form class="docs__search" role="search" onsubmit="return false">
          <label class="visually-hidden" for="docs-search">Search the documentation</label>
          <input
            type="search"
            id="docs-search"
            name="q"
            placeholder="Search the docs"
            autocomplete="off"
            aria-describedby="docs-search-count"
            aria-controls="docs-search-results"
          />
          <p class="docs__searchcount" id="docs-search-count" role="status" aria-live="polite"></p>
          <ul class="docs__results" id="docs-search-results" hidden></ul>
        </form>

        <nav aria-label="Documentation" id="docs-nav-list">
          {
            sections.map((section) => (
              <div class="docs__group">
                <p class="docs__grouplabel mono">{section.label}</p>
                <ul>
                  {section.links.map((link) => (
                    <li>
                      <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="docs__main">
      <p class="eyebrow">Docs</p>
      <h1 class="carved">{heading}</h1>
      <div class="prose">
        <slot />
      </div>

      <footer class="docs__foot">
        <p>
          Stuck? Ask in the app — Plan mode answers doc questions for 2 credits —
          or email
          <a href="mailto:apple.labs.app@gmail.com">apple.labs.app@gmail.com</a>.
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: clamp(2.25rem, 5vw, 3.5rem) clamp(3.5rem, 8vw, 6rem);
    align-items: start;
  }

  .docs__side {
    position: sticky;
    top: 6rem;
  }

  .docs__nav {
    border: 0;
  }

  .docs__nav > summary {
    display: none;
  }

  .docs__search {
    margin-bottom: 1.4rem;
  }

  .docs__search input {
    width: 100%;
    padding: 0.5rem 0.7rem;
    font: inherit;
    font-size: 0.88rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }

  .docs__search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .docs__searchcount {
    margin: 0.45rem 0 0;
    font-size: 0.75rem;
    color: var(--faint);
  }

  .docs__searchcount:empty {
    display: none;
  }

  .docs__results {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  /* :global BECAUSE THESE NODES ARE BUILT AT RUNTIME. Astro scopes a component's styles by
     stamping a data attribute onto the elements in its template; a <li> created by innerHTML never
     gets one, so a scoped rule silently does not match it. Measured: the snippet rendered
     unclamped and unstyled until these were globalised. The `.docs__results` ancestor is in the
     template, so the scoping still confines them to this list. */
  .docs__results :global(a) {
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    text-decoration: none;
    background: var(--surface);
  }

  .docs__results :global(a:hover) {
    border-color: var(--accent);
    text-decoration: none;
  }

  .docs__results :global(.docs__resulttitle) {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 550;
  }

  /* Two lines of the matching prose. A result list of bare titles would be the nav again, which is
     the thing this exists to improve on. */
  .docs__results :global(.docs__resultsnip) {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .docs__group {
    margin-bottom: 1.6rem;
  }

  .docs__grouplabel {
    font-size: 0.63rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 0.55rem;
  }

  .docs__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
    border-left: 1px solid var(--line);
  }

  .docs__group a {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
    padding: 0.35rem 0.85rem;
    border-left: 2px solid transparent;
    margin-left: -1px;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .docs__group a:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .docs__group a[aria-current='page'] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 550;
  }

  .docs__main {
    max-width: 72ch;
    min-width: 0;
  }

  .docs__main h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 1.5rem;
  }

  /* ---- prose ---- */
  .prose :global(h2) {
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    margin-top: 2.75rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }

  .prose :global(h2:first-child) {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.9rem;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(em) {
    color: var(--ink);
    font-style: italic;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
    display: grid;
    gap: 0.45rem;
    margin: 0.7rem 0 1.3rem;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .prose :global(.callout) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    box-shadow: var(--lift-1);
  }

  .prose :global(.callout p) {
    margin: 0;
    color: var(--ink);
    font-size: 0.94rem;
  }

  .prose :global(.callout--violet) {
    border-left-color: var(--acc-rune);
  }

  .docs__foot {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.88rem;
  }

  /* ---- mobile nav ---- */
  @media (max-width: 900px) {
    .docs {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .docs__side {
      position: static;
    }

    .docs__nav {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      box-shadow: var(--lift-1);
      overflow: hidden;
    }

    .docs__nav > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      cursor: pointer;
      font-weight: 570;
      font-size: 0.94rem;
      padding: 0.85rem 1.1rem;
      list-style: none;
      color: var(--ink);
    }

    .docs__nav > summary::-webkit-details-marker {
      display: none;
    }

    .docs__chev {
      width: 9px;
      height: 9px;
      border-right: 1.5px solid var(--accent);
      border-bottom: 1.5px solid var(--accent);
      transform: rotate(45deg) translateY(-2px);
      transition: transform var(--dur) var(--ease-out);
      flex: none;
    }

    .docs__nav[open] .docs__chev {
      transform: rotate(225deg) translateY(-2px);
    }

    .docs__nav nav {
      padding: 0 1.1rem 1rem;
    }

    .docs__main {
      max-width: none;
    }
  }
</style>

<script>
  import { searchDocs, type DocEntry } from '../data/docs-index';

  // WHY THE INDEX IS FETCHED RATHER THAN INLINED. The prose of every docs page is tens of
  // kilobytes; inlined into each one it would be paid for by every reader, including those who
  // never type anything. It is fetched once, on the first keystroke, and reused after that.
  //
  // AND A FAILURE TO LOAD IS SAID OUT LOUD. A search box that silently finds nothing because its
  // index 404'd looks exactly like one working over a corpus that does not cover your question,
  // and the reader draws the second conclusion. It says which, and leaves the nav in place.
  const input = document.getElementById('docs-search') as HTMLInputElement | null;
  const results = document.getElementById('docs-search-results') as HTMLUListElement | null;
  const count = document.getElementById('docs-search-count');
  const navList = document.getElementById('docs-nav-list');

  let index: DocEntry[] | null = null;
  let loading: Promise<DocEntry[] | null> | null = null;

  function loadIndex(): Promise<DocEntry[] | null> {
    if (index) return Promise.resolve(index);
    loading ??= fetch('/docs-index.json', { cache: 'force-cache' })
      .then((r) => (r.ok ? (r.json() as Promise<DocEntry[]>) : null))
      .then((data) => {
        index = Array.isArray(data) ? data : null;
        return index;
      })
      .catch(() => null);
    return loading;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);
  }

  function render(query: string, data: DocEntry[] | null) {
    if (!results || !count) return;
    if (!query.trim()) {
      results.hidden = true;
      results.innerHTML = '';
      count.textContent = '';
      if (navList) navList.hidden = false;
      return;
    }
    if (!data) {
      results.hidden = true;
      results.innerHTML = '';
      count.textContent = 'Search is unavailable — the index did not load. The list below still works.';
      if (navList) navList.hidden = false;
      return;
    }
    const hits = searchDocs(data, query);
    if (navList) navList.hidden = hits.length > 0;
    count.textContent =
      hits.length === 0 ? `Nothing matches “${query}”.` : `${hits.length} page${hits.length === 1 ? '' : 's'}`;
    results.hidden = hits.length === 0;
    results.innerHTML = hits
      .map(
        (h) =>
          `<li><a href="${h.path}"><span class="docs__resulttitle">${escapeHtml(h.title)}</span>`
          + `<span class="docs__resultsnip">${escapeHtml(h.snippet)}</span></a></li>`,
      )
      .join('');
  }

  input?.addEventListener('input', () => {
    // Render what is typed NOW, not what was typed when the fetch started: the index arrives once
    // and later keystrokes must not be answered with an earlier query's results.
    void loadIndex().then((data) => render(input.value, data));
  });

  input?.addEventListener('keydown', (e) => {
    // Escape clears the query. Without this it closes the mobile disclosure the box lives in, which
    // hides the results the reader was looking at.
    if (e.key === 'Escape' && input.value) {
      e.stopPropagation();
      input.value = '';
      render('', index);
    }
  });

  // Desktop keeps the nav permanently expanded; mobile treats it as a disclosure.
  const details = document.getElementById('docs-nav-details') as HTMLDetailsElement | null;
  if (details) {
    const mq = window.matchMedia('(min-width: 901px)');
    const sync = () => {
      if (mq.matches) details.open = true;
    };
    sync();
    mq.addEventListener('change', sync);
  }
</script>
