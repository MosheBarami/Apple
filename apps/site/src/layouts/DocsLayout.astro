---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;

// Every docs route appears here exactly once. A page absent from this list is
// reachable only by typing its URL, so adding a page under src/pages/docs/ and
// not adding it here ships an orphan — which is what happened to /docs/connect,
// /docs/updating, /docs/troubleshooting and /docs/build-from-source.
const sections = [
  {
    label: 'Start here',
    links: [
      { href: '/docs', label: 'Overview' },
      { href: '/docs/getting-started', label: 'Getting started' },
      { href: '/docs/plugin', label: 'Install the plugin' },
      { href: '/docs/connect', label: 'Connect a project' },
    ],
  },
  {
    label: 'Using Golem',
    links: [
      { href: '/docs/modes', label: 'Modes: Plan, Agent, Super Agent' },
      { href: '/docs/sparks-and-limits', label: 'Sparks & limits' },
    ],
  },
  {
    label: 'Keeping it working',
    links: [
      { href: '/docs/updating', label: 'Updating the plugin' },
      { href: '/docs/troubleshooting', label: 'Troubleshooting' },
    ],
  },
  {
    label: 'Trust',
    links: [
      { href: '/docs/privacy-and-data', label: 'Privacy & data' },
      { href: '/docs/faq', label: 'FAQ' },
    ],
  },
  {
    label: 'Developer',
    links: [{ href: '/docs/build-from-source', label: 'Build from source' }],
  },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/docs';
---

<Base title={title} description={description}>
  <div class="wrap docs">
    <aside class="docs__side">
      <details class="docs__nav" id="docs-nav-details">
        <summary>
          <span>Docs navigation</span>
          <span class="docs__chev" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Documentation">
          {
            sections.map((section) => (
              <div class="docs__group">
                <p class="docs__grouplabel mono">{section.label}</p>
                <ul>
                  {section.links.map((link) => (
                    <li>
                      <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="docs__main">
      <p class="eyebrow">Docs</p>
      <h1 class="carved">{heading}</h1>
      <div class="prose">
        <slot />
      </div>

      <footer class="docs__foot">
        <p>
          Stuck? Ask in the app — Plan mode answers doc questions for 2 sparks —
          or email
          <a href="mailto:golem.labs.app@gmail.com">golem.labs.app@gmail.com</a>.
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: clamp(2.25rem, 5vw, 3.5rem) clamp(3.5rem, 8vw, 6rem);
    align-items: start;
  }

  .docs__side {
    position: sticky;
    top: 6rem;
  }

  .docs__nav {
    border: 0;
  }

  .docs__nav > summary {
    display: none;
  }

  .docs__group {
    margin-bottom: 1.6rem;
  }

  .docs__grouplabel {
    font-size: 0.63rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 0.55rem;
  }

  .docs__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
    border-left: 1px solid var(--line);
  }

  .docs__group a {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
    padding: 0.35rem 0.85rem;
    border-left: 2px solid transparent;
    margin-left: -1px;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .docs__group a:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .docs__group a[aria-current='page'] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 550;
  }

  .docs__main {
    max-width: 72ch;
    min-width: 0;
  }

  .docs__main h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 1.5rem;
  }

  /* ---- prose ---- */
  .prose :global(h2) {
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    margin-top: 2.75rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }

  .prose :global(h2:first-child) {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.9rem;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(em) {
    color: var(--ink);
    font-style: italic;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
    display: grid;
    gap: 0.45rem;
    margin: 0.7rem 0 1.3rem;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .prose :global(.callout) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    box-shadow: var(--lift-1);
  }

  .prose :global(.callout p) {
    margin: 0;
    color: var(--ink);
    font-size: 0.94rem;
  }

  .prose :global(.callout--violet) {
    border-left-color: var(--acc-rune);
  }

  .docs__foot {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.88rem;
  }

  /* ---- mobile nav ---- */
  @media (max-width: 900px) {
    .docs {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .docs__side {
      position: static;
    }

    .docs__nav {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      box-shadow: var(--lift-1);
      overflow: hidden;
    }

    .docs__nav > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      cursor: pointer;
      font-weight: 570;
      font-size: 0.94rem;
      padding: 0.85rem 1.1rem;
      list-style: none;
      color: var(--ink);
    }

    .docs__nav > summary::-webkit-details-marker {
      display: none;
    }

    .docs__chev {
      width: 9px;
      height: 9px;
      border-right: 1.5px solid var(--accent);
      border-bottom: 1.5px solid var(--accent);
      transform: rotate(45deg) translateY(-2px);
      transition: transform var(--dur) var(--ease-out);
      flex: none;
    }

    .docs__nav[open] .docs__chev {
      transform: rotate(225deg) translateY(-2px);
    }

    .docs__nav nav {
      padding: 0 1.1rem 1rem;
    }

    .docs__main {
      max-width: none;
    }
  }
</style>

<script>
  // Desktop keeps the nav permanently expanded; mobile treats it as a disclosure.
  const details = document.getElementById('docs-nav-details') as HTMLDetailsElement | null;
  if (details) {
    const mq = window.matchMedia('(min-width: 901px)');
    const sync = () => {
      if (mq.matches) details.open = true;
    };
    sync();
    mq.addEventListener('change', sync);
  }
</script>
