---
import Base from './Base.astro';
import { SUPPORT_EMAIL } from '@studpilot/shared';
import { docsPages } from '../data/docs-index';

/*
 * THE DOCS LAYOUT, on the site's one Base layout (M2 site fix cycle 1, plan step 2.6).
 *
 * THE SIDEBAR IS DERIVED FROM THE FILES. It was a hand-written list of sections and links, and the header comment above it said that a page
 * added under src/pages/docs and not added to the list ships as an orphan, which is what happened to four of them. The list is now read from the
 * page sources (src/data/docs-index.ts, the same raw glob the search index reads): a page appears the day its file exists, under its own
 * `heading` and in the order of its own `order`. tests/docs-nav-derived.test.mjs reads the built sidebar back.
 *
 * What a docs page passes: `title`, `description` and `heading` as before, plus `order` (its place) and `summary` (one line for the /docs index).
 * The title is written as "<heading> | StudPilot", like every page of the site.
 */
interface Props {
  title: string;
  description: string;
  heading: string;
  /** Read from the page's source by docsPages(); the layout itself does not use them. */
  summary?: string;
  order?: number;
}

const { title, description, heading } = Astro.props;

const sources = import.meta.glob('../pages/docs/*.astro', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const pages = docsPages(sources);
const current = Astro.url.pathname.replace(/\/$/, '') || '/docs';
const label = (p: { path: string; heading: string }) => (p.path === '/docs' ? 'Overview' : p.heading);
---

<Base title={title} description={description}>
  <div class="wrap docs">
    <aside class="docs__side">
      <details class="docs__nav" id="docs-nav-details">
        <summary>
          <span>Docs pages</span>
          <span class="docs__chev" aria-hidden="true"></span>
        </summary>
        {/* THE DOCS SEARCH reads a static index built from the page sources at deploy time (src/pages/docs-index.json.js) and filters it in
            the browser. It deliberately does NOT call the worker's /api/docs/search, which indexes Roblox's documentation rather than ours and
            bills a Credit per query. */}
        <form class="docs__search" role="search" onsubmit="return false">
          <label class="visually-hidden" for="docs-search">Search the documentation</label>
          <input
            type="search"
            id="docs-search"
            name="q"
            placeholder="Search the docs"
            autocomplete="off"
            aria-describedby="docs-search-count"
            aria-controls="docs-search-results"
          />
          <p class="docs__searchcount" id="docs-search-count" role="status" aria-live="polite"></p>
          <ul class="docs__results" id="docs-search-results" hidden></ul>
        </form>

        <nav aria-label="Documentation" id="docs-nav-list">
          <ul>
            {
              pages.map((p) => (
                <li>
                  <a href={p.path} aria-current={current === p.path ? 'page' : undefined}>
                    {label(p)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </aside>

    <article class="docs__main">
      <p class="eyebrow">Docs</p>
      <h1 class="carved">{heading}</h1>
      <div class="prose">
        <slot />
      </div>

      <footer class="docs__foot">
        <p>
          Stuck? Ask in the app, check your Credits before sending, or email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: clamp(2.25rem, 5vw, 3.5rem) clamp(3.5rem, 8vw, 6rem);
    align-items: start;
  }

  .docs__side {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }

  .docs__nav > summary {
    display: none;
  }

  .docs__search {
    margin-bottom: 20px;
  }

  .docs__search input {
    width: 100%;
    min-height: 40px;
    padding: 0 12px;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    transition: border-color var(--t-fast) var(--ease-out);
  }

  .docs__search input::placeholder {
    color: var(--faint);
  }

  .docs__search input:hover {
    border-color: var(--line-strong);
  }

  .docs__searchcount {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--faint);
  }

  .docs__searchcount:empty {
    display: none;
  }

  .docs__results {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  /* :global BECAUSE THESE NODES ARE BUILT AT RUNTIME. Astro scopes a component's styles by stamping a data attribute onto the elements in its
     template; a <li> created by innerHTML never gets one, so a scoped rule silently does not match it. */
  .docs__results :global(a) {
    display: grid;
    gap: 2px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    text-decoration: none;
    background: var(--surface);
  }

  .docs__results :global(a:hover) {
    border-color: var(--line-strong);
  }

  .docs__results :global(.docs__resulttitle) {
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
  }

  /* Two lines of the matching prose. A result list of bare titles would be the nav again. */
  .docs__results :global(.docs__resultsnip) {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #docs-nav-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  #docs-nav-list a {
    display: block;
    padding: 7px 10px;
    border-radius: var(--r-sm);
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    transition:
      color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  #docs-nav-list a:hover {
    color: var(--ink);
    background: var(--control-fill);
  }

  /* The page you are on: ink, the accent wash, and an accent rule on its edge, so it is not carried by colour alone. */
  #docs-nav-list a[aria-current='page'] {
    color: var(--ink);
    background: var(--accent-wash);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  /* The column is exactly the prose measure, so the title, the section rules and the "Stuck?" rule under the page all end where the text ends
     (it was 72ch beside a 70ch .prose, and the footer rule overshot every rule above it by 21px). */
  .docs__main {
    max-width: var(--prose-measure);
    min-width: 0;
  }

  /* The title is `.carved`, at the size every document route shares. */
  .docs__main h1 {
    margin-bottom: 28px;
  }

  /* ---- prose ---- */
  .prose :global(h2) {
    font-size: 1.375rem;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
  }

  .prose :global(h2:first-child) {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.9rem;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(em) {
    color: var(--ink);
    font-style: italic;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
    display: grid;
    gap: 0.45rem;
    margin: 0.7rem 0 1.3rem;
  }

  .prose :global(li::marker) {
    color: var(--faint);
  }

  .prose :global(a:not(.btn)) {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 0.17em;
  }

  .prose :global(.callout) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 16px 20px;
    margin: 24px 0;
  }

  .prose :global(.callout p) {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
  }

  /* A keyboard key. A plain keycap, not an animated one: it shows the key and does nothing else. */
  .prose :global(kbd) {
    padding: 1px 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-xs);
    background: var(--surface-2);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .docs__foot {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
    color: var(--faint);
    font-size: 0.88rem;
  }

  .docs__foot p {
    margin: 0;
  }

  /* ---- narrow screens: the list folds into a disclosure ---- */
  @media (max-width: 900px) {
    .docs {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .docs__side {
      position: static;
    }

    /* NO overflow: hidden HERE. The summary fills this box edge to edge and the shared focus ring is drawn 4px OUTSIDE it, so clipping the box clipped the
       whole ring: a keyboard user tabbing to "Docs pages" saw no focus at all. The corners are rounded by the box itself (a background follows the
       radius) and by the summary, so nothing needs clipping. */
    .docs__nav {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
    }

    .docs__nav > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      cursor: pointer;
      font-weight: 500;
      font-size: 15px;
      padding: 0.85rem 1.1rem;
      list-style: none;
      color: var(--ink);
      border-radius: var(--r-lg);
    }

    .docs__nav[open] > summary {
      border-radius: var(--r-lg) var(--r-lg) 0 0;
    }

    .docs__nav > summary::-webkit-details-marker {
      display: none;
    }

    .docs__chev {
      width: 9px;
      height: 9px;
      border-right: 1.5px solid var(--muted);
      border-bottom: 1.5px solid var(--muted);
      transform: rotate(45deg) translateY(-2px);
      transition: transform var(--t-base) var(--ease-out);
      flex: none;
    }

    .docs__nav[open] .docs__chev {
      transform: rotate(225deg) translateY(-2px);
    }

    .docs__search,
    .docs__nav nav {
      padding: 0 1.1rem 1rem;
    }

    .docs__main {
      max-width: none;
    }
  }
</style>

<script>
  import { searchDocs, type DocEntry } from '../data/docs-index';

  // WHY THE INDEX IS FETCHED RATHER THAN INLINED. The prose of every docs page is tens of kilobytes; inlined into each one it would be paid for
  // by every reader, including those who never type anything. It is fetched once, on the first keystroke, and reused after that.
  //
  // AND A FAILURE TO LOAD IS SAID OUT LOUD. A search box that silently finds nothing because its index 404'd looks exactly like one working
  // over a corpus that does not cover your question, and the reader draws the second conclusion. It says which, and leaves the list in place.
  const input = document.getElementById('docs-search') as HTMLInputElement | null;
  const results = document.getElementById('docs-search-results') as HTMLUListElement | null;
  const count = document.getElementById('docs-search-count');
  const navList = document.getElementById('docs-nav-list');

  let index: DocEntry[] | null = null;
  let loading: Promise<DocEntry[] | null> | null = null;

  function loadIndex(): Promise<DocEntry[] | null> {
    if (index) return Promise.resolve(index);
    loading ??= fetch('/docs-index.json', { cache: 'force-cache' })
      .then((r) => (r.ok ? (r.json() as Promise<DocEntry[]>) : null))
      .then((data) => {
        index = Array.isArray(data) ? data : null;
        return index;
      })
      .catch(() => null);
    return loading;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);
  }

  function render(query: string, data: DocEntry[] | null) {
    if (!results || !count) return;
    if (!query.trim()) {
      results.hidden = true;
      results.innerHTML = '';
      count.textContent = '';
      if (navList) navList.hidden = false;
      return;
    }
    if (!data) {
      results.hidden = true;
      results.innerHTML = '';
      count.textContent = 'Search is unavailable — the index did not load. The list below still works.';
      if (navList) navList.hidden = false;
      return;
    }
    const hits = searchDocs(data, query);
    if (navList) navList.hidden = hits.length > 0;
    count.textContent = hits.length === 0 ? `Nothing matches “${query}”.` : `${hits.length} page${hits.length === 1 ? '' : 's'}`;
    results.hidden = hits.length === 0;
    results.innerHTML = hits
      .map((h) => `<li><a href="${h.path}"><span class="docs__resulttitle">${escapeHtml(h.title)}</span><span class="docs__resultsnip">${escapeHtml(h.snippet)}</span></a></li>`)
      .join('');
  }

  input?.addEventListener('input', () => {
    // Render what is typed NOW, not what was typed when the fetch started: the index arrives once and later keystrokes must not be answered
    // with an earlier query's results.
    void loadIndex().then((data) => render(input.value, data));
  });

  input?.addEventListener('keydown', (e) => {
    // Escape clears the query. Without this it closes the mobile disclosure the box lives in, which hides the results the reader was looking at.
    if (e.key === 'Escape' && input.value) {
      e.stopPropagation();
      input.value = '';
      render('', index);
    }
  });

  // Desktop keeps the list permanently expanded; mobile treats it as a disclosure.
  const details = document.getElementById('docs-nav-details') as HTMLDetailsElement | null;
  if (details) {
    const mq = window.matchMedia('(min-width: 901px)');
    const sync = () => {
      if (mq.matches) details.open = true;
    };
    sync();
    mq.addEventListener('change', sync);
  }
</script>
