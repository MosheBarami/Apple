---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
}
const { title, description, heading, updated } = Astro.props;
---

<Base title={title} description={description}>
  <section class="section legal">
    <div class="wrap legal__wrap">
      <p class="eyebrow">Legal</p>
      <h1 class="carved">{heading}</h1>
      <p class="legal__updated mono">Last updated: {updated}</p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal__wrap {
    width: min(760px, calc(100% - var(--gutter) * 2));
    margin-inline: auto;
  }

  .legal h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
  }

  .legal__updated {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }

  .prose :global(h2) {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    margin-top: 2.75rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }

  .prose :global(h3) {
    font-size: 1.06rem;
    margin-top: 1.7rem;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.68;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.45rem;
    margin: 0.7rem 0 1.3rem;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(.callout) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    box-shadow: var(--lift-1);
  }

  .prose :global(.callout p) {
    margin: 0;
    color: var(--ink);
    font-size: 0.94rem;
  }
</style>
