---
/**
 * THE SOUND CONTROL FOR THE FRONT PAGE.
 *
 * Base.astro's routes get their toggle from Nav.astro. The landing has its own header, which this
 * lane does not own, so the control is its own object docked in the corner rather than a button
 * squeezed into somebody else's row. It drives the same `[data-sound-toggle]` hook the chrome's
 * button uses, so ONE listener in sound/interface-sound.js serves both and there is no second
 * implementation to drift.
 *
 * GEOMETRY IS THE MEASURED REFERENCE'S, IN OUR GREEN. 32px tall — `--h-sm`, one of the four control
 * heights every button on rosebud.ai lands on — a 6px `--r-sm` radius because nothing there is a
 * pill, a 1px hairline rather than a shadow, and the accent appearing as a 12% tint with a 38%
 * border and a 14% glow rather than as a fill. The fallbacks on every var() are there because the
 * chrome routes' global.css carries a smaller token set than landing.css, and an unresolvable
 * var() deletes its whole declaration silently.
 */
---

<div class="sound-dock" data-sound-dock>
  <button
    class="sound-dock__btn"
    type="button"
    data-sound-toggle
    aria-pressed="false"
    aria-label="Turn interface sound on"
  >
    <span class="sound-dock__dot" aria-hidden="true"></span>
    {/* The icon IS the meter: flat while sound is off, live while it is on, and it kicks on every
        press with the height of that press's own body gain. */}
    <canvas
      class="sound-dock__scope"
      width="64"
      height="20"
      data-sound-scope
      aria-hidden="true"></canvas>
    <span class="sound-dock__label">Sound</span>
  </button>
</div>

<style>
  /*
   * Geometry straight off the measured reference: 32px tall (--h-sm, one of its four control
   * heights), 6px radius (--r-sm, its control radius — nothing is a pill), a hairline border and
   * an accent that appears as a tint rather than a fill. The fallbacks exist because the chrome
   * routes' global.css carries a smaller token set than landing.css; a var() naming a token
   * nobody defines silently deletes the whole declaration.
   */
  .sound-dock {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 25;
    animation: sound-dock-rise 0.26s var(--ease-hard, cubic-bezier(0.32, 0.72, 0, 1)) both;
  }

  /*
   * IT YIELDS RATHER THAN COVERS. `data-flow` is written by the script when the floating corner
   * would land on top of a control — measured, not assumed; see the long note in
   * sound/interface-sound.js for the nine viewport sizes that produced this rule. In that state the
   * dock stops floating and takes its place at the end of the page, where it can cover nothing.
   */
  .sound-dock[data-flow] {
    position: static;
    display: flex;
    justify-content: center;
    padding: 0 16px 28px;
    animation: none;
  }

  /* IT NEEDS SCRIPTING TO DO ANYTHING, so without scripting it is not offered. Every other control
     on these pages works without JavaScript; a dead switch is worse than no switch. */
  :global(html.no-js) .sound-dock {
    display: none;
  }

  .sound-dock__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: var(--h-sm, 32px);
    padding: 0 10px;
    border-radius: var(--r-sm, 6px);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.08));
    background: var(--raised, #0a0f0c);
    color: var(--muted, #8b938e);
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
    position: relative;
    transition:
      color var(--t-color, 0.26s) var(--ease-hard, cubic-bezier(0.32, 0.72, 0, 1)),
      border-color var(--t-fast, 0.15s) ease-out,
      background-color var(--t-fast, 0.15s) ease-out;
  }

  .sound-dock__btn:hover {
    color: var(--ink, #fff);
    border-color: var(--line-strong, #2c3a33);
  }

  .sound-dock__btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 1px var(--accent, #00d492);
  }

  /* Armed: the accent family doing its three jobs — the light tint borders, the fill glows. */
  .sound-dock__btn[aria-pressed='true'] {
    color: var(--accent, #00d492);
    border-color: var(--accent-ring, rgba(102, 239, 194, 0.38));
    background: var(--accent-soft, rgba(0, 212, 146, 0.12));
    box-shadow: 0 0 12px var(--accent-glow, rgba(0, 212, 146, 0.14));
  }

  .sound-dock__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }

  .sound-dock__btn[aria-pressed='true'] .sound-dock__dot {
    opacity: 1;
    animation: sound-breathe 1.6s ease-in-out infinite;
  }

  .sound-dock__scope {
    width: 32px;
    height: 10px;
    display: block;
    opacity: 0.55;
    transition: opacity var(--t-color, 0.26s) var(--ease-hard, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .sound-dock__btn[aria-pressed='true'] .sound-dock__scope {
    opacity: 1;
  }

  /* THE PRESS RIPPLE. Added by the same handler that makes the sound, so what is seen and what is
     heard are one event. 0.26s is the ceiling the whole interface obeys. */
  .sound-dock__btn.is-hit::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--accent, #00d492);
    animation: sound-ring 0.26s var(--ease-hard, cubic-bezier(0.32, 0.72, 0, 1)) forwards;
    pointer-events: none;
  }

  @keyframes sound-dock-rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes sound-breathe {
    0%, 100% { opacity: 0.55; transform: scale(0.86); }
    50% { opacity: 1; transform: scale(1); }
  }

  @keyframes sound-ring {
    from { opacity: 0.9; transform: scale(1); }
    to { opacity: 0; transform: scale(1.14); }
  }

  /*
   * EVERY AMBIENT RULE STOPS THREE WAYS, and the script owns one predicate for all of them:
   * `data-sound-still` is written on <html> whenever sound is off, the tab is hidden, or the
   * visitor asked for reduced motion. The press ripple is deliberately NOT paused by it — it is a
   * response to a finger, not scenery, and it is over in 0.26s.
   */
  :global(html[data-sound-still='true']) .sound-dock__dot {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .sound-dock,
    .sound-dock__dot,
    .sound-dock__btn.is-hit::after {
      animation: none;
    }
    .sound-dock__btn,
    .sound-dock__scope {
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .sound-dock {
      right: 16px;
      bottom: 16px;
    }
    .sound-dock__label {
      display: none;
    }
  }
</style>
