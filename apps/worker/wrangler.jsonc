{
  "name": "golem",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionDO" },
      { "name": "QUOTA_DO", "class_name": "QuotaDO" },
      { "name": "PAIRING_DO", "class_name": "PairingDO" },
      { "name": "ADMIN_DO", "class_name": "AdminDO" },
      { "name": "BUDGET_DO", "class_name": "BudgetDO" },
      { "name": "DISCORD_DO", "class_name": "DiscordDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO", "QuotaDO", "PairingDO", "AdminDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BudgetDO"] },
    { "tag": "v3", "new_sqlite_classes": ["DiscordDO"] }
  ],
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "CORPUS", "database_name": "golem-corpus", "database_id": "32c9471e-a7d7-49ee-a8fe-0a7def2c68bd" }],
  //[[ GENERATED MEDIA LIVES IN R2, NOT IN A KV KEY WITH AN HOUR TO LIVE.
  //
  //   Generated images, generated audio and chat attachments were base64 in KV with
  //   expirationTtl 3600 — so a picture the product made for someone evaporated an hour later, and
  //   the retention page published that as the policy because it was true. KV is a key-value store
  //   with a 25 MiB value ceiling and no lifecycle; it was never the right home for bytes.
  //
  //   R2 free tier: 10 GB-month, 1,000,000 Class A and 10,000,000 Class B operations a month,
  //   deletes free, egress free. This product is nowhere near any of those.
  //
  //   TWO THINGS MUST TRAVEL WITH THE FIRST WRITE, not after it. R2 has no expiry, so an object
  //   lifecycle rule has to bound growth; and erasure.ts deletes a user's data by listing KV BY
  //   PREFIX, so it has to learn R2 or account deletion silently stops covering every image, audio
  //   file and attachment. That second one is a legal hole, not a bug.
  //
  //   Identical in both wrangler files on purpose — the contract at the top of this file. ]]
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "apple-media"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "cc341a7db4d748139f161fdc292e6e84" }],
  "vectorize": [{ "binding": "VEC", "index_name": "golem-docs" }],
    "vars": {
    // The Roblox account new library assets are created under. A public user id, not a
    // credential — the secret is ROBLOX_API_KEY. Read off the published Golem plugin
    // (asset 132128477945417, creator Herobrine583522) so the two cannot disagree.
    "ROBLOX_CREATOR_USER_ID": "11279664020",
    "SUPABASE_URL": "https://npqvyijsvzkuwddyhtpm.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_CZXQt2nYfaSnkYF5XoslzQ_LaIIn6wt",
    "ENVIRONMENT": "production",
    "BILLING_WORKER_NAME": "golem",
    "MEMBERSHIP_OUTBOX_CONSUMER": "golem",
    "AI_GATEWAY_ID": "golem",
    "BUILD_SHA": "616d84b"
  },
  //[[ THE NIGHTLY RETENTION SWEEP.
  //
  //   Three sweeps existed with no caller: expired memory entries, read and stale notifications,
  //   and automation run history. Every one of those windows is published; none of them was being
  //   applied. `scheduled` in src/index.ts is what this calls.
  //
  //   03:00 UTC, once a day. It deletes whole ranges from D1, which is single-threaded, so it runs
  //   when almost nothing else does — see schema-once.ts for what happens to this database when
  //   bulk work and ordinary requests arrive together. ]]
  // Every minute drains a bounded membership-access batch. This Worker acknowledges only the
  // `golem` delivery row; `apple` has a distinct SessionDO namespace and its own trigger.
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  //[[ TRACES ON, SAMPLED, BEFORE THE METER STARTS.
  //
  //   Logs were already enabled and already billed; nothing read them, because SENTRY_DSN was set on
  //   the OLD worker and never on this one. Traces are the half that answers "which step of the build
  //   broke" — the GLM call, the Vectorize lookup, every D1 read, every hop into SessionDO.
  //
  //   head_sampling_rate 0.05 is not caution, it is arithmetic. /api/studio/poll long-polls with a
  //   0.05s floor, so one active build fires dozens of invocations a second and each fans out into
  //   many spans. Traces are free until 2026-10-01 and then count against the same 20M events/month
  //   the plan includes, at $0.60 per extra million. Turning them on now, sampled, buys a free
  //   measurement of the real span volume before the meter starts — which is the only way to choose
  //   this number rather than guess it. Revisit it with that measurement, not with an opinion. ]]
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.05 } }
}
