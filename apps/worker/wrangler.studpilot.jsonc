// The StudPilot Worker, the product's only backend (`infra/deploy-worker.mjs studpilot`).
// It was the `apple` Worker, renamed in place in handoff step 1.3, which kept its Durable Objects,
// secrets and id. The former `apple` and `golem` hosts are proxies now (infra/legacy-proxy).
{
  "name": "studpilot",
  "main": "src/index.ts",
  // Explicit, because declaring `routes` below makes Wrangler turn the workers.dev host off by default.
  // studpilot.<sub>.workers.dev stays up as a second way in if the custom domain misbehaves.
  "workers_dev": true,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO"
      },
      {
        "name": "QUOTA_DO",
        "class_name": "QuotaDO"
      },
      {
        // golem's QuotaDO, moved into this Worker by migration v4 with its data (do/archive.ts).
        "name": "LEGACY_QUOTA_DO",
        "class_name": "ArchiveQuotaDO"
      },
      {
        "name": "PAIRING_DO",
        "class_name": "PairingDO"
      },
      {
        "name": "ADMIN_DO",
        "class_name": "AdminDO"
      },
      {
        "name": "BUDGET_DO",
        "class_name": "BudgetDO"
      },
      {
        "name": "DISCORD_DO",
        "class_name": "DiscordDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionDO",
        "QuotaDO",
        "PairingDO",
        "AdminDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "BudgetDO"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "DiscordDO"
      ]
    },
    {
      // Handoff 1.3: every Durable Object of the former `golem` Worker, with its storage, so that
      // Worker can become a proxy without deleting anything. Only ArchiveQuotaDO is served.
      "tag": "v4",
      "transferred_classes": [
        { "from": "SessionDO", "from_script": "golem", "to": "ArchiveSessionDO" },
        { "from": "QuotaDO", "from_script": "golem", "to": "ArchiveQuotaDO" },
        { "from": "PairingDO", "from_script": "golem", "to": "ArchivePairingDO" },
        { "from": "AdminDO", "from_script": "golem", "to": "ArchiveAdminDO" },
        { "from": "BudgetDO", "from_script": "golem", "to": "ArchiveBudgetDO" },
        { "from": "DiscordDO", "from_script": "golem", "to": "ArchiveDiscordDO" }
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "CORPUS",
      "database_name": "golem-corpus",
      "database_id": "32c9471e-a7d7-49ee-a8fe-0a7def2c68bd"
    }
  ],
  //[[ GENERATED MEDIA LIVES IN R2, NOT IN A KV KEY WITH AN HOUR TO LIVE.
  //
  //   Generated images, generated audio and chat attachments were base64 in KV with
  //   expirationTtl 3600 — so a picture the product made for someone evaporated an hour later, and
  //   the retention page published that as the policy because it was true. KV is a key-value store
  //   with a 25 MiB value ceiling and no lifecycle; it was never the right home for bytes.
  //
  //   R2 free tier: 10 GB-month, 1,000,000 Class A and 10,000,000 Class B operations a month,
  //   deletes free, egress free. This product is nowhere near any of those.
  //
  //   TWO THINGS MUST TRAVEL WITH THE FIRST WRITE, not after it. R2 has no expiry, so an object
  //   lifecycle rule has to bound growth; and erasure.ts deletes a user's data by listing KV BY
  //   PREFIX, so it has to learn R2 or account deletion silently stops covering every image, audio
  //   file and attachment. That second one is a legal hole, not a bug. ]]
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "apple-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "cc341a7db4d748139f161fdc292e6e84"
    }
  ],
  "vectorize": [
    {
      "binding": "VEC",
      "index_name": "golem-docs"
    }
  ],
  //[[ THE REST OF CLOUDFLARE (D-VISION-1). Every one is optional in env.ts.
  //   PRODUCT_EVENTS: product events, 3 months, no person in them (analytics-engine.ts).
  //   NOTIFY_QUEUE: notifications written by a consumer with retries (notify-queue.ts).
  //   MODEL_UPLOAD_WORKFLOW: finishes a slow 3D upload and tells the user (model-upload.ts).
  //   IMAGES: display-sized WebP copies of generated images (image-resize.ts). ]]
  "analytics_engine_datasets": [
    {
      "binding": "PRODUCT_EVENTS",
      "dataset": "apple_product_events"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFY_QUEUE",
        "queue": "apple-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "apple-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 6
      }
    ]
  },
  "workflows": [
    {
      "name": "apple-model-upload",
      "binding": "MODEL_UPLOAD_WORKFLOW",
      "class_name": "ModelUploadWorkflow"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "SUPABASE_URL": "https://npqvyijsvzkuwddyhtpm.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_CZXQt2nYfaSnkYF5XoslzQ_LaIIn6wt",
    "ENVIRONMENT": "production",
    // The self-check before answering (look + claim audit), on in production since 2026-10-04: the owner's /goal item 4
    // ("the agent checks its own work with multi-angle screenshots and improves it before answering") supersedes Q21.
    "SELF_CHECK": "on",
    "BILLING_WORKER_NAME": "apple",
    // D-PAY-2: signed-in emails admitted to Stripe TEST-mode checkout in production (comma-separated).
    "BILLING_TEST_ADMINS": "moshe.barami111@gmail.com",
    "MEMBERSHIP_OUTBOX_CONSUMER": "apple",
    "AI_GATEWAY_ID": "golem",
    // Public account id; with the CF_ANALYTICS_TOKEN secret it lets /api/admin/product-analytics read Analytics Engine.
    "CF_ACCOUNT_ID": "e9b8acf2e89a1de289a1ee4abb0f3f8d",
    "BUILD_SHA": "616d84b"
  },
  "triggers": {
    // The minute drains the membership outbox; 03:00 runs the retention sweeps (index.ts runScheduled).
    "crons": [
      "* * * * *",
      "0 3 * * *"
    ]
  },
  "routes": [
    { "pattern": "studpilot.app", "custom_domain": true }
  ],
  //[[ TRACES ON, SAMPLED, BEFORE THE METER STARTS.
  //
  //   Logs were already enabled and already billed; nothing read them, because SENTRY_DSN was set on
  //   the OLD worker and never on this one. Traces are the half that answers "which step of the build
  //   broke" — the GLM call, the Vectorize lookup, every D1 read, every hop into SessionDO.
  //
  //   head_sampling_rate 0.05 is not caution, it is arithmetic. /api/studio/poll long-polls with a
  //   0.05s floor, so one active build fires dozens of invocations a second and each fans out into
  //   many spans. Traces are free until 2026-10-01 and then count against the same 20M events/month
  //   the plan includes, at $0.60 per extra million. Turning them on now, sampled, buys a free
  //   measurement of the real span volume before the meter starts — which is the only way to choose
  //   this number rather than guess it. Revisit it with that measurement, not with an opinion. ]]
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
