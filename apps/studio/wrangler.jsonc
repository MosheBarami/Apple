{
  // The StudPilot agent (planning/REBUILD-2026-10-08.md): one AIChatAgent Durable Object per project.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studpilot-studio",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the `studpilot` worker, which proxies studpilot.app/studio/agent/* and /studio/api/* here
  // unchanged (same origin, so the signed-in Supabase session carries over). No workers.dev route.
  "workers_dev": false,
  "ai": { "binding": "AI" },
  // The agent's one door to the place: the Studio gate on the main worker.
  "services": [{ "binding": "GATE", "service": "studpilot", "entrypoint": "StudioGate" }],
  "vars": {
    "SUPABASE_URL": "https://npqvyijsvzkuwddyhtpm.supabase.co",
    "AI_GATEWAY_ID": "studpilot",
    "AGENT_MODEL": "@cf/moonshotai/kimi-k2.7-code"
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "StudPilotAgent", "class_name": "StudPilotAgent" },
      { "name": "FLUE_STUDPILOT", "class_name": "FlueStudPilotAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlueStudPilotAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["StudPilotAgent"] }
  ]
}
