{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    // The generative-UI validator is imported with an explicit .ts extension so
    // `node --test` can load it directly (native type stripping) without a build
    // step. Legal because this project never emits from tsc.
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // AICSS is vendored byte-for-byte from its public MIT package. Its upstream
  // tsconfig does not enable this repo's noUncheckedIndexedAccess/noUnusedLocals
  // flags, so keep the untouched vendor out of Apple's stricter root program
  // until a workspace integration imports or wraps it deliberately.
  "exclude": ["src/components/aicss"]
}
