<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.moshe.apple.strategic-owner</string>
  <key>ProgramArguments</key><array>
    <string>{{PYTHON}}</string><string>{{SUPERVISOR}}</string>
    <string>--owner</string><string>--config</string><string>{{CONFIG}}</string>
  </array>
  <key>WorkingDirectory</key><string>{{ROOT}}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>StandardOutPath</key><string>{{OUTPUT}}/launchd.stdout.log</string>
  <key>StandardErrorPath</key><string>{{OUTPUT}}/launchd.stderr.log</string>
</dict></plist>
